# ═══════════════════════════════════════════════════════
# Exyconn Website — Environment Variables (Example)
# ═══════════════════════════════════════════════════════

# NOTE: The website holds NO SMTP credentials. Public forms are posted to the
# portal, which stores the submission and sends the notification email using the
# SMTP account configured in Admin > Environment Variables (database-backed).

# App
PUBLIC_SITE_URL=https://exyconn.com

# Portal (content + form submissions API)
PUBLIC_PORTAL_GRAPHQL_URL=http://localhost:4004/graphql


# GCC cost calculator: the INR rate table exchange rates come from (ExchangeRate-API's free
# open endpoint, attribution shown in the calculator). Optional; this is the default.
GCC_FX_RATES_URL=https://open.er-api.com/v6/latest/INR
