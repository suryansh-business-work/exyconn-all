# ═══════════════════════════════════════════════════════
# Exyconn Website — Environment Variables (Example)
# ═══════════════════════════════════════════════════════

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@exyconn.com
SMTP_PASS=your-app-password
SMTP_FROM="Exyconn <your-email@exyconn.com>"
SMTP_TO=your-email@exyconn.com

# App
PUBLIC_SITE_URL=https://exyconn.com

# Portal (content + form submissions API)
PUBLIC_PORTAL_GRAPHQL_URL=http://localhost:4004/graphql

# TinaCMS — only needed to host the content editor (/admin) on the live site via TinaCloud.
# Local editing (`pnpm dev` → http://localhost:4000/admin/index.html) needs neither.
PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
