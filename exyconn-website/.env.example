# ═══════════════════════════════════════════════════════
# Exyconn Website — Environment Variables (Example)
# ═══════════════════════════════════════════════════════

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@exyconn.com
SMTP_PASS=your-app-password
SMTP_FROM="Exyconn <your-email@exyconn.com>"
SMTP_TO=your-email@exyconn.com

# App
PUBLIC_SITE_URL=https://exyconn.com

# Portal (content + form submissions API)
PUBLIC_PORTAL_GRAPHQL_URL=http://localhost:4004/graphql

# TinaCMS editor (/admin). `pnpm dev` runs it against the working tree with no login and needs
# none of these. In production the backend is self-hosted on this server: the content index lives
# in MongoDB and every save is committed to GitHub (fine-grained PAT, Contents: read and write).
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
GITHUB_OWNER=suryansh-business-work
GITHUB_REPO=exyconn-all
GITHUB_BRANCH=main
GITHUB_PERSONAL_ACCESS_TOKEN=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://exyconn.com/api/tina/auth
