---
import { processCopy, processSteps } from "../lib/home/process";
---

<!-- How We Work - Enhanced Process -->
<section class="py-24 px-4 bg-surface-subtle relative overflow-hidden">
  <!-- Background decoration -->

  <div class="max-w-6xl mx-auto relative z-10">
    <div class="text-center mb-16">
      <span
        class="inline-flex items-center gap-2 px-4 py-2 bg-cyan-subtle border border-cyan-muted rounded-full text-sm font-semibold text-cyan-fg-strong mb-4"
      >
        <i class={`fa-solid ${processCopy.badgeIcon}`}></i>
        {processCopy.badge}
      </span>
      <h2 class="text-4xl md:text-5xl font-black text-fg mb-4 tracking-tight" data-anime="fade-up">
        {processCopy.title}
        <span class="text-cyan-fg">{processCopy.accent}</span>
      </h2>
      <p
        class="text-xl text-fg-muted max-w-2xl mx-auto"
        data-anime="fade-up"
        data-anime-delay="100"
      >
        {processCopy.lead}
      </p>
    </div>

    <div class="grid md:grid-cols-4 gap-6" data-anime-stagger="fade-up" data-anime-step="120">
      {
        processSteps.map((step, index) => (
          <div class="relative group">
            <div
              class={`bg-surface rounded-2xl shadow-lg border border-line-subtle p-8 h-full hover:shadow-xl ${step.border} transition-all duration-300`}
            >
              <div
                class={`w-14 h-14 ${step.tile} rounded-2xl flex items-center justify-center mb-6 shadow-lg group-hover:scale-110 transition-transform`}
              >
                <i class={`fa-solid ${step.icon} text-2xl text-on-solid`} />
              </div>
              <div class="flex items-center gap-2 mb-3">
                <span
                  class={`w-8 h-8 ${step.chip} rounded-full flex items-center justify-center text-sm font-bold`}
                >
                  {index + 1}
                </span>
                <h3 class="font-bold text-lg text-fg">{step.title}</h3>
              </div>
              <p class="text-fg-muted text-sm leading-relaxed">{step.text}</p>
              <div class="mt-4 pt-4 border-t border-line-subtle">
                <span class="text-xs text-fg-faint font-medium">{step.when}</span>
              </div>
            </div>
            {index < processSteps.length - 1 && (
              <div class="hidden md:block absolute top-1/2 -right-3 transform -translate-y-1/2 z-20">
                <i class={`fa-solid fa-chevron-right ${step.connector}`} />
              </div>
            )}
          </div>
        ))
      }
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-16">
      <a
        href={processCopy.cta.href}
        class="inline-flex items-center gap-2 bg-cyan-deep text-on-solid font-semibold px-10 py-4 rounded-full shadow-lg shadow-cyan/25 hover:shadow-cyan/40 hover:scale-105 transition-all duration-300"
      >
        <i class={`fa-solid ${processCopy.cta.icon}`}></i>
        {processCopy.cta.label}
      </a>
    </div>
  </div>
</section>
