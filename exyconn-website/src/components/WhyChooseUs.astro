---
import {
  whyChooseUsActions,
  whyChooseUsCopy,
  whyChooseUsStats,
  whyChooseUsValues,
} from "../lib/home/why-choose-us";

const ACTION_CLASSES = [
  "inline-flex items-center gap-2 bg-cyan-deep text-on-solid font-semibold px-8 py-4 rounded-full shadow-lg shadow-cyan/25 hover:shadow-cyan/40 hover:scale-105 transition-all duration-300",
  "inline-flex items-center gap-2 bg-surface-muted text-fg font-semibold px-8 py-4 rounded-full hover:bg-surface-strong hover:scale-105 transition-all duration-300",
];
---

<!-- Why Choose Exyconn - Enhanced Value Proposition -->
<section class="bg-surface py-24 px-4 relative overflow-hidden">
  <!-- Background Elements -->

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-16">
      <!-- Left: Image with Stats Overlay -->
      <div class="w-full lg:w-1/2 relative">
        <img
          src={whyChooseUsCopy.image.src}
          alt={whyChooseUsCopy.image.alt}
          class="w-full rounded-3xl shadow-2xl object-cover h-[500px]"
        />
        <!-- Floating Stats Card -->
        <div
          class="absolute -bottom-8 -right-8 bg-surface rounded-2xl shadow-xl p-6 border border-line-subtle hidden md:block"
        >
          <div class="flex items-center gap-6">
            {
              whyChooseUsStats.map((stat, index) => (
                <>
                  {index > 0 && <div class="h-12 w-px bg-surface-strong" />}
                  <div class="text-center">
                    <div class={`text-3xl font-black ${stat.ink}`}>{stat.value}</div>
                    <div class="text-sm text-fg-subtle">{stat.label}</div>
                  </div>
                </>
              ))
            }
          </div>
        </div>
        <!-- Award Badge -->
      </div>

      <!-- Right: Content -->
      <div class="w-full lg:w-1/2">
        <span
          class="inline-flex items-center gap-2 px-4 py-2 bg-cyan-subtle border border-cyan-muted rounded-full text-sm font-semibold text-cyan-fg-strong mb-4"
        >
          <i class={`fa-solid ${whyChooseUsCopy.badgeIcon}`}></i>
          {whyChooseUsCopy.badge}
        </span>
        <h2
          class="text-4xl md:text-5xl font-black text-fg mb-6 tracking-tight leading-tight"
          data-anime="slide-right"
        >
          {whyChooseUsCopy.title}
          <span class="text-cyan-fg">{whyChooseUsCopy.accent}</span>
        </h2>
        <p class="text-xl text-fg-muted mb-8 leading-relaxed">
          {whyChooseUsCopy.lead}
        </p>

        <!-- Value Props Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
          {
            whyChooseUsValues.map((value) => (
              <div class="bg-surface rounded-xl shadow-md border border-line-subtle p-5 hover:shadow-lg transition-shadow">
                <div
                  class={`w-12 h-12 ${value.tile} rounded-xl flex items-center justify-center mb-4 shadow-lg`}
                >
                  <i class={`fa-solid ${value.icon} text-on-solid text-xl`} />
                </div>
                <h3 class="font-bold text-lg text-fg mb-2">{value.title}</h3>
                <p class="text-fg-muted text-sm">{value.text}</p>
              </div>
            ))
          }
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4">
          {
            whyChooseUsActions.map((action, index) => (
              <a href={action.href} class={ACTION_CLASSES[index]}>
                <i class={`fa-solid ${action.icon}`} />
                {action.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
