---
/** Chapter "FAQ" of a capability or service page (CMS "detail.faq"): heading beside the questions. */
import ChapterHeading from "../../inner/ChapterHeading.astro";
import FaqAccordion from "../../inner/FaqAccordion.astro";
import type { FaqItem } from "../../inner/types";

type Props = Readonly<{ index: number; label: string; title: string; items: readonly FaqItem[] }>;

const { index, label, title, items } = Astro.props;
---

<section class="inner-section stage-shell" aria-labelledby="detail-faq">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16">
    <ChapterHeading index={index} label={label} title={title} id="detail-faq" />
    <FaqAccordion items={items} />
  </div>
</section>
