---
/**
 * Chapter "Live demo" (CMS "detail.live"): a numbered heading over whatever the page drops
 * inside it — e.g. the WhatsApp chatbot's phone preview and demo access.
 */
import ChapterHeading from "../../inner/ChapterHeading.astro";

type Props = Readonly<{ index: number; label: string; title: string; lede: string }>;

const { index, label, title, lede } = Astro.props;
---

<section class="inner-section stage-shell" id="try-demo" aria-labelledby="detail-live">
  <ChapterHeading index={index} label={label} title={title} lede={lede} id="detail-live" />
  <div class="mt-10">
    <slot />
  </div>
</section>
