---
/**
 * 'company.chapter' — a numbered chapter of an inner page: its heading, then whatever is
 * dropped inside it (cards, lists, beliefs…).
 */
import ChapterHeading from "../../inner/ChapterHeading.astro";
import { cmsText } from "./types";

type Props = Readonly<{
  index: number;
  /** The heading's anchor; the section is labelled by it. */
  id: string;
  label: string;
  title: string;
  lede?: string;
}>;

const { index, id, label, title, lede } = Astro.props;
---

<section class="inner-section stage-shell" aria-labelledby={id}>
  <ChapterHeading index={index} id={id} label={label} title={title} lede={cmsText(lede)} />
  <slot />
</section>
