---
/**
 * 'company.sitemap' — the human sitemap: the portal's navigation links grouped by category
 * (Website › Navigation), else the site's own routes, with a search filter. The words are
 * props; `stats`, `pages` and `countTemplate` name {pages}, {sections}, {count}, {shown}
 * and {total}.
 */
import "../../content/content.css";
import FilterBar from "../../inner/FilterBar.astro";
import InnerStage from "../../inner/InnerStage.astro";
import { slugify } from "../../../lib/inner/headings";
import { pageCount, sitemapSections, treeBranches } from "../../../lib/content/sitemap";
import { getNavLinks } from "../../../lib/portal";
import { aiServiceLinks } from "../../../lib/cms/ai-services";
import type { CmsCrumb } from "./types";

type Props = Readonly<{
  crumbs: readonly CmsCrumb[];
  title: string;
  /** The landmark's name, e.g. "Sitemap". */
  navLabel: string;
  stats: string;
  filterLabel: string;
  searchLabel: string;
  searchPlaceholder: string;
  countTemplate: string;
  noMatch: string;
  pages: string;
  page: string;
}>;

const copy = Astro.props;
// The portal's navigation links when it has any; the site's own routes (with the AI service
// pages from the CMS catalogue) otherwise.
const host = Astro.request.headers.get("host") ?? "";
const sections = sitemapSections(await getNavLinks(), await aiServiceLinks(host));
const stats = copy.stats
  .replace("{pages}", String(pageCount(sections)))
  .replace("{sections}", String(sections.length));
---

<InnerStage
  family="company"
  variant="band"
  crumbs={copy.crumbs}
  title={copy.title}
  scene={{ shapes: ["tree"], data: { tree: { branches: treeBranches(sections) } } }}
>
  <p class="inner-meta stage-label">{stats}</p>
</InnerStage>

<div class="inner-section stage-shell">
  <FilterBar
    target="sitemap-sections"
    label={copy.filterLabel}
    sheetLabel={copy.filterLabel}
    search={{ param: "q", label: copy.searchLabel, placeholder: copy.searchPlaceholder }}
    countTemplate={copy.countTemplate}
  />
  <nav id="sitemap-sections" aria-label={copy.navLabel} class="content-sitemap mt-10">
    {
      sections.map((section, index) => (
        <section
          class="content-sitemap__section"
          aria-labelledby={`sitemap-${slugify(section.label)}`}
          data-stage-highlight={index + 1}
        >
          <p class="stage-label inner-index">{String(index + 1).padStart(2, "0")}</p>
          <h2 id={`sitemap-${slugify(section.label)}`} class="inner-h3 mt-2">
            {section.label}
          </h2>
          <p class="stage-label mt-1 text-fg-secondary">
            {section.links.length === 1
              ? copy.page
              : copy.pages.replace("{count}", String(section.links.length))}
          </p>
          <ul class="content-sitemap__links">
            {section.links.map((link) => (
              <li data-filter-item data-search={`${link.label} ${link.description ?? ""}`}>
                <a href={link.href} class="content-sitemap__link">
                  <span>{link.label}</span>
                  {link.description && (
                    <span class="content-sitemap__description">{link.description}</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </nav>
  <p data-filter-empty="sitemap-sections" class="inner-panel p-6 mt-6 text-fg-secondary" hidden>
    {copy.noMatch}
  </p>
</div>
