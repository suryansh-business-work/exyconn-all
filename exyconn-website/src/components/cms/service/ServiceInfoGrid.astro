---
/**
 * A numbered chapter of plain cards (CMS "service.info-grid"): what we offer, capabilities.
 * `anchor` gives the section an id other pages deep-link to ("" for none); `indexPrefix` puts
 * a mono index on each card ("" for none).
 */
import ChapterHeading from "../../inner/ChapterHeading.astro";
import InfoGrid from "../../hubs/InfoGrid.astro";

type Props = Readonly<{
  index: number;
  id: string;
  anchor: string;
  label: string;
  title: string;
  lede: string;
  indexPrefix: string;
  items: readonly { id?: string; title: string; text: string; points?: readonly string[] }[];
}>;

const { index, id, anchor, label, title, lede, indexPrefix, items } = Astro.props;
const sectionClass = anchor
  ? "inner-section stage-shell scroll-mt-24"
  : "inner-section stage-shell";
---

<section id={anchor || undefined} class={sectionClass} aria-labelledby={id}>
  <ChapterHeading index={index} id={id} label={label} title={title} lede={lede || undefined} />
  <InfoGrid items={items} indexPrefix={indexPrefix || undefined} />
</section>
