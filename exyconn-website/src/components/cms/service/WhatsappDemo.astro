---
/**
 * The WhatsApp chatbot page's live demo (CMS "service.whatsapp-demo"): the self-playing phone
 * preview beside the form that opens the real demo bots. Place it inside "detail.live".
 */
import WhatsappLivePreview from "../../whatsapp/WhatsappLivePreview.astro";
import type { PreviewMessage } from "../../whatsapp/types";
import { WhatsappDemoAccess } from "../../forms/whatsapp-demo";

type Props = Readonly<{
  business: string;
  status: string;
  caption: string;
  ariaLabel: string;
  messages: readonly PreviewMessage[];
}>;

const preview = Astro.props;
---

<div class="grid items-start gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16">
  <WhatsappLivePreview
    business={preview.business}
    status={preview.status}
    caption={preview.caption}
    ariaLabel={preview.ariaLabel}
    messages={preview.messages}
  />
  <WhatsappDemoAccess client:visible />
</div>
