---
/** A call-to-action link: solid `primary` or outlined `ghost`. Readable on night bands and in both site themes. */
import type { InnerAction } from "./types";

type Props = Readonly<{
  action: InnerAction;
  variant?: "primary" | "ghost";
  /** Tag to light in the stage scene while hovered or focused. */
  highlight?: number;
}>;

const { action, variant = "primary", highlight } = Astro.props;
const external = action.external ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<a
  href={action.href}
  {...external}
  class={`inner-action inner-action--${variant} w-full sm:w-auto`}
  data-stage-highlight={highlight}
>
  {action.label}
  {action.external && <span class="sr-only">(opens in a new tab)</span>}
  <i class="fa-solid fa-arrow-right icon-xs" aria-hidden="true"></i>
</a>
