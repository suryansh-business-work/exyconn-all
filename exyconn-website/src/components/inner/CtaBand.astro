---
/**
 * The closing call to action, on a night band. Its echo host is where the page's scene
 * re-forms small once the hero is gone (`echoShape` picks which of the scene's shapes, by
 * index). The default slot takes a mini form (e.g. a three-field enquiry).
 */
import "../../styles/inner-stage.css";
import ActionLink from "./ActionLink.astro";
import type { InnerAction, PageFamily } from "./types";

type Props = Readonly<{
  family: PageFamily;
  label?: string;
  title: string;
  text?: string;
  primary?: InnerAction;
  secondary?: InnerAction;
  /** Show the scene's echo (default true). */
  echo?: boolean;
  echoShape?: number;
  headingId?: string;
}>;

const {
  family,
  label,
  title,
  text,
  primary,
  secondary,
  echo = true,
  echoShape = 0,
  headingId = "closing-cta",
} = Astro.props;
---

<section
  class="inner-cta inner-section"
  data-theme="dark"
  data-accent={family}
  aria-labelledby={headingId}
>
  <div class="stage-shell grid gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
    <div class="max-w-2xl">
      {label && <p class="stage-label">{label}</p>}
      <h2 id={headingId} class="stage-title stage-title--md mt-3">
        <span class="block" data-reveal-line>{title}</span>
      </h2>
      {text && <p class="inner-lede">{text}</p>}
      {
        (primary || secondary) && (
          <div class="inner-stage__actions">
            {primary && <ActionLink action={primary} />}
            {secondary && <ActionLink action={secondary} variant="ghost" />}
          </div>
        )
      }
      <slot />
    </div>
    {
      echo && (
        <div class="inner-cta__echo" aria-hidden="true">
          <div class="inner-echo" data-stage-echo data-stage-shape={echoShape} />
        </div>
      )
    }
  </div>
</section>

<script>
  import { bootReveals } from "../../scripts/inner/reveal";

  bootReveals();
</script>
