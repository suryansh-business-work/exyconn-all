---
import { DEFAULT_MARKET, MARKETS, marketUrl, splitMarketPath } from "../lib/i18n/markets";

/**
 * Where somebody changes country and language.
 *
 * Every market is named the way that market names itself — "Österreich - Deutsch", not
 * "Austria - German" — because the person looking for it is reading in that language. The
 * links point at the page they are already on, so changing market never costs them their
 * place.
 */
const market = Astro.locals.market ?? DEFAULT_MARKET;
const { rest } = splitMarketPath(Astro.url.pathname.replace(/\/+$/, "") || "/");
const here = rest === "" ? "/" : rest;
---

<!-- Never translated: every market names itself in its own language, which is the point. -->
<details class="market-picker" translate="no">
  <summary aria-label="Change country and language">
    <span class="market-picker__globe" aria-hidden="true">🌐</span>
    <span>{market.label}</span>
  </summary>
  <div class="market-picker__panel">
    <ul>
      {
        MARKETS.map((entry) => (
          <li>
            <a
              href={marketUrl(entry, here)}
              hreflang={entry.locale}
              lang={entry.locale}
              aria-current={entry.path === market.path ? "true" : undefined}
            >
              {entry.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</details>

<style>
  .market-picker {
    position: relative;
    font-size: 0.875rem;
  }

  .market-picker summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    padding: 0.5rem 0;
    list-style: none;
  }

  .market-picker summary::-webkit-details-marker {
    display: none;
  }

  .market-picker__globe {
    font-size: 1rem;
  }

  .market-picker__panel {
    position: absolute;
    bottom: 100%;
    inset-inline-start: 0;
    z-index: 40;
    width: min(92vw, 46rem);
    max-height: min(60vh, 28rem);
    overflow-y: auto;
    padding: 1rem;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, currentColor 15%, transparent);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg, 0 1.25rem 2.5rem color-mix(in srgb, currentColor 22%, transparent));
  }

  .market-picker__panel ul {
    /* Eighty-six markets: one column on a phone, more as the screen allows. */
    columns: 1;
    column-gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .market-picker__panel ul {
      columns: 2;
    }
  }

  @media (min-width: 64rem) {
    .market-picker__panel ul {
      columns: 3;
    }
  }

  .market-picker__panel li {
    break-inside: avoid;
  }

  .market-picker__panel a {
    display: block;
    padding: 0.35rem 0.25rem;
    border-radius: 0.375rem;
    text-decoration: none;
    color: inherit;
  }

  .market-picker__panel a:hover,
  .market-picker__panel a:focus-visible {
    background: color-mix(in srgb, currentColor 8%, transparent);
  }

  .market-picker__panel a[aria-current] {
    font-weight: 700;
  }
</style>
