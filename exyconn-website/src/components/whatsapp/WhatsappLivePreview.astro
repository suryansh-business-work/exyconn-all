---
/**
 * The WhatsApp chatbot page's phone preview: a booking conversation that plays itself, message
 * by message, on a loop. The conversation is the page's CMS props ("service.whatsapp-demo").
 * With reduced motion the whole conversation simply shows.
 */
import "./whatsapp-preview.css";
import type { PreviewMessage } from "./types";

type Props = Readonly<{
  business: string;
  status: string;
  caption: string;
  /** The figure's accessible name; "{business}" is replaced by the business's name. */
  ariaLabel: string;
  messages: readonly PreviewMessage[];
}>;

const { business, status, caption, ariaLabel, messages } = Astro.props;
---

<figure class="wa-preview" aria-label={ariaLabel.replaceAll("{business}", business)}>
  <div class="wa-preview__phone">
    <div class="wa-preview__header">
      <span class="wa-preview__avatar" aria-hidden="true">
        <i class="fa-solid fa-tooth"></i>
      </span>
      <span class="wa-preview__who">
        <span class="wa-preview__name">{business}</span>
        <span class="wa-preview__status">{status}</span>
      </span>
      <i class="fa-brands fa-whatsapp wa-preview__brand" aria-hidden="true"></i>
    </div>
    <ol class="wa-preview__chat">
      {
        messages.map((message, index) => (
          <li
            class={`wa-preview__message wa-preview__message--${message.from}`}
            style={`--i: ${index}`}
          >
            <span class="wa-preview__bubble">{message.text}</span>
            {message.buttons.length > 0 && (
              <span class="wa-preview__buttons">
                {message.buttons.map((label) => (
                  <span class="wa-preview__button">{label}</span>
                ))}
              </span>
            )}
          </li>
        ))
      }
    </ol>
  </div>
  <figcaption class="wa-preview__caption">{caption}</figcaption>
</figure>
