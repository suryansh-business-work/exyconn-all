---
/**
 * The reading column of a role's page: skills, the portal's own description and
 * responsibilities (sanitized rich text), requirements, nice-to-haves, benefits and sharing.
 * Blocks without content are left out.
 */
import "../../styles/article.css";
import "./career.css";
import ShareLinks from "../content/ShareLinks.astro";
import DetailSection from "./DetailSection.astro";
import { fill } from "../../lib/career/format";
import type { CareerJobCopy } from "./types";
import { hasText } from "../../lib/career/company";
import { ARTICLE_CLASS, sanitizeArticleHtml } from "../../lib/portal";
import type { Job, JobCompany } from "../../lib/portal/types";

type Props = Readonly<{
  job: Job;
  company: JobCompany;
  url: string;
  copy: Pick<CareerJobCopy, "skills" | "body" | "share" | "shareTitle">;
}>;

const { job, company, url, copy } = Astro.props;
const lists = [
  { title: copy.body.requirements, items: job.requirements },
  { title: copy.body.niceToHave, items: job.niceToHave },
  { title: copy.body.benefits, items: job.benefits },
].filter((list) => list.items.length > 0);
---

<div class="career-detail__main">
  {
    job.skillSet.length > 0 && (
      <DetailSection title={copy.skills}>
        <ul class="inner-chips">
          {job.skillSet.map((skill) => (
            <li class="inner-chip">{skill}</li>
          ))}
        </ul>
      </DetailSection>
    )
  }
  {
    hasText(job.jobDescription) && (
      <DetailSection title={copy.body.about}>
        <div class={ARTICLE_CLASS} set:html={sanitizeArticleHtml(job.jobDescription)} />
      </DetailSection>
    )
  }
  {
    hasText(job.jobResponsibilities) && (
      <DetailSection title={copy.body.responsibilities}>
        <div class={ARTICLE_CLASS} set:html={sanitizeArticleHtml(job.jobResponsibilities)} />
      </DetailSection>
    )
  }
  {
    lists.map((list) => (
      <DetailSection title={list.title}>
        <ul class="inner-points">
          {list.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </DetailSection>
    ))
  }
  <div class="career-block">
    <ShareLinks
      url={url}
      title={fill(copy.shareTitle, { title: job.title, name: company.name })}
      labels={copy.share}
    />
  </div>
</div>
