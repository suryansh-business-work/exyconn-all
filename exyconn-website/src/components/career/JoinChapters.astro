---
/** Why join, how hiring works and the FAQ — the careers index's closing chapters. */
import ChapterHeading from "../inner/ChapterHeading.astro";
import FaqAccordion from "../inner/FaqAccordion.astro";
import StepTrack from "../inner/StepTrack.astro";
import PerkGrid from "./PerkGrid.astro";
import type { CareerIndexCopy } from "./types";

type Props = Readonly<{ start: number } & Pick<CareerIndexCopy, "why" | "hiring" | "faq">>;

const { start, why, hiring, faq } = Astro.props;
---

<section class="inner-section stage-shell" aria-labelledby="why-title">
  <ChapterHeading
    index={start}
    label={why.label}
    title={why.title}
    lede={why.lede}
    id="why-title"
  />
  <PerkGrid items={why.perks} />
</section>

<section class="inner-section stage-shell" aria-labelledby="hiring-title">
  <ChapterHeading index={start + 1} label={hiring.label} title={hiring.title} id="hiring-title" />
  <div class="mt-10"><StepTrack steps={hiring.steps} /></div>
</section>

<section class="inner-section stage-shell" aria-labelledby="faq-title">
  <ChapterHeading index={start + 2} label={faq.label} title={faq.title} id="faq-title" />
  <div class="mt-10 career-column">
    <FaqAccordion items={faq.items} />
    <p class="inner-card__text mt-8">{faq.accommodations}</p>
  </div>
</section>
