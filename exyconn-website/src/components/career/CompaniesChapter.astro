---
/** The careers index's company cards, the group company's cross-brand card last. */
import ChapterHeading from "../inner/ChapterHeading.astro";
import CompanyCard from "./CompanyCard.astro";
import type { CareerIndexCopy } from "./types";
import { countLabel } from "../../lib/career/format";
import type { CompanyCard as Card } from "../../lib/career/roles";

type Props = Readonly<{
  index: number;
  companies: readonly Card[];
  group?: Card;
  copy: CareerIndexCopy["companies"];
}>;

const { index, companies, group, copy } = Astro.props;
const openings = (n: number) => (n === 0 ? copy.noRoles : countLabel(n, copy.role, copy.roles));
---

<section class="inner-section stage-shell" aria-labelledby="companies-title">
  <ChapterHeading
    index={index}
    label={copy.label}
    title={copy.title}
    lede={copy.lede}
    id="companies-title"
  />
  <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 mt-10">
    {
      companies.map(({ company, openRoles }) => (
        <CompanyCard
          href={`/career/company/${company.slug}`}
          name={company.name}
          logo={company.logo}
          industry={company.industry}
          tagline={company.tagline}
          openings={openings(openRoles)}
          more={copy.viewOpenings}
        />
      ))
    }
    {
      group && group.openRoles > 0 && (
        <CompanyCard
          href={`/career/company/${group.company.slug}`}
          name={copy.groupTitle}
          logo={group.company.logo}
          industry={group.company.name}
          tagline={copy.groupText}
          openings={openings(group.openRoles)}
          more={copy.viewOpenings}
        />
      )
    }
  </ul>
</section>
