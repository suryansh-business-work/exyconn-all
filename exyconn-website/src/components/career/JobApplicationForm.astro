---
/**
 * The job application on a role's page: a React Hook Form + Zod island (./job-application)
 * that sends the fields and the résumé file to /api/job-application. Hydrates when scrolled
 * near, so the page above it loads no form code.
 */
import { JobApplicationForm as Form } from "./job-application";

type Props = Readonly<{
  jobId: string;
  jobTitle: string;
  companyName: string;
  companySlug: string;
}>;

const { jobId, jobTitle, companyName, companySlug } = Astro.props;
---

<Form
  client:visible
  jobId={jobId}
  jobTitle={jobTitle}
  companyName={companyName}
  companySlug={companySlug}
/>
