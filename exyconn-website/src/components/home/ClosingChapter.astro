---
/** Chapter 4 — the core again, complete. The company's own slogan and the way in. */
import { heroActions } from "../../lib/home/hero";
import { processCopy } from "../../lib/home/process";
import ChapterIntro from "./ChapterIntro.astro";
import StageButton from "./StageButton.astro";

interface Props {
  id: string;
  slogan: string;
  description: string;
  businessName: string;
}

const { id, slogan, description, businessName } = Astro.props;
---

<section id={id} data-chapter="4" class="stage-chapter stage-chapter--closing">
  <div class="stage-shell">
    <div class="glass p-6 md:p-10 max-w-2xl mx-auto">
      <ChapterIntro
        index={4}
        label={businessName}
        title={slogan}
        lead={description}
        size="md"
        centered
      >
        <div class="mt-8 flex flex-col sm:flex-row justify-center gap-3">
          <StageButton action={processCopy.cta} variant="solid" />
          <StageButton action={heroActions[0]} variant="glass" />
        </div>
      </ChapterIntro>
    </div>
  </div>
</section>
