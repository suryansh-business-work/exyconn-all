---
/**
 * Chapter 4 — the core again, complete. The company's own name, slogan and description
 * (Admin › Branding) and the way in.
 */
import { BRANDING_FALLBACK } from "../../lib/portal";
import type { CmsRenderContext } from "../../lib/cms/types";
import ChapterIntro from "./ChapterIntro.astro";
import StageButton from "./StageButton.astro";
import type { HomeAction } from "./types";

interface Props {
  id: string;
  /** The first is the solid button, the second the glass one. */
  actions: readonly HomeAction[];
  cms: CmsRenderContext;
}

const { id, actions, cms } = Astro.props;
// Every branding field can be empty until an admin fills it in.
const { branding } = cms;
const businessName = branding.businessName || BRANDING_FALLBACK.businessName;
const slogan = branding.slogan || BRANDING_FALLBACK.slogan;
const description = branding.description || BRANDING_FALLBACK.description;
const VARIANTS = ["solid", "glass"] as const;
---

<section id={id} data-chapter="4" class="stage-chapter stage-chapter--closing">
  <div class="stage-shell">
    <div class="glass p-6 md:p-10 max-w-2xl mx-auto">
      <ChapterIntro
        index={4}
        label={businessName}
        title={slogan}
        lead={description}
        size="md"
        centered
      >
        <div class="mt-8 flex flex-col sm:flex-row justify-center gap-3">
          {
            actions.map((action, index) => (
              <StageButton action={action} variant={VARIANTS[index]} />
            ))
          }
        </div>
      </ChapterIntro>
    </div>
  </div>
</section>
