---
/**
 * The platforms Exyconn builds on: two rows of logo cards sliding in opposite directions.
 *
 * Each row is rendered twice and the track moves by half its width, so the loop has no seam;
 * the second copy is hidden from assistive technology so every logo is announced once. A row
 * pauses while it is hovered or has focus, and under reduced motion the rows stop and wrap.
 */
import type { HomeLogo } from "./types";

interface Props {
  id: string;
  title: string;
  lead: string;
  /** Each row slides on its own, every second one against the first. */
  rows: readonly { logos: readonly HomeLogo[] }[];
}

const { id, title, lead, rows } = Astro.props;
const headingId = `${id}-title`;
---

<section id={id} class="platforms" aria-labelledby={headingId}>
  <div class="stage-shell">
    <div class="glass p-5 md:p-8">
      <h2 id={headingId} class="stage-title stage-title--md text-center">
        <span class="block" data-reveal-line>{title}</span>
      </h2>
      <p class="mt-3 text-center text-fg-secondary max-w-2xl mx-auto">{lead}</p>

      <div class="mt-8 flex flex-col gap-4">
        {
          rows.map((row, rowIndex) => (
            <div class:list={["platforms__row", { "platforms__row--reverse": rowIndex % 2 === 1 }]}>
              <div class="platforms__track">
                {[false, true].map((copy) => (
                  <ul class="platforms__list" aria-hidden={copy ? "true" : undefined}>
                    {row.logos.map((logo) => (
                      <li class="tech-logo-item platforms__card border border-line-subtle">
                        <img
                          src={logo.src}
                          alt=""
                          class="tech-logo platforms__logo"
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="platforms__name text-fg">{logo.name}</span>
                      </li>
                    ))}
                  </ul>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .platforms {
    position: relative;
    padding-block: var(--space-16);
  }

  .platforms__row {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 6%, black 94%, transparent);
  }

  .platforms__track {
    display: flex;
    width: max-content;
    animation: platforms-slide 60s linear infinite;
  }

  .platforms__row--reverse .platforms__track {
    animation-direction: reverse;
  }

  .platforms__row:hover .platforms__track,
  .platforms__row:focus-within .platforms__track {
    animation-play-state: paused;
  }

  .platforms__list {
    display: flex;
    gap: var(--space-4);
    padding-inline-end: var(--space-4);
  }

  .platforms__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    width: 10rem;
    height: 9rem;
    padding: var(--space-6) var(--space-3) var(--space-4);
    border-radius: var(--radius-xl);
  }

  .platforms__logo {
    height: var(--space-10);
    width: auto;
    max-width: 100%;
    margin-block: auto;
    object-fit: contain;
  }

  .platforms__name {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-align: center;
  }

  @media (min-width: 768px) {
    .platforms__card {
      width: 14rem;
      height: 13rem;
      padding: var(--space-10) var(--space-4) var(--space-6);
      border-radius: var(--radius-2xl);
    }

    .platforms__logo {
      height: var(--space-12);
    }

    .platforms__name {
      font-size: var(--font-size-sm);
    }
  }

  @keyframes platforms-slide {
    to {
      transform: translateX(-50%);
    }
  }

  /* Reduced motion: no slide — the cards wrap in place and the loop's copy is dropped. */
  @media (prefers-reduced-motion: reduce) {
    .platforms__row {
      mask-image: none;
    }

    .platforms__track {
      animation: none;
      width: auto;
    }

    .platforms__list {
      flex-wrap: wrap;
      justify-content: center;
      padding-inline-end: 0;
    }

    .platforms__list[aria-hidden="true"] {
      display: none;
    }
  }
</style>
