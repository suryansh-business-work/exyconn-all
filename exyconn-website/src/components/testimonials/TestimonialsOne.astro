<section class="relative isolate overflow-hidden bg-surface px-6 py-24 sm:py-32 lg:px-8">
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(45rem_50rem_at_top,var(--color-indigo-soft),var(--color-surface))] opacity-20"
  >
  </div>
  <div
    class="absolute inset-y-0 right-1/2 -z-10 mr-16 w-[200%] origin-bottom-left skew-x-[-30deg] bg-surface shadow-xl ring-1 shadow-indigo-strong/10 ring-indigo-subtle sm:mr-28 lg:mr-0 xl:mr-16 xl:origin-center"
  >
  </div>
  <div class="mx-auto max-w-2xl lg:max-w-4xl">
    <img
