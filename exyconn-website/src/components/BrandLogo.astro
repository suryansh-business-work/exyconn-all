---
/**
 * The site logo in whichever mode the element is in — the header, phone menu and footer are
 * night objects, so they show the night logo in both site modes. Branding carries a separate
 * logo for dark backgrounds (Admin > Branding); until one is uploaded the daylight logo is
 * drawn in one light colour on night surfaces, so it never turns dark-on-dark.
 */
import type { HTMLAttributes } from "astro/types";
import { BRANDING_FALLBACK, type Branding } from "../lib/portal";

type Props = Readonly<
  Omit<HTMLAttributes<"img">, "src"> & {
    branding: Branding;
    alt: string;
  }
>;

const { branding, class: className, ...imgProps } = Astro.props;

const lightSrc = branding.logoUrl || BRANDING_FALLBACK.logoUrl;
const darkSrc = branding.logoDarkUrl || lightSrc;
---

{
  darkSrc === lightSrc ? (
    <img class:list={[className, "dark:brightness-0 dark:invert"]} src={lightSrc} {...imgProps} />
  ) : (
    <>
      <img class:list={[className, "dark:hidden"]} src={lightSrc} {...imgProps} />
      <img class:list={[className, "hidden dark:inline"]} src={darkSrc} {...imgProps} />
    </>
  )
}
