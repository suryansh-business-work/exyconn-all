---
/**
 * The site logo in whichever mode the element is in — the header, phone menu and footer are
 * night objects, so they show the night logo in both site modes. Branding carries a separate
 * logo for dark backgrounds (Admin > Branding); until one is uploaded the daylight logo is
 * drawn in one light colour on night surfaces, so it never turns dark-on-dark.
 */
import type { HTMLAttributes } from "astro/types";
import { BRANDING_FALLBACK, type Branding } from "../lib/portal";
import { sizedImage } from "../lib/chrome/sized-image";

type Props = Readonly<
  Omit<HTMLAttributes<"img">, "src" | "height"> & {
    branding: Branding;
    alt: string;
    /** The drawn height in CSS pixels; the image is fetched at twice it. */
    height: number;
  }
>;

const { branding, class: className, height, ...imgProps } = Astro.props;

const lightSrc = sizedImage(branding.logoUrl || BRANDING_FALLBACK.logoUrl, height);
const darkSrc = branding.logoDarkUrl ? sizedImage(branding.logoDarkUrl, height) : lightSrc;
---

{
  darkSrc === lightSrc ? (
    <img
      class:list={[className, "dark:brightness-0 dark:invert"]}
      src={lightSrc}
      height={height}
      {...imgProps}
    />
  ) : (
    <>
      <img class:list={[className, "dark:hidden"]} src={lightSrc} height={height} {...imgProps} />
      <img
        class:list={[className, "hidden dark:inline"]}
        src={darkSrc}
        height={height}
        {...imgProps}
      />
    </>
  )
}
