---
const {
  title = "Lorem Ipsum Dolor Sit Amet",
  items = [
    {
      icon: "fa-solid fa-bolt text-indigo-fg mt-1",
      text: "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
    },
    {
      icon: "fa-solid fa-arrows-rotate text-indigo-fg mt-1",
      text: "Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
    },
    {
      icon: "fa-solid fa-money-bill-trend-up text-indigo-fg mt-1",
      text: "Ut enim ad minim veniam, quis nostrud exercitation ullamco.",
    },
    {
      icon: "fa-solid fa-gauge-high text-indigo-fg mt-1",
      text: "Duis aute irure dolor in reprehenderit in voluptate velit esse.",
    },
    {
      icon: "fa-solid fa-lightbulb text-indigo-fg mt-1",
      text: "Excepteur sint occaecat cupidatat non proident, sunt in culpa.",
    },
  ],
} = Astro.props;

/* Only the style and glyph classes are kept: size and colour belong to the tile. */
const iconName = (icon: string | null | undefined): string =>
  (icon ?? "").split(" ").slice(0, 2).join(" ");
---

<section class="py-20 lg:py-28 bg-surface-subtle">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <div class="bg-surface rounded-3xl shadow-xl border border-line-subtle p-8 lg:p-12">
      <!-- Title -->
      <h2 class="text-2xl md:text-3xl font-bold text-fg mb-8 text-center">
        {title}
      </h2>

      <!-- Items: wrapped and centred so an odd last row sits in the middle -->
      <ul class="flex flex-wrap justify-center gap-5">
        {
          items.map((item: { icon: string | null | undefined; text: unknown }) => (
            <li class="group flex items-center gap-4 p-5 w-full sm:w-[calc(50%-0.625rem)] lg:w-[calc(33.333%-0.834rem)] bg-surface-subtle rounded-2xl border border-line-subtle hover:border-blue-soft hover:bg-blue-subtle hover:-translate-y-0.5 transition-all duration-300">
              <div
                class="w-12 h-12 bg-blue-deep rounded-xl flex items-center justify-center shrink-0 shadow-lg shadow-blue/25 group-hover:scale-105 transition-transform duration-300"
                aria-hidden="true"
              >
                <i class={`${iconName(item.icon)} text-on-solid text-lg`} />
              </div>
              <p
                class="text-fg-secondary leading-relaxed text-sm font-medium"
                set:html={item.text}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
