---
export interface Props {
  headers: string[];
  rows: string[][];
  caption?: string;
  striped?: boolean;
  hoverable?: boolean;
  compact?: boolean;
}

const { headers, rows, caption, striped = true, hoverable = true, compact = false } = Astro.props;
---

<div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white">
  <table class="min-w-full divide-y divide-gray-200">
    {
      caption && (
        <caption class="px-6 py-4 text-left text-sm text-gray-500 bg-gray-50 border-b border-gray-200">
          {caption}
        </caption>
      )
    }
    <thead class="bg-gray-50">
      <tr>
        {
          headers.map((header, idx) => (
            <th
              scope="col"
              class={`${compact ? "px-4 py-3" : "px-6 py-4"} text-left text-xs font-semibold text-gray-600 uppercase tracking-wider ${idx === 0 ? "rounded-tl-2xl" : ""} ${idx === headers.length - 1 ? "rounded-tr-2xl" : ""}`}
            >
              {header}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      {
        rows.map((row, rowIdx) => (
          <tr
            class={`${striped && rowIdx % 2 === 1 ? "bg-gray-50/50" : "bg-white"} ${hoverable ? "hover:bg-blue-50/50 transition-colors" : ""}`}
          >
            {row.map((cell, cellIdx) => (
              <td
                class={`${compact ? "px-4 py-2.5" : "px-6 py-4"} text-sm ${cellIdx === 0 ? "font-medium text-gray-900" : "text-gray-600"} whitespace-nowrap`}
              >
                {cell === "Live" ? (
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-emerald-100 text-emerald-700 text-xs font-semibold rounded-full">
                    <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full" />
                    {cell}
                  </span>
                ) : cell === "In Development" ? (
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-amber-100 text-amber-700 text-xs font-semibold rounded-full">
                    <span class="w-1.5 h-1.5 bg-amber-500 rounded-full" />
                    {cell}
                  </span>
                ) : cell === "Coming Soon" ? (
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-gray-100 text-gray-600 text-xs font-semibold rounded-full">
                    <span class="w-1.5 h-1.5 bg-gray-400 rounded-full" />
                    {cell}
                  </span>
                ) : (
                  cell
                )}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
