---
export interface Props {
  headers: string[];
  rows: string[][];
  caption?: string;
  striped?: boolean;
  hoverable?: boolean;
  compact?: boolean;
}

const { headers, rows, caption, striped = true, hoverable = true, compact = false } = Astro.props;
---

<div class="overflow-x-auto rounded-2xl border border-line bg-surface">
  <table class="min-w-full divide-y divide-line">
    {
      caption && (
        <caption class="px-6 py-4 text-left text-sm text-fg-subtle bg-surface-subtle border-b border-line">
          {caption}
        </caption>
      )
    }
    <thead class="bg-surface-subtle">
      <tr>
        {
          headers.map((header, idx) => (
            <th
              scope="col"
              class={`${compact ? "px-4 py-3" : "px-6 py-4"} text-left text-xs font-semibold text-fg-muted uppercase tracking-wider ${idx === 0 ? "rounded-tl-2xl" : ""} ${idx === headers.length - 1 ? "rounded-tr-2xl" : ""}`}
            >
              {header}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody class="divide-y divide-line-subtle">
      {
        rows.map((row, rowIdx) => (
          <tr
            class={`${striped && rowIdx % 2 === 1 ? "bg-surface-subtle/50" : "bg-surface"} ${hoverable ? "hover:bg-blue-subtle/50 transition-colors" : ""}`}
          >
            {row.map((cell, cellIdx) => (
              <td
                class={`${compact ? "px-4 py-2.5" : "px-6 py-4"} text-sm ${cellIdx === 0 ? "font-medium text-fg" : "text-fg-muted"} whitespace-nowrap`}
              >
                {cell === "Live" ? (
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-emerald-soft text-emerald-fg-strong text-xs font-semibold rounded-full">
                    <span class="w-1.5 h-1.5 bg-emerald rounded-full" />
                    {cell}
                  </span>
                ) : cell === "In Development" ? (
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-amber-soft text-amber-fg-strong text-xs font-semibold rounded-full">
                    <span class="w-1.5 h-1.5 bg-amber rounded-full" />
                    {cell}
                  </span>
                ) : cell === "Coming Soon" ? (
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-surface-muted text-fg-muted text-xs font-semibold rounded-full">
                    <span class="w-1.5 h-1.5 bg-line-strong rounded-full" />
                    {cell}
                  </span>
                ) : (
                  cell
                )}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
