---
interface Props {
  icon: string;
  title: string;
  description: string;
  link?: string;
  color?: "blue" | "emerald" | "purple" | "orange" | "red" | "cyan" | "indigo";
  variant?: "default" | "dark" | "outline";
}

const { icon, title, description, link, color = "blue" } = Astro.props;

const gradientClasses = {
  blue: "from-blue to-blue-strong",
  emerald: "from-emerald to-teal-strong",
  purple: "from-purple to-violet-strong",
  orange: "from-orange to-amber-strong",
  red: "from-red to-rose-strong",
  cyan: "from-cyan to-blue-strong",
  indigo: "from-indigo to-purple-strong",
};

const shadowClasses = {
  blue: "shadow-blue/20",
  emerald: "shadow-emerald/20",
  purple: "shadow-purple/20",
  orange: "shadow-orange/20",
  red: "shadow-red/20",
  cyan: "shadow-cyan/20",
  indigo: "shadow-indigo/20",
};

const textClasses = {
  blue: "text-blue-fg",
  emerald: "text-emerald-fg",
  purple: "text-purple-fg",
  orange: "text-orange-fg",
  red: "text-red-fg",
  cyan: "text-cyan-fg",
  indigo: "text-indigo-fg",
};

const borderHoverClasses = {
  blue: "hover:border-blue-muted",
  emerald: "hover:border-emerald-muted",
  purple: "hover:border-purple-muted",
  orange: "hover:border-orange-muted",
  red: "hover:border-red-muted",
  cyan: "hover:border-cyan-muted",
  indigo: "hover:border-indigo-muted",
};

const WrapperTag = link ? "a" : "div";
---

<WrapperTag
  href={link}
  class={`group block bg-surface rounded-2xl shadow-md border border-line-subtle p-6 hover:shadow-xl ${borderHoverClasses[color]} transition-all duration-300`}
>
  <div
    class={`w-12 h-12 bg-gradient-to-br ${gradientClasses[color]} rounded-xl flex items-center justify-center mb-4 shadow-lg ${shadowClasses[color]} group-hover:scale-110 transition-transform`}
  >
    <i class={`fa-solid ${icon} text-on-solid text-xl`}></i>
  </div>
  <h4 class="font-bold text-lg text-fg mb-2 group-hover:text-fg">{title}</h4>
  <p class="text-fg-muted text-sm leading-relaxed">{description}</p>
  {
    link && (
      <div
        class={`mt-4 inline-flex items-center gap-1 ${textClasses[color]} text-sm font-semibold`}
      >
        Learn more{" "}
        <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform" />
      </div>
    )
  }
</WrapperTag>
