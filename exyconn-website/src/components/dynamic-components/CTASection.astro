---
interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  primaryCta?: {
    text: string;
    href: string;
    icon?: string;
  };
  secondaryCta?: {
    text: string;
    href: string;
    icon?: string;
  };
  variant?: "dark" | "light" | "gradient";
}

const { title, subtitle, description, primaryCta, secondaryCta, variant = "dark" } = Astro.props;

const bgClasses = {
  dark: "bg-gradient-to-br from-inverse to-inverse-muted",
  light: "bg-gradient-to-br from-surface-subtle to-blue-subtle",
  gradient: "bg-gradient-to-br from-blue-strong via-cyan to-teal",
};

const textClasses = {
  dark: "text-on-solid",
  light: "text-fg",
  gradient: "text-on-solid",
};

const subtextClasses = {
  dark: "text-fg-faint",
  light: "text-fg-muted",
  gradient: "text-on-solid/80",
};

const primaryBtnClasses = {
  dark: "bg-surface text-fg hover:bg-surface-muted",
  light: "bg-inverse text-on-solid hover:bg-inverse-muted",
  gradient: "bg-surface text-fg hover:bg-surface-muted",
};

const secondaryBtnClasses = {
  dark: "bg-on-solid/10 border border-on-solid/20 text-on-solid hover:bg-on-solid/20",
  light: "bg-surface border border-line text-fg hover:bg-surface-subtle",
  gradient: "bg-on-solid/20 border border-on-solid/30 text-on-solid hover:bg-on-solid/30",
};
---

<section class={`py-24 px-6 ${bgClasses[variant]} relative overflow-hidden`}>
  {
    variant !== "light" && (
      <>
        <div class="absolute top-20 left-20 w-80 h-80 bg-gradient-to-r from-blue/20 to-cyan/20 rounded-full blur-3xl" />
        <div class="absolute bottom-20 right-20 w-96 h-96 bg-gradient-to-r from-purple/20 to-pink/20 rounded-full blur-3xl" />
      </>
    )
  }

  <div class="max-w-4xl mx-auto text-center relative z-10">
    {
      subtitle && (
        <span class={`inline-block ${subtextClasses[variant]} text-sm font-medium mb-4`}>
          {subtitle}
        </span>
      )
    }
    <h2 class={`text-4xl md:text-5xl font-bold ${textClasses[variant]} mb-6`}>{title}</h2>
    {
      description && (
        <p class={`text-xl ${subtextClasses[variant]} mb-10 max-w-2xl mx-auto`}>{description}</p>
      )
    }
    <div class="flex flex-wrap justify-center gap-4">
      {
        primaryCta && (
          <a
            href={primaryCta.href}
            class={`inline-flex items-center gap-2 ${primaryBtnClasses[variant]} font-semibold px-8 py-4 rounded-full transition shadow-xl`}
          >
            {primaryCta.icon && <i class={`fa-solid ${primaryCta.icon}`} />}
            {primaryCta.text}
          </a>
        )
      }
      {
        secondaryCta && (
          <a
            href={secondaryCta.href}
            class={`inline-flex items-center gap-2 ${secondaryBtnClasses[variant]} font-semibold px-8 py-4 rounded-full transition`}
          >
            {secondaryCta.icon && <i class={`fa-solid ${secondaryCta.icon}`} />}
            {secondaryCta.text}
          </a>
        )
      }
    </div>
  </div>
</section>
