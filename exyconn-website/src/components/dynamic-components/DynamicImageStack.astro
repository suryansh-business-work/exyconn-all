---
import { defaultTechLogos, type LogoItem } from "../../lib/tech-logos";

interface Props {
  title?: string;
  subtitle?: string;
  logos?: LogoItem[];
  bgClass?: string;
  lightBg?: boolean;
}

const {
  title = "Powered By Leading Technology",
  subtitle = "Built with industry-leading AI and cloud platforms",
  logos,
  bgClass = " bg-surface-subtle",
  lightBg = false,
} = Astro.props;

const techLogos = logos || defaultTechLogos;
---

<section class={`py-16 lg:py-24 ${bgClass}`}>
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2
        class={`text-2xl md:text-3xl lg:text-4xl font-bold mb-3 ${lightBg ? "text-fg" : "text-fg"}`}
      >
        {title}
      </h2>
      <p class={`text-lg ${lightBg ? "text-fg-muted" : "text-fg-muted"}`}>{subtitle}</p>
    </div>

    <!-- Logo Grid -->
    <div class="flex flex-wrap justify-center gap-6">
      {
        techLogos.map((logo) => (
          <div class="tech-logo-item flex items-center justify-center rounded-2xl border border-line-subtle px-5 transition-colors duration-300 hover:border-line w-[calc(50%-0.75rem)] sm:w-44 h-24">
            <img
              src={logo.src}
              alt={logo.name}
              class="tech-logo object-contain h-8 md:h-9 w-auto max-w-full"
              loading="lazy"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
