---
interface Props {
  image?: string;
  title: string;
  subtitle?: string;
  description?: string;
  link?: string;
  linkText?: string;
  features?: string[];
  badge?: string;
  badgeColor?: "amber" | "emerald" | "blue" | "purple" | "red";
  color?: "indigo" | "emerald" | "cyan" | "purple" | "orange";
}

const {
  image,
  title,
  subtitle,
  description,
  link,
  linkText = "Learn More",
  features = [],
  badge,
  badgeColor = "emerald",
  color = "indigo",
} = Astro.props;

const badgeClasses = {
  amber: "bg-amber-soft text-amber-fg-strong",
  emerald: "bg-emerald-soft text-emerald-fg-strong",
  blue: "bg-blue-soft text-blue-fg-strong",
  purple: "bg-purple-soft text-purple-fg-strong",
  red: "bg-red-soft text-red-fg-strong",
};

const btnClasses = {
  indigo: "bg-indigo-strong hover:bg-indigo-deep",
  emerald: "bg-emerald-strong hover:bg-emerald-deep",
  cyan: "bg-cyan-strong hover:bg-cyan-deep",
  purple: "bg-purple-strong hover:bg-purple-deep",
  orange: "bg-orange-strong hover:bg-orange-deep",
};

const checkClasses = {
  indigo: "text-indigo-fg",
  emerald: "text-emerald-fg",
  cyan: "text-cyan-fg",
  purple: "text-purple-fg",
  orange: "text-orange-fg",
};
---

<div
  class="group relative bg-surface rounded-3xl border border-line-subtle p-8 hover:shadow-2xl hover:shadow-surface-strong/50 transition-all duration-300"
>
  {
    badge && (
      <div class="absolute top-6 right-6">
        <span
          class={`inline-flex items-center gap-1 px-3 py-1 ${badgeClasses[badgeColor]} text-xs font-bold rounded-full`}
        >
          {badge}
        </span>
      </div>
    )
  }

  {
    image && (
      <div class="mb-6">
        <img src={image} alt={title} class="h-10 object-contain" />
      </div>
    )
  }

  <h3 class="text-2xl font-bold text-fg mb-2">{title}</h3>

  {subtitle && <p class={`${checkClasses[color]} font-medium mb-4`}>{subtitle}</p>}

  {description && <p class="text-fg-muted mb-6 leading-relaxed">{description}</p>}

  {
    features.length > 0 && (
      <ul class="space-y-2 mb-8 text-sm">
        {features.map((feature) => (
          <li class="flex items-center gap-2 text-fg-muted">
            <i class={`fa-solid fa-check ${checkClasses[color]}`} />
            {feature}
          </li>
        ))}
      </ul>
    )
  }

  {
    link && (
      <div class="flex flex-wrap gap-3">
        <a
          href={link}
          target={link.startsWith("http") ? "_blank" : "_self"}
          class={`inline-flex items-center gap-2 ${btnClasses[color]} text-on-solid font-semibold px-6 py-3 rounded-full transition`}
        >
          <i class="fa-solid fa-rocket" /> {linkText}
        </a>
      </div>
    )
  }
</div>
