---
interface Props {
  badge?: string;
  badgeIcon?: string;
  badgeColor?: "blue" | "emerald" | "purple" | "orange" | "red" | "gray";
  title: string;
  titleHighlight?: string;
  description?: string;
  centered?: boolean;
}

const {
  badge,
  badgeIcon = "fa-sparkles",
  badgeColor = "blue",
  title,
  titleHighlight,
  description,
  centered = true,
} = Astro.props;

const colorClasses = {
  blue: "bg-blue-subtle border-blue-soft text-blue-fg",
  emerald: "bg-emerald-subtle border-emerald-soft text-emerald-fg",
  purple: "bg-purple-subtle border-purple-soft text-purple-fg",
  orange: "bg-orange-subtle border-orange-soft text-orange-fg",
  red: "bg-red-subtle border-red-soft text-red-fg",
  gray: "bg-surface-muted border-line text-fg-muted",
};

const gradientClasses = {
  blue: "from-blue-strong to-cyan",
  emerald: "from-emerald-strong to-teal",
  purple: "from-purple-strong to-pink",
  orange: "from-orange-strong to-amber",
  red: "from-red-strong to-rose",
  gray: "from-fg-subtle to-fg-subtle",
};
---

<div class={`mb-12 ${centered ? "text-center" : ""}`}>
  {
    badge && (
      <span
        class={`inline-flex items-center gap-2 px-4 py-2 ${colorClasses[badgeColor]} border rounded-full text-sm font-semibold mb-4`}
      >
        <i class={`fa-solid ${badgeIcon}`} />
        {badge}
      </span>
    )
  }
  <h2 class="text-4xl md:text-5xl font-bold text-fg mb-4 tracking-tight">
    {title}
    {
      titleHighlight && (
        <span
          class={`bg-gradient-to-r ${gradientClasses[badgeColor]} bg-clip-text text-transparent`}
        >
          {" "}
          {titleHighlight}
        </span>
      )
    }
  </h2>
  {
    description && (
      <p class={`text-xl text-fg-muted leading-relaxed ${centered ? "max-w-3xl mx-auto" : ""}`}>
        {description}
      </p>
    )
  }
</div>
