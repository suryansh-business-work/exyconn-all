---
interface Props {
  badge?: string;
  badgeIcon?: string;
  badgeColor?: "blue" | "emerald" | "purple" | "orange" | "red" | "gray";
  title: string;
  titleHighlight?: string;
  description?: string;
  centered?: boolean;
}

const {
  badge,
  badgeIcon = "fa-sparkles",
  badgeColor = "blue",
  title,
  titleHighlight,
  description,
  centered = true,
} = Astro.props;

const colorClasses = {
  blue: "bg-blue-50 border-blue-100 text-blue-600",
  emerald: "bg-emerald-50 border-emerald-100 text-emerald-600",
  purple: "bg-purple-50 border-purple-100 text-purple-600",
  orange: "bg-orange-50 border-orange-100 text-orange-600",
  red: "bg-red-50 border-red-100 text-red-600",
  gray: "bg-gray-100 border-gray-200 text-gray-600",
};

const gradientClasses = {
  blue: "from-blue-600 to-cyan-500",
  emerald: "from-emerald-600 to-teal-500",
  purple: "from-purple-600 to-pink-500",
  orange: "from-orange-600 to-amber-500",
  red: "from-red-600 to-rose-500",
  gray: "from-gray-600 to-slate-500",
};
---

<div class={`mb-12 ${centered ? "text-center" : ""}`}>
  {
    badge && (
      <span
        class={`inline-flex items-center gap-2 px-4 py-2 ${colorClasses[badgeColor]} border rounded-full text-sm font-semibold mb-4`}
      >
        <i class={`fa-solid ${badgeIcon}`} />
        {badge}
      </span>
    )
  }
  <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 tracking-tight">
    {title}
    {
      titleHighlight && (
        <span
          class={`bg-gradient-to-r ${gradientClasses[badgeColor]} bg-clip-text text-transparent`}
        >
          {" "}
          {titleHighlight}
        </span>
      )
    }
  </h2>
  {
    description && (
      <p class={`text-xl text-gray-600 leading-relaxed ${centered ? "max-w-3xl mx-auto" : ""}`}>
        {description}
      </p>
    )
  }
</div>
