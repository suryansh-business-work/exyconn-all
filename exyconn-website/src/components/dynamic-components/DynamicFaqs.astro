---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  faqs: FAQItem[];
}

const {
  title = "Frequently Asked Questions",
  subtitle = "Everything you need to know about our services",
  faqs,
} = Astro.props;
---

<section class="py-20 lg:py-28 bg-gradient-to-b from-surface via-surface-subtle/50 to-surface">
  <div class="max-w-4xl mx-auto px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-14">
      <span
        class="inline-flex items-center gap-2 bg-blue-soft text-blue-fg-strong text-sm font-semibold px-4 py-2 rounded-full mb-6"
      >
        <i class="fa-solid fa-circle-question"></i>
        FAQ
      </span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-fg mb-4">
        {title}
      </h2>
      <p class="text-lg text-fg-muted">{subtitle}</p>
    </div>

    <!-- FAQ Accordion -->
    <div class="space-y-4">
      {
        faqs.map((faq, index) => (
          <details
            class="group bg-surface rounded-2xl border border-line-subtle shadow-sm hover:shadow-md transition-all duration-300"
            open={index === 0}
          >
            <summary class="flex items-center justify-between gap-4 p-6 cursor-pointer list-none">
              <div class="flex items-center gap-4">
                <span class="flex items-center justify-center w-10 h-10 bg-gradient-to-br from-blue to-purple-strong text-on-solid text-sm font-bold rounded-xl shrink-0">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3 class="text-lg font-semibold text-fg group-open:text-blue-fg transition-colors">
                  {faq.question}
                </h3>
              </div>
              <div class="shrink-0 w-8 h-8 bg-surface-muted group-open:bg-blue-soft rounded-full flex items-center justify-center transition-colors">
                <i class="fa-solid fa-chevron-down text-fg-subtle group-open:text-blue-fg group-open:rotate-180 transition-all duration-300 text-sm" />
              </div>
            </summary>
            <div class="px-6 pb-6 pt-2 ml-14">
              <p class="text-fg-muted leading-relaxed">{faq.answer}</p>
            </div>
          </details>
        ))
      }
    </div>

    <!-- Bottom CTA -->
    <div
      class="mt-14 text-center p-8 bg-gradient-to-br from-blue-subtle to-purple-subtle rounded-3xl border border-blue-soft"
    >
      <div
        class="inline-flex items-center justify-center w-14 h-14 bg-gradient-to-br from-blue to-purple-strong rounded-2xl mb-4"
      >
        <i class="fa-solid fa-headset text-on-solid text-xl"></i>
      </div>
      <h3 class="text-xl font-bold text-fg mb-2">Still have questions?</h3>
      <p class="text-fg-muted mb-6">
        Can't find the answer you're looking for? Our team is here to help.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 bg-inverse text-on-solid font-semibold px-6 py-3 rounded-full hover:bg-inverse-muted transition-all"
      >
        <i class="fa-solid fa-message"></i>
        Contact Support
      </a>
    </div>
  </div>
</section>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
