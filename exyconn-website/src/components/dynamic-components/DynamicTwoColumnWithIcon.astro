---
const {
  title = "Lorem Ipsum Dolor Sit Amet",
  description = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Pellentesque euismod, urna eu tincidunt consectetur, nisi nisl aliquam enim, vitae facilisis sapien enim nec erat. Mauris non erat nec eros dictum cursus. Etiam ac ex nec velit cursus dictum. Suspendisse potenti. Nullam euismod, nisi vel consectetur cursus, nisl nunc consectetur nisi, euismod aliquam nisl nunc euismod.",
  iconClass = "fa-solid fa-brain text-6xl text-indigo-fg",
} = Astro.props;

/* Only the style and glyph classes are kept: size and colour belong to this tile. */
const iconName = iconClass.split(" ").slice(0, 2).join(" ");
---

<section class="py-20 lg:py-28 bg-surface">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div class="space-y-6">
        <h2 class="text-3xl md:text-4xl font-bold text-fg">
          {title}
        </h2>
        <div class="text-lg text-fg-muted leading-relaxed prose prose-lg">
          <span set:html={description} />
        </div>
      </div>

      <!-- Icon Box -->
      <div class="flex justify-center" aria-hidden="true">
        <div class="relative w-56 h-56 sm:w-72 sm:h-72 flex items-center justify-center">
          <div class="absolute inset-0 rounded-full border border-dashed border-line"></div>
          <div
            class="absolute inset-10 rounded-full border border-line-subtle bg-surface-subtle/60"
          >
          </div>
          <div
            class="relative w-32 h-32 bg-blue-deep rounded-[2rem] flex items-center justify-center shadow-2xl shadow-blue/40 ring-8 ring-surface"
          >
            <i class={`${iconName} text-5xl text-on-solid`}></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
