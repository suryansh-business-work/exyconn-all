---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
  variant?: "inline" | "bordered" | "cards";
  centered?: boolean;
}

const { stats, variant = "bordered", centered = true } = Astro.props;
---

{
  variant === "inline" && (
    <div class={`flex flex-wrap ${centered ? "justify-center" : ""} gap-8`}>
      {stats.map((stat, i) => (
        <div class={`flex flex-col items-center ${i > 0 ? "border-l border-gray-200 pl-8" : ""}`}>
          <span class="text-4xl font-bold text-gray-900">{stat.value}</span>
          <span class="text-sm text-gray-500">{stat.label}</span>
        </div>
      ))}
    </div>
  )
}

{
  variant === "bordered" && (
    <div
      class={`flex flex-wrap ${centered ? "justify-center" : ""} gap-8 py-8 border-y border-gray-100`}
    >
      {stats.map((stat, i) => (
        <div class={`text-center ${i > 0 ? "border-l border-gray-200 pl-8" : ""}`}>
          <div class="text-4xl font-bold text-gray-900 mb-1">{stat.value}</div>
          <div class="text-sm text-gray-500">{stat.label}</div>
        </div>
      ))}
    </div>
  )
}

{
  variant === "cards" && (
    <div class={`grid grid-cols-2 md:grid-cols-${stats.length} gap-6`}>
      {stats.map((stat) => (
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 text-center">
          <div class="text-4xl font-bold text-gray-900 mb-1">{stat.value}</div>
          <div class="text-sm text-gray-500">{stat.label}</div>
        </div>
      ))}
    </div>
  )
}
