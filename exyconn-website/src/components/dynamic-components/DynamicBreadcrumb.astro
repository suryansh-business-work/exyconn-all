---
const pathname = Astro.url.pathname;

// Split and filter out empty segments
const segments = pathname.split("/").filter(Boolean);

// Build breadcrumb items with their URLs
const breadcrumbs = [
  { name: "Home", href: "/" },
  ...segments.map((seg: string, idx: number) => ({
    name: seg.replace(/-/g, " ").replace(/\b\w/g, (c: string) => c.toUpperCase()),
    href: "/" + segments.slice(0, idx + 1).join("/"),
  })),
];
---

<nav
  aria-label="Breadcrumb"
  class="w-full py-3 sm:py-4 px-4 sm:px-6 bg-gray-50 border-b border-gray-100 overflow-x-auto"
>
  <ol class="flex items-center gap-1.5 sm:gap-2 text-xs sm:text-sm mx-auto max-w-7xl flex-wrap">
    {
      breadcrumbs.map((crumb, idx) => (
        <li
          class="flex items-center gap-1.5 sm:gap-2"
          aria-current={idx === breadcrumbs.length - 1 ? "page" : undefined}
        >
          {idx !== 0 && (
            <i class="fa-solid fa-chevron-right text-gray-300 text-[10px] sm:text-xs" />
          )}

          {idx < breadcrumbs.length - 1 ? (
            <a href={crumb.href} class="text-gray-500 hover:text-blue-600 transition-colors">
              {idx === 0 && <i class="fa-solid fa-home mr-1 text-[10px] sm:text-xs" />}
              <span class="break-words">{crumb.name}</span>
            </a>
          ) : (
            <span class="font-semibold text-gray-900 break-words">{crumb.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  /* Hide scrollbar for cleaner look on mobile */
  nav {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  nav::-webkit-scrollbar {
    display: none;
  }
</style>
