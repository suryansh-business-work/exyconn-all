---
/**
 * The phone menu: a night drawer from the right (scripts/chrome/drawer.ts) with the highlighted
 * "GCC in India" link, the header groups as disclosures, the shortcuts and the social links, then
 * one slim pinned row — the call to action beside search, accessibility and cookie preferences —
 * so the scrolling list keeps most of the screen's height.
 */
import BrandLogo from "../BrandLogo.astro";
import Icon from "../inner/Icon.astro";
import { BRANDING_FALLBACK, type Branding } from "../../lib/portal";
import {
  GCC_LINK,
  HEADER_ACTIONS,
  HEADER_MENUS,
  MOBILE_SHORTCUTS,
} from "../../lib/chrome/navigation";
import SocialIcon from "../SocialIcon.astro";
import { socialLinks } from "../../lib/social-links";

interface Props {
  branding: Branding;
}

const { branding } = Astro.props;
const businessName = branding.businessName || BRANDING_FALLBACK.businessName;
const social = socialLinks(branding);
const newTab = { target: "_blank", rel: "noopener noreferrer" };
---

<div class="chrome-backdrop" data-drawer-backdrop="mobileMenu" data-open="false"></div>
<div
  id="mobileMenu"
  class="chrome-drawer chrome-mobile-menu"
  data-theme="dark"
  role="dialog"
  aria-modal="true"
  aria-label="Main menu"
  data-open="false"
  tabindex="-1"
>
  <div class="chrome-drawer__head">
    <a href="/" aria-label={`${businessName} home`} class="inline-flex min-h-11 items-center">
      <BrandLogo branding={branding} alt="" width="96" height="32" class="h-8 w-auto" />
    </a>
    <button
      type="button"
      class="chrome-icon-button"
      data-drawer-close="mobileMenu"
      aria-label="Close menu"
    >
      <Icon name="close" />
    </button>
  </div>

  <nav class="chrome-drawer__body" aria-label="Main">
    <div class="chrome-mobile-section">
      <a href={GCC_LINK.href} class="gcc-mobile-pill">
        <span>{GCC_LINK.label}</span>
        <span class="gcc-mobile-pill__text">{GCC_LINK.text}</span>
      </a>
    </div>
    {
      HEADER_MENUS.map((group) => (
        <details class="chrome-mobile-group chrome-mobile-section">
          <summary>
            {group.label}
            <Icon name="chevron-down" class="icon-sm text-fg-subtle" />
          </summary>
          <ul class="pb-2">
            {[...group.links, ...(group.overview ? [group.overview] : [])].map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    "chrome-mobile-link",
                    { "chrome-mobile-link--highlight": link.highlight },
                  ]}
                  {...(link.external ? newTab : {})}
                >
                  {link.label}
                  {link.external && <span class="sr-only">(opens in a new tab)</span>}
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
    <ul class="chrome-mobile-section">
      {
        MOBILE_SHORTCUTS.map((link) => (
          <li>
            <a
              href={link.href}
              class="chrome-mobile-link chrome-mobile-link--strong"
              {...(link.external ? newTab : {})}
            >
              {link.label}
              {link.external && <span class="sr-only">(opens in a new tab)</span>}
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="chrome-mobile-social" aria-label="Social media links">
      {
        social.map((link) => (
          <li>
            <a href={link.url} {...newTab} aria-label={link.label} class="chrome-social">
              <SocialIcon glyph={link.glyph} />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="chrome-drawer__foot chrome-mobile-foot">
    <a href={HEADER_ACTIONS.primary.href} class="chrome-button chrome-button--solid">
      {HEADER_ACTIONS.primary.label}
      <Icon name="arrow-right" class="icon-xs" />
    </a>
    <button
      type="button"
      data-search-open
      class="chrome-icon-button chrome-mobile-foot__icon"
      aria-label="Search the website"
      title="Search"
    >
      <Icon name="search" />
    </button>
    <button
      type="button"
      class="chrome-icon-button chrome-mobile-foot__icon"
      data-drawer-open="a11y-drawer"
      aria-label="Accessibility options"
      title="Accessibility"
    >
      <Icon name="accessibility" />
    </button>
    <button
      type="button"
      class="chrome-icon-button chrome-mobile-foot__icon"
      data-drawer-open="cookie-drawer"
      aria-label="Cookie preferences"
      title="Cookies"
    >
      <Icon name="cookie" />
    </button>
  </div>
</div>

<script>
  import "../../scripts/chrome/mobile-menu";
</script>

<style>
  /* The highlighted GCC link at the top of the phone menu (the drawer is always night). */
  .gcc-mobile-pill {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-height: 2.75rem;
    padding: var(--space-3) var(--space-4);
    border: var(--border-width-hairline) solid var(--color-sky-muted);
    border-radius: var(--radius-xl);
    background: var(--color-sky-subtle);
    color: var(--color-sky-fg);
    font-weight: var(--font-weight-semibold);
  }

  .gcc-mobile-pill:hover {
    background: var(--color-sky-soft);
  }

  .gcc-mobile-pill:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .gcc-mobile-pill__text {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-fg-secondary);
  }
</style>
