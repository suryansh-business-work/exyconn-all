                class="block px-3 py-2.5 rounded-lg hover:bg-blue-subtle transition-colors"
              >
                <div class="font-medium text-fg flex items-center gap-2 text-sm">
                  <i class="fa-solid fa-robot text-indigo-fg w-4"></i> Agentic AI
                </div>
                <p class="text-xs text-fg-subtle mt-0.5 ml-6">Autonomous business agents</p>
              </a>
              <a
