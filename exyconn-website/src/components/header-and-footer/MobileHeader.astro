                class="flex items-center gap-2 px-3 py-2.5 rounded-lg hover:bg-purple-subtle transition-colors"
              >
                <i class="fa-solid fa-bullhorn text-pink-fg w-4 text-sm"></i>
                <span class="text-sm text-fg-secondary">Digital Marketing</span>
              </a>
              <a
