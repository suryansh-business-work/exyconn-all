---
/**
 * The phone menu: a night drawer from the right (scripts/chrome/drawer.ts) with the three
 * header groups as disclosures, the shortcuts, then the call to action and the settings —
 * search, accessibility and cookie preferences live here instead of floating over the page.
 */
import BrandLogo from "../BrandLogo.astro";
import Icon from "../inner/Icon.astro";
import { BRANDING_FALLBACK, type Branding } from "../../lib/portal";
import { HEADER_ACTIONS, HEADER_MENUS, MOBILE_SHORTCUTS } from "../../lib/chrome/navigation";
import SocialIcon from "../SocialIcon.astro";
import { socialLinks } from "../../lib/social-links";

interface Props {
  branding: Branding;
}

const { branding } = Astro.props;
const businessName = branding.businessName || BRANDING_FALLBACK.businessName;
const social = socialLinks(branding);
const newTab = { target: "_blank", rel: "noopener noreferrer" };
---

<div class="chrome-backdrop" data-drawer-backdrop="mobileMenu" data-open="false"></div>
<div
  id="mobileMenu"
  class="chrome-drawer chrome-mobile-menu"
  data-theme="dark"
  role="dialog"
  aria-modal="true"
  aria-label="Main menu"
  data-open="false"
  tabindex="-1"
>
  <div class="chrome-drawer__head">
    <a href="/" aria-label={`${businessName} home`} class="inline-flex min-h-11 items-center">
      <BrandLogo branding={branding} alt="" width="96" height="32" class="h-8 w-auto" />
    </a>
    <button
      type="button"
      class="chrome-icon-button"
      data-drawer-close="mobileMenu"
      aria-label="Close menu"
    >
      <Icon name="close" />
    </button>
  </div>

  <nav class="chrome-drawer__body" aria-label="Main">
    {
      HEADER_MENUS.map((group) => (
        <details class="chrome-mobile-group chrome-mobile-section">
          <summary>
            {group.label}
            <Icon name="chevron-down" class="icon-sm text-fg-subtle" />
          </summary>
          <ul class="pb-2">
            {[...group.links, ...(group.overview ? [group.overview] : [])].map((link) => (
              <li>
                <a href={link.href} class="chrome-mobile-link" {...(link.external ? newTab : {})}>
                  {link.label}
                  {link.external && <span class="sr-only">(opens in a new tab)</span>}
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
    <ul class="chrome-mobile-section">
      {
        MOBILE_SHORTCUTS.map((link) => (
          <li>
            <a
              href={link.href}
              class="chrome-mobile-link chrome-mobile-link--strong"
              {...(link.external ? newTab : {})}
            >
              {link.label}
              {link.external && <span class="sr-only">(opens in a new tab)</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="chrome-drawer__foot chrome-drawer__foot--stack">
    <a href={HEADER_ACTIONS.primary.href} class="chrome-button chrome-button--solid">
      {HEADER_ACTIONS.primary.label}
      <Icon name="arrow-right" class="icon-xs" />
    </a>
    <div class="grid grid-cols-3 gap-2">
      <button type="button" data-search-open class="chrome-button chrome-button--tile">
        <Icon name="search" class="icon-md" />Search
      </button>
      <button
        type="button"
        class="chrome-button chrome-button--tile"
        data-drawer-open="a11y-drawer"
      >
        <Icon name="accessibility" class="icon-md" />Accessibility
      </button>
      <button
        type="button"
        class="chrome-button chrome-button--tile"
        data-drawer-open="cookie-drawer"
      >
        <Icon name="cookie" class="icon-md" />Cookies
      </button>
    </div>
    <ul class="flex items-center justify-center gap-2" aria-label="Social media links">
      {
        social.map((link) => (
          <li>
            <a href={link.url} {...newTab} aria-label={link.label} class="chrome-social">
              <SocialIcon glyph={link.glyph} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  import "../../scripts/chrome/mobile-menu";
</script>
