---
import BrandLogo from "../BrandLogo.astro";
import { BRANDING_FALLBACK, type Branding } from "../../lib/portal";
import { TOOLS_SITE_URL } from "../../lib/site";

interface Props {
  branding: Branding;
}

const { branding } = Astro.props;

const businessName = branding.businessName || BRANDING_FALLBACK.businessName;
---

<!-- Modern Mobile Drawer Menu -->
<div
  id="mobileMenu"
  class="lg:hidden fixed inset-0 z-[9999] hidden"
  role="dialog"
  aria-modal="true"
>
  <!-- Backdrop with blur -->
  <div
    id="closeMobileMenuBg"
    class="fixed inset-0 bg-scrim/50 backdrop-blur-sm transition-opacity duration-300"
    style="height: 100dvh;"
  >
  </div>

  <!-- Drawer Panel -->
  <div
    id="mobileDrawer"
    class="fixed right-0 w-[85%] max-w-[380px] bg-surface shadow-2xl overflow-hidden flex flex-col transform translate-x-full transition-transform duration-300 ease-out"
    style="top: 0; height: 100dvh; bottom: 0;"
  >
    <!-- Header -->
    <div
      class="flex items-center justify-between p-4 border-b border-line-subtle bg-gradient-to-r from-surface-subtle to-surface"
    >
      <a href="/" class="flex items-center gap-2">
        <BrandLogo branding={branding} class="h-8 w-auto" alt={businessName} />
      </a>
      <button
        type="button"
        class="cursor-pointer w-10 h-10 rounded-full bg-surface-muted hover:bg-surface-strong flex items-center justify-center text-fg-muted hover:text-fg transition-all"
        id="closeMobileMenuBtn"
        aria-label="Close menu"
      >
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <!-- Scrollable Content -->
    <div class="flex-1 overflow-y-auto overscroll-contain">
      <!-- Navigation Links -->
      <nav class="p-4 space-y-1">
        <!-- Home -->
        <a
          href="/"
          class="flex items-center gap-3 px-4 py-3 rounded-xl text-fg-secondary hover:bg-surface-subtle transition-colors group"
        >
          <div
            class="w-9 h-9 rounded-lg bg-surface-muted group-hover:bg-blue-soft flex items-center justify-center transition-colors"
          >
            <i class="fa-solid fa-home text-fg-subtle group-hover:text-blue-fg"></i>
          </div>
          <span class="font-medium">Home</span>
        </a>

        <!-- AI Services - Featured -->
        <a
          href="/ai-services"
          class="flex items-center gap-3 px-4 py-3 rounded-xl bg-gradient-to-r from-inverse to-inverse-muted text-on-solid group relative overflow-hidden"
        >
          <div class="w-9 h-9 rounded-lg bg-on-solid/10 flex items-center justify-center">
            <i class="fa-solid fa-bolt text-yellow-bright"></i>
          </div>
          <div>
            <span class="font-semibold">AI Services</span>
            <p class="text-xs text-on-solid-muted">Agents, automation & platforms</p>
          </div>
          <i
            class="fa-solid fa-arrow-right ml-auto opacity-60 group-hover:translate-x-1 transition-transform"
          ></i>
        </a>

        <!-- Exyconn Services -->
        <a
          href="/exyconn-services"
          class="flex items-center gap-3 px-4 py-3 rounded-xl text-fg-secondary hover:bg-surface-subtle transition-colors group"
        >
          <div class="w-9 h-9 rounded-lg bg-cyan-subtle flex items-center justify-center">
            <i class="fa-solid fa-terminal text-cyan-fg"></i>
          </div>
          <span class="font-medium">Exyconn Services</span>
        </a>

        <!-- AI Dropdown -->
        <div class="mobile-accordion">
          <button
            type="button"
            class="mobile-accordion-trigger w-full flex items-center gap-3 px-4 py-3 rounded-xl text-on-solid bg-gradient-to-r from-indigo-strong via-blue to-cyan shadow-lg hover:shadow-xl transition-all"
          >
            <div class="w-9 h-9 rounded-lg bg-on-solid/20 flex items-center justify-center">
              <i class="fa-solid fa-microchip"></i>
            </div>
            <span class="font-semibold">AI Solutions</span>
            <i
              class="fa-solid fa-chevron-down ml-auto transition-transform duration-200 accordion-icon"
            ></i>
          </button>
