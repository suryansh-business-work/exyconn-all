---
/**
 * The night footer: the newsletter row, the brand and four link columns (lib/chrome), then the
 * market picker, copyright and legal links. It also hosts the two settings drawers, opened
 * from the header, the phone menu and the "Cookie preferences" button here — none of them
 * floats over the page.
 */
import Newsletter from "../fragments/Newsletter.astro";
import CokkiesModel from "../CokkiesModel.astro";
import AccessibilityDrawer from "../AccessibilityDrawer.astro";
import BrandLogo from "../BrandLogo.astro";
import MarketPicker from "../MarketPicker.astro";
import Icon from "../inner/Icon.astro";
import { BRANDING_FALLBACK, type Branding } from "../../lib/portal";
import SocialIcon from "../SocialIcon.astro";
import { socialLinks } from "../../lib/social-links";
import { FOOTER_COLUMNS, FOOTER_TAGLINE, LEGAL_LINKS } from "../../lib/chrome/navigation";

interface Props {
  branding: Branding;
}

const { branding } = Astro.props;

// The build, for whoever debugs a deployment: in the markup, never on screen.
const version = import.meta.env.PUBLIC_APP_VERSION || "dev";

const businessName = branding.businessName || BRANDING_FALLBACK.businessName;
const legalName = branding.legalName || BRANDING_FALLBACK.legalName;
const copyrightText =
  branding.copyrightText || `© ${new Date().getFullYear()} ${legalName}. All rights reserved.`;
// GitHub stays in the mobile menu but not here: the footer is for the profiles that speak for
// the business — where people follow it, review it and look it up.
const social = socialLinks(branding).filter((link) => link.id !== "github");
const newTab = { target: "_blank", rel: "noopener noreferrer" };
---

<footer class="site-footer" data-theme="dark" data-version={version} aria-label="Site footer">
  <div class="chrome-neon" aria-hidden="true"></div>
  <Newsletter />

  <div class="chrome-shell site-footer__columns border-t border-line pt-12 pb-12">
    <div class="site-footer__brand">
      <a href="/" class="inline-flex min-h-11 items-center" aria-label={`${businessName} home`}>
        <BrandLogo branding={branding} alt="" width="120" height="40" class="h-10 w-auto" />
      </a>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-fg-secondary">{FOOTER_TAGLINE}</p>
      <ul
        class="mt-6 flex flex-wrap items-center gap-2"
        aria-label="Social media and company profiles"
      >
        {
          social.map((link) => (
            <li>
              <a href={link.url} {...newTab} aria-label={link.label} class="chrome-social">
                <SocialIcon glyph={link.glyph} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      FOOTER_COLUMNS.map((column) => (
        <nav aria-labelledby={`footer-${column.id}`}>
          <h2 id={`footer-${column.id}`} class="stage-label mb-3">
            {column.label}
          </h2>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="site-footer__link" {...(link.external ? newTab : {})}>
                  {link.label}
                  {link.external && (
                    <>
                      <Icon name="arrow-up-right" class="icon-xs text-fg-subtle" />
                      <span class="sr-only">(opens in a new tab)</span>
                    </>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="site-footer__bottom">
    <div
      class="chrome-shell flex flex-col gap-4 text-sm lg:flex-row lg:items-center lg:justify-between"
    >
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-6">
        <MarketPicker />
        <p class="text-fg-muted">{copyrightText}</p>
      </div>
      <nav aria-label="Legal links" class="flex flex-wrap items-center gap-x-5">
        {
          LEGAL_LINKS.map((link) => (
            <a href={link.href} class="site-footer__link">
              {link.label}
            </a>
          ))
        }
        <button
          type="button"
          class="site-footer__link"
          data-drawer-open="cookie-drawer"
          aria-controls="cookie-drawer"
          aria-expanded="false"
        >
          <Icon name="cookie" class="icon-xs" />
          Cookie preferences
        </button>
      </nav>
    </div>
  </div>
</footer>

<!-- Fixed drawers sit outside the footer, so its stacking and theme never reach them. -->
<CokkiesModel />
<AccessibilityDrawer />
