      </nav>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-line-subtle">
    <!-- Bottom padding clears the launchers pinned to the bottom corners, so they never sit on these links. -->
    <div class="max-w-7xl mx-auto px-6 pt-6 pb-36">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <MarketPicker />
          <p class="text-sm text-fg-subtle">{copyrightText}</p>
          <span
            class="text-xs text-fg-faint bg-surface-muted px-2 py-0.5 rounded font-mono"
            title="Website Version">{versionLabel}</span
          >
        </div>
        <nav aria-label="Legal links" class="flex flex-wrap items-center gap-6 text-sm">
          <a
            href="/privacy-policy"
            class="inline-block py-1 text-fg-subtle hover:text-fg transition focus:underline"
            >Privacy Policy</a
          >
          <a
            href="/legal"
            class="inline-block py-1 text-fg-subtle hover:text-fg transition focus:underline"
            >Terms of Service</a
          >
          <a
            href="/cookies"
            class="inline-block py-1 text-fg-subtle hover:text-fg transition focus:underline"
            >Cookies</a
          >
          <a
            href="/sitemap"
            class="inline-block py-1 text-fg-subtle hover:text-fg transition focus:underline"
            >Sitemap</a
          >
        </nav>
      </div>
    </div>
  </div>

  <CokkiesModel />
  <AccessibilityDrawer />
</footer>

<script is:inline>
  // Cookie consent handling
  function showCookieDialog() {
    const consent = localStorage.getItem("cookieConsent");
    const dialog = document.getElementById("cookieConsent");
    if (!consent && dialog) {
      dialog.querySelector("div").style.display = "flex";
    }
  }
  function hideCookieDialog() {
    const dialog = document.getElementById("cookieConsent");
    if (dialog) dialog.querySelector("div").style.display = "none";
  }
  document.addEventListener("DOMContentLoaded", () => {
    showCookieDialog();
    document.getElementById("acceptCookies")?.addEventListener("click", () => {
      localStorage.setItem("cookieConsent", "accepted");
      hideCookieDialog();
    });
    document.getElementById("rejectCookies")?.addEventListener("click", () => {
      localStorage.setItem("cookieConsent", "rejected");
      hideCookieDialog();
    });
  });
</script>

<!-- Google Analytics -->
