---
import Newsletter from "./../fragments/Newsletter.astro";
import CokkiesModel from "../CokkiesModel.astro";
import AccessibilityDrawer from "../AccessibilityDrawer.astro";
import BrandLogo from "../BrandLogo.astro";
import MarketPicker from "../MarketPicker.astro";
import { BRANDING_FALLBACK, type Branding } from "../../lib/portal";
import { socialLinks, type SocialNetwork } from "../../lib/social-links";
import { TOOLS_SITE_URL } from "../../lib/site";

interface Props {
  branding: Branding;
}

const { branding } = Astro.props;

// Version is injected at build time via Vite define in astro.config.mjs
// Falls back to env variable or default
const versionLabel = import.meta.env.PUBLIC_APP_VERSION || "v0.0.1-dev";

// Branding fields are empty strings until an admin fills them in — fall back to the values
// the site used to hardcode so it looks unchanged until then.
const businessName = branding.businessName || BRANDING_FALLBACK.businessName;
const legalName = branding.legalName || BRANDING_FALLBACK.legalName;

// The portal can supply the whole notice; otherwise build it from the legal name + this year.
const copyrightText =
  branding.copyrightText || `© ${new Date().getFullYear()} ${legalName}. All rights reserved.`;

// Hover colour per network; the links themselves come from Admin > Branding.
const SOCIAL_HOVER: Record<SocialNetwork, string> = {
  linkedin: "hover:bg-blue-subtle hover:text-blue-fg",
  twitter: "hover:bg-blue-subtle hover:text-blue-fg",
  facebook: "hover:bg-blue-subtle hover:text-blue-fg",
  instagram: "hover:bg-pink-subtle hover:text-pink-fg",
  youtube: "hover:bg-red-subtle hover:text-red-fg",
  github: "hover:bg-surface-strong hover:text-fg",
};
const social = socialLinks(branding);
---

<Newsletter />

<!-- Footer Section - Modern Light Design -->
<footer
  class="w-full bg-surface-subtle border-t border-line-subtle"
  role="contentinfo"
  aria-label="Site footer"
>
  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-10">
      <!-- Brand Column -->
      <div class="lg:col-span-2">
        <a href="/" class="inline-block mb-6" aria-label={`${businessName} - Go to homepage`}>
          <BrandLogo
            branding={branding}
            alt={`${businessName} Logo`}
            class="h-10"
            width="120"
            height="40"
          />
        </a>
        <p class="text-fg-muted text-sm leading-relaxed mb-6 max-w-sm">
          Empowering businesses with AI-native intelligence and enterprise-ready SaaS solutions.
          From idea to MVP in weeks, not months.
        </p>
        <ul class="flex items-center gap-4" aria-label="Social media links">
          {
            social.map((link) => (
              <li>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={[
                    "w-10 h-10 bg-surface-muted rounded-full flex items-center justify-center text-fg-muted transition",
                    SOCIAL_HOVER[link.id],
                  ]}
                  aria-label={link.label}
                >
                  <i class:list={[link.icon, "icon-md"]} aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- AI Solutions Column -->
      <nav aria-label="AI Solutions navigation">
        <h2 class="font-semibold text-fg mb-4">AI Solutions</h2>
        <ul class="space-y-1 text-sm">
          <li>
            <a
              href="/ai"
              class="inline-block py-1 text-fg-muted hover:text-fg transition focus:underline"
              >AI Platform</a
            >
          </li>
          <li>
            <a
              href="/ai/agentic"
              class="inline-block py-1 text-fg-muted hover:text-fg transition focus:underline"
              >Agentic AI</a
            >
          </li>
          <li>
            <a
              href="/ai/bot-creation"
              class="inline-block py-1 text-fg-muted hover:text-fg transition focus:underline"
              >Bot Creation</a
            >
          </li>
          <li>
            <a
              href="/ai/workflows"
              class="inline-block py-1 text-fg-muted hover:text-fg transition focus:underline"
              >AI Workflows</a
            >
          </li>
          <li>
            <a
              href="/ai/llms"
              class="inline-block py-1 text-fg-muted hover:text-fg transition focus:underline"
              >LLMs</a
            >
          </li>
          <li>
            <a
              href="/ai/custom-model-training"
              class="inline-block py-1 text-fg-muted hover:text-fg transition focus:underline"
              >Custom Training</a
            >
          </li>
          <li>
            <a
              href="/ai/mcp-server"
              class="inline-block py-1 text-fg-muted hover:text-fg transition focus:underline"
              >MCP Server</a
            >
          </li>
        </ul>
      </nav>

      <!-- Services Column -->
      <nav aria-label="Services navigation">
        <h2 class="font-semibold text-fg mb-4">Services</h2>
        <ul class="space-y-1 text-sm">
          <li>
            <a
