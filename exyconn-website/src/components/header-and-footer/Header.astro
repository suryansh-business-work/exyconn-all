<script is:inline>
  function setupDesktopDropdown(menuBtnId, submenuId) {
    const menuBtn = document.getElementById(menuBtnId);
    const submenu = document.getElementById(submenuId);
    let open = false;

    if (menuBtn && submenu) {
      menuBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        open = !open;
        submenu.classList.toggle("hidden", !open);
        menuBtn.setAttribute("aria-expanded", open ? "true" : "false");
      });

      document.addEventListener("click", (e) => {
        if (open && !menuBtn.contains(e.target) && !submenu.contains(e.target)) {
          open = false;
          submenu.classList.add("hidden");
          menuBtn.setAttribute("aria-expanded", "false");
        }
      });

      menuBtn.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          open = false;
          submenu.classList.add("hidden");
          menuBtn.setAttribute("aria-expanded", "false");
        }
      });
    }
  }

  setupDesktopDropdown("moreMenuBtn", "moreSubmenu");
  setupDesktopDropdown("servicesMenuBtn", "servicesSubmenu");
  setupDesktopDropdown("aiMenuBtn", "aiSubmenu");
</script>

