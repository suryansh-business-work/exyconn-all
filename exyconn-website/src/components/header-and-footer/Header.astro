---
import MobileHeader from "./MobileHeader.astro";
import { BRANDING_FALLBACK, type Branding } from "../../lib/portal";
import { TOOLS_SITE_URL } from "../../lib/site";

interface Props {
  branding: Branding;
}

const { branding } = Astro.props;

// Branding fields are empty strings until an admin fills them in — fall back to the values
// the site used to hardcode so it looks unchanged until then.
const businessName = branding.businessName || BRANDING_FALLBACK.businessName;
const logoUrl = branding.logoUrl || BRANDING_FALLBACK.logoUrl;
---

<!-- Top Banner for Free Tools -->
<div
  class="bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-500 text-white py-2 px-4 text-center text-sm"
>
  <a
    href={TOOLS_SITE_URL}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 hover:opacity-90 transition-opacity"
