    class="mx-auto flex max-w-7xl items-center justify-between p-4"
    aria-label="Global"
    role="navigation"
  >
    <!-- Logo -->
    <div class="flex lg:flex-1 items-center gap-2 animate-fade-in">
      <a href="/" class="flex items-center gap-2" aria-label={`${businessName} Home`}>
        <span class="sr-only">{businessName}</span>
        <img class="h-9 w-auto transition duration-300" src={logoUrl} alt={businessName} />
