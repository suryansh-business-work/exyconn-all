---
/**
 * The site header: a slim promo strip, then the sticky night bar — logo, the AI, Services,
 * Industries, Demos and Company menus (Blog sits in Company) and the highlighted "GCC in India"
 * pill, search, accessibility, theme, and the two calls to action. Phones get the same bar
 * with icon buttons and the menu drawer.
 */
import MobileHeader from "./MobileHeader.astro";
import NavMenu from "./NavMenu.astro";
import BrandLogo from "../BrandLogo.astro";
import ThemeToggle from "../ThemeToggle.astro";
import Icon from "../inner/Icon.astro";
import { BRANDING_FALLBACK, type Branding } from "../../lib/portal";
import { GCC_LINK, HEADER_ACTIONS, HEADER_MENUS, PROMO_LINK } from "../../lib/chrome/navigation";

interface Props {
  branding: Branding;
}

const { branding } = Astro.props;
const businessName = branding.businessName || BRANDING_FALLBACK.businessName;
---

<div class="chrome-promo" data-theme="dark">
  <a href={PROMO_LINK.href} target="_blank" rel="noopener noreferrer" class="chrome-shell">
    <span class="chrome-promo__tag stage-label">{PROMO_LINK.text}</span>
    <span class="chrome-promo__text">{PROMO_LINK.label}</span>
    <span class="sr-only">(opens in a new tab)</span>
    <Icon name="arrow-right" class="icon-xs shrink-0" />
  </a>
</div>

<header class="site-header" data-theme="dark">
  <nav class="chrome-shell site-header__bar" aria-label="Global">
    <a href="/" class="site-header__logo" aria-label={`${businessName} home`}>
      <BrandLogo branding={branding} alt="" width="96" height={32} />
    </a>

    <div class="chrome-nav">
      {HEADER_MENUS.map((group) => <NavMenu group={group} />)}
      <a href={GCC_LINK.href} class="chrome-nav__link gcc-nav-pill" title={GCC_LINK.text}>
        {GCC_LINK.label}
      </a>
    </div>

    <button
      type="button"
      data-search-open
      class="chrome-search"
      aria-label="Search the website"
      title="Search (Ctrl/Cmd + K)"
    >
      <Icon name="search" class="icon-sm" />
      <span>Search…</span>
      <kbd>⌘K</kbd>
    </button>
    <button
      type="button"
      data-search-open
      class="chrome-icon-button chrome-search-icon"
      aria-label="Search the website"
    >
      <Icon name="search" />
    </button>
    <button
      type="button"
      class="chrome-icon-button"
      data-drawer-open="a11y-drawer"
      aria-controls="a11y-drawer"
      aria-expanded="false"
      aria-label="Accessibility options"
      title="Accessibility options"
    >
      <Icon name="accessibility" />
    </button>
    <ThemeToggle />
    <a
      href={HEADER_ACTIONS.secondary.href}
      class="chrome-action chrome-action--ghost chrome-cta chrome-cta--wide"
    >
      {HEADER_ACTIONS.secondary.label}
    </a>
    <a href={HEADER_ACTIONS.primary.href} class="chrome-action chrome-action--primary chrome-cta">
      {HEADER_ACTIONS.primary.label}
      <Icon name="arrow-right" class="icon-xs" />
    </a>
    <button
      id="openMobileMenu"
      type="button"
      class="chrome-icon-button chrome-menu-button"
      data-drawer-open="mobileMenu"
      aria-label="Open main menu"
      aria-controls="mobileMenu"
      aria-expanded="false"
    >
      <Icon name="menu" />
    </button>
  </nav>
  <div class="chrome-neon" aria-hidden="true"></div>
</header>

<!-- Outside <header>, not in it: the header's backdrop-filter makes it the containing block
     for every fixed descendant, which pinned the "full-screen" menu to the header's own box. -->
<MobileHeader branding={branding} />

<script>
  import "../../scripts/chrome/header-menus";
</script>

<style>
  /* The highlighted GCC item: a sky pill on the night bar, always readable (data-theme="dark"). */
  .chrome-nav__link.gcc-nav-pill {
    margin-left: var(--space-1);
    border: var(--border-width-hairline) solid var(--color-sky-muted);
    border-radius: var(--radius-pill);
    background: var(--color-sky-subtle);
    color: var(--color-sky-fg);
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
  }

  .chrome-nav__link.gcc-nav-pill:hover {
    background: var(--color-sky-soft);
    color: var(--color-sky-fg-strong);
  }

  .gcc-nav-pill:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
</style>
