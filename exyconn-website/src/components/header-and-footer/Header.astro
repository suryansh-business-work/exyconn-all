              </div>
              <div>
                <div class="font-semibold text-gray-900 text-sm">Agentic AI</div>
                <div class="text-xs text-gray-500 mt-0.5">Autonomous agents for business</div>
              </div>
            </a>
            <a href="/ai/bot-creation" class="header-menu-item" role="menuitem">
