---
/**
 * The blog (CMS component 'blog.list'): the band with the knowledge constellation of the
 * site's posts, the filterable list (the newest featured post leads, wide) or the empty
 * state, and the closing call to action. Every word comes from the props; the posts from
 * Website › Blog, for the site the page belongs to.
 */
import type { CmsComponentProps } from "@exyconn/cms";
import ContentEmpty from "../content/ContentEmpty.astro";
import PostCard from "../content/PostCard.astro";
import ChapterHeading from "../inner/ChapterHeading.astro";
import CtaBand from "../inner/CtaBand.astro";
import FilterBar from "../inner/FilterBar.astro";
import InnerStage from "../inner/InnerStage.astro";
import type { CmsRenderContext } from "../../lib/cms/types";
import { blogConstellation, leadPost } from "../../lib/content/blog";
import { chipOptions, displayDate, filterTokens, sortableDate } from "../../lib/content/format";
import { DEFAULT_MARKET } from "../../lib/i18n/markets";
import { getBlogPosts } from "../../lib/portal";

type Props = Readonly<CmsComponentProps<"blog.list"> & { cms: CmsRenderContext }>;

const { crumbs, title, lede, chapterLabel, chapterTitle, filters, empty, cta, cms } = Astro.props;
const { featured, read, noMatch } = Astro.props;
const market = Astro.locals.market ?? DEFAULT_MARKET;
const posts = await getBlogPosts(cms.site);
const lead = leadPost(posts);
const ordered = lead ? [lead, ...posts.filter((post) => post !== lead)] : [];
const topics = chipOptions(
  posts.flatMap((post) => post.tags),
  8
);
const constellation = blogConstellation(posts);
---

<InnerStage
  family="blog"
  variant="band"
  crumbs={crumbs}
  title={title}
  lede={lede}
  scene={{ shapes: ["constellation"], data: { constellation } }}
/>

<section class="inner-section stage-shell" aria-labelledby="blog-articles">
  <ChapterHeading index={1} label={chapterLabel} title={chapterTitle} id="blog-articles" />
  {
    ordered.length === 0 ? (
      <div class="mt-10">
        <ContentEmpty
          label={empty.label}
          title={empty.title}
          text={empty.text}
          primary={empty.primary}
          secondary={empty.secondary}
          level="h3"
        />
      </div>
    ) : (
      <>
        <div class="mt-10">
          <FilterBar
            target="blog-posts"
            label={filters.label}
            sheetLabel={filters.sheetLabel}
            groups={[
              {
                param: "topic",
                label: filters.topicLabel,
                allLabel: filters.allTopics,
                options: topics,
              },
            ]}
            search={{
              param: "q",
              label: filters.searchLabel,
              placeholder: filters.searchPlaceholder,
            }}
            sort={{
              param: "sort",
              label: filters.sortLabel,
              options: [
                { value: "", label: filters.sortNewest },
                { value: "date", label: filters.sortOldest },
              ],
            }}
            countTemplate={filters.countTemplate}
          />
        </div>
        <ul id="blog-posts" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mt-8">
          {ordered.map((post, index) => (
            <PostCard
              href={`/blog/${post.slug}`}
              title={post.title}
              summary={post.summary}
              image={post.coverImage}
              kicker={post.tags[0]}
              badge={post.featured ? featured : undefined}
              meta={[displayDate(post.publishedAt, market.locale).text, post.readTime]}
              more={read}
              wide={index === 0}
              eager={index === 0}
              data-filter-item
              data-filter-topic={filterTokens(post.tags)}
              data-search={`${post.title} ${post.summary} ${post.tags.join(" ")}`}
              data-sort-date={sortableDate(post.publishedAt)}
            />
          ))}
        </ul>
        <p data-filter-empty="blog-posts" class="inner-panel p-6 mt-6 text-fg-secondary" hidden>
          {noMatch}
        </p>
      </>
    )
  }
</section>

<CtaBand
  family="blog"
  label={cta.label}
  title={cta.title}
  text={cta.text}
  primary={cta.primary}
  secondary={cta.secondary}
/>
