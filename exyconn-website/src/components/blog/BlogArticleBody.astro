---
/**
 * The blog article: the reading layout with the post's sanitised body (and its live-editor
 * CSS, scoped to the article), topics, author, sharing, related posts and the call to action.
 */
import type { CmsComponentProps } from "@exyconn/cms";
import ShareLinks from "../content/ShareLinks.astro";
import ArticleLayout from "../inner/ArticleLayout.astro";
import ChapterHeading from "../inner/ChapterHeading.astro";
import CtaBand from "../inner/CtaBand.astro";
import LinkCard from "../inner/LinkCard.astro";
import type { BlogArticleDetail } from "../../lib/cms/loaders/blog";
import { articleSheets } from "../../lib/content/blog";
import { displayDate } from "../../lib/content/format";
import { DEFAULT_MARKET } from "../../lib/i18n/markets";
import { withHeadingIds } from "../../lib/inner/headings";
import { ARTICLE_CLASS, sanitizeArticleHtml, scopeArticleCss } from "../../lib/portal";

type Props = Readonly<CmsComponentProps<"blog.article"> & { detail: BlogArticleDetail }>;

const { crumbs, tocLabel, byLabel, tagsLabel, share, relatedLabel, relatedTitle, read, cta } =
  Astro.props;
const { post, related, url } = Astro.props.detail;
const market = Astro.locals.market ?? DEFAULT_MARKET;
const { html, toc } = withHeadingIds(sanitizeArticleHtml(post.content));
// A body designed in the portal's live editor brings its own CSS, scoped to the article.
const designCss = scopeArticleCss(post.contentCss);
const image = post.coverImage
  ? { src: post.coverImage, alt: "", width: 1600, height: 900 }
  : undefined;
---

<ArticleLayout
  title={post.title}
  crumbs={[...crumbs, { label: post.title }]}
  category={post.tags[0]}
  author={post.author.name}
  published={displayDate(post.publishedAt, market.locale)}
  readTime={post.readTime}
  image={image}
  tocLabel={tocLabel}
  toc={toc}
  scene={{ shapes: ["documents"], data: { documents: { sheets: articleSheets(toc) } } }}
>
  {designCss && <style is:inline set:html={designCss} />}
  <p class="inner-lede mb-10">{post.summary}</p>
  <article class={ARTICLE_CLASS} set:html={html} />

  <div slot="after" class="mt-16 grid gap-6">
    {
      post.tags.length > 0 && (
        <ul class="inner-chips" aria-label={tagsLabel}>
          {post.tags.map((tag) => (
            <li class="inner-chip">{tag}</li>
          ))}
        </ul>
      )
    }
    <div class="inner-panel content-author">
      <span class="content-author__mark" aria-hidden="true">{post.author.initials}</span>
      <div>
        <p class="stage-label">{byLabel}</p>
        <p class="inner-h3 mt-1">{post.author.name}</p>
        {post.author.role && <p class="inner-card__text">{post.author.role}</p>}
      </div>
    </div>
    <ShareLinks url={url} title={post.title} labels={share} />
  </div>
</ArticleLayout>

{
  related.length > 0 && (
    <section class="inner-section stage-shell" aria-labelledby="related-articles">
      <ChapterHeading index={1} label={relatedLabel} title={relatedTitle} id="related-articles" />
      <ul class="grid gap-6 md:grid-cols-3 mt-10">
        {related.map((other) => (
          <li>
            <LinkCard
              href={`/blog/${other.slug}`}
              index={other.tags[0]}
              title={other.title}
              text={other.summary}
              more={read}
            />
          </li>
        ))}
      </ul>
    </section>
  )
}

<CtaBand
  family="blog"
  label={cta.label}
  title={cta.title}
  text={cta.text}
  primary={cta.primary}
  secondary={cta.secondary}
/>
