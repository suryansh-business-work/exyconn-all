---
/**
 * The one template behind every AI capability page (src/pages/[market]/ai/*) and service
 * detail page (src/pages/[market]/services/*). A page passes its content module from
 * src/lib/detail/<section>/<slug>.ts; the chapters it shows follow from what the module has.
 *
 * A page with `liveDemo` gets a "Live demo" chapter after What it is, filled from its `live` slot.
 *
 * AI: hero → tools → What it is (+ demo) → Architecture → Use cases → Explore (tabs) → FAQ →
 * related → CTA. Services: hero → tools → What it is → What we deliver → How we work → FAQ →
 * related → CTA (the lattice re-forms into the service glyph there).
 */
import Page from "../../layouts/Page.astro";
import ChapterHeading from "../inner/ChapterHeading.astro";
import CtaBand from "../inner/CtaBand.astro";
import FaqAccordion from "../inner/FaqAccordion.astro";
import InnerStage from "../inner/InnerStage.astro";
import DetailArchitecture from "./DetailArchitecture.astro";
import DetailIntro from "./DetailIntro.astro";
import DetailLogos from "./DetailLogos.astro";
import DetailOfferings from "./DetailOfferings.astro";
import DetailProcess from "./DetailProcess.astro";
import DetailRelated from "./DetailRelated.astro";
import DetailTabs from "./DetailTabs.astro";
import { DETAIL_COPY } from "../../lib/detail/copy";
import {
  detailChapters,
  detailCrumbs,
  detailPath,
  relatedPages,
  serviceJsonLd,
  type DetailChapter,
} from "../../lib/detail/helpers";
import { logosFor } from "../../lib/detail/logos";
import { DETAIL_PAGES } from "../../lib/detail/registry";
import { SERVICE_GLYPH_SHAPE } from "../../lib/detail/scenes";
import type { DetailPage } from "../../lib/detail/schema";
import { breadcrumbJsonLd } from "../../lib/inner/structured-data";
import { DEFAULT_MARKET, marketUrl } from "../../lib/i18n/markets";
import { BRANDING_FALLBACK } from "../../lib/portal";

type Props = Readonly<{ page: DetailPage }>;

const { page } = Astro.props;
const { section } = page;
const copy = DETAIL_COPY;
const isService = section === "services";

const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const market = Astro.locals.market ?? DEFAULT_MARKET;
const absolute = (path: string) => `${SITE_URL}${marketUrl(market, path)}`;

const crumbs = detailCrumbs(page);
const jsonLd = [
  breadcrumbJsonLd(
    crumbs.map((crumb) => ({ ...crumb, href: absolute(crumb.href ?? detailPath(page)) })),
    SITE_URL
  ),
  serviceJsonLd(page, absolute(detailPath(page)), {
    name: BRANDING_FALLBACK.businessName,
    url: SITE_URL,
  }),
];

const chapters = detailChapters(page);
const chapter = (id: DetailChapter): number => chapters[id] ?? 0;
---

<Page
  metaTitle={page.meta.title}
  metaDescription={page.meta.description}
  metaKeywords={page.meta.keywords}
  metaImage={page.meta.image}
  jsonLd={jsonLd}
>
  <InnerStage
    family={section}
    crumbs={crumbs}
    title={page.hero.title}
    lede={page.hero.lede}
    primary={page.hero.action}
    secondary={copy.hub[section]}
    scene={page.scene}
  >
    <p class="stage-label mt-8 text-fg-secondary">{page.hero.tagline}</p>
  </InnerStage>

  {page.logos && <DetailLogos label={page.logos.label} logos={logosFor(page.logos.keys)} />}

  <DetailIntro
    index={chapter("intro")}
    label={copy.chapters.intro}
    intro={page.intro}
    benefits={page.benefits}
    demo={page.demo}
  />

  {
    page.liveDemo && (
      <section class="inner-section stage-shell" id="try-demo" aria-labelledby="detail-live">
        <ChapterHeading
          index={chapter("live")}
          label={copy.chapters.live}
          title={page.liveDemo.title}
          lede={page.liveDemo.lede}
          id="detail-live"
        />
        <div class="mt-10">
          <slot name="live" />
        </div>
      </section>
    )
  }

  {
    page.architecture && (
      <DetailArchitecture
        index={chapter("architecture")}
        label={copy.chapters.architecture}
        title={page.architecture.title}
        layers={page.architecture.layers}
      />
    )
  }

  <DetailOfferings
    index={chapter("offerings")}
    label={copy.chapters.offerings[section]}
    offerings={page.offerings}
  />

  {
    page.tabs && (
      <DetailTabs
        index={chapter("tabs")}
        label={copy.chapters.tabs}
        title={page.tabs.title}
        items={page.tabs.items}
      />
    )
  }

  {isService && <DetailProcess index={chapter("process")} label={copy.chapters.process} />}

  <section class="inner-section stage-shell" aria-labelledby="detail-faq">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16">
      <ChapterHeading
        index={chapter("faq")}
        label={copy.chapters.faq}
        title={copy.faqTitle(page.name)}
        id="detail-faq"
      />
      <FaqAccordion items={page.faqs} />
    </div>
  </section>

  <DetailRelated
    index={chapter("related")}
    label={copy.chapters.related[section]}
    title={copy.relatedTitle[section]}
    more={copy.relatedMore}
    cards={relatedPages(DETAIL_PAGES, page)}
  />

  <CtaBand
    family={section}
    label={copy.cta.label}
    title={copy.ctaTitle(page.name)}
    text={page.hero.tagline}
    primary={page.hero.action}
    secondary={copy.cta.secondary}
    echoShape={isService ? SERVICE_GLYPH_SHAPE : 0}
  />
</Page>
