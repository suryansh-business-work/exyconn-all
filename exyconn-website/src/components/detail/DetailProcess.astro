---
/**
 * Chapter "How we work" (service pages): the site's delivery process as stations on a line.
 * The steps and the heading are the page's CMS props.
 */
import "../../styles/inner-stage.css";
import ChapterHeading from "../inner/ChapterHeading.astro";
import StepTrack from "../inner/StepTrack.astro";
import type { DetailStep } from "./types";

type Props = Readonly<{
  index: number;
  label: string;
  title: string;
  lede: string;
  steps: readonly DetailStep[];
}>;

const { index, label, title, lede, steps } = Astro.props;
---

<section class="inner-section stage-shell" aria-labelledby="detail-process">
  <ChapterHeading index={index} label={label} title={title} lede={lede} id="detail-process" />
  <div class="mt-10">
    <StepTrack steps={steps} />
  </div>
</section>
