---
/**
 * A titled panel of short icon rows (the "why invest" reasons). Icons are bare Font Awesome
 * free solid names from the page's content module.
 */
import "../../styles/inner-stage.css";

type Props = Readonly<{
  title: string;
  items: readonly { icon: string; text: string }[];
  class?: string;
}>;

const { title, items, class: extra = "" } = Astro.props;
---

<div class={`inner-panel p-6 sm:p-8 ${extra}`}>
  <h3 class="inner-h3">{title}</h3>
  <ul class="mt-6 grid gap-4">
    {
      items.map((item) => (
        <li class="flex items-start gap-4">
          <span class="detail-icon" aria-hidden="true">
            <i class={`fa-solid fa-${item.icon} icon-sm`} aria-hidden="true" />
          </span>
          <span class="pt-1.5 text-fg-secondary leading-relaxed">{item.text}</span>
        </li>
      ))
    }
  </ul>
</div>

<style is:global>
  .detail-icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-lg);
    border: var(--border-width-hairline) solid var(--color-line);
    background: var(--color-surface-subtle);
    color: var(--accent-a-ink, var(--color-fg));
  }
</style>
