---
import { aiServices, aiServiceCategories } from "../lib/services/aiServices";
---

<!-- AI + SaaS Solutions Grid - Light Theme -->
<section
  class="py-24 px-4 md:px-8 bg-gradient-to-b from-surface to-surface-subtle w-full relative overflow-hidden"
>
  <!-- Background decoration -->
  <div
    class="absolute top-0 right-0 w-96 h-96 bg-gradient-to-br from-blue-soft/50 to-cyan-soft/50 rounded-full blur-3xl -z-10"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-80 h-80 bg-gradient-to-tr from-purple-soft/50 to-pink-soft/50 rounded-full blur-3xl -z-10"
  >
  </div>

  <div class="max-w-7xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-16 animate-fade-in-down">
      <span
        class="inline-flex items-center gap-2 px-4 py-2 bg-blue-subtle border border-blue-soft rounded-full text-sm font-semibold text-blue-fg mb-4"
      >
        <i class="fa-solid fa-sparkles"></i>
        What We Offer
      </span>
      <h2
        class="text-4xl md:text-5xl font-bold text-fg mb-6 tracking-tight"
        data-anime="fade-up"
      >
        Solutions for <span
          class="bg-gradient-to-r from-blue-strong to-cyan bg-clip-text text-transparent"
          >Modern Business</span
        >
      </h2>
      <p
        class="text-xl text-fg-muted max-w-3xl mx-auto leading-relaxed"
        data-anime="fade-up"
        data-anime-delay="100"
      >
        From idea to MVP in one week. We handle the infrastructure, you focus on building value.
      </p>
    </div>

    <!-- Three-Pillar Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16">
      <!-- Pillar 1: AI Services -->
      <a
        href="/ai-services"
        class="group bg-gradient-to-br from-inverse to-inverse-muted rounded-3xl shadow-2xl p-8 flex flex-col text-on-solid hover:scale-[1.02] hover:shadow-inverse/30 transition-all duration-300 relative overflow-hidden"
      >
        <div
          class="absolute top-0 right-0 w-40 h-40 bg-gradient-to-br from-blue/20 to-cyan/20 rounded-full blur-2xl"
        >
        </div>
        <div class="relative z-10">
          <div
            class="w-16 h-16 bg-gradient-to-br from-blue to-cyan rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-blue/30 group-hover:scale-110 transition-transform"
          >
            <i class="fa-solid fa-bolt text-2xl text-on-solid" aria-hidden="true"></i>
          </div>
          <span
            class="inline-flex items-center gap-1 px-2 py-1 bg-yellow/20 text-yellow-bright text-xs font-bold rounded-full mb-3"
          >
            <i class="fa-solid fa-star text-[10px]" aria-hidden="true"></i> FEATURED
          </span>
          <h3 class="font-bold text-2xl mb-3">AI Services</h3>
          <p class="text-on-solid-muted mb-6 leading-relaxed">
            {aiServices.length} service areas across agents, automation, vertical AI products and the
            platform underneath them — delivered on the systems you already run.
          </p>
          <ul class="space-y-3 mb-8">
            {
              aiServiceCategories.slice(0, 4).map((category) => (
                <li class="flex items-center gap-3 text-on-solid-muted">
                  <i class="fa-solid fa-check-circle text-blue-bright" aria-hidden="true"></i>
                  {category.title}
                </li>
              ))
            }
          </ul>
          <div
            class="inline-flex items-center gap-2 text-blue-bright font-semibold group-hover:text-blue-bright transition"
          >
            Learn More <i
              class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
          </div>
        </div>
      </a>

      <!-- Pillar 2: SaaS Products -->
      <a
        href="/our-products"
        class="group bg-surface rounded-3xl shadow-xl border border-line-subtle p-8 flex flex-col hover:scale-[1.02] hover:shadow-2xl transition-all duration-300 relative overflow-hidden"
      >
        <div
          class="absolute top-0 right-0 w-40 h-40 bg-gradient-to-br from-indigo-soft to-purple-soft rounded-full blur-2xl"
        >
        </div>
        <div class="relative z-10">
          <div
            class="w-16 h-16 bg-gradient-to-br from-indigo to-purple-strong rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-indigo/30 group-hover:scale-110 transition-transform"
          >
            <i class="fa-solid fa-cube text-2xl text-on-solid"></i>
          </div>
          <h3 class="font-bold text-2xl text-fg mb-3">SaaS Products</h3>
          <p class="text-fg-muted mb-6 leading-relaxed">
            Production-ready SaaS platforms built for scale. Instant deployment, enterprise
            security.
          </p>
          <div class="space-y-4 mb-8">
            <div
              class="bg-gradient-to-r from-surface-subtle to-indigo-subtle rounded-xl p-4 border border-indigo-soft"
            >
              <div class="flex items-center gap-3 mb-1">
                <img
                  src="https://ik.imagekit.io/esdata1/sibera/logo/logo-only.svg"
                  alt="Sibera"
                  class="h-5"
                />
                <span class="text-xs text-amber-fg font-medium">Early Access</span>
              </div>
              <p class="text-sm text-fg-muted">AI-powered CRM platform</p>
            </div>
            <div
              class="bg-gradient-to-r from-surface-subtle to-emerald-subtle rounded-xl p-4 border border-emerald-soft"
            >
              <div class="flex items-center gap-3 mb-1">
                <img src="https://spentiva.com/logo.svg" alt="Spentiva" class="h-5" />
                <span class="text-xs text-emerald-fg font-medium">Live</span>
              </div>
              <p class="text-sm text-fg-muted">Smart expense tracking with AI</p>
            </div>
          </div>
          <div
            class="inline-flex items-center gap-2 text-indigo-fg font-semibold group-hover:text-indigo-fg-strong transition"
          >
            View All Products <i
              class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
          </div>
        </div>
      </a>

      <!-- Pillar 3: AI Platform -->
      <a
        href="/ai"
        class="group bg-surface rounded-3xl shadow-xl border border-line-subtle p-8 flex flex-col hover:scale-[1.02] hover:shadow-2xl transition-all duration-300 relative overflow-hidden"
      >
        <div
          class="absolute top-0 right-0 w-40 h-40 bg-gradient-to-br from-cyan-soft to-blue-soft rounded-full blur-2xl"
        >
        </div>
        <div class="relative z-10">
          <div
            class="w-16 h-16 bg-gradient-to-br from-cyan to-blue-strong rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-cyan/30 group-hover:scale-110 transition-transform"
          >
            <i class="fa-solid fa-microchip text-2xl text-on-solid"></i>
          </div>
          <h3 class="font-bold text-2xl text-fg mb-3">AI Platform</h3>
          <p class="text-fg-muted mb-6 leading-relaxed">
            Deploy production-ready AI agents, workflows, and LLM-powered applications with
            enterprise security.
          </p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-center gap-3 text-fg-secondary">
              <i class="fa-solid fa-check-circle text-cyan-fg"></i>
              Agentic AI & Autonomous Agents
            </li>
            <li class="flex items-center gap-3 text-fg-secondary">
              <i class="fa-solid fa-check-circle text-cyan-fg"></i>
              Custom LLM Training
            </li>
            <li class="flex items-center gap-3 text-fg-secondary">
              <i class="fa-solid fa-check-circle text-cyan-fg"></i>
              AI Workflow Orchestration
            </li>
            <li class="flex items-center gap-3 text-fg-secondary">
              <i class="fa-solid fa-check-circle text-cyan-fg"></i>
              MCP Server Infrastructure
            </li>
          </ul>
          <div
            class="inline-flex items-center gap-2 text-cyan-fg font-semibold group-hover:text-cyan-fg-strong transition"
          >
            Explore AI Platform <i
              class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
          </div>
        </div>
      </a>
    </div>

    <!-- Quick Solutions Grid -->
    <div
      class="grid grid-cols-2 md:grid-cols-4 gap-6"
      data-anime-stagger="fade-up"
      data-anime-step="80"
    >
      <a
        href="/ai/agentic"
        class="group bg-surface rounded-2xl shadow-md border border-line-subtle p-6 hover:shadow-xl hover:border-blue-muted transition-all duration-300"
      >
        <i
          class="fa-solid fa-robot text-2xl text-blue-fg mb-3 group-hover:scale-110 transition-transform"
        ></i>
        <h4 class="font-semibold text-fg mb-1">Agentic AI</h4>
        <p class="text-sm text-fg-subtle">Autonomous agents</p>
      </a>
      <a
        href="/ai/workflows"
        class="group bg-surface rounded-2xl shadow-md border border-line-subtle p-6 hover:shadow-xl hover:border-purple-muted transition-all duration-300"
      >
        <i
          class="fa-solid fa-diagram-project text-2xl text-purple-fg mb-3 group-hover:scale-110 transition-transform"
        ></i>
        <h4 class="font-semibold text-fg mb-1">Workflows</h4>
        <p class="text-sm text-fg-subtle">Process automation</p>
      </a>
      <a
        href="/services/digital-consulting"
        class="group bg-surface rounded-2xl shadow-md border border-line-subtle p-6 hover:shadow-xl hover:border-emerald-muted transition-all duration-300"
      >
        <i
          class="fa-solid fa-lightbulb text-2xl text-emerald-fg mb-3 group-hover:scale-110 transition-transform"
        ></i>
        <h4 class="font-semibold text-fg mb-1">Consulting</h4>
        <p class="text-sm text-fg-subtle">Digital strategy</p>
      </a>
      <a
        href="/services/data-analytics"
        class="group bg-surface rounded-2xl shadow-md border border-line-subtle p-6 hover:shadow-xl hover:border-orange-muted transition-all duration-300"
      >
        <i
          class="fa-solid fa-chart-line text-2xl text-orange-fg mb-3 group-hover:scale-110 transition-transform"
        ></i>
        <h4 class="font-semibold text-fg mb-1">Analytics</h4>
        <p class="text-sm text-fg-subtle">Data insights</p>
      </a>
    </div>
  </div>

  <style>
    @keyframes fade-in-up {
      0% {
        opacity: 0;
        transform: translateY(40px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @keyframes fade-in-down {
      0% {
        opacity: 0;
        transform: translateY(-40px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .animate-fade-in-up {
      animation: fade-in-up 0.9s cubic-bezier(0.4, 0, 0.2, 1) both;
    }
    .animate-fade-in-down {
      animation: fade-in-down 0.9s cubic-bezier(0.4, 0, 0.2, 1) both;
    }
  </style>
</section>
