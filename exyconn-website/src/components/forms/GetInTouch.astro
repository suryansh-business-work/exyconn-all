---
// Improved Get In Touch Design
import ContactFormReact from "./ContactFormReact.tsx";
---

<section class="py-20 lg:py-28 bg-surface">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-start">
      <!-- Left Column - Info -->
      <div class="space-y-8">
        <!-- Badge -->
        <span
          class="inline-flex items-center gap-2 bg-blue-soft text-blue-fg-strong text-sm font-semibold px-4 py-2 rounded-full"
        >
          <i class="fa-solid fa-message"></i>
          Get In Touch
        </span>

        <!-- Heading -->
        <div>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-fg mb-4">
            Let's Build Something <span class="text-blue-fg">Amazing Together</span>
          </h2>
          <p class="text-lg text-fg-muted leading-relaxed">
            Have a project in mind? We'd love to hear from you. Send us a message and we'll respond
            as soon as possible.
          </p>
        </div>

        <!-- Contact Info Cards -->
        <div class="space-y-4">
          <div
            class="flex items-start gap-4 p-5 bg-surface rounded-2xl border border-line-subtle shadow-sm hover:shadow-md transition-shadow"
          >
            <div
              class="w-12 h-12 bg-blue-deep rounded-xl flex items-center justify-center shrink-0"
            >
              <i class="fa-solid fa-envelope text-on-solid"></i>
            </div>
            <div>
              <h3 class="font-semibold text-fg mb-1">Email Us</h3>
              <p class="text-fg-muted text-sm">services@exyconn.com</p>
              <p class="text-fg-subtle text-xs mt-1">We reply within 24 hours</p>
            </div>
          </div>

          <div
            class="flex items-start gap-4 p-5 bg-surface rounded-2xl border border-line-subtle shadow-sm hover:shadow-md transition-shadow"
          >
            <div
              class="w-12 h-12 bg-emerald-deep rounded-xl flex items-center justify-center shrink-0"
            >
              <i class="fa-solid fa-location-dot text-on-solid"></i>
            </div>
            <div>
              <h3 class="font-semibold text-fg mb-1">Schedule an appointment</h3>
              <p class="text-fg-muted text-sm">
                <a href="https://calendly.com/exyconn" target="_blank" rel="noopener noreferrer"
                  >https://calendly.com/exyconn</a
                >
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column - Form: the site's contact form, so it is stored and captcha-checked. -->
      <ContactFormReact client:visible />
    </div>
  </div>
</section>
