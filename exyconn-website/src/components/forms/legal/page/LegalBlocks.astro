---
/**
 * Renders one legal section's blocks (paragraphs, lists, term cards, topic cards, notes) from
 * src/lib/legal. Plain markup only, so every word is in the server HTML.
 */
import type { LegalBlock } from "../../../../lib/legal";
import "./legal-page.css";

type Props = Readonly<{ blocks: readonly LegalBlock[] }>;

const { blocks } = Astro.props;
---

{
  blocks.map((block) => {
    switch (block.kind) {
      case "paragraph":
        return (
          <p>
            {block.parts.map((part) =>
              typeof part === "string" ? part : <a href={part.href}>{part.text}</a>
            )}
          </p>
        );
      case "list":
        return (
          <ul class="legal-list">
            {block.items.map((item) => (
              <li>
                {item.term && <strong>{`${item.term} `}</strong>}
                {item.text}
              </li>
            ))}
          </ul>
        );
      case "terms":
        return (
          <dl class="legal-terms">
            {block.items.map((item) => (
              <div class="inner-panel">
                <dt>{item.term}</dt>
                <dd>{item.text}</dd>
              </div>
            ))}
          </dl>
        );
      case "topics":
        return (
          <div class="legal-topics">
            {block.items.map((topic) => (
              <article class="inner-card">
                <h3 class="inner-h3">{topic.title}</h3>
                <p class="inner-card__text">{topic.text}</p>
                <ul class="legal-list legal-list--check">
                  {topic.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        );
      default:
        return <p class="legal-note">{block.text}</p>;
    }
  })
}
