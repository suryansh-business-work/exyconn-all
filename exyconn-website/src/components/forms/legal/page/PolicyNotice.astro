---
/**
 * The policies pages' empty or error state: what happened, and where the site's own privacy
 * and cookie policies are in the meantime. Every word comes from the page (its CMS props).
 */
import "./legal-page.css";

interface NoticeLink {
  label: string;
  text: string;
  href: string;
}

/** The notice's words: one title and line per state, and the links offered meanwhile. */
export interface PolicyNoticeCopy {
  empty: { title: string; text: string };
  error: { title: string; text: string };
  fallbackIntro: string;
  fallbacks: readonly NoticeLink[];
}

type Props = Readonly<{
  kind: "empty" | "error";
  headingLevel?: "h2" | "h3";
  copy: PolicyNoticeCopy;
}>;

const { kind, headingLevel: Heading = "h2", copy } = Astro.props;
const state = copy[kind];
---

<div class="inner-panel legal-empty" role={kind === "error" ? "alert" : undefined}>
  <Heading class="inner-h3">{state.title}</Heading>
  <p>{state.text}</p>
  <p>{copy.fallbackIntro}</p>
  <ul class="legal-list">
    {
      copy.fallbacks.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a> — {link.text}
        </li>
      ))
    }
  </ul>
</div>
