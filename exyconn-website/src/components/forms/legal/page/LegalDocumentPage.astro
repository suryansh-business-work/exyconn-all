---
/**
 * A whole legal page from one `LegalDocument`: Page meta + breadcrumb JSON-LD, the night band
 * with its scene, "Last updated" in the reader's locale, the plain-words summary, the TOC and
 * every section that has blocks. Sections with no blocks (a FAQ, a form) are rendered by the
 * page in the default slot, as LegalSection with the number from `sectionNumber`.
 */
import LegalLayout from "../../../inner/LegalLayout.astro";
import LegalSection from "../../../inner/LegalSection.astro";
import type { Crumb, PageFamily, SceneConfig } from "../../../inner/types";
import Page from "../../../../layouts/Page.astro";
import { DEFAULT_MARKET } from "../../../../lib/i18n/markets";
import { breadcrumbJsonLd } from "../../../../lib/inner/structured-data";
import { readerDate, type LegalDocument, type LegalLink } from "../../../../lib/legal";
import LegalBlocks from "./LegalBlocks.astro";
import RelatedLegal from "./RelatedLegal.astro";

type Props = Readonly<{
  doc: LegalDocument;
  current: LegalLink["key"];
  crumbs: readonly Crumb[];
  scene: SceneConfig;
  family?: PageFamily;
}>;

const { doc, current, crumbs, scene, family } = Astro.props;
const market = Astro.locals.market ?? DEFAULT_MARKET;
const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const numbered = doc.sections.map((section, index) => ({ ...section, number: index + 1 }));
---

<Page
  metaTitle={doc.metaTitle}
  metaDescription={doc.metaDescription}
  metaKeywords={doc.metaKeywords}
  jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}
>
  <LegalLayout
    title={doc.title}
    crumbs={crumbs}
    updatedLabel="Last updated"
    updated={doc.updated ? readerDate(doc.updated, market.locale) : undefined}
    summaryTitle="In plain words"
    summary={doc.summary}
    tocLabel="On this page"
    sections={doc.sections}
    family={family}
    scene={scene}
  >
    {
      numbered
        .filter((section) => section.blocks.length > 0)
        .map((section) => (
          <LegalSection
            id={section.id}
            number={section.number}
            title={section.label}
            anchorLabel="Link to this section"
          >
            <LegalBlocks blocks={section.blocks} />
          </LegalSection>
        ))
    }
    <slot />
    <RelatedLegal current={current} slot="after" />
  </LegalLayout>
</Page>
