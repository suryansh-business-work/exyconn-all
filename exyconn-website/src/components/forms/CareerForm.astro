<div class="bg-white rounded-2xl shadow-xl p-8 max-w-2xl mx-auto mt-20" id="apply-now-form">
  <h3 id="career-form-title" class="text-2xl font-bold text-[#0071e3] mb-4 text-center">
    Apply Now
  </h3>
  <form
    class="space-y-6"
    name="career-application"
    method="POST"
    data-netlify="true"
    enctype="multipart/form-data"
    aria-labelledby="career-form-title"
  >
    <input type="hidden" name="form-name" value="career-application" />
    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label for="career-name" class="block text-gray-700 font-semibold mb-2">
          Full Name <span class="text-red-500" aria-hidden="true">*</span>
          <span class="sr-only">(required)</span>
        </label>
        <input
          required
          type="text"
          id="career-name"
          name="name"
          autocomplete="name"
          aria-required="true"
          class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          placeholder="Your full name"
        />
      </div>
      <div>
        <label for="career-email" class="block text-gray-700 font-semibold mb-2">
          Email <span class="text-red-500" aria-hidden="true">*</span>
          <span class="sr-only">(required)</span>
        </label>
        <input
          required
          type="email"
          id="career-email"
          name="email"
          autocomplete="email"
          aria-required="true"
          class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          placeholder="you@example.com"
        />
      </div>
    </div>
    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label for="career-phone" class="block text-gray-700 font-semibold mb-2">
          Phone <span class="text-gray-400 font-normal">(optional)</span>
        </label>
        <input
          type="tel"
          id="career-phone"
          name="phone"
          autocomplete="tel"
          class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          placeholder="+1 (555) 000-0000"
        />
      </div>
      <div>
        <label for="jobId" class="block text-gray-700 font-semibold mb-2">
          Position Applied For (Job ID) <span class="text-red-500" aria-hidden="true">*</span>
          <span class="sr-only">(required)</span>
        </label>
        <input
          required
          type="text"
          id="jobId"
          name="jobId"
          aria-required="true"
          class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          placeholder="e.g., EXY-2024-001"
        />
      </div>
    </div>
    <div>
      <label for="resume" class="block text-gray-700 font-semibold mb-2">
        Resume <span class="text-gray-500 font-normal">(PDF, DOCX, Max 5MB)</span>
        <span class="text-red-500" aria-hidden="true">*</span>
        <span class="sr-only">(required)</span>
      </label>
      <input
        required
        type="file"
        id="resume"
        name="resume"
        accept=".pdf,.doc,.docx"
        aria-required="true"
        aria-describedby="resume-help"
        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100"
      />
      <p id="resume-help" class="text-sm text-gray-500 mt-1">
        Accepted formats: PDF, DOC, DOCX (max 5MB)
      </p>
    </div>
    <div>
      <label for="career-message" class="block text-gray-700 font-semibold mb-2">
        Cover Letter / Message <span class="text-gray-400 font-normal">(optional)</span>
      </label>
      <textarea
        id="career-message"
        name="message"
        rows="4"
        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        placeholder="Tell us why you'd be a great fit for this role..."></textarea>
    </div>
    <div class="text-center">
      <button
        type="submit"
        class="btn w-full bg-blue-600 text-white font-semibold py-3 px-6 rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 transition-all duration-200"
        aria-label="Submit job application"
      >
        Submit Application
      </button>
    </div>
  </form>
</div>
