<section class="max-w-xl mx-auto mt-12 rounded-xl p-5">
  <div class="bg-white rounded-lg shadow-lg p-8">
    <h2 class="text-2xl font-semibold text-[#0071e3] mb-6 text-center">Submit Your Grievance</h2>
    <form method="POST" name="grievance-form">
      <div class="mb-4">
        <label class="block mb-1 font-medium text-gray-700" for="name">Your Name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full px-4 py-2 border rounded focus:ring-2 focus:ring-[#0071e3] outline-none"
        />
      </div>
      <div class="mb-4">
        <label class="block mb-1 font-medium text-gray-700" for="email">Your Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full px-4 py-2 border rounded focus:ring-2 focus:ring-[#0071e3] outline-none"
        />
      </div>
      <div class="mb-4">
        <label class="block mb-1 font-medium text-gray-700" for="subject">Subject</label>
        <input
          type="text"
          id="subject"
          name="subject"
          required
          class="w-full px-4 py-2 border rounded focus:ring-2 focus:ring-[#0071e3] outline-none"
        />
      </div>
      <div class="mb-6">
        <label class="block mb-1 font-medium text-gray-700" for="message">Grievance Details</label>
        <textarea
          id="message"
          name="message"
          rows="6"
          required
          class="w-full px-4 py-2 border rounded focus:ring-2 focus:ring-[#0071e3] outline-none"
        ></textarea>
      </div>
      <button type="submit" class="btn w-full"> Submit Grievance </button>
    </form>
    <p class="text-xs text-gray-500 mt-4 text-center">
      By submitting, you agree that your grievance will be reviewed in accordance with Exyconn’s
      grievance redressal policy.
    </p>
  </div>
</section>
