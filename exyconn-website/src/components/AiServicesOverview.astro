---
/**
 * Home page AI service catalogue. Renders straight from the shared catalogue
 * so the home page, /ai-services and each detail page can never drift apart.
 */
import { aiServiceCategories, aiServices, servicesInCategory } from "../lib/services/aiServices";
---

<section class="py-24 px-4 md:px-8 bg-white w-full relative overflow-hidden">
  <div
    class="absolute top-1/4 left-0 w-96 h-96 bg-gradient-to-br from-blue-100/40 to-cyan-100/40 rounded-full blur-3xl -z-10"
    aria-hidden="true"
  >
  </div>

  <div class="max-w-7xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-16">
      <span
        class="inline-flex items-center gap-2 px-4 py-2 bg-blue-50 border border-blue-100 rounded-full text-sm font-semibold text-blue-600 mb-4"
      >
        <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
        AI Services
      </span>
      <h2
        class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 tracking-tight"
        data-anime="fade-up"
      >
        {aiServices.length} Ways We Put <span
          class="bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent"
          >AI to Work</span
        >
      </h2>
      <p
        class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed"
        data-anime="fade-up"
        data-anime-delay="100"
      >
        Agents that carry out real work, vertical AI products for a single industry, and the
        platform layer underneath — built on the systems you already run.
      </p>
    </div>

    <!-- Categories -->
    <div class="space-y-14">
      {
        aiServiceCategories.map((category) => (
          <div data-anime="fade-up">
            <div class="flex items-start gap-4 mb-6">
              <div class="w-12 h-12 shrink-0 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-xl flex items-center justify-center shadow-lg shadow-blue-500/25">
                <i class={`fa-solid ${category.icon} text-white text-lg`} aria-hidden="true" />
              </div>
              <div>
                <h3 class="font-bold text-2xl text-gray-900">{category.title}</h3>
                <p class="text-gray-600 mt-1 max-w-3xl">{category.description}</p>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {servicesInCategory(category.slug).map((service) => (
                <a
                  href={`/ai-services/${service.slug}`}
                  class="group bg-white rounded-2xl border border-gray-200 p-5 flex flex-col hover:border-blue-300 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300"
                >
                  <div
                    class={`w-11 h-11 bg-gradient-to-br ${service.color} rounded-xl flex items-center justify-center mb-4 shadow-md group-hover:scale-110 transition-transform`}
                  >
                    <i class={`fa-solid ${service.icon} text-white`} aria-hidden="true" />
                  </div>
                  <h4 class="font-semibold text-gray-900 mb-2 leading-snug">{service.title}</h4>
                  <p class="text-sm text-gray-600 leading-relaxed grow">{service.summary}</p>
                  <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-blue-600 group-hover:text-blue-700">
                    Learn more
                    <i
                      class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"
                      aria-hidden="true"
                    />
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <!-- CTA -->
    <div class="mt-16 text-center">
      <a
        href="/ai-services"
        class="inline-flex items-center justify-center gap-2 bg-gray-900 text-white font-semibold px-8 py-4 rounded-xl hover:bg-gray-800 transition-colors"
      >
        Browse all AI services
        <i class="fa-solid fa-arrow-right text-sm" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>
