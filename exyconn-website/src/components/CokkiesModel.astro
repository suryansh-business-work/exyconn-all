---
/**
 * Cookie preferences: a drawer from the right (scripts/chrome/drawer.ts). It opens by itself
 * on a first visit (no `cookieConsent` stored) and from the footer's "Cookie preferences"
 * button or the phone menu; the choice is kept by scripts/chrome/cookie-consent.ts. Closed,
 * it is hidden and inert, so it neither shows at the page edge nor takes focus.
 */
import DrawerHead from "./header-and-footer/DrawerHead.astro";
import { COOKIE_CATEGORIES } from "../lib/chrome/preferences";
---

<div class="chrome-backdrop" data-drawer-backdrop="cookie-drawer" data-open="false"></div>
<aside
  id="cookie-drawer"
  class="chrome-drawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cookie-drawer-title"
  tabindex="-1"
  data-open="false"
  inert
>
  <DrawerHead
    drawerId="cookie-drawer"
    titleId="cookie-drawer-title"
    label="We value your privacy"
    title="Cookie preferences"
    closeLabel="Close cookie preferences"
  />

  <div class="chrome-drawer__body grid content-start gap-4">
    <p class="text-sm leading-relaxed text-fg-secondary">
      We use cookies to enhance your browsing experience, serve personalised content and analyse our
      traffic. Choose which categories you allow. Read the
      <a href="/cookies" class="font-semibold text-fg underline underline-offset-4">cookie policy</a
      >.
    </p>
    <ul class="grid gap-2">
      <li class="chrome-option chrome-option--static">
        <span>
          <span class="chrome-option__label">Essential</span>
          <span class="chrome-option__text">Required for the site to work. Cannot be disabled.</span
          >
        </span>
        <span class="stage-label shrink-0">Always on</span>
      </li>
      {
        COOKIE_CATEGORIES.map((category) => (
          <li>
            <label class="chrome-option">
              <span>
                <span class="chrome-option__label">{category.label}</span>
                <span class="chrome-option__text">{category.text}</span>
              </span>
              <input
                type="checkbox"
                class="chrome-switch"
                data-cookie-category={category.id}
                checked={category.initial}
              />
            </label>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="chrome-drawer__foot">
    <button id="cookie-reject" type="button" class="chrome-button">Reject all</button>
    <button id="cookie-save-preferences" type="button" class="chrome-button">Save choices</button>
    <button id="cookie-accept" type="button" class="chrome-button chrome-button--solid">
      Accept all
    </button>
  </div>
</aside>

<script>
  import "../scripts/chrome/cookie-consent";
</script>
