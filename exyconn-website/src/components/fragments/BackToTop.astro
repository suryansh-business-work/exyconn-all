---
/**
 * Back to top: small, bottom-right, clear of the safe-area insets. It shows only while the
 * reader scrolls back up a long page (scripts/chrome/back-to-top.ts), so it never parks over
 * the text being read; the footer keeps room under its last row for it.
 */
import Icon from "../inner/Icon.astro";
---

<button
  id="back-to-top"
  type="button"
  class="back-to-top"
  data-theme="dark"
  data-visible="false"
  aria-label="Back to top"
  title="Back to top"
>
  <Icon name="arrow-up" class="icon-md" />
</button>

<script>
  import "../../scripts/chrome/back-to-top";
</script>
