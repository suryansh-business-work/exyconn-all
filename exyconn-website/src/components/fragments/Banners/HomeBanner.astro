---
// Clean, Professional Home Banner
import { aiServices } from "../../../lib/services/aiServices";
import { TOOLS_SITE_URL } from "../../../lib/site";
---

<section class="relative bg-surface overflow-hidden">
  <!-- Simple Background Pattern -->
  <div class="absolute inset-0 bg-gradient-to-b from-surface-subtle to-surface"></div>
  <div
    class="absolute inset-0 opacity-[0.03] pattern-plus bg-fg"
  >
  </div>

  <!-- Main Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 py-15 lg:py-15">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Badge -->
      <div
        class="inline-flex items-center gap-2 bg-surface-muted rounded-full px-4 py-2 mb-8"
        data-anime="fade-up"
      >
        <span class="w-2 h-2 bg-green rounded-full animate-pulse"></span>
        <span class="text-fg-secondary text-sm font-medium">AI Products &amp; Services</span>
      </div>

      <!-- Headline -->
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-bold text-fg leading-tight mb-6"
        data-anime="fade-up"
        data-anime-delay="100"
      >
        AI That Does the Work.{" "}
        <span class="block text-fg-subtle mt-2">Not Just the Talking.</span>
      </h1>

      <!-- Description -->
      <p
        class="text-lg md:text-xl text-fg-muted max-w-2xl mx-auto mb-10 leading-relaxed"
        data-anime="fade-up"
        data-anime-delay="200"
      >
        We build AI agents, automation and vertical AI products that run real operations — sales,
        support, finance, hiring and logistics — across {aiServices.length} service areas, on the
        systems you already use.
      </p>

      <!-- CTA Buttons -->
      <div
        class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16"
        data-anime="fade-up"
        data-anime-delay="300"
      >
        <a
          href="/ai-services"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-inverse text-on-solid font-semibold px-8 py-4 rounded-xl hover:bg-inverse-muted transition-colors"
        >
          <i class="fa-solid fa-bolt text-amber-bright" aria-hidden="true"></i>
          Explore AI Services
          <i class="fa-solid fa-arrow-right text-sm" aria-hidden="true"></i>
        </a>
        <a
          href="/our-products"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-surface text-fg-secondary font-semibold px-8 py-4 rounded-xl border border-line hover:border-line-strong hover:bg-surface-subtle transition-colors"
        >
          <i class="fa-solid fa-cube text-blue-fg"></i>
          View Products
        </a>
        <a
          href={TOOLS_SITE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gradient-to-r from-indigo to-purple text-on-solid font-semibold px-8 py-4 rounded-xl hover:from-indigo-strong hover:to-purple-strong transition-colors shadow-lg shadow-indigo/25"
        >
          <i class="fa-solid fa-toolbox"></i>
          Free Tools
          <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>

      <!-- Stats Row -->
      <div
        class="grid grid-cols-3 gap-6 max-w-xl mx-auto mb-20"
        data-anime-stagger="fade-up"
        data-anime-step="100"
      >
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-bold text-fg">1 Week</div>
          <div class="text-sm text-fg-subtle mt-1">Launch Time</div>
        </div>
        <div class="text-center border-x border-line">
          <div class="text-3xl md:text-4xl font-bold text-fg">60%</div>
          <div class="text-sm text-fg-subtle mt-1">Cost Savings</div>
        </div>
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-bold text-fg">99.9%</div>
          <div class="text-sm text-fg-subtle mt-1">Uptime</div>
        </div>
      </div>

      <!-- Scroll Indicator -->
      <div class="flex flex-col items-center gap-2 pt-8">
        <span class="text-fg-subtle text-xs uppercase tracking-widest">Scroll to explore</span>
        <div class="w-6 h-10 border-2 border-line-strong rounded-full flex justify-center">
          <div class="w-1.5 h-3 bg-fg-subtle rounded-full mt-2 animate-scroll-down"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Features Section -->
  <div class="relative z-10 border-t border-line-subtle bg-surface-subtle">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16">
      <div
        class="grid md:grid-cols-2 lg:grid-cols-4 gap-6"
        data-anime-stagger="fade-up"
        data-anime-step="90"
      >
        <!-- Feature 1 -->
        <div class="bg-surface rounded-xl p-6 border border-line-subtle">
          <div class="w-12 h-12 bg-blue-soft rounded-xl flex items-center justify-center mb-4">
            <i class="fa-solid fa-robot text-blue-fg text-xl"></i>
          </div>
          <h3 class="font-semibold text-fg mb-2">AI Agents</h3>
          <p class="text-sm text-fg-muted leading-relaxed">
            Autonomous systems that work 24/7, handling tasks intelligently.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="bg-surface rounded-xl p-6 border border-line-subtle">
          <div class="w-12 h-12 bg-purple-soft rounded-xl flex items-center justify-center mb-4">
            <i class="fa-solid fa-shield-halved text-purple-fg text-xl"></i>
          </div>
          <h3 class="font-semibold text-fg mb-2">Authentication</h3>
          <p class="text-sm text-fg-muted leading-relaxed">
            Complete auth with OAuth 2.0, MFA, and RBAC support.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="bg-surface rounded-xl p-6 border border-line-subtle">
          <div class="w-12 h-12 bg-emerald-soft rounded-xl flex items-center justify-center mb-4">
            <i class="fa-solid fa-cube text-emerald-fg text-xl"></i>
          </div>
          <h3 class="font-semibold text-fg mb-2">SaaS Products</h3>
          <p class="text-sm text-fg-muted leading-relaxed">
            Full-featured B2B and B2B2C platforms ready to deploy.
          </p>
        </div>

        <!-- Feature 4 -->
        <div class="bg-surface rounded-xl p-6 border border-line-subtle">
          <div class="w-12 h-12 bg-amber-soft rounded-xl flex items-center justify-center mb-4">
            <i class="fa-solid fa-code text-amber-fg text-xl"></i>
          </div>
          <h3 class="font-semibold text-fg mb-2">Developer Tools</h3>
          <p class="text-sm text-fg-muted leading-relaxed">
            APIs, SDKs, and infrastructure tools for rapid development.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .grid-pattern-light {
    background-image:
      linear-gradient(color-mix(in srgb, var(--color-indigo) 8%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--color-indigo) 8%, transparent) 1px, transparent 1px);
    background-size: 50px 50px;
    width: 100%;
    height: 100%;
  }

  .glass-stat-light {
    padding: 16px 20px;
    background: color-mix(in srgb, var(--color-surface) 70%, transparent);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-xl);
    border: 1px solid color-mix(in srgb, var(--color-surface) 80%, transparent);
    box-shadow: 0 4px 20px color-mix(in srgb, var(--color-scrim) 5%, transparent);
    min-width: 100px;
    text-align: center;
  }

  @keyframes scroll-down {
    0%,
    100% {
      transform: translateY(0);
      opacity: 1;
    }
    50% {
      transform: translateY(8px);
      opacity: 0.5;
    }
  }

  .animate-scroll-down {
    animation: scroll-down 2s ease-in-out infinite;
  }

  @media (max-width: 1024px) {
    .glass-stat-light {
      min-width: 80px;
      padding: 12px;
    }
    .glass-stat-light > div:first-child {
      font-size: var(--font-size-2xl);
    }
  }

  /* Info dropdown styles */
  .info-trigger:hover + .info-dropdown,
  .info-dropdown:hover {
    display: block;
  }
</style>

<script is:inline>
  // Info Dropdown Handler
  function initializeInfoDropdown() {
    const infoTrigger = document.querySelector(".info-trigger");
    const infoDropdown = document.querySelector(".info-dropdown");

    if (infoTrigger && infoDropdown) {
      infoTrigger.addEventListener("click", (e) => {
        e.stopPropagation();
        infoDropdown.classList.toggle("hidden");
      });

      document.addEventListener("click", () => {
        infoDropdown.classList.add("hidden");
      });

      infoDropdown.addEventListener("click", (e) => {
        e.stopPropagation();
      });
    }
  }

  // Card Rotation Handler
  function initializeCardRotation() {
    const mainCard = document.getElementById("main-glass-card");
    if (!mainCard) return;

    const cardData = [
      {
        icon: "fa-robot",
        gradient: "from-purple to-pink",
        title: "AI Agents",
        description:
          "Autonomous systems that work for you 24/7, handling tasks and making decisions intelligently.",
        features: ["Natural Language Processing", "Multi-Agent Workflows", "Real-time Analytics"],
      },
      {
        icon: "fa-shield-halved",
        gradient: "from-blue to-cyan",
        title: "Exyconn Auth",
        description:
          "Complete authentication and authorization service with OAuth 2.0, MFA, and RBAC support.",
        features: [
          "OAuth 2.0 & OpenID Connect",
          "Multi-Factor Authentication",
          "Role-Based Access Control",
        ],
      },
      {
        icon: "fa-cube",
        gradient: "from-emerald to-teal",
        title: "SaaS Products",
        description: "Full-featured B2B and B2B2C platforms including Spentiva, Sibera, and more.",
        features: [
          "AI-Powered Analytics",
          "Multi-Tenant Architecture",
          "Global Scale Infrastructure",
        ],
      },
      {
        icon: "fa-code",
        gradient: "from-orange to-red",
        title: "Developer Tools",
        description: "MCP servers, design systems, and infrastructure tools for rapid development.",
        features: ["API-First Architecture", "Component Libraries", "CI/CD Integration"],
      },
      {
        icon: "fa-comment-dots",
        gradient: "from-cyan to-blue",
        title: "Conversational AI",
        description:
          "Voice agents and WhatsApp automation that answer, qualify and book around the clock.",
        features: ["AI Voice Agents", "WhatsApp Business API", "Human Handover"],
      },
      {
        icon: "fa-chart-line",
        gradient: "from-violet to-purple",
        title: "Analytics & Insights",
        description: "Real-time business intelligence with AI-powered predictive analytics.",
        features: ["Real-Time Dashboards", "Predictive Models", "Custom Reports"],
      },
      {
        icon: "fa-cloud",
        gradient: "from-sky to-indigo",
        title: "Cloud Infrastructure",
        description:
          "Scalable cloud solutions with auto-scaling, load balancing, and global CDN distribution.",
        features: ["Auto-Scaling", "Load Balancing", "Global CDN Network"],
      },
      {
        icon: "fa-lock",
        gradient: "from-red to-rose",
        title: "Security & Compliance",
        description:
          "Enterprise-grade security with SOC 2, GDPR compliance, and advanced threat protection.",
        features: ["SOC 2 Certified", "GDPR Compliant", "DDoS Protection"],
      },
      {
        icon: "fa-database",
        gradient: "from-green to-emerald",
        title: "Data Management",
        description:
          "Advanced data storage, backup solutions, and real-time synchronization across platforms.",
        features: ["Automated Backups", "Real-time Sync", "Data Encryption"],
      },
      {
        icon: "fa-gear",
        gradient: "from-amber to-orange",
        title: "Workflow Automation",
        description:
          "Streamline operations with intelligent automation, triggers, and custom workflow builders.",
        features: ["Custom Workflows", "Event Triggers", "Integration APIs"],
      },
    ];

    const contentDiv = mainCard.querySelector(".card-content");
    if (!contentDiv) return;

    let currentCardIndex = 0;
    let rotationTimer = null;

    function updateCard() {
      const card = cardData[currentCardIndex];
      contentDiv.style.opacity = "0";
      contentDiv.style.transform = "scale(0.95)";

      setTimeout(() => {
        contentDiv.innerHTML = `
          <div>
            <div class="w-14 h-14 bg-gradient-to-br ${card.gradient} rounded-2xl flex items-center justify-center mb-4 shadow-lg">
              <i class="fa-solid ${card.icon} text-on-solid text-xl"></i>
            </div>
            <h3 class="text-fg font-bold text-xl">${card.title}</h3>
            <p class="text-fg-subtle text-sm mt-2">${card.description}</p>
          </div>
          <div class="space-y-3">
            ${card.features
              .map(
                (f) => `
              <div class="flex items-center gap-3 text-fg-muted">
                <i class="fa-solid fa-check-circle text-green-fg"></i>
                <span class="text-sm">${f}</span>
              </div>
            `
              )
              .join("")}
          </div>
        `;

        setTimeout(() => {
          contentDiv.style.opacity = "1";
          contentDiv.style.transform = "scale(1)";
        }, 50);
      }, 300);
    }

    contentDiv.style.transition = "opacity 0.3s ease, transform 0.3s ease";

    function startRotation() {
      rotationTimer = setInterval(() => {
        currentCardIndex = (currentCardIndex + 1) % cardData.length;
        updateCard();
      }, 3000);
    }

    startRotation();

    mainCard.addEventListener("mouseenter", () => {
      if (rotationTimer) clearInterval(rotationTimer);
    });

    mainCard.addEventListener("mouseleave", startRotation);
  }

  // Initialize when DOM is ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      initializeInfoDropdown();
      initializeCardRotation();
    });
  } else {
    initializeInfoDropdown();
    initializeCardRotation();
  }
</script>
