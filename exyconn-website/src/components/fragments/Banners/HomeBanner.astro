---
// Clean, Professional Home Banner
import { aiServices } from "../../../lib/services/aiServices";
---

<section class="relative bg-white overflow-hidden">
  <!-- Simple Background Pattern -->
  <div class="absolute inset-0 bg-gradient-to-b from-gray-50 to-white"></div>
  <div
    class="absolute inset-0 opacity-[0.03]"
    style='background-image: url(&apos;data:image/svg+xml,%3Csvg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="none" fill-rule="evenodd"%3E%3Cg fill="%23000000" fill-opacity="1"%3E%3Cpath d="M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&apos;);'
  >
  </div>

  <!-- Main Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 py-15 lg:py-15">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Badge -->
      <div
        class="inline-flex items-center gap-2 bg-gray-100 rounded-full px-4 py-2 mb-8"
        data-anime="fade-up"
      >
        <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
        <span class="text-gray-700 text-sm font-medium">AI Products &amp; Services</span>
      </div>

      <!-- Headline -->
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight mb-6"
        data-anime="fade-up"
        data-anime-delay="100"
      >
        AI That Does the Work.{" "}
        <span class="block text-gray-500 mt-2">Not Just the Talking.</span>
      </h1>

      <!-- Description -->
      <p
        class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto mb-10 leading-relaxed"
        data-anime="fade-up"
        data-anime-delay="200"
      >
        We build AI agents, automation and vertical AI products that run real operations — sales,
        support, finance, hiring and logistics — across {aiServices.length} service areas, on the
        systems you already use.
      </p>

      <!-- CTA Buttons -->
      <div
        class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16"
        data-anime="fade-up"
        data-anime-delay="300"
      >
        <a
          href="/ai-services"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gray-900 text-white font-semibold px-8 py-4 rounded-xl hover:bg-gray-800 transition-colors"
        >
          <i class="fa-solid fa-bolt text-amber-400" aria-hidden="true"></i>
          Explore AI Services
          <i class="fa-solid fa-arrow-right text-sm" aria-hidden="true"></i>
        </a>
        <a
          href="/our-products"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white text-gray-700 font-semibold px-8 py-4 rounded-xl border border-gray-200 hover:border-gray-300 hover:bg-gray-50 transition-colors"
        >
          <i class="fa-solid fa-cube text-blue-600"></i>
          View Products
        </a>
        <a
          href="/tools"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gradient-to-r from-indigo-500 to-purple-500 text-white font-semibold px-8 py-4 rounded-xl hover:from-indigo-600 hover:to-purple-600 transition-colors shadow-lg shadow-indigo-500/25"
        >
          <i class="fa-solid fa-toolbox"></i>
          Free Tools
          <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>

      <!-- Stats Row -->
      <div
        class="grid grid-cols-3 gap-6 max-w-xl mx-auto mb-20"
        data-anime-stagger="fade-up"
        data-anime-step="100"
      >
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-bold text-gray-900">1 Week</div>
          <div class="text-sm text-gray-500 mt-1">Launch Time</div>
        </div>
        <div class="text-center border-x border-gray-200">
          <div class="text-3xl md:text-4xl font-bold text-gray-900">60%</div>
          <div class="text-sm text-gray-500 mt-1">Cost Savings</div>
        </div>
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-bold text-gray-900">99.9%</div>
          <div class="text-sm text-gray-500 mt-1">Uptime</div>
        </div>
      </div>

      <!-- Scroll Indicator -->
      <div class="flex flex-col items-center gap-2 pt-8">
        <span class="text-gray-500 text-xs uppercase tracking-widest">Scroll to explore</span>
        <div class="w-6 h-10 border-2 border-gray-400 rounded-full flex justify-center">
          <div class="w-1.5 h-3 bg-gray-500 rounded-full mt-2 animate-scroll-down"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Features Section -->
  <div class="relative z-10 border-t border-gray-100 bg-gray-50">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16">
      <div
        class="grid md:grid-cols-2 lg:grid-cols-4 gap-6"
        data-anime-stagger="fade-up"
        data-anime-step="90"
      >
        <!-- Feature 1 -->
        <div class="bg-white rounded-xl p-6 border border-gray-100">
          <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mb-4">
            <i class="fa-solid fa-robot text-blue-600 text-xl"></i>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">AI Agents</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Autonomous systems that work 24/7, handling tasks intelligently.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="bg-white rounded-xl p-6 border border-gray-100">
          <div class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center mb-4">
            <i class="fa-solid fa-shield-halved text-purple-600 text-xl"></i>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Authentication</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Complete auth with OAuth 2.0, MFA, and RBAC support.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="bg-white rounded-xl p-6 border border-gray-100">
          <div class="w-12 h-12 bg-emerald-100 rounded-xl flex items-center justify-center mb-4">
            <i class="fa-solid fa-cube text-emerald-600 text-xl"></i>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">SaaS Products</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Full-featured B2B and B2B2C platforms ready to deploy.
          </p>
        </div>

        <!-- Feature 4 -->
        <div class="bg-white rounded-xl p-6 border border-gray-100">
          <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center mb-4">
            <i class="fa-solid fa-code text-amber-600 text-xl"></i>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Developer Tools</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            APIs, SDKs, and infrastructure tools for rapid development.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .grid-pattern-light {
    background-image:
      linear-gradient(rgba(99, 102, 241, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(99, 102, 241, 0.08) 1px, transparent 1px);
    background-size: 50px 50px;
    width: 100%;
    height: 100%;
  }

  .glass-stat-light {
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(10px);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    min-width: 100px;
    text-align: center;
  }

  @keyframes scroll-down {
    0%,
    100% {
      transform: translateY(0);
      opacity: 1;
    }
    50% {
      transform: translateY(8px);
      opacity: 0.5;
    }
  }

  .animate-scroll-down {
    animation: scroll-down 2s ease-in-out infinite;
  }

  @media (max-width: 1024px) {
    .glass-stat-light {
      min-width: 80px;
      padding: 12px;
    }
    .glass-stat-light > div:first-child {
      font-size: 1.5rem;
    }
  }

  /* Info dropdown styles */
  .info-trigger:hover + .info-dropdown,
  .info-dropdown:hover {
    display: block;
  }
</style>

<script is:inline>
  // Info Dropdown Handler
  function initializeInfoDropdown() {
    const infoTrigger = document.querySelector(".info-trigger");
    const infoDropdown = document.querySelector(".info-dropdown");

    if (infoTrigger && infoDropdown) {
      infoTrigger.addEventListener("click", (e) => {
        e.stopPropagation();
        infoDropdown.classList.toggle("hidden");
      });

      document.addEventListener("click", () => {
        infoDropdown.classList.add("hidden");
      });

      infoDropdown.addEventListener("click", (e) => {
        e.stopPropagation();
      });
    }
  }

  // Card Rotation Handler
  function initializeCardRotation() {
    const mainCard = document.getElementById("main-glass-card");
    if (!mainCard) return;

    const cardData = [
      {
        icon: "fa-robot",
        gradient: "from-purple-500 to-pink-500",
        title: "AI Agents",
        description:
          "Autonomous systems that work for you 24/7, handling tasks and making decisions intelligently.",
        features: ["Natural Language Processing", "Multi-Agent Workflows", "Real-time Analytics"],
      },
      {
        icon: "fa-shield-halved",
        gradient: "from-blue-500 to-cyan-500",
        title: "Exyconn Auth",
        description:
          "Complete authentication and authorization service with OAuth 2.0, MFA, and RBAC support.",
        features: [
          "OAuth 2.0 & OpenID Connect",
          "Multi-Factor Authentication",
          "Role-Based Access Control",
        ],
      },
      {
        icon: "fa-cube",
        gradient: "from-emerald-500 to-teal-500",
        title: "SaaS Products",
        description: "Full-featured B2B and B2B2C platforms including Spentiva, Sibera, and more.",
        features: [
          "AI-Powered Analytics",
          "Multi-Tenant Architecture",
          "Global Scale Infrastructure",
        ],
      },
      {
        icon: "fa-code",
        gradient: "from-orange-500 to-red-500",
        title: "Developer Tools",
        description: "MCP servers, design systems, and infrastructure tools for rapid development.",
        features: ["API-First Architecture", "Component Libraries", "CI/CD Integration"],
      },
      {
        icon: "fa-comment-dots",
        gradient: "from-cyan-500 to-blue-500",
        title: "Conversational AI",
        description:
          "Voice agents and WhatsApp automation that answer, qualify and book around the clock.",
        features: ["AI Voice Agents", "WhatsApp Business API", "Human Handover"],
      },
      {
        icon: "fa-chart-line",
        gradient: "from-violet-500 to-purple-500",
        title: "Analytics & Insights",
        description: "Real-time business intelligence with AI-powered predictive analytics.",
        features: ["Real-Time Dashboards", "Predictive Models", "Custom Reports"],
      },
      {
        icon: "fa-cloud",
        gradient: "from-sky-500 to-indigo-500",
        title: "Cloud Infrastructure",
        description:
          "Scalable cloud solutions with auto-scaling, load balancing, and global CDN distribution.",
        features: ["Auto-Scaling", "Load Balancing", "Global CDN Network"],
      },
      {
        icon: "fa-lock",
        gradient: "from-red-500 to-rose-500",
        title: "Security & Compliance",
        description:
          "Enterprise-grade security with SOC 2, GDPR compliance, and advanced threat protection.",
        features: ["SOC 2 Certified", "GDPR Compliant", "DDoS Protection"],
      },
      {
        icon: "fa-database",
        gradient: "from-green-500 to-emerald-500",
        title: "Data Management",
        description:
          "Advanced data storage, backup solutions, and real-time synchronization across platforms.",
        features: ["Automated Backups", "Real-time Sync", "Data Encryption"],
      },
      {
        icon: "fa-gear",
        gradient: "from-amber-500 to-orange-500",
        title: "Workflow Automation",
        description:
          "Streamline operations with intelligent automation, triggers, and custom workflow builders.",
        features: ["Custom Workflows", "Event Triggers", "Integration APIs"],
      },
    ];

    const contentDiv = mainCard.querySelector(".card-content");
    if (!contentDiv) return;

    let currentCardIndex = 0;
    let rotationTimer = null;

    function updateCard() {
      const card = cardData[currentCardIndex];
      contentDiv.style.opacity = "0";
      contentDiv.style.transform = "scale(0.95)";

      setTimeout(() => {
        contentDiv.innerHTML = `
          <div>
            <div class="w-14 h-14 bg-gradient-to-br ${card.gradient} rounded-2xl flex items-center justify-center mb-4 shadow-lg">
              <i class="fa-solid ${card.icon} text-white text-xl"></i>
            </div>
            <h3 class="text-gray-900 font-bold text-xl">${card.title}</h3>
            <p class="text-gray-500 text-sm mt-2">${card.description}</p>
          </div>
          <div class="space-y-3">
            ${card.features
              .map(
                (f) => `
              <div class="flex items-center gap-3 text-gray-600">
                <i class="fa-solid fa-check-circle text-green-500"></i>
                <span class="text-sm">${f}</span>
              </div>
            `
              )
              .join("")}
          </div>
        `;

        setTimeout(() => {
          contentDiv.style.opacity = "1";
          contentDiv.style.transform = "scale(1)";
        }, 50);
      }, 300);
    }

    contentDiv.style.transition = "opacity 0.3s ease, transform 0.3s ease";

    function startRotation() {
      rotationTimer = setInterval(() => {
        currentCardIndex = (currentCardIndex + 1) % cardData.length;
        updateCard();
      }, 3000);
    }

    startRotation();

    mainCard.addEventListener("mouseenter", () => {
      if (rotationTimer) clearInterval(rotationTimer);
    });

    mainCard.addEventListener("mouseleave", startRotation);
  }

  // Initialize when DOM is ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      initializeInfoDropdown();
      initializeCardRotation();
    });
  } else {
    initializeInfoDropdown();
    initializeCardRotation();
  }
</script>
