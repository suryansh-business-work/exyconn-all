---
const {
  title = "Lorem Ipsum Dolor Sit Amet",
  subtitle = "Lorem Ipsum for Modern Business",
  description = "Discover how lorem-driven workflows can automate, optimize, and scale your business processes. From data collection to actionable insights, streamline every step for maximum efficiency and growth.",
  image = "https://images.unsplash.com/photo-1521737711867-e3b97375f902?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=1587&q=80",
  ctaText = "Contact Us",
  ctaHref = "#contact",
} = Astro.props;
---

<section
  class="relative w-full py-20 lg:py-28 px-6 bg-gradient-to-br from-slate-50 via-blue-50/40 to-indigo-50 overflow-hidden"
>
  <!-- Background Decorations -->
  <div
    class="absolute top-0 right-0 w-96 h-96 bg-gradient-to-br from-blue-200/30 to-purple-200/30 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-80 h-80 bg-gradient-to-tr from-cyan-200/30 to-blue-200/30 rounded-full blur-3xl translate-y-1/2 -translate-x-1/3"
  >
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left - Content -->
      <div class="space-y-6">
        <!-- Badge -->
        <span
          class="inline-flex items-center gap-2 bg-white border border-gray-200 text-gray-700 text-sm font-medium px-4 py-2 rounded-full shadow-sm"
        >
          <i class="fa-solid fa-star text-yellow-500 text-xs"></i>
          {subtitle}
        </span>

        <!-- Title -->
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight">
          {title}
        </h1>

        <!-- Description -->
        <p class="text-lg text-gray-600 leading-relaxed max-w-xl">
          {description}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4 pt-4">
          <a
            href={ctaHref}
            class="inline-flex items-center gap-2 bg-gray-900 text-white font-semibold px-7 py-4 rounded-full hover:bg-gray-800 transition-all duration-300 shadow-lg shadow-gray-900/20"
          >
            {ctaText}
            <i class="fa-solid fa-arrow-right"></i>
          </a>
          <a
            href="/get-a-quote"
            class="inline-flex items-center gap-2 bg-white border border-gray-200 text-gray-900 font-semibold px-7 py-4 rounded-full hover:bg-gray-50 transition-all duration-300 shadow-sm"
          >
            <i class="fa-solid fa-calculator"></i>
            Get a Quote
          </a>
        </div>
      </div>

      <!-- Right - Image -->
      <div class="relative">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl shadow-gray-200/60">
          <img
            class="w-full h-[350px] md:h-[450px] object-cover"
            src={image}
            alt={title}
            loading="lazy"
          />
          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
        </div>

        <!-- Floating Stats Card -->
        <div
          class="absolute -bottom-6 -left-6 bg-white rounded-2xl p-5 shadow-xl border border-gray-100 hidden lg:block"
        >
          <div class="flex items-center gap-4">
            <div
              class="w-12 h-12 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center"
            >
              <i class="fa-solid fa-check text-white"></i>
            </div>
            <div>
              <div class="text-2xl font-bold text-gray-900">100+</div>
              <div class="text-sm text-gray-500">Projects Delivered</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
