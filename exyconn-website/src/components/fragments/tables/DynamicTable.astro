---
const {
  title = "Dynamic Table",
  headers = ["Column 1", "Column 2"],
  rows = [
    ["Row 1, Col 1", "Row 1, Col 2"],
    ["Row 2, Col 1", "Row 2, Col 2"],
    ["Row 3, Col 1", "Row 3, Col 2"],
  ],
} = Astro.props;
---

<section class="max-w-5xl mx-auto px-4 py-12">
  <h2 class="text-2xl font-bold text-cyan-700 mb-8 text-center">
    {title}
  </h2>
  <div class="overflow-x-auto">
    <table
      class="min-w-full bg-gradient-to-br from-white via-cyan-50 to-indigo-50 rounded-2xl shadow-xl text-left border-separate border-spacing-0"
    >
      <thead>
        <tr>
          {
            headers.map((header: unknown, idx: number) => (
              <th
                class={`px-6 py-4 font-semibold text-lg ${
                  idx === 0
                    ? "bg-cyan-500/90 text-white rounded-tl-2xl"
                    : idx === headers.length - 1
                      ? "bg-indigo-500/90 text-white rounded-tr-2xl"
                      : "bg-cyan-400/90 text-white"
                }`}
              >
                {header}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody class="text-base">
        {
          rows.map((row: unknown[], rowIdx: number) => (
            <tr class={rowIdx % 2 === 1 ? "bg-white/70" : "bg-cyan-50/60"}>
              {row.map((cell: unknown, _cellIdx: number) => (
                <td class="px-6 py-4 border-t align-top border-gray-100">
                  <span class="text-gray-800">{cell}</span>
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
