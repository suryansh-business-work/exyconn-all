---
// Modern Newsletter Design - Light Theme
import CaptchaBlock from "../forms/shared/CaptchaBlock.astro";
---

<section class="py-20 lg:py-28 bg-blue-subtle relative overflow-hidden">
  <!-- Background Elements -->
  <div class="absolute inset-0 pattern-plus bg-indigo/5"></div>

  <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-8">
    <div class="text-center">
      <!-- Icon -->
      <div
        class="inline-flex items-center justify-center w-16 h-16 bg-purple-deep rounded-2xl mb-6 shadow-lg shadow-purple/20"
      >
        <i class="fa-solid fa-envelope-open-text text-on-solid text-2xl"></i>
      </div>

      <!-- Heading -->
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-fg mb-4">
        Follow Us for <span class="text-blue-fg">More Updates</span>
      </h2>
      <p class="text-fg-muted text-lg max-w-xl mx-auto mb-10">
        Stay ahead with the latest in AI, technology trends, and exclusive insights delivered
        straight to your inbox.
      </p>

      <!-- Newsletter Form -->
      <form id="newsletter-form" class="flex flex-col gap-4 max-w-xl mx-auto">
        <div class="flex flex-col sm:flex-row gap-4">
          <div class="flex-1 relative">
            <label for="newsletter-email" class="sr-only">Email address</label>
            <input
              type="email"
              id="newsletter-email"
              autocomplete="email"
              placeholder="Enter your email address"
              class="w-full px-6 py-4 bg-surface border border-line rounded-2xl text-fg placeholder-fg-faint focus:outline-none focus:border-purple focus:ring-2 focus:ring-purple/20 transition-all shadow-sm"
              required
            />
          </div>
          <button
            type="submit"
            id="newsletter-btn"
            class="cursor-pointer inline-flex items-center justify-center gap-2 bg-purple-strong text-on-solid font-semibold px-8 py-4 rounded-2xl hover:opacity-90 transition-all duration-300 shadow-lg shadow-purple/20 whitespace-nowrap"
          >
            Subscribe
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </button>
        </div>
        <CaptchaBlock id="newsletter" />
      </form>

      <!-- Success/Error Messages -->
      <div
        id="newsletter-success"
        role="status"
        class="hidden mt-4 p-4 bg-green-subtle border border-green-muted rounded-xl text-green-fg-strong text-sm flex items-center justify-center gap-2 max-w-xl mx-auto"
      >
        <i class="fa-solid fa-check-circle"></i>
        <span>Thank you for subscribing! You'll receive our updates soon.</span>
      </div>
      <div
        id="newsletter-error"
        role="alert"
        class="hidden mt-4 p-4 bg-red-subtle border border-red-muted rounded-xl text-red-fg-strong text-sm flex items-center justify-center gap-2 max-w-xl mx-auto"
      >
        <i class="fa-solid fa-exclamation-circle"></i>
        <span>Something went wrong. Please try again.</span>
      </div>

      <!-- Benefits -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-8 text-sm text-fg-subtle">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-check-circle text-green-fg"></i>
          <span>Weekly AI Insights</span>
        </div>
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-check-circle text-green-fg"></i>
          <span>Product Updates</span>
        </div>
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-check-circle text-green-fg"></i>
          <span>Exclusive Content</span>
        </div>
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-check-circle text-green-fg"></i>
          <span>No Spam, Ever</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountCaptcha } from "../../lib/captcha-dom";

  document.addEventListener("DOMContentLoaded", () => {
    const captcha = mountCaptcha(document, "newsletter");
    const form = document.getElementById("newsletter-form") as HTMLFormElement;
    const emailInput = document.getElementById("newsletter-email") as HTMLInputElement;
    const btn = document.getElementById("newsletter-btn") as HTMLButtonElement;
    const successMsg = document.getElementById("newsletter-success");
    const errorMsg = document.getElementById("newsletter-error");

    if (form && emailInput && btn && successMsg && errorMsg && captcha) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const email = emailInput.value.trim();
        if (!email) return;

        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Subscribing...';
        successMsg.classList.add("hidden");
        errorMsg.classList.add("hidden");

        try {
          // A wrong security answer is shown under the question itself.
          if ((await captcha.send("newsletter", { email })) === "sent") {
            successMsg.classList.remove("hidden");
            emailInput.value = "";
          }
        } catch {
          errorMsg.classList.remove("hidden");
        } finally {
          btn.disabled = false;
          btn.innerHTML = 'Subscribe <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>';
        }
      });
    }
  });
</script>
