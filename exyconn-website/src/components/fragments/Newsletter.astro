---
/**
 * The newsletter row at the top of the night footer: kicker, title and the sign-up form with
 * its security question. Copy lives in lib/chrome/newsletter.ts.
 */
import CaptchaBlock from "../forms/shared/CaptchaBlock.astro";
import Icon from "../inner/Icon.astro";
import { NEWSLETTER_COPY as copy } from "../../lib/chrome/newsletter";
---

<section
  class="chrome-shell grid gap-8 py-12 lg:grid-cols-2 lg:gap-16 lg:py-16"
  aria-labelledby="newsletter-title"
>
  <div>
    <p class="stage-label">{copy.label}</p>
    <div class="stage-rule max-w-xs mt-3 mb-5" aria-hidden="true"></div>
    <h2 id="newsletter-title" class="stage-title chrome-newsletter__title">{copy.title}</h2>
    <p class="mt-4 max-w-lg text-fg-secondary leading-relaxed">{copy.text}</p>
    <ul class="mt-5 flex flex-wrap gap-2" aria-label="What you get">
      {
        copy.benefits.map((benefit) => (
          <li class="inline-flex items-center gap-2 rounded-full border border-line-strong px-3 py-1 text-xs text-fg-secondary">
            <Icon name="check-circle" class="icon-xs text-cyan-bright" />
            {benefit}
          </li>
        ))
      }
    </ul>
  </div>
  <div class="lg:pt-8">
    <form id="newsletter-form" class="grid gap-3">
      <label for="newsletter-email" class="text-sm font-semibold text-fg-secondary">
        {copy.emailLabel}
      </label>
      <div class="flex flex-col gap-3 sm:flex-row">
        <input
          type="email"
          id="newsletter-email"
          autocomplete="email"
          placeholder={copy.placeholder}
          class="chrome-field flex-1"
          required
        />
        <button
          type="submit"
          id="newsletter-btn"
          class="chrome-button chrome-button--solid group px-6"
          data-busy="false"
        >
          <span class="group-data-[busy=true]:hidden">{copy.submit}</span>
          <span class="hidden group-data-[busy=true]:inline">{copy.busy}</span>
          <Icon name="arrow-right" class="icon-xs group-data-[busy=true]:hidden" />
          <Icon
            name="spinner"
            class="icon-xs hidden animate-spin group-data-[busy=true]:inline-block"
          />
        </button>
      </div>
      <CaptchaBlock id="newsletter" />
    </form>
    <p
      id="newsletter-success"
      role="status"
      class="mt-3 flex items-center gap-2 text-sm text-green-bright"
      hidden
    >
      <Icon name="check-circle" class="icon-sm" />
      {copy.success}
    </p>
    <p
      id="newsletter-error"
      role="alert"
      class="mt-3 flex items-center gap-2 text-sm text-red-bright"
      hidden
    >
      <Icon name="alert-circle" class="icon-sm" />
      {copy.error}
    </p>
  </div>
</section>

<script>
  import "../../scripts/chrome/newsletter";
</script>
