---
// Modern Newsletter Design - Light Theme
---

<section
  class="py-20 lg:py-28 bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 relative overflow-hidden"
>
  <!-- Background Elements -->
  <div class="absolute inset-0 opacity-40">
    <div class="absolute top-0 left-1/4 w-72 h-72 bg-purple-300 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-72 h-72 bg-blue-300 rounded-full blur-3xl"></div>
  </div>
  <div
    class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=%2260%22 height=%2260%22 viewBox=%220 0 60 60%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cg fill=%22none%22 fill-rule=%22evenodd%22%3E%3Cg fill=%22%236366f1%22 fill-opacity=%220.05%22%3E%3Cpath d=%22M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z%22/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')]"
  >
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-8">
    <div class="text-center">
      <!-- Icon -->
      <div
        class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-purple-500 to-pink-500 rounded-2xl mb-6 shadow-lg shadow-purple-500/20"
      >
        <i class="fa-solid fa-envelope-open-text text-white text-2xl"></i>
      </div>

      <!-- Heading -->
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        Follow Us for <span
          class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent"
          >More Updates</span
        >
      </h2>
      <p class="text-gray-600 text-lg max-w-xl mx-auto mb-10">
        Stay ahead with the latest in AI, technology trends, and exclusive insights delivered
        straight to your inbox.
      </p>

      <!-- Newsletter Form -->
      <form id="newsletter-form" class="flex flex-col sm:flex-row gap-4 max-w-xl mx-auto">
        <div class="flex-1 relative">
          <input
            type="email"
            id="newsletter-email"
            placeholder="Enter your email address"
            class="w-full px-6 py-4 bg-white border border-gray-200 rounded-2xl text-gray-900 placeholder-gray-400 focus:outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-400/20 transition-all shadow-sm"
            required
          />
        </div>
        <button
          type="submit"
          id="newsletter-btn"
          class="cursor-pointer inline-flex items-center justify-center gap-2 bg-gradient-to-r from-purple-600 to-pink-500 text-white font-semibold px-8 py-4 rounded-2xl hover:opacity-90 transition-all duration-300 shadow-lg shadow-purple-500/20 whitespace-nowrap"
        >
          Subscribe
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </form>

      <!-- Success/Error Messages -->
      <div
        id="newsletter-success"
        class="hidden mt-4 p-4 bg-green-50 border border-green-200 rounded-xl text-green-700 text-sm flex items-center justify-center gap-2 max-w-xl mx-auto"
      >
        <i class="fa-solid fa-check-circle"></i>
        <span>Thank you for subscribing! You'll receive our updates soon.</span>
      </div>
      <div
        id="newsletter-error"
        class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm flex items-center justify-center gap-2 max-w-xl mx-auto"
      >
        <i class="fa-solid fa-exclamation-circle"></i>
        <span>Something went wrong. Please try again.</span>
      </div>

      <!-- Benefits -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-8 text-sm text-gray-500">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-check-circle text-green-500"></i>
          <span>Weekly AI Insights</span>
        </div>
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-check-circle text-green-500"></i>
          <span>Product Updates</span>
        </div>
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-check-circle text-green-500"></i>
          <span>Exclusive Content</span>
        </div>
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-check-circle text-green-500"></i>
          <span>No Spam, Ever</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("newsletter-form") as HTMLFormElement;
    const emailInput = document.getElementById("newsletter-email") as HTMLInputElement;
    const btn = document.getElementById("newsletter-btn") as HTMLButtonElement;
    const successMsg = document.getElementById("newsletter-success");
    const errorMsg = document.getElementById("newsletter-error");

    if (form && emailInput && btn && successMsg && errorMsg) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const email = emailInput.value.trim();
        if (!email) return;

        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Subscribing...';
        successMsg.classList.add("hidden");
        errorMsg.classList.add("hidden");

        try {
          const res = await fetch("/api/form-submit", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ formType: "newsletter", email }),
          });
          if (!res.ok) throw new Error("Failed");
          successMsg.classList.remove("hidden");
          emailInput.value = "";
        } catch {
          errorMsg.classList.remove("hidden");
        } finally {
          btn.disabled = false;
          btn.innerHTML = 'Subscribe <i class="fa-solid fa-arrow-right"></i>';
        }
      });
    }
  });
</script>
