---
/**
 * Accessibility options in a drawer from the right (scripts/chrome/drawer.ts), opened from the
 * header's accessibility button or the phone menu: text size and six display toggles, kept
 * in localStorage by scripts/chrome/a11y-preferences.ts and applied to <html> as
 * data-a11y-* attributes (the effects are in styles/chrome-a11y.css).
 */
import DrawerHead from "./header-and-footer/DrawerHead.astro";
import Icon from "./inner/Icon.astro";
import { A11Y_TOGGLES, DEFAULT_FONT } from "../lib/chrome/preferences";
import "../styles/chrome-a11y.css";

const FONT_BUTTONS = [
  { action: "dec", label: "Decrease text size", icon: "minus" },
  { action: "reset", label: "Default text size", icon: undefined },
  { action: "inc", label: "Increase text size", icon: "plus" },
] as const;
---

<div class="chrome-backdrop" data-drawer-backdrop="a11y-drawer" data-open="false"></div>
<aside
  id="a11y-drawer"
  class="chrome-drawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="a11y-drawer-title"
  tabindex="-1"
  data-open="false"
  inert
>
  <DrawerHead
    drawerId="a11y-drawer"
    titleId="a11y-drawer-title"
    label="Your view"
    title="Accessibility"
    closeLabel="Close accessibility options"
  />

  <div class="chrome-drawer__body grid content-start gap-6">
    <section aria-labelledby="a11y-text-size">
      <div class="mb-3 flex items-center justify-between">
        <h3 id="a11y-text-size" class="chrome-option__label">Text size</h3>
        <span id="a11y-font-label" class="stage-label" aria-live="polite">{DEFAULT_FONT}%</span>
      </div>
      <div class="grid grid-cols-3 gap-2">
        {
          FONT_BUTTONS.map((button) => (
            <button
              type="button"
              class="chrome-button"
              data-a11y-font={button.action}
              aria-label={button.label}
            >
              {button.icon ? <Icon name={button.icon} /> : "Default"}
            </button>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="a11y-visual">
      <h3 id="a11y-visual" class="chrome-option__label mb-3">Visual adjustments</h3>
      <ul class="grid gap-2">
        {
          A11Y_TOGGLES.map((toggle) => (
            <li>
              <label class="chrome-option">
                <span>
                  <span class="chrome-option__label">{toggle.label}</span>
                  <span class="chrome-option__text">{toggle.text}</span>
                </span>
                <input type="checkbox" class="chrome-switch" data-a11y-toggle={toggle.id} />
              </label>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <div class="chrome-drawer__foot">
    <button id="a11y-reset-btn" type="button" class="chrome-button">
      <Icon name="reset" class="icon-sm" />
      Reset all
    </button>
    <a href="/contact" class="chrome-button chrome-button--solid">Get help</a>
  </div>
</aside>

<script>
  import "../scripts/chrome/a11y-preferences";
</script>
