---
import Page from "../../layouts/Page.astro";
---

<Page
  metaTitle="AI Platform | Agentic AI, LLMs & Automation | Exyconn"
  metaDescription="Deploy production-ready AI solutions with Exyconn's AI Platform. Agentic AI agents, custom LLM training, workflow automation, and MCP server infrastructure for enterprise scale."
  metaKeywords="AI platform, agentic AI, LLM training, AI automation, workflow AI, MCP server, enterprise AI, Exyconn"
  metaImage="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=1200&q=80"
>
  <!-- Hero Section - Light Background -->
  <section
    class="relative min-h-[70vh] bg-gradient-to-br from-blue-subtle via-surface to-purple-subtle flex items-center overflow-hidden"
  >
    <!-- Animated Background -->
    <div class="absolute inset-0 overflow-hidden">
      <div
        class="absolute top-20 right-20 w-96 h-96 bg-gradient-to-r from-cyan-muted/40 to-blue-muted/40 rounded-full blur-3xl animate-pulse"
      >
      </div>
      <div
        class="absolute bottom-10 left-10 w-80 h-80 bg-gradient-to-r from-indigo-muted/30 to-purple-muted/30 rounded-full blur-3xl animate-pulse"
        style="animation-delay: 1s;"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-to-r from-cyan-soft/30 to-indigo-soft/30 rounded-full blur-3xl"
      >
      </div>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto text-center py-24 px-6">
      <span
        class="inline-flex items-center gap-2 px-4 py-2 bg-surface border border-line rounded-full text-sm font-semibold text-blue-fg mb-6 shadow-sm animate-fade-in"
      >
        <i class="fa-solid fa-microchip"></i>
        Enterprise AI Platform
      </span>
      <h1 class="text-5xl md:text-7xl font-black mb-6 tracking-tight leading-tight animate-fade-in">
        <span class="text-fg">AI That Works.</span>
        <br />
        <span
          class="bg-gradient-to-r from-blue-strong via-cyan to-purple-strong bg-clip-text text-transparent"
          >Day One.</span
        >
      </h1>
      <p
        class="text-xl md:text-2xl text-fg-muted max-w-3xl mx-auto leading-relaxed mb-10 animate-fade-in"
        style="animation-delay: 0.1s;"
      >
        Deploy autonomous agents, train custom models, and orchestrate intelligent workflows—all
        production-ready and enterprise-secure.
      </p>

      <!-- Key Stats -->
      <div
        class="flex flex-wrap justify-center gap-8 mb-12 animate-fade-in"
        style="animation-delay: 0.2s;"
      >
        <div
          class="text-center bg-surface/80 backdrop-blur-sm rounded-2xl px-6 py-4 border border-line-subtle shadow-sm"
        >
          <div class="text-4xl font-black text-blue-fg">10x</div>
          <div class="text-sm text-fg-muted">Faster Deployment</div>
        </div>
        <div
          class="text-center bg-surface/80 backdrop-blur-sm rounded-2xl px-6 py-4 border border-line-subtle shadow-sm"
        >
          <div class="text-4xl font-black text-blue-fg">95%</div>
          <div class="text-sm text-fg-muted">Accuracy Rate</div>
        </div>
        <div
          class="text-center bg-surface/80 backdrop-blur-sm rounded-2xl px-6 py-4 border border-line-subtle shadow-sm"
        >
          <div class="text-4xl font-black text-blue-fg">50+</div>
          <div class="text-sm text-fg-muted">Pre-built Agents</div>
        </div>
      </div>

      <div
        class="flex flex-wrap justify-center gap-4 animate-fade-in"
        style="animation-delay: 0.3s;"
      >
        <a
          href="/contact"
          class="inline-flex items-center gap-2 bg-gradient-to-r from-blue-strong to-purple-strong text-on-solid font-semibold px-10 py-4 rounded-full shadow-lg shadow-blue/25 hover:shadow-blue/40 hover:scale-105 transition-all"
        >
          <i class="fa-solid fa-rocket"></i>
          Deploy Your First Agent
        </a>
        <a
          href="/order-agents"
          class="inline-flex items-center gap-2 bg-surface border border-line text-fg font-semibold px-10 py-4 rounded-full hover:bg-surface-subtle hover:border-line-strong transition-all shadow-sm"
        >
          <i class="fa-solid fa-robot"></i>
          Order Pre-built Agents
        </a>
      </div>
    </div>
  </section>

  <!-- AI Capabilities Grid -->
  <section class="py-24 px-4 bg-surface">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span
          class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-subtle border border-indigo-muted rounded-full text-sm font-semibold text-indigo-fg-strong mb-4"
        >
          <i class="fa-solid fa-brain"></i>
          AI Capabilities
        </span>
        <h2 class="text-4xl md:text-5xl font-black text-fg mb-6 tracking-tight">
          The Complete <span
            class="bg-gradient-to-r from-cyan-strong to-indigo-strong bg-clip-text text-transparent"
            >AI Toolkit</span
          >
        </h2>
        <p class="text-xl text-fg-muted max-w-3xl mx-auto">
          Everything you need to build, deploy, and scale intelligent AI systems.
        </p>
      </div>

      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8">
        <!-- Agentic AI -->
        <a
          href="/ai/agentic"
          class="group relative bg-gradient-to-br from-blue-strong to-indigo-deep rounded-3xl p-8 text-on-solid overflow-hidden hover:scale-[1.02] transition-all duration-300"
        >
          <div
            class="absolute top-0 right-0 w-40 h-40 bg-gradient-to-br from-cyan/30 to-blue/30 rounded-full blur-2xl group-hover:opacity-80 transition-opacity"
          >
          </div>
          <div class="relative z-10">
            <div
              class="w-16 h-16 bg-on-solid/20 backdrop-blur-sm rounded-2xl flex items-center justify-center mb-6 shadow-lg group-hover:scale-110 transition-transform"
            >
              <i class="fa-solid fa-robot text-2xl"></i>
            </div>
            <h3 class="font-bold text-2xl mb-3">Agentic AI</h3>
            <p class="text-on-solid-muted mb-6 leading-relaxed">
              Autonomous agents that perceive, decide, and act to achieve business goals. Deploy
              intelligent systems that work 24/7.
            </p>
            <div
              class="flex items-center gap-2 text-on-solid font-semibold group-hover:translate-x-2 transition-transform"
            >
              Learn More <i class="fa-solid fa-arrow-right"></i>
            </div>
          </div>
        </a>

        <!-- Bot Creation -->
        <a
          href="/ai/bot-creation"
          class="group bg-surface rounded-3xl shadow-xl border border-line-subtle p-8 hover:shadow-2xl hover:border-indigo-muted transition-all duration-300"
        >
          <div
            class="w-16 h-16 bg-gradient-to-br from-indigo to-purple-strong rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-indigo/30 group-hover:scale-110 transition-transform"
          >
            <i class="fa-solid fa-comments text-2xl text-on-solid"></i>
          </div>
          <h3 class="font-bold text-2xl text-fg mb-3">Bot Creation</h3>
          <p class="text-fg-muted mb-6 leading-relaxed">
            Build conversational and workflow bots that handle customer support, lead qualification,
            and task automation.
          </p>
          <div
            class="flex items-center gap-2 text-indigo-fg font-semibold group-hover:translate-x-2 transition-transform"
          >
            Learn More <i class="fa-solid fa-arrow-right"></i>
          </div>
        </a>

        <!-- Workflows -->
        <a
          href="/ai/workflows"
          class="group bg-surface rounded-3xl shadow-xl border border-line-subtle p-8 hover:shadow-2xl hover:border-purple-muted transition-all duration-300"
        >
          <div
            class="w-16 h-16 bg-gradient-to-br from-purple to-pink-strong rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-purple/30 group-hover:scale-110 transition-transform"
          >
            <i class="fa-solid fa-diagram-project text-2xl text-on-solid"></i>
          </div>
          <h3 class="font-bold text-2xl text-fg mb-3">AI Workflows</h3>
          <p class="text-fg-muted mb-6 leading-relaxed">
            Automate complex multi-step business processes with intelligent, adaptive workflows
            powered by AI.
          </p>
          <div
            class="flex items-center gap-2 text-purple-fg font-semibold group-hover:translate-x-2 transition-transform"
          >
            Learn More <i class="fa-solid fa-arrow-right"></i>
          </div>
        </a>

        <!-- LLMs -->
        <a
          href="/ai/llms"
          class="group bg-surface rounded-3xl shadow-xl border border-line-subtle p-8 hover:shadow-2xl hover:border-blue-muted transition-all duration-300"
        >
          <div
            class="w-16 h-16 bg-gradient-to-br from-blue to-cyan-strong rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-blue/30 group-hover:scale-110 transition-transform"
          >
            <i class="fa-solid fa-brain text-2xl text-on-solid"></i>
          </div>
          <h3 class="font-bold text-2xl text-fg mb-3">LLM Solutions</h3>
          <p class="text-fg-muted mb-6 leading-relaxed">
            Leverage the power of Large Language Models for text generation, analysis, translation,
            and knowledge retrieval.
          </p>
          <div
            class="flex items-center gap-2 text-blue-fg font-semibold group-hover:translate-x-2 transition-transform"
          >
            Learn More <i class="fa-solid fa-arrow-right"></i>
          </div>
        </a>

        <!-- Custom Model Training -->
        <a
          href="/ai/custom-model-training"
          class="group bg-surface rounded-3xl shadow-xl border border-line-subtle p-8 hover:shadow-2xl hover:border-teal-muted transition-all duration-300"
        >
          <div
            class="w-16 h-16 bg-gradient-to-br from-teal to-emerald-strong rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-teal/30 group-hover:scale-110 transition-transform"
          >
            <i class="fa-solid fa-flask text-2xl text-on-solid"></i>
          </div>
          <h3 class="font-bold text-2xl text-fg mb-3">Custom Training</h3>
          <p class="text-fg-muted mb-6 leading-relaxed">
            Train and fine-tune AI models on your proprietary data for domain-specific accuracy and
            performance.
          </p>
          <div
            class="flex items-center gap-2 text-teal-fg font-semibold group-hover:translate-x-2 transition-transform"
          >
            Learn More <i class="fa-solid fa-arrow-right"></i>
          </div>
        </a>

        <!-- MCP Server -->
        <a
          href="/ai/mcp-server"
          class="group bg-surface rounded-3xl shadow-xl border border-line-subtle p-8 hover:shadow-2xl hover:border-orange-muted transition-all duration-300"
        >
          <div
            class="w-16 h-16 bg-gradient-to-br from-orange to-red rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-orange/30 group-hover:scale-110 transition-transform"
          >
            <i class="fa-solid fa-server text-2xl text-on-solid"></i>
          </div>
          <h3 class="font-bold text-2xl text-fg mb-3">MCP Server</h3>
          <p class="text-fg-muted mb-6 leading-relaxed">
            Deploy and manage AI pipelines with our Model Context Protocol infrastructure for
            enterprise scale.
          </p>
          <div
            class="flex items-center gap-2 text-orange-fg font-semibold group-hover:translate-x-2 transition-transform"
          >
            Learn More <i class="fa-solid fa-arrow-right"></i>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Why Our AI Platform -->
  <section class="py-24 px-4 bg-gradient-to-b from-surface-subtle to-surface">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-black text-fg mb-4">Why Exyconn's AI Platform?</h2>
        <p class="text-xl text-fg-muted max-w-2xl mx-auto">
          Built different. Deployed faster. Scales infinitely.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center">
          <div
            class="w-16 h-16 bg-cyan-soft rounded-2xl flex items-center justify-center mx-auto mb-4"
          >
            <i class="fa-solid fa-bolt text-2xl text-cyan-fg"></i>
          </div>
          <h3 class="font-bold text-lg text-fg mb-2">10x Faster</h3>
          <p class="text-fg-muted text-sm">
            Pre-built components mean you ship in weeks, not months.
          </p>
        </div>
        <div class="text-center">
          <div
            class="w-16 h-16 bg-indigo-soft rounded-2xl flex items-center justify-center mx-auto mb-4"
          >
            <i class="fa-solid fa-shield-halved text-2xl text-indigo-fg"></i>
          </div>
          <h3 class="font-bold text-lg text-fg mb-2">Enterprise Secure</h3>
          <p class="text-fg-muted text-sm">
            SOC 2 compliant with end-to-end encryption and audit logs.
          </p>
        </div>
        <div class="text-center">
          <div
            class="w-16 h-16 bg-emerald-soft rounded-2xl flex items-center justify-center mx-auto mb-4"
          >
            <i class="fa-solid fa-expand text-2xl text-emerald-fg"></i>
          </div>
          <h3 class="font-bold text-lg text-fg mb-2">Infinite Scale</h3>
          <p class="text-fg-muted text-sm">
            Auto-scaling infrastructure handles any workload seamlessly.
          </p>
        </div>
        <div class="text-center">
          <div
            class="w-16 h-16 bg-orange-soft rounded-2xl flex items-center justify-center mx-auto mb-4"
          >
            <i class="fa-solid fa-plug text-2xl text-orange-fg"></i>
          </div>
          <h3 class="font-bold text-lg text-fg mb-2">50+ Integrations</h3>
          <p class="text-fg-muted text-sm">
            Connect with your existing tools and data sources instantly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section
    class="py-24 px-4 bg-gradient-to-br from-inverse via-indigo-night to-inverse relative overflow-hidden"
  >
    <div
      class="absolute top-20 right-20 w-96 h-96 bg-gradient-to-r from-cyan/20 to-blue/20 rounded-full blur-3xl"
    >
    </div>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <h2 class="text-4xl md:text-5xl font-black text-on-solid mb-6">Ready to Deploy AI?</h2>
      <p class="text-xl text-on-solid-muted mb-10 max-w-2xl mx-auto">
        Get your first AI agent running in production within days—not months.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/get-a-quote"
          class="inline-flex items-center gap-2 bg-gradient-to-r from-cyan to-blue-strong text-on-solid font-semibold px-10 py-4 rounded-full shadow-lg shadow-cyan/25 hover:shadow-cyan/40 hover:scale-105 transition-all"
        >
          <i class="fa-solid fa-calculator"></i>
          Get a Quote
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 bg-on-solid/10 backdrop-blur-sm border border-on-solid/30 text-on-solid font-semibold px-10 py-4 rounded-full hover:bg-on-solid/20 transition-all"
        >
          <i class="fa-solid fa-message"></i>
          Talk to an Expert
        </a>
      </div>
    </div>
  </section>

  <style>
    @keyframes fade-in {
      0% {
        opacity: 0;
        transform: translateY(20px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .animate-fade-in {
      animation: fade-in 0.8s cubic-bezier(0.4, 0, 0.2, 1) both;
    }
  </style>
</Page>
