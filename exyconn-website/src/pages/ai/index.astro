---
import Page from "../../layouts/Page.astro";
---

<Page
  metaTitle="AI Platform | Agentic AI, LLMs & Automation | Exyconn"
  metaDescription="Deploy production-ready AI solutions with Exyconn's AI Platform. Agentic AI agents, custom LLM training, workflow automation, and MCP server infrastructure for enterprise scale."
  metaKeywords="AI platform, agentic AI, LLM training, AI automation, workflow AI, MCP server, enterprise AI, Exyconn"
  metaImage="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=1200&q=80"
>
  <!-- Hero Section - Light Background -->
  <section
    class="relative min-h-[70vh] bg-gradient-to-br from-blue-50 via-white to-purple-50 flex items-center overflow-hidden"
  >
    <!-- Animated Background -->
    <div class="absolute inset-0 overflow-hidden">
      <div
        class="absolute top-20 right-20 w-96 h-96 bg-gradient-to-r from-cyan-200/40 to-blue-200/40 rounded-full blur-3xl animate-pulse"
      >
      </div>
      <div
        class="absolute bottom-10 left-10 w-80 h-80 bg-gradient-to-r from-indigo-200/30 to-purple-200/30 rounded-full blur-3xl animate-pulse"
        style="animation-delay: 1s;"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-to-r from-cyan-100/30 to-indigo-100/30 rounded-full blur-3xl"
      >
      </div>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto text-center py-24 px-6">
      <span
        class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-full text-sm font-semibold text-blue-600 mb-6 shadow-sm animate-fade-in"
      >
        <i class="fa-solid fa-microchip"></i>
        Enterprise AI Platform
      </span>
      <h1 class="text-5xl md:text-7xl font-black mb-6 tracking-tight leading-tight animate-fade-in">
        <span class="text-gray-900">AI That Works.</span>
        <br />
        <span
          class="bg-gradient-to-r from-blue-600 via-cyan-500 to-purple-600 bg-clip-text text-transparent"
          >Day One.</span
        >
      </h1>
      <p
        class="text-xl md:text-2xl text-gray-600 max-w-3xl mx-auto leading-relaxed mb-10 animate-fade-in"
        style="animation-delay: 0.1s;"
      >
        Deploy autonomous agents, train custom models, and orchestrate intelligent workflows—all
        production-ready and enterprise-secure.
      </p>

      <!-- Key Stats -->
      <div
        class="flex flex-wrap justify-center gap-8 mb-12 animate-fade-in"
        style="animation-delay: 0.2s;"
      >
        <div
          class="text-center bg-white/80 backdrop-blur-sm rounded-2xl px-6 py-4 border border-gray-100 shadow-sm"
        >
          <div class="text-4xl font-black text-blue-600">10x</div>
          <div class="text-sm text-gray-600">Faster Deployment</div>
        </div>
        <div
          class="text-center bg-white/80 backdrop-blur-sm rounded-2xl px-6 py-4 border border-gray-100 shadow-sm"
        >
          <div class="text-4xl font-black text-blue-600">95%</div>
          <div class="text-sm text-gray-600">Accuracy Rate</div>
        </div>
        <div
          class="text-center bg-white/80 backdrop-blur-sm rounded-2xl px-6 py-4 border border-gray-100 shadow-sm"
        >
          <div class="text-4xl font-black text-blue-600">50+</div>
          <div class="text-sm text-gray-600">Pre-built Agents</div>
        </div>
      </div>

      <div
        class="flex flex-wrap justify-center gap-4 animate-fade-in"
        style="animation-delay: 0.3s;"
      >
        <a
          href="/contact"
          class="inline-flex items-center gap-2 bg-gradient-to-r from-blue-600 to-purple-600 text-white font-semibold px-10 py-4 rounded-full shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40 hover:scale-105 transition-all"
        >
          <i class="fa-solid fa-rocket"></i>
          Deploy Your First Agent
        </a>
        <a
          href="/order-agents"
          class="inline-flex items-center gap-2 bg-white border border-gray-200 text-gray-900 font-semibold px-10 py-4 rounded-full hover:bg-gray-50 hover:border-gray-300 transition-all shadow-sm"
        >
          <i class="fa-solid fa-robot"></i>
          Order Pre-built Agents
        </a>
      </div>
    </div>
  </section>

  <!-- AI Capabilities Grid -->
  <section class="py-24 px-4 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span
          class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-50 border border-indigo-200 rounded-full text-sm font-semibold text-indigo-700 mb-4"
        >
          <i class="fa-solid fa-brain"></i>
          AI Capabilities
        </span>
        <h2 class="text-4xl md:text-5xl font-black text-slate-900 mb-6 tracking-tight">
          The Complete <span
            class="bg-gradient-to-r from-cyan-600 to-indigo-600 bg-clip-text text-transparent"
            >AI Toolkit</span
          >
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Everything you need to build, deploy, and scale intelligent AI systems.
        </p>
      </div>

      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8">
        <!-- Agentic AI -->
        <a
          href="/ai/agentic"
          class="group relative bg-gradient-to-br from-blue-600 to-indigo-700 rounded-3xl p-8 text-white overflow-hidden hover:scale-[1.02] transition-all duration-300"
        >
          <div
            class="absolute top-0 right-0 w-40 h-40 bg-gradient-to-br from-cyan-400/30 to-blue-400/30 rounded-full blur-2xl group-hover:opacity-80 transition-opacity"
          >
          </div>
          <div class="relative z-10">
            <div
              class="w-16 h-16 bg-white/20 backdrop-blur-sm rounded-2xl flex items-center justify-center mb-6 shadow-lg group-hover:scale-110 transition-transform"
            >
              <i class="fa-solid fa-robot text-2xl"></i>
            </div>
            <h3 class="font-bold text-2xl mb-3">Agentic AI</h3>
            <p class="text-blue-100 mb-6 leading-relaxed">
              Autonomous agents that perceive, decide, and act to achieve business goals. Deploy
              intelligent systems that work 24/7.
            </p>
            <div
              class="flex items-center gap-2 text-white font-semibold group-hover:translate-x-2 transition-transform"
            >
              Learn More <i class="fa-solid fa-arrow-right"></i>
            </div>
          </div>
        </a>

        <!-- Bot Creation -->
        <a
          href="/ai/bot-creation"
          class="group bg-white rounded-3xl shadow-xl border border-gray-100 p-8 hover:shadow-2xl hover:border-indigo-200 transition-all duration-300"
        >
          <div
            class="w-16 h-16 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-indigo-500/30 group-hover:scale-110 transition-transform"
          >
            <i class="fa-solid fa-comments text-2xl text-white"></i>
          </div>
          <h3 class="font-bold text-2xl text-slate-900 mb-3">Bot Creation</h3>
          <p class="text-gray-600 mb-6 leading-relaxed">
            Build conversational and workflow bots that handle customer support, lead qualification,
            and task automation.
          </p>
          <div
            class="flex items-center gap-2 text-indigo-600 font-semibold group-hover:translate-x-2 transition-transform"
          >
            Learn More <i class="fa-solid fa-arrow-right"></i>
          </div>
        </a>

        <!-- Workflows -->
        <a
          href="/ai/workflows"
          class="group bg-white rounded-3xl shadow-xl border border-gray-100 p-8 hover:shadow-2xl hover:border-purple-200 transition-all duration-300"
        >
          <div
            class="w-16 h-16 bg-gradient-to-br from-purple-500 to-pink-600 rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-purple-500/30 group-hover:scale-110 transition-transform"
          >
            <i class="fa-solid fa-diagram-project text-2xl text-white"></i>
          </div>
          <h3 class="font-bold text-2xl text-slate-900 mb-3">AI Workflows</h3>
          <p class="text-gray-600 mb-6 leading-relaxed">
            Automate complex multi-step business processes with intelligent, adaptive workflows
            powered by AI.
          </p>
          <div
            class="flex items-center gap-2 text-purple-600 font-semibold group-hover:translate-x-2 transition-transform"
          >
            Learn More <i class="fa-solid fa-arrow-right"></i>
          </div>
        </a>

        <!-- LLMs -->
        <a
          href="/ai/llms"
          class="group bg-white rounded-3xl shadow-xl border border-gray-100 p-8 hover:shadow-2xl hover:border-blue-200 transition-all duration-300"
        >
          <div
            class="w-16 h-16 bg-gradient-to-br from-blue-500 to-cyan-600 rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-blue-500/30 group-hover:scale-110 transition-transform"
          >
            <i class="fa-solid fa-brain text-2xl text-white"></i>
          </div>
          <h3 class="font-bold text-2xl text-slate-900 mb-3">LLM Solutions</h3>
          <p class="text-gray-600 mb-6 leading-relaxed">
            Leverage the power of Large Language Models for text generation, analysis, translation,
            and knowledge retrieval.
          </p>
          <div
            class="flex items-center gap-2 text-blue-600 font-semibold group-hover:translate-x-2 transition-transform"
          >
            Learn More <i class="fa-solid fa-arrow-right"></i>
          </div>
        </a>

        <!-- Custom Model Training -->
        <a
          href="/ai/custom-model-training"
          class="group bg-white rounded-3xl shadow-xl border border-gray-100 p-8 hover:shadow-2xl hover:border-teal-200 transition-all duration-300"
        >
          <div
            class="w-16 h-16 bg-gradient-to-br from-teal-500 to-emerald-600 rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-teal-500/30 group-hover:scale-110 transition-transform"
          >
            <i class="fa-solid fa-flask text-2xl text-white"></i>
          </div>
          <h3 class="font-bold text-2xl text-slate-900 mb-3">Custom Training</h3>
          <p class="text-gray-600 mb-6 leading-relaxed">
            Train and fine-tune AI models on your proprietary data for domain-specific accuracy and
            performance.
          </p>
          <div
            class="flex items-center gap-2 text-teal-600 font-semibold group-hover:translate-x-2 transition-transform"
          >
            Learn More <i class="fa-solid fa-arrow-right"></i>
          </div>
        </a>

        <!-- MCP Server -->
        <a
          href="/ai/mcp-server"
          class="group bg-white rounded-3xl shadow-xl border border-gray-100 p-8 hover:shadow-2xl hover:border-orange-200 transition-all duration-300"
        >
          <div
            class="w-16 h-16 bg-gradient-to-br from-orange-500 to-red-500 rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-orange-500/30 group-hover:scale-110 transition-transform"
          >
            <i class="fa-solid fa-server text-2xl text-white"></i>
          </div>
          <h3 class="font-bold text-2xl text-slate-900 mb-3">MCP Server</h3>
          <p class="text-gray-600 mb-6 leading-relaxed">
            Deploy and manage AI pipelines with our Model Context Protocol infrastructure for
            enterprise scale.
          </p>
          <div
            class="flex items-center gap-2 text-orange-600 font-semibold group-hover:translate-x-2 transition-transform"
          >
            Learn More <i class="fa-solid fa-arrow-right"></i>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Why Our AI Platform -->
  <section class="py-24 px-4 bg-gradient-to-b from-slate-50 to-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-black text-slate-900 mb-4">Why Exyconn's AI Platform?</h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Built different. Deployed faster. Scales infinitely.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center">
          <div
            class="w-16 h-16 bg-cyan-100 rounded-2xl flex items-center justify-center mx-auto mb-4"
          >
            <i class="fa-solid fa-bolt text-2xl text-cyan-600"></i>
          </div>
          <h3 class="font-bold text-lg text-slate-900 mb-2">10x Faster</h3>
          <p class="text-gray-600 text-sm">
            Pre-built components mean you ship in weeks, not months.
          </p>
        </div>
        <div class="text-center">
          <div
            class="w-16 h-16 bg-indigo-100 rounded-2xl flex items-center justify-center mx-auto mb-4"
          >
            <i class="fa-solid fa-shield-halved text-2xl text-indigo-600"></i>
          </div>
          <h3 class="font-bold text-lg text-slate-900 mb-2">Enterprise Secure</h3>
          <p class="text-gray-600 text-sm">
            SOC 2 compliant with end-to-end encryption and audit logs.
          </p>
        </div>
        <div class="text-center">
          <div
            class="w-16 h-16 bg-emerald-100 rounded-2xl flex items-center justify-center mx-auto mb-4"
          >
            <i class="fa-solid fa-expand text-2xl text-emerald-600"></i>
          </div>
          <h3 class="font-bold text-lg text-slate-900 mb-2">Infinite Scale</h3>
          <p class="text-gray-600 text-sm">
            Auto-scaling infrastructure handles any workload seamlessly.
          </p>
        </div>
        <div class="text-center">
          <div
            class="w-16 h-16 bg-orange-100 rounded-2xl flex items-center justify-center mx-auto mb-4"
          >
            <i class="fa-solid fa-plug text-2xl text-orange-600"></i>
          </div>
          <h3 class="font-bold text-lg text-slate-900 mb-2">50+ Integrations</h3>
          <p class="text-gray-600 text-sm">
            Connect with your existing tools and data sources instantly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section
    class="py-24 px-4 bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 relative overflow-hidden"
  >
    <div
      class="absolute top-20 right-20 w-96 h-96 bg-gradient-to-r from-cyan-500/20 to-blue-500/20 rounded-full blur-3xl"
    >
    </div>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <h2 class="text-4xl md:text-5xl font-black text-white mb-6">Ready to Deploy AI?</h2>
      <p class="text-xl text-gray-300 mb-10 max-w-2xl mx-auto">
        Get your first AI agent running in production within days—not months.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/get-a-quote"
          class="inline-flex items-center gap-2 bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-semibold px-10 py-4 rounded-full shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:scale-105 transition-all"
        >
          <i class="fa-solid fa-calculator"></i>
          Get a Quote
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/30 text-white font-semibold px-10 py-4 rounded-full hover:bg-white/20 transition-all"
        >
          <i class="fa-solid fa-message"></i>
          Talk to an Expert
        </a>
      </div>
    </div>
  </section>

  <style>
    @keyframes fade-in {
      0% {
        opacity: 0;
        transform: translateY(20px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .animate-fade-in {
      animation: fade-in 0.8s cubic-bezier(0.4, 0, 0.2, 1) both;
    }
  </style>
</Page>
