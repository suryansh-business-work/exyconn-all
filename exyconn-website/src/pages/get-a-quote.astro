---
import Page from "../layouts/Page.astro";
---

<Page
  metaTitle="Get a Quote | Project Budget Calculator | Exyconn"
  metaDescription="Use Exyconn's Software Budget Calculator to estimate your project costs. Select project type, team composition, and timeline for an instant budget estimate."
  metaKeywords="get a quote, software budget calculator, project estimate, AI development, SaaS pricing, Exyconn"
  metaImage="https://images.pexels.com/photos/1181675/pexels-photo-1181675.jpeg?auto=compress&w=1200&q=80"
>
  <main class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-cyan-50">
    <!-- Hero -->
    <section class="py-16 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
          <span
            class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-full text-sm font-medium text-gray-600 mb-6 shadow-sm"
          >
            <i class="fa-solid fa-calculator text-blue-500"></i>
            Budget Estimator
          </span>
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 tracking-tight">
            Project Budget <span
              class="bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent"
              >Calculator</span
            >
          </h1>
          <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            Get an instant estimate for your software project. Configure your team, timeline, and
            requirements.
          </p>
        </div>

        <div class="bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden">
          <div class="grid lg:grid-cols-3">
            <!-- Calculator Form -->
            <div class="lg:col-span-2 p-8 md:p-10">
              <div id="calculator-root"></div>
            </div>

            <!-- Summary Panel -->
            <div
              class="bg-gradient-to-br from-gray-50 to-blue-50 p-8 md:p-10 border-t lg:border-t-0 lg:border-l border-gray-100"
            >
              <div class="sticky top-24">
                <div class="text-center mb-8">
                  <div
                    class="w-16 h-16 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg shadow-blue-500/30"
                  >
                    <i class="fa-solid fa-file-invoice-dollar text-white text-2xl"></i>
                  </div>
                  <h3 class="text-xl font-bold text-gray-900 mb-2">Estimated Budget</h3>
                  <div
                    id="budget-value"
                    class="text-5xl font-extrabold bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent"
                  >
                    $0
                  </div>
                </div>

                <div id="budget-breakdown" class="space-y-3 mb-8">
                  <!-- Breakdown will be populated by JS -->
                </div>

                <div class="bg-white rounded-xl p-4 border border-gray-100 mb-6">
                  <p class="text-xs text-gray-500 text-center">
                    This is an estimate based on your selections. Final costs may vary based on
                    specific requirements.
                  </p>
                </div>

                <div class="flex flex-col gap-3">
                  <button
                    id="downloadPdfBtn"
                    class="w-full inline-flex items-center justify-center gap-2 bg-white border border-gray-200 text-gray-700 font-semibold px-6 py-4 rounded-full hover:bg-gray-50 transition shadow-sm cursor-pointer"
                  >
                    <i class="fa-solid fa-download"></i>
                    Download as TXT
                  </button>
                  <a
                    href="/contact"
                    class="w-full inline-flex items-center justify-center gap-2 bg-gray-900 text-white font-semibold px-6 py-4 rounded-full hover:bg-gray-800 transition shadow-lg"
                  >
                    <i class="fa-solid fa-message"></i>
                    Discuss Your Project
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script is:inline type="module">
    import { h, render } from "https://esm.sh/preact@10.19.2";
    import { useState, useEffect } from "https://esm.sh/preact@10.19.2/hooks";

    function BudgetCalculator() {
      // Project Types with "Other" option
      const projectTypes = [
        {
          id: "mvp",
          label: "MVP / Prototype",
          multiplier: 0.6,
          description: "Quick proof of concept",
        },
        {
          id: "saas",
          label: "SaaS Application",
          multiplier: 1.0,
          description: "Full-featured SaaS platform",
        },
        {
          id: "enterprise",
          label: "Enterprise App",
          multiplier: 1.5,
          description: "Large-scale enterprise solution",
        },
        {
          id: "mobile",
          label: "Mobile App",
          multiplier: 0.8,
          description: "iOS & Android application",
        },
        {
          id: "ai",
          label: "AI/ML Solution",
          multiplier: 1.3,
          description: "AI-powered application",
        },
        {
          id: "ecommerce",
          label: "E-Commerce",
          multiplier: 1.1,
          description: "Online store platform",
        },
        {
          id: "other",
          label: "Other",
          multiplier: 1.0,
          description: "Custom project type",
        },
      ];

      // Team Roles grouped by category
      const roleGroups = {
        "Product & Management": [
          { id: "pm", label: "Project Manager", rate: 50 },
          { id: "product", label: "Product Manager", rate: 55 },
          { id: "scrum", label: "Scrum Master", rate: 48 },
        ],
        Engineering: [
          { id: "frontend", label: "Frontend Engineer", rate: 40 },
          { id: "backend", label: "Backend Engineer", rate: 45 },
          { id: "fullstack", label: "Full Stack Engineer", rate: 50 },
          { id: "ai-ml", label: "AI/ML Engineer", rate: 60 },
          { id: "devops", label: "DevOps Engineer", rate: 55 },
          { id: "data", label: "Data Engineer", rate: 55 },
          { id: "security", label: "Security Engineer", rate: 65 },
        ],
        "Design & QA": [
          { id: "designer", label: "UI/UX Designer", rate: 38 },
          { id: "qa", label: "QA Engineer", rate: 35 },
          { id: "qa-auto", label: "QA Automation", rate: 45 },
        ],
        Custom: [{ id: "custom", label: "Custom Role", rate: 50, isCustom: true }],
      };

      // Flatten role groups for easy access
      const roleOptions = Object.values(roleGroups).flat();

      // Duration presets
      const durationPresets = [
        { id: "1w", label: "1 Week (MVP)", months: 0.25, description: "Proof of concept" },
        { id: "1m", label: "1 Month", months: 1, description: "Small project" },
        { id: "3m", label: "3 Months", months: 3, description: "Medium project" },
        { id: "6m", label: "6 Months", months: 6, description: "Large project" },
        { id: "12m", label: "12 Months", months: 12, description: "Enterprise project" },
        { id: "custom", label: "Custom", months: 0, description: "Set your own" },
      ];

      // Hours per month options
      const hoursOptions = [
        { id: "part", label: "Part-time (80h/mo)", hours: 80 },
        { id: "full", label: "Full-time (160h/mo)", hours: 160 },
        { id: "dedicated", label: "Dedicated (200h/mo)", hours: 200 },
      ];

      // State
      const [projectType, setProjectType] = useState(projectTypes[0]);
      const [customProjectDesc, setCustomProjectDesc] = useState("");
      const [roles, setRoles] = useState([
        { ...roleOptions.find((r) => r.id === "fullstack"), count: 1 },
        { ...roleOptions.find((r) => r.id === "qa"), count: 1 },
      ]);
      const [durationPreset, setDurationPreset] = useState(durationPresets[2]); // 3 months
      const [customDuration, setCustomDuration] = useState(3);
      const [hoursOption, setHoursOption] = useState(hoursOptions[1]); // Full-time

      // Calculate duration
      const duration = durationPreset.id === "custom" ? customDuration : durationPreset.months;

      // Calculate totals
      const baseTotal = roles.reduce(
        (sum, r) => sum + r.count * r.rate * hoursOption.hours * duration,
        0
      );
      const adjustedTotal = Math.round(baseTotal * projectType.multiplier);

      // Store data for PDF export
      window.calculatorData = {
        projectType: projectType.label,
        customProjectDesc,
        roles: roles.map((r) => ({
          label: r.customLabel || r.label,
          count: r.count,
          rate: r.rate,
        })),
        duration,
        hoursPerMonth: hoursOption.hours,
        baseTotal,
        adjustedTotal,
        multiplier: projectType.multiplier,
      };

      // Update DOM
      useEffect(() => {
        const budgetEl = document.getElementById("budget-value");
        const breakdownEl = document.getElementById("budget-breakdown");

        if (budgetEl) {
          budgetEl.textContent = `$${adjustedTotal.toLocaleString()}`;
        }

        if (breakdownEl) {
          breakdownEl.innerHTML = `
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">Project Type</span>
              <span class="font-medium text-gray-900">${projectType.label}</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">Team Size</span>
              <span class="font-medium text-gray-900">${roles.reduce((sum, r) => sum + r.count, 0)} members</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">Duration</span>
              <span class="font-medium text-gray-900">${duration < 1 ? Math.round(duration * 4) + " weeks" : duration + " months"}</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">Work Hours</span>
              <span class="font-medium text-gray-900">${hoursOption.hours}h/month</span>
            </div>
            <div class="flex justify-between text-sm pt-2 border-t border-gray-200">
              <span class="text-gray-500">Base Cost</span>
              <span class="font-medium text-gray-700">$${baseTotal.toLocaleString()}</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">Complexity (${projectType.multiplier}x)</span>
              <span class="font-medium text-gray-700">${projectType.multiplier > 1 ? "+" : ""}${Math.round((projectType.multiplier - 1) * 100)}%</span>
            </div>
          `;
        }
      }, [adjustedTotal, roles, duration, projectType, hoursOption]);

      // Handlers
      function handleRoleChange(idx, field, value) {
        setRoles(roles.map((role, i) => (i === idx ? { ...role, [field]: value } : role)));
      }

      function handleSelectRole(idx, roleId) {
        const found = roleOptions.find((r) => r.id === roleId);
        if (found) {
          setRoles(
            roles.map((role, i) =>
              i === idx ? { ...found, count: role.count, customLabel: role.customLabel } : role
            )
          );
        }
      }

      function addRole() {
        const unusedRoles = roleOptions.filter(
          (r) => !r.isCustom && !roles.find((role) => role.id === r.id)
        );
        const newRole =
          unusedRoles.length > 0 ? unusedRoles[0] : roleOptions.find((r) => r.isCustom);
        setRoles([...roles, { ...newRole, count: 1, customLabel: "" }]);
      }

      function removeRole(idx) {
        if (roles.length > 1) {
          setRoles(roles.filter((_, i) => i !== idx));
        }
      }

      return h("div", { class: "space-y-8" }, [
        // Project Type Section
        h("div", {}, [
          h("label", { class: "block text-sm font-semibold text-gray-900 mb-3" }, [
            h("i", { class: "fa-solid fa-folder-open text-blue-500 mr-2" }),
            "Project Type",
          ]),
          h(
            "div",
            { class: "grid grid-cols-2 md:grid-cols-4 gap-3" },
            projectTypes.map((pt) =>
              h(
                "button",
                {
                  type: "button",
                  class: `cursor-pointer p-4 rounded-xl border-2 text-left transition-all ${
                    projectType.id === pt.id
                      ? "border-blue-500 bg-blue-50"
                      : "border-gray-100 bg-gray-50 hover:border-gray-200"
                  }`,
                  onClick: () => setProjectType(pt),
                },
                [
                  h(
                    "div",
                    {
                      class: `font-semibold text-sm ${projectType.id === pt.id ? "text-blue-700" : "text-gray-900"}`,
                    },
                    pt.label
                  ),
                  h("div", { class: "text-xs text-gray-500 mt-1" }, pt.description),
                ]
              )
            )
          ),
          // Custom project description textarea
          projectType.id === "other" &&
            h("div", { class: "mt-4" }, [
              h(
                "label",
                { class: "block text-xs font-medium text-gray-500 mb-2" },
                "Describe your project"
              ),
              h("textarea", {
                class:
                  "w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-blue-200 focus:border-blue-400 focus:outline-none bg-white resize-none",
                rows: 3,
                placeholder: "Tell us about your custom project requirements...",
                value: customProjectDesc,
                onInput: (e) => setCustomProjectDesc(e.target.value),
              }),
            ]),
        ]),

        // Team Composition Section with Grouped Roles
        h("div", {}, [
          h("label", { class: "block text-sm font-semibold text-gray-900 mb-3" }, [
            h("i", { class: "fa-solid fa-users text-blue-500 mr-2" }),
            "Team Composition",
          ]),
          h(
            "div",
            { class: "space-y-3" },
            roles.map((role, idx) =>
              h(
                "div",
                {
                  class: "flex flex-col gap-3 p-4 bg-gray-50 rounded-xl border border-gray-100",
                },
                [
                  h("div", { class: "flex flex-col sm:flex-row gap-3" }, [
                    h("div", { class: "flex-1" }, [
                      h("label", { class: "block text-xs font-medium text-gray-500 mb-1" }, "Role"),
                      h(
                        "select",
                        {
                          class:
                            "w-full rounded-lg border border-gray-200 px-3 py-2.5 text-sm focus:ring-2 focus:ring-blue-200 focus:border-blue-400 focus:outline-none bg-white",
                          value: role.id,
                          onChange: (e) => handleSelectRole(idx, e.target.value),
                        },
                        Object.entries(roleGroups).map(([groupName, groupRoles]) =>
                          h(
                            "optgroup",
                            { label: groupName },
                            groupRoles.map((r) =>
                              h("option", { value: r.id }, `${r.label} ($${r.rate}/hr)`)
                            )
                          )
                        )
                      ),
                    ]),
                    h("div", { class: "w-24" }, [
                      h(
                        "label",
                        { class: "block text-xs font-medium text-gray-500 mb-1" },
                        "Count"
                      ),
                      h("input", {
                        type: "number",
                        min: 1,
                        max: 10,
                        class:
                          "w-full rounded-lg border border-gray-200 px-3 py-2.5 text-sm focus:ring-2 focus:ring-blue-200 focus:border-blue-400 focus:outline-none bg-white",
                        value: role.count,
                        onInput: (e) =>
                          handleRoleChange(idx, "count", Math.max(1, Number(e.target.value))),
                      }),
                    ]),
                    h("div", { class: "w-28" }, [
                      h(
                        "label",
                        { class: "block text-xs font-medium text-gray-500 mb-1" },
                        "Rate/hr"
                      ),
                      h("input", {
                        type: "number",
                        min: 20,
                        class:
                          "w-full rounded-lg border border-gray-200 px-3 py-2.5 text-sm focus:ring-2 focus:ring-blue-200 focus:border-blue-400 focus:outline-none bg-white",
                        value: role.rate,
                        onInput: (e) =>
                          handleRoleChange(idx, "rate", Math.max(20, Number(e.target.value))),
                      }),
                    ]),
                    h(
                      "button",
                      {
                        type: "button",
                        class:
                          "cursor-pointer self-end p-2.5 text-red-500 hover:text-red-700 hover:bg-red-50 rounded-lg transition",
                        onClick: () => removeRole(idx),
                        disabled: roles.length <= 1,
                        "aria-label": "Remove role",
                      },
                      h("i", { class: "fa-solid fa-trash" })
                    ),
                  ]),
                  // Custom role name input when custom role selected
                  role.id === "custom" &&
                    h("div", { class: "w-full" }, [
                      h(
                        "label",
                        { class: "block text-xs font-medium text-gray-500 mb-1" },
                        "Custom Role Name"
                      ),
                      h("input", {
                        type: "text",
                        placeholder: "Enter custom role name...",
                        class:
                          "w-full rounded-lg border border-gray-200 px-3 py-2.5 text-sm focus:ring-2 focus:ring-blue-200 focus:border-blue-400 focus:outline-none bg-white",
                        value: role.customLabel || "",
                        onInput: (e) => handleRoleChange(idx, "customLabel", e.target.value),
                      }),
                    ]),
                ]
              )
            )
          ),
          h(
            "button",
            {
              type: "button",
              class:
                "cursor-pointer mt-3 inline-flex items-center gap-2 bg-blue-50 text-blue-700 font-semibold px-4 py-2.5 rounded-lg hover:bg-blue-100 transition text-sm",
              onClick: addRole,
            },
            [h("i", { class: "fa-solid fa-plus" }), "Add Team Member"]
          ),
        ]),

        // Duration Section
        h("div", {}, [
          h("label", { class: "block text-sm font-semibold text-gray-900 mb-3" }, [
            h("i", { class: "fa-solid fa-calendar text-blue-500 mr-2" }),
            "Project Duration",
          ]),
          h(
            "div",
            { class: "grid grid-cols-3 md:grid-cols-6 gap-2 mb-3" },
            durationPresets.map((dp) =>
              h(
                "button",
                {
                  type: "button",
                  class: `cursor-pointer p-3 rounded-xl border-2 text-center transition-all ${
                    durationPreset.id === dp.id
                      ? "border-blue-500 bg-blue-50"
                      : "border-gray-100 bg-gray-50 hover:border-gray-200"
                  }`,
                  onClick: () => setDurationPreset(dp),
                },
                [
                  h(
                    "div",
                    {
                      class: `font-semibold text-sm ${durationPreset.id === dp.id ? "text-blue-700" : "text-gray-900"}`,
                    },
                    dp.label
                  ),
                ]
              )
            )
          ),
          durationPreset.id === "custom" &&
            h("div", { class: "mt-3" }, [
              h(
                "label",
                { class: "block text-xs font-medium text-gray-500 mb-1" },
                "Custom Duration (months)"
              ),
              h("input", {
                type: "number",
                min: 0.25,
                step: 0.25,
                class:
                  "w-32 rounded-lg border border-gray-200 px-3 py-2.5 text-sm focus:ring-2 focus:ring-blue-200 focus:border-blue-400 focus:outline-none bg-white",
                value: customDuration,
                onInput: (e) => setCustomDuration(Math.max(0.25, Number(e.target.value))),
              }),
            ]),
        ]),

        // Work Hours Section
        h("div", {}, [
          h("label", { class: "block text-sm font-semibold text-gray-900 mb-3" }, [
            h("i", { class: "fa-solid fa-clock text-blue-500 mr-2" }),
            "Work Commitment",
          ]),
          h(
            "div",
            { class: "grid grid-cols-3 gap-3" },
            hoursOptions.map((ho) =>
              h(
                "button",
                {
                  type: "button",
                  class: `cursor-pointer p-4 rounded-xl border-2 text-center transition-all ${
                    hoursOption.id === ho.id
                      ? "border-blue-500 bg-blue-50"
                      : "border-gray-100 bg-gray-50 hover:border-gray-200"
                  }`,
                  onClick: () => setHoursOption(ho),
                },
                [
                  h(
                    "div",
                    {
                      class: `font-semibold text-sm ${hoursOption.id === ho.id ? "text-blue-700" : "text-gray-900"}`,
                    },
                    ho.label
                  ),
                ]
              )
            )
          ),
        ]),
      ]);
    }

    render(h(BudgetCalculator), document.getElementById("calculator-root"));

    // PDF Download functionality
    document.getElementById("downloadPdfBtn")?.addEventListener("click", () => {
      const data = window.calculatorData;
      if (!data) return;

      // Create PDF content
      const content = `
EXYCONN - PROJECT BUDGET ESTIMATE
=====================================
Generated: ${new Date().toLocaleDateString()}

PROJECT DETAILS
---------------
Project Type: ${data.projectType}
${data.customProjectDesc ? `Description: ${data.customProjectDesc}` : ""}

TEAM COMPOSITION
----------------
${data.roles.map((r) => `• ${r.label || "Custom Role"}: ${r.count} member(s) @ $${r.rate}/hr`).join("\n")}

PROJECT TIMELINE
----------------
Duration: ${data.duration < 1 ? Math.round(data.duration * 4) + " weeks" : data.duration + " months"}
Work Hours: ${data.hoursPerMonth}h/month

COST BREAKDOWN
--------------
Base Cost: $${data.baseTotal.toLocaleString()}
Complexity Multiplier: ${data.multiplier}x
${data.multiplier !== 1 ? `Adjustment: ${data.multiplier > 1 ? "+" : ""}${Math.round((data.multiplier - 1) * 100)}%` : ""}

ESTIMATED TOTAL: $${data.adjustedTotal.toLocaleString()}
=====================================

Note: This is an estimate based on your selections.
Final costs may vary based on specific requirements.

Contact us: contact@exyconn.com
Website: https://exyconn.com
      `.trim();

      // Create and download file
      const blob = new Blob([content], { type: "text/plain" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `exyconn-budget-estimate-${Date.now()}.txt`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  </script>
</Page>
