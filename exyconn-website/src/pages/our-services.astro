---
import Page from "../layouts/Page.astro";
---

<Page
  metaTitle="AI & SaaS Services | Enterprise Solutions | Exyconn"
  metaDescription="Transform your enterprise with Exyconn's AI automation, agentic AI, and SaaS solutions. From strategy to deployment—we deliver production-ready intelligent systems."
  metaKeywords="AI services, enterprise AI, SaaS solutions, AI automation, agentic AI, business transformation, Exyconn"
  metaImage="https://images.pexels.com/photos/1181675/pexels-photo-1181675.jpeg?auto=compress&w=1200&q=80"
>
  <main class="bg-surface min-h-screen">
    <!-- Hero Section - Light Background -->
    <section
      class="relative min-h-[60vh] bg-gradient-to-br from-blue-subtle via-surface to-purple-subtle flex items-center overflow-hidden"
    >
      <!-- Background Effects -->
      <div
        class="absolute top-20 right-20 w-96 h-96 bg-gradient-to-r from-cyan-muted/40 to-blue-muted/40 rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-20 left-10 w-80 h-80 bg-gradient-to-r from-indigo-muted/30 to-purple-muted/30 rounded-full blur-3xl"
      >
      </div>

      <div class="relative z-10 max-w-5xl mx-auto text-center py-20 px-6">
        <span
          class="inline-flex items-center gap-2 px-4 py-2 bg-surface border border-line rounded-full text-sm font-medium text-blue-fg mb-6 shadow-sm"
        >
          <i class="fa-solid fa-sparkles"></i>
          Enterprise AI + SaaS Solutions
        </span>
        <h1 class="text-5xl md:text-6xl font-black mb-6 tracking-tight leading-tight">
          <span class="text-fg">Services That</span>
          <br />
          <span
            class="bg-gradient-to-r from-blue-strong via-cyan to-purple-strong bg-clip-text text-transparent"
            >Transform Business</span
          >
        </h1>
        <p class="text-xl text-fg-muted max-w-3xl mx-auto leading-relaxed mb-8">
          From AI strategy to SaaS deployment, we provide end-to-end services that turn intelligent
          automation into competitive advantage.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 bg-gradient-to-r from-blue-strong to-purple-strong text-on-solid font-semibold px-8 py-4 rounded-full shadow-lg shadow-blue/25 hover:shadow-blue/40 hover:scale-105 transition-all"
          >
            <i class="fa-solid fa-calendar-check"></i>
            Schedule Consultation
          </a>
          <a
            href="/case-studies"
            class="inline-flex items-center gap-2 bg-surface border border-line text-fg font-semibold px-8 py-4 rounded-full hover:bg-surface-subtle hover:border-line-strong transition-all shadow-sm"
          >
            <i class="fa-solid fa-chart-line"></i>
            View Case Studies
          </a>
        </div>
      </div>
    </section>

    <!-- Service Categories -->
    <section class="py-24 px-4 max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-black text-fg mb-4">Our Service Pillars</h2>
        <p class="text-xl text-fg-muted max-w-2xl mx-auto">
          Three interconnected pillars that power your digital transformation journey.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- AI Platform Services -->
        <div
          class="group relative bg-gradient-to-br from-blue-strong to-indigo-deep rounded-3xl p-8 text-on-solid overflow-hidden hover:scale-[1.02] transition-all duration-300"
        >
          <div
            class="absolute top-0 right-0 w-40 h-40 bg-gradient-to-br from-cyan/30 to-blue/30 rounded-full blur-2xl"
          >
          </div>
          <div class="relative z-10">
            <div
              class="w-16 h-16 bg-gradient-to-br from-cyan to-blue-strong rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-cyan/30"
            >
              <i class="fa-solid fa-microchip text-2xl"></i>
            </div>
            <h3 class="text-2xl font-bold mb-4">AI Platform Services</h3>
            <p class="text-on-solid-muted mb-6">
              Deploy production-ready AI systems that automate, analyze, and accelerate.
            </p>
            <ul class="space-y-3 mb-8">
              <li class="flex items-center gap-3 text-on-solid-muted">
                <i class="fa-solid fa-check-circle text-cyan-bright text-sm"></i>
                <span>Agentic AI & Autonomous Agents</span>
              </li>
              <li class="flex items-center gap-3 text-on-solid-muted">
                <i class="fa-solid fa-check-circle text-cyan-bright text-sm"></i>
                <span>Custom LLM Training & Fine-tuning</span>
              </li>
              <li class="flex items-center gap-3 text-on-solid-muted">
                <i class="fa-solid fa-check-circle text-cyan-bright text-sm"></i>
                <span>AI Workflow Automation</span>
              </li>
              <li class="flex items-center gap-3 text-on-solid-muted">
                <i class="fa-solid fa-check-circle text-cyan-bright text-sm"></i>
                <span>Intelligent Bot Development</span>
              </li>
              <li class="flex items-center gap-3 text-on-solid-muted">
                <i class="fa-solid fa-check-circle text-cyan-bright text-sm"></i>
                <span>MCP Server Architecture</span>
              </li>
            </ul>
            <a
              href="/ai"
              class="inline-flex items-center gap-2 text-cyan-bright font-semibold hover:text-cyan-bright transition group"
            >
              Explore AI Services <i
                class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
            </a>
          </div>
        </div>

        <!-- SaaS Development -->
        <div
          class="group relative bg-surface rounded-3xl p-8 border border-line-subtle shadow-xl overflow-hidden hover:scale-[1.02] hover:shadow-2xl transition-all duration-300"
        >
          <div
            class="absolute top-0 right-0 w-40 h-40 bg-gradient-to-br from-indigo-soft to-purple-soft rounded-full blur-2xl"
          >
          </div>
          <div class="relative z-10">
            <div
              class="w-16 h-16 bg-gradient-to-br from-indigo to-purple-strong rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-indigo/30"
            >
              <i class="fa-solid fa-cloud text-2xl text-on-solid"></i>
            </div>
            <h3 class="text-2xl font-bold text-fg mb-4">SaaS Development</h3>
            <p class="text-fg-muted mb-6">
              Build and scale cloud-native software with enterprise security.
            </p>
            <ul class="space-y-3 mb-8">
              <li class="flex items-center gap-3 text-fg-secondary">
                <i class="fa-solid fa-check-circle text-indigo-fg text-sm"></i>
                <span>Custom SaaS Platform Development</span>
              </li>
              <li class="flex items-center gap-3 text-fg-secondary">
                <i class="fa-solid fa-check-circle text-indigo-fg text-sm"></i>
                <span>Cloud Architecture & Migration</span>
              </li>
              <li class="flex items-center gap-3 text-fg-secondary">
                <i class="fa-solid fa-check-circle text-indigo-fg text-sm"></i>
                <span>API & Integration Services</span>
              </li>
              <li class="flex items-center gap-3 text-fg-secondary">
                <i class="fa-solid fa-check-circle text-indigo-fg text-sm"></i>
                <span>Multi-tenant Architecture</span>
              </li>
              <li class="flex items-center gap-3 text-fg-secondary">
                <i class="fa-solid fa-check-circle text-indigo-fg text-sm"></i>
                <span>DevOps & CI/CD Pipelines</span>
              </li>
            </ul>
            <a
              href="/services/software-as-a-service"
              class="inline-flex items-center gap-2 text-indigo-fg font-semibold hover:text-indigo-fg-strong transition group"
            >
              Learn More <i
                class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
            </a>
          </div>
        </div>

        <!-- Enterprise Consulting -->
        <div
          class="group relative bg-surface rounded-3xl p-8 border border-line-subtle shadow-xl overflow-hidden hover:scale-[1.02] hover:shadow-2xl transition-all duration-300"
        >
          <div
            class="absolute top-0 right-0 w-40 h-40 bg-gradient-to-br from-emerald-soft to-teal-soft rounded-full blur-2xl"
          >
          </div>
          <div class="relative z-10">
            <div
              class="w-16 h-16 bg-gradient-to-br from-emerald to-teal-strong rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-emerald/30"
            >
              <i class="fa-solid fa-lightbulb text-2xl text-on-solid"></i>
            </div>
            <h3 class="text-2xl font-bold text-fg mb-4">Enterprise Consulting</h3>
            <p class="text-fg-muted mb-6">
              Strategic guidance to maximize your AI and digital investments.
            </p>
            <ul class="space-y-3 mb-8">
              <li class="flex items-center gap-3 text-fg-secondary">
                <i class="fa-solid fa-check-circle text-emerald-fg text-sm"></i>
                <span>AI Strategy & Roadmapping</span>
              </li>
              <li class="flex items-center gap-3 text-fg-secondary">
                <i class="fa-solid fa-check-circle text-emerald-fg text-sm"></i>
                <span>Digital Transformation Planning</span>
              </li>
              <li class="flex items-center gap-3 text-fg-secondary">
                <i class="fa-solid fa-check-circle text-emerald-fg text-sm"></i>
                <span>Data Analytics & BI</span>
              </li>
              <li class="flex items-center gap-3 text-fg-secondary">
                <i class="fa-solid fa-check-circle text-emerald-fg text-sm"></i>
                <span>Process Optimization</span>
              </li>
              <li class="flex items-center gap-3 text-fg-secondary">
                <i class="fa-solid fa-check-circle text-emerald-fg text-sm"></i>
                <span>Change Management</span>
              </li>
            </ul>
            <a
              href="/services/digital-consulting"
              class="inline-flex items-center gap-2 text-emerald-fg font-semibold hover:text-emerald-fg-strong transition group"
            >
              Learn More <i
                class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- All Services Grid -->
    <section class="py-24 px-4 bg-gradient-to-b from-surface-subtle to-surface">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-black text-fg mb-4">Complete Service Portfolio</h2>
          <p class="text-xl text-fg-muted">
            Specialized services across AI, SaaS, and enterprise technology.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Service Cards -->
          <a
            href="/ai/agentic"
            class="group bg-surface rounded-2xl p-6 border border-line-subtle shadow-md hover:shadow-xl hover:border-cyan-muted transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-cyan-soft rounded-xl flex items-center justify-center group-hover:bg-cyan transition-colors"
              >
                <i
                  class="fa-solid fa-robot text-cyan-fg group-hover:text-on-solid transition-colors"
                ></i>
              </div>
              <h3 class="font-bold text-lg text-fg">Agentic AI</h3>
            </div>
            <p class="text-fg-muted text-sm">
              Autonomous agents for business automation and decision-making.
            </p>
          </a>

          <a
            href="/ai/bot-creation"
            class="group bg-surface rounded-2xl p-6 border border-line-subtle shadow-md hover:shadow-xl hover:border-indigo-muted transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-indigo-soft rounded-xl flex items-center justify-center group-hover:bg-indigo transition-colors"
              >
                <i
                  class="fa-solid fa-comments text-indigo-fg group-hover:text-on-solid transition-colors"
                ></i>
              </div>
              <h3 class="font-bold text-lg text-fg">Bot Creation</h3>
            </div>
            <p class="text-fg-muted text-sm">
              Conversational and workflow bots for support and engagement.
            </p>
          </a>

          <a
            href="/ai/workflows"
            class="group bg-surface rounded-2xl p-6 border border-line-subtle shadow-md hover:shadow-xl hover:border-purple-muted transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-purple-soft rounded-xl flex items-center justify-center group-hover:bg-purple transition-colors"
              >
                <i
                  class="fa-solid fa-diagram-project text-purple-fg group-hover:text-on-solid transition-colors"
                ></i>
              </div>
              <h3 class="font-bold text-lg text-fg">AI Workflows</h3>
            </div>
            <p class="text-fg-muted text-sm">
              Automate complex business processes with AI-driven workflows.
            </p>
          </a>

          <a
            href="/ai/llms"
            class="group bg-surface rounded-2xl p-6 border border-line-subtle shadow-md hover:shadow-xl hover:border-blue-muted transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-blue-soft rounded-xl flex items-center justify-center group-hover:bg-blue transition-colors"
              >
                <i
                  class="fa-solid fa-brain text-blue-fg group-hover:text-on-solid transition-colors"
                ></i>
              </div>
              <h3 class="font-bold text-lg text-fg">LLM Solutions</h3>
            </div>
            <p class="text-fg-muted text-sm">
              Large Language Models for advanced text and data solutions.
            </p>
          </a>

          <a
            href="/ai/custom-model-training"
            class="group bg-surface rounded-2xl p-6 border border-line-subtle shadow-md hover:shadow-xl hover:border-teal-muted transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-teal-soft rounded-xl flex items-center justify-center group-hover:bg-teal transition-colors"
              >
                <i
                  class="fa-solid fa-flask text-teal-fg group-hover:text-on-solid transition-colors"
                ></i>
              </div>
              <h3 class="font-bold text-lg text-fg">Custom AI Training</h3>
            </div>
            <p class="text-fg-muted text-sm">
              Tailored AI models trained on your unique business data.
            </p>
          </a>

          <a
            href="/services/software-as-a-service"
            class="group bg-surface rounded-2xl p-6 border border-line-subtle shadow-md hover:shadow-xl hover:border-emerald-muted transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-emerald-soft rounded-xl flex items-center justify-center group-hover:bg-emerald transition-colors"
              >
                <i
                  class="fa-solid fa-cloud text-emerald-fg group-hover:text-on-solid transition-colors"
                ></i>
              </div>
              <h3 class="font-bold text-lg text-fg">SaaS Development</h3>
            </div>
            <p class="text-fg-muted text-sm">
              Custom cloud software with scalability and security built-in.
            </p>
          </a>

          <a
            href="/services/data-analytics"
            class="group bg-surface rounded-2xl p-6 border border-line-subtle shadow-md hover:shadow-xl hover:border-orange-muted transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-orange-soft rounded-xl flex items-center justify-center group-hover:bg-orange transition-colors"
              >
                <i
                  class="fa-solid fa-chart-line text-orange-fg group-hover:text-on-solid transition-colors"
                ></i>
              </div>
              <h3 class="font-bold text-lg text-fg">Data Analytics</h3>
            </div>
            <p class="text-fg-muted text-sm">
              Transform data into actionable insights with AI-powered analytics.
            </p>
          </a>

          <a
            href="/services/automation-integration"
            class="group bg-surface rounded-2xl p-6 border border-line-subtle shadow-md hover:shadow-xl hover:border-rose-muted transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-rose-soft rounded-xl flex items-center justify-center group-hover:bg-rose transition-colors"
              >
                <i class="fa-solid fa-plug text-rose-fg group-hover:text-on-solid transition-colors"
                ></i>
              </div>
              <h3 class="font-bold text-lg text-fg">Integration Services</h3>
            </div>
            <p class="text-fg-muted text-sm">
              Connect your systems with seamless API and data integration.
            </p>
          </a>

          <a
            href="/services/maintenance"
            class="group bg-surface rounded-2xl p-6 border border-line-subtle shadow-md hover:shadow-xl hover:border-line-strong transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-surface-muted rounded-xl flex items-center justify-center group-hover:bg-fg-subtle transition-colors"
              >
                <i
                  class="fa-solid fa-shield-check text-fg-muted group-hover:text-on-solid transition-colors"
                ></i>
              </div>
              <h3 class="font-bold text-lg text-fg">Managed Support</h3>
            </div>
            <p class="text-fg-muted text-sm">
              24/7 monitoring, maintenance, and optimization services.
            </p>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section
      class="py-24 px-4 bg-gradient-to-br from-inverse via-indigo-night to-inverse relative overflow-hidden"
    >
      <div
        class="absolute top-20 right-20 w-96 h-96 bg-gradient-to-r from-cyan/20 to-blue/20 rounded-full blur-3xl"
      >
      </div>
      <div class="max-w-4xl mx-auto text-center relative z-10">
        <h2 class="text-4xl md:text-5xl font-black text-on-solid mb-6">
          Ready to Transform Your Business?
        </h2>
        <p class="text-xl text-on-solid-muted mb-10 max-w-2xl mx-auto">
          Let's discuss how AI and SaaS can accelerate your growth and give you a competitive edge.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/get-a-quote"
            class="inline-flex items-center gap-2 bg-gradient-to-r from-cyan to-blue-strong text-on-solid font-semibold px-10 py-4 rounded-full shadow-lg shadow-cyan/25 hover:shadow-cyan/40 hover:scale-105 transition-all"
          >
            <i class="fa-solid fa-calculator"></i>
            Get a Quote
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 bg-on-solid/10 backdrop-blur-sm border border-on-solid/30 text-on-solid font-semibold px-10 py-4 rounded-full hover:bg-on-solid/20 transition-all"
          >
            <i class="fa-solid fa-message"></i>
            Contact Us
          </a>
        </div>
      </div>
    </section>
  </main>
</Page>
