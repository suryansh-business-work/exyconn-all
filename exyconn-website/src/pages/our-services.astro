---
import Page from "../layouts/Page.astro";
---

<Page
  metaTitle="AI & SaaS Services | Enterprise Solutions | Exyconn"
  metaDescription="Transform your enterprise with Exyconn's AI automation, agentic AI, and SaaS solutions. From strategy to deployment—we deliver production-ready intelligent systems."
  metaKeywords="AI services, enterprise AI, SaaS solutions, AI automation, agentic AI, business transformation, Exyconn"
  metaImage="https://images.pexels.com/photos/1181675/pexels-photo-1181675.jpeg?auto=compress&w=1200&q=80"
>
  <main class="bg-white min-h-screen">
    <!-- Hero Section - Light Background -->
    <section
      class="relative min-h-[60vh] bg-gradient-to-br from-blue-50 via-white to-purple-50 flex items-center overflow-hidden"
    >
      <!-- Background Effects -->
      <div
        class="absolute top-20 right-20 w-96 h-96 bg-gradient-to-r from-cyan-200/40 to-blue-200/40 rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-20 left-10 w-80 h-80 bg-gradient-to-r from-indigo-200/30 to-purple-200/30 rounded-full blur-3xl"
      >
      </div>

      <div class="relative z-10 max-w-5xl mx-auto text-center py-20 px-6">
        <span
          class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-full text-sm font-medium text-blue-600 mb-6 shadow-sm"
        >
          <i class="fa-solid fa-sparkles"></i>
          Enterprise AI + SaaS Solutions
        </span>
        <h1 class="text-5xl md:text-6xl font-black mb-6 tracking-tight leading-tight">
          <span class="text-gray-900">Services That</span>
          <br />
          <span
            class="bg-gradient-to-r from-blue-600 via-cyan-500 to-purple-600 bg-clip-text text-transparent"
            >Transform Business</span
          >
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed mb-8">
          From AI strategy to SaaS deployment, we provide end-to-end services that turn intelligent
          automation into competitive advantage.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 bg-gradient-to-r from-blue-600 to-purple-600 text-white font-semibold px-8 py-4 rounded-full shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40 hover:scale-105 transition-all"
          >
            <i class="fa-solid fa-calendar-check"></i>
            Schedule Consultation
          </a>
          <a
            href="/case-studies"
            class="inline-flex items-center gap-2 bg-white border border-gray-200 text-gray-900 font-semibold px-8 py-4 rounded-full hover:bg-gray-50 hover:border-gray-300 transition-all shadow-sm"
          >
            <i class="fa-solid fa-chart-line"></i>
            View Case Studies
          </a>
        </div>
      </div>
    </section>

    <!-- Service Categories -->
    <section class="py-24 px-4 max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-black text-slate-900 mb-4">Our Service Pillars</h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Three interconnected pillars that power your digital transformation journey.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- AI Platform Services -->
        <div
          class="group relative bg-gradient-to-br from-blue-600 to-indigo-700 rounded-3xl p-8 text-white overflow-hidden hover:scale-[1.02] transition-all duration-300"
        >
          <div
            class="absolute top-0 right-0 w-40 h-40 bg-gradient-to-br from-cyan-500/30 to-blue-500/30 rounded-full blur-2xl"
          >
          </div>
          <div class="relative z-10">
            <div
              class="w-16 h-16 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-cyan-500/30"
            >
              <i class="fa-solid fa-microchip text-2xl"></i>
            </div>
            <h3 class="text-2xl font-bold mb-4">AI Platform Services</h3>
            <p class="text-gray-300 mb-6">
              Deploy production-ready AI systems that automate, analyze, and accelerate.
            </p>
            <ul class="space-y-3 mb-8">
              <li class="flex items-center gap-3 text-gray-200">
                <i class="fa-solid fa-check-circle text-cyan-400 text-sm"></i>
                <span>Agentic AI & Autonomous Agents</span>
              </li>
              <li class="flex items-center gap-3 text-gray-200">
                <i class="fa-solid fa-check-circle text-cyan-400 text-sm"></i>
                <span>Custom LLM Training & Fine-tuning</span>
              </li>
              <li class="flex items-center gap-3 text-gray-200">
                <i class="fa-solid fa-check-circle text-cyan-400 text-sm"></i>
                <span>AI Workflow Automation</span>
              </li>
              <li class="flex items-center gap-3 text-gray-200">
                <i class="fa-solid fa-check-circle text-cyan-400 text-sm"></i>
                <span>Intelligent Bot Development</span>
              </li>
              <li class="flex items-center gap-3 text-gray-200">
                <i class="fa-solid fa-check-circle text-cyan-400 text-sm"></i>
                <span>MCP Server Architecture</span>
              </li>
            </ul>
            <a
              href="/ai"
              class="inline-flex items-center gap-2 text-cyan-400 font-semibold hover:text-cyan-300 transition group"
            >
              Explore AI Services <i
                class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
            </a>
          </div>
        </div>

        <!-- SaaS Development -->
        <div
          class="group relative bg-white rounded-3xl p-8 border border-gray-100 shadow-xl overflow-hidden hover:scale-[1.02] hover:shadow-2xl transition-all duration-300"
        >
          <div
            class="absolute top-0 right-0 w-40 h-40 bg-gradient-to-br from-indigo-100 to-purple-100 rounded-full blur-2xl"
          >
          </div>
          <div class="relative z-10">
            <div
              class="w-16 h-16 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-indigo-500/30"
            >
              <i class="fa-solid fa-cloud text-2xl text-white"></i>
            </div>
            <h3 class="text-2xl font-bold text-slate-900 mb-4">SaaS Development</h3>
            <p class="text-gray-600 mb-6">
              Build and scale cloud-native software with enterprise security.
            </p>
            <ul class="space-y-3 mb-8">
              <li class="flex items-center gap-3 text-gray-700">
                <i class="fa-solid fa-check-circle text-indigo-500 text-sm"></i>
                <span>Custom SaaS Platform Development</span>
              </li>
              <li class="flex items-center gap-3 text-gray-700">
                <i class="fa-solid fa-check-circle text-indigo-500 text-sm"></i>
                <span>Cloud Architecture & Migration</span>
              </li>
              <li class="flex items-center gap-3 text-gray-700">
                <i class="fa-solid fa-check-circle text-indigo-500 text-sm"></i>
                <span>API & Integration Services</span>
              </li>
              <li class="flex items-center gap-3 text-gray-700">
                <i class="fa-solid fa-check-circle text-indigo-500 text-sm"></i>
                <span>Multi-tenant Architecture</span>
              </li>
              <li class="flex items-center gap-3 text-gray-700">
                <i class="fa-solid fa-check-circle text-indigo-500 text-sm"></i>
                <span>DevOps & CI/CD Pipelines</span>
              </li>
            </ul>
            <a
              href="/services/software-as-a-service"
              class="inline-flex items-center gap-2 text-indigo-600 font-semibold hover:text-indigo-700 transition group"
            >
              Learn More <i
                class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
            </a>
          </div>
        </div>

        <!-- Enterprise Consulting -->
        <div
          class="group relative bg-white rounded-3xl p-8 border border-gray-100 shadow-xl overflow-hidden hover:scale-[1.02] hover:shadow-2xl transition-all duration-300"
        >
          <div
            class="absolute top-0 right-0 w-40 h-40 bg-gradient-to-br from-emerald-100 to-teal-100 rounded-full blur-2xl"
          >
          </div>
          <div class="relative z-10">
            <div
              class="w-16 h-16 bg-gradient-to-br from-emerald-500 to-teal-600 rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-emerald-500/30"
            >
              <i class="fa-solid fa-lightbulb text-2xl text-white"></i>
            </div>
            <h3 class="text-2xl font-bold text-slate-900 mb-4">Enterprise Consulting</h3>
            <p class="text-gray-600 mb-6">
              Strategic guidance to maximize your AI and digital investments.
            </p>
            <ul class="space-y-3 mb-8">
              <li class="flex items-center gap-3 text-gray-700">
                <i class="fa-solid fa-check-circle text-emerald-500 text-sm"></i>
                <span>AI Strategy & Roadmapping</span>
              </li>
              <li class="flex items-center gap-3 text-gray-700">
                <i class="fa-solid fa-check-circle text-emerald-500 text-sm"></i>
                <span>Digital Transformation Planning</span>
              </li>
              <li class="flex items-center gap-3 text-gray-700">
                <i class="fa-solid fa-check-circle text-emerald-500 text-sm"></i>
                <span>Data Analytics & BI</span>
              </li>
              <li class="flex items-center gap-3 text-gray-700">
                <i class="fa-solid fa-check-circle text-emerald-500 text-sm"></i>
                <span>Process Optimization</span>
              </li>
              <li class="flex items-center gap-3 text-gray-700">
                <i class="fa-solid fa-check-circle text-emerald-500 text-sm"></i>
                <span>Change Management</span>
              </li>
            </ul>
            <a
              href="/services/digital-consulting"
              class="inline-flex items-center gap-2 text-emerald-600 font-semibold hover:text-emerald-700 transition group"
            >
              Learn More <i
                class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- All Services Grid -->
    <section class="py-24 px-4 bg-gradient-to-b from-slate-50 to-white">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-black text-slate-900 mb-4">Complete Service Portfolio</h2>
          <p class="text-xl text-gray-600">
            Specialized services across AI, SaaS, and enterprise technology.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Service Cards -->
          <a
            href="/ai/agentic"
            class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-md hover:shadow-xl hover:border-cyan-200 transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-cyan-100 rounded-xl flex items-center justify-center group-hover:bg-cyan-500 transition-colors"
              >
                <i class="fa-solid fa-robot text-cyan-600 group-hover:text-white transition-colors"
                ></i>
              </div>
              <h3 class="font-bold text-lg text-slate-900">Agentic AI</h3>
            </div>
            <p class="text-gray-600 text-sm">
              Autonomous agents for business automation and decision-making.
            </p>
          </a>

          <a
            href="/ai/bot-creation"
            class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-md hover:shadow-xl hover:border-indigo-200 transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-indigo-100 rounded-xl flex items-center justify-center group-hover:bg-indigo-500 transition-colors"
              >
                <i
                  class="fa-solid fa-comments text-indigo-600 group-hover:text-white transition-colors"
                ></i>
              </div>
              <h3 class="font-bold text-lg text-slate-900">Bot Creation</h3>
            </div>
            <p class="text-gray-600 text-sm">
              Conversational and workflow bots for support and engagement.
            </p>
          </a>

          <a
            href="/ai/workflows"
            class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-md hover:shadow-xl hover:border-purple-200 transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center group-hover:bg-purple-500 transition-colors"
              >
                <i
                  class="fa-solid fa-diagram-project text-purple-600 group-hover:text-white transition-colors"
                ></i>
              </div>
              <h3 class="font-bold text-lg text-slate-900">AI Workflows</h3>
            </div>
            <p class="text-gray-600 text-sm">
              Automate complex business processes with AI-driven workflows.
            </p>
          </a>

          <a
            href="/ai/llms"
            class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-md hover:shadow-xl hover:border-blue-200 transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-blue-500 transition-colors"
              >
                <i class="fa-solid fa-brain text-blue-600 group-hover:text-white transition-colors"
                ></i>
              </div>
              <h3 class="font-bold text-lg text-slate-900">LLM Solutions</h3>
            </div>
            <p class="text-gray-600 text-sm">
              Large Language Models for advanced text and data solutions.
            </p>
          </a>

          <a
            href="/ai/custom-model-training"
            class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-md hover:shadow-xl hover:border-teal-200 transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-teal-100 rounded-xl flex items-center justify-center group-hover:bg-teal-500 transition-colors"
              >
                <i class="fa-solid fa-flask text-teal-600 group-hover:text-white transition-colors"
                ></i>
              </div>
              <h3 class="font-bold text-lg text-slate-900">Custom AI Training</h3>
            </div>
            <p class="text-gray-600 text-sm">
              Tailored AI models trained on your unique business data.
            </p>
          </a>

          <a
            href="/services/software-as-a-service"
            class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-md hover:shadow-xl hover:border-emerald-200 transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-emerald-100 rounded-xl flex items-center justify-center group-hover:bg-emerald-500 transition-colors"
              >
                <i
                  class="fa-solid fa-cloud text-emerald-600 group-hover:text-white transition-colors"
                ></i>
              </div>
              <h3 class="font-bold text-lg text-slate-900">SaaS Development</h3>
            </div>
            <p class="text-gray-600 text-sm">
              Custom cloud software with scalability and security built-in.
            </p>
          </a>

          <a
            href="/services/data-analytics"
            class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-md hover:shadow-xl hover:border-orange-200 transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center group-hover:bg-orange-500 transition-colors"
              >
                <i
                  class="fa-solid fa-chart-line text-orange-600 group-hover:text-white transition-colors"
                ></i>
              </div>
              <h3 class="font-bold text-lg text-slate-900">Data Analytics</h3>
            </div>
            <p class="text-gray-600 text-sm">
              Transform data into actionable insights with AI-powered analytics.
            </p>
          </a>

          <a
            href="/services/automation-integration"
            class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-md hover:shadow-xl hover:border-rose-200 transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-rose-100 rounded-xl flex items-center justify-center group-hover:bg-rose-500 transition-colors"
              >
                <i class="fa-solid fa-plug text-rose-600 group-hover:text-white transition-colors"
                ></i>
              </div>
              <h3 class="font-bold text-lg text-slate-900">Integration Services</h3>
            </div>
            <p class="text-gray-600 text-sm">
              Connect your systems with seamless API and data integration.
            </p>
          </a>

          <a
            href="/services/maintenance"
            class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-md hover:shadow-xl hover:border-slate-300 transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-slate-100 rounded-xl flex items-center justify-center group-hover:bg-slate-600 transition-colors"
              >
                <i
                  class="fa-solid fa-shield-check text-slate-600 group-hover:text-white transition-colors"
                ></i>
              </div>
              <h3 class="font-bold text-lg text-slate-900">Managed Support</h3>
            </div>
            <p class="text-gray-600 text-sm">
              24/7 monitoring, maintenance, and optimization services.
            </p>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section
      class="py-24 px-4 bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 relative overflow-hidden"
    >
      <div
        class="absolute top-20 right-20 w-96 h-96 bg-gradient-to-r from-cyan-500/20 to-blue-500/20 rounded-full blur-3xl"
      >
      </div>
      <div class="max-w-4xl mx-auto text-center relative z-10">
        <h2 class="text-4xl md:text-5xl font-black text-white mb-6">
          Ready to Transform Your Business?
        </h2>
        <p class="text-xl text-gray-300 mb-10 max-w-2xl mx-auto">
          Let's discuss how AI and SaaS can accelerate your growth and give you a competitive edge.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/get-a-quote"
            class="inline-flex items-center gap-2 bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-semibold px-10 py-4 rounded-full shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:scale-105 transition-all"
          >
            <i class="fa-solid fa-calculator"></i>
            Get a Quote
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/30 text-white font-semibold px-10 py-4 rounded-full hover:bg-white/20 transition-all"
          >
            <i class="fa-solid fa-message"></i>
            Contact Us
          </a>
        </div>
      </div>
    </section>
  </main>
</Page>
