---
import Page from "../layouts/Page.astro";
import { getToolCategoriesWithTools } from "../lib/portal";

const toolCategories = await getToolCategoriesWithTools();

// Calculate stats
const totalToolsCount = toolCategories.reduce((sum, category) => sum + category.items.length, 0);

// SEO Keywords
const seoKeywords = [
  "free online tools",
  "SEO tools",
  "sitemap generator",
  "sitemap validator",
  "AI tools",
  "business tools",
  "logo generator",
  "email signature generator",
  "lead generator",
  "contact extractor",
  "PDF to Markdown",
  "AI prompt generator",
  "FAQ generator",
  "file converter",
  "website analyzer",
  "chatbot tools",
  "content generation",
  "productivity tools",
  "free SEO tools online",
  "AI content tools",
].join(", ");

// Structured Data for SEO (JSON-LD)
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Free Online Tools - SEO, AI & Business Automation | Exyconn",
  "description": "Discover 50+ free online tools for SEO, AI content generation, business automation, file conversion, and more. Professional-grade tools, completely free.",
  "url": "https://exyconn.com/tools",
  "publisher": {
    "@type": "Organization",
    "name": "Exyconn",
    "logo": {
      "@type": "ImageObject",
      "url": "https://ik.imagekit.io/esdata1/exyconn/logo/exyconn.svg"
    }
  },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": toolCategories.flatMap((category, catIndex) =>
      category.items.map((tool, toolIndex) => ({
        "@type": "ListItem",
        "position": catIndex * 10 + toolIndex + 1,
        "item": {
          "@type": "SoftwareApplication",
          "name": tool.name,
          "description": tool.description,
          "url": `https://tools.exyconn.com${tool.url}`,
          "applicationCategory": category.category,
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          }
        }
      }))
    )
  }
};
---

<Page
  title="Free Online Tools | SEO, AI & Automation | Exyconn"
  description="Discover 50+ free online tools for SEO optimization, sitemap generation, AI content creation, business automation, file conversion, and more. Professional-grade tools, no signup required."
  keywords={seoKeywords}
  metaImage="https://ik.imagekit.io/esdata1/exyconn/og/tools-og.png"
>
  <!-- Structured Data -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-indigo-600 via-purple-600 to-pink-500 overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; viewBox=&quot;0 0 60 60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cg fill=&quot;none&quot; fill-rule=&quot;evenodd&quot;%3E%3Cg fill=&quot;%23ffffff&quot; fill-opacity=&quot;1&quot;%3E%3Cpath d=&quot;M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z&quot;/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-sm rounded-full px-4 py-2 mb-6">
          <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
          <span class="text-white text-sm font-medium">{totalToolsCount} Active Tools</span>
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
          Free Online Tools for
          <span class="block text-transparent bg-clip-text bg-gradient-to-r from-yellow-200 to-pink-200">SEO, AI & Business</span>
        </h1>

        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-10 leading-relaxed">
          Professional-grade tools for sitemap generation, SEO optimization, AI content creation, 
          file conversion, and business automation. All free, no signup required.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="#all-tools"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white text-indigo-600 font-semibold px-8 py-4 rounded-xl hover:bg-gray-100 transition-all shadow-lg"
          >
            <i class="fa-solid fa-rocket"></i>
            Browse All {totalToolsCount} Tools
          </a>
          <a
            href="#seo-tools"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white/10 backdrop-blur-sm text-white font-semibold px-8 py-4 rounded-xl border border-white/30 hover:bg-white/20 transition-all"
          >
            <i class="fa-solid fa-sitemap"></i>
            SEO & Sitemap Tools
          </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-6 max-w-xl mx-auto mt-16">
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-white">{totalToolsCount}+</div>
            <div class="text-sm text-white/70 mt-1">Free Tools</div>
          </div>
          <div class="text-center border-x border-white/20">
            <div class="text-3xl md:text-4xl font-bold text-white">100%</div>
            <div class="text-sm text-white/70 mt-1">Free Forever</div>
          </div>
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-white">No</div>
            <div class="text-sm text-white/70 mt-1">Signup Required</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Wave Divider -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg class="w-full h-16 fill-white" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V95.8C57.1,118.64,124.72,93.37,163.14,81.62,216.27,65.19,260.29,67.64,321.39,56.44Z"></path>
      </svg>
    </div>
  </section>

  <!-- Quick Navigation - Sticky with Horizontal Scroll on Mobile -->
  <section class="py-4 md:py-6 bg-white/95 backdrop-blur-md border-b border-gray-100 sticky top-0 z-50 shadow-sm" id="all-tools">
    <div class="max-w-7xl mx-auto px-4 lg:px-8">
      <div class="flex items-center gap-3 overflow-x-auto scrollbar-hide pb-2 md:pb-0 md:flex-wrap md:justify-center -mx-4 px-4 md:mx-0 md:px-0">
        {toolCategories.map((category) => (
          <a
            href={`#${category.slug}`}
            class="inline-flex items-center gap-2 px-4 py-2.5 bg-gray-50 hover:bg-indigo-50 rounded-full text-sm font-medium text-gray-700 hover:text-indigo-600 border border-gray-200 hover:border-indigo-200 transition-all whitespace-nowrap flex-shrink-0"
          >
            <i class={`${category.icon} text-xs`} style={`color: ${category.color}`}></i>
            <span class="hidden sm:inline">{category.category.replace(' Tools', '')}</span>
            <span class="sm:hidden">{category.category.replace(' Tools', '').split(' ')[0]}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Tools Categories Section -->
  <section class="py-16 bg-white" id="seo-tools">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Explore Our Free Online Tools
        </h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          From SEO optimization and sitemap generation to AI-powered content creation and file conversion. 
          Find the perfect tool for your needs - all completely free.
        </p>
      </div>

      <!-- Categories Grid -->
      <div class="space-y-20">
        {toolCategories.map((category) => (
          <div
            class="tools-category scroll-mt-32"
            id={category.slug}
          >
            <!-- Category Header -->
            <div class="flex flex-col md:flex-row md:items-center gap-4 mb-8">
              <div 
                class="w-14 h-14 rounded-2xl flex items-center justify-center text-white shadow-lg"
                style={`background: linear-gradient(135deg, ${category.color}, ${category.color}dd)`}
              >
                <i class={`${category.icon} text-2xl`}></i>
              </div>
              <div class="flex-1">
                <h3 class="text-2xl md:text-3xl font-bold text-gray-900">{category.category}</h3>
                <p class="text-gray-600 mt-1">{category.description}</p>
              </div>
              <div class="text-sm text-gray-500 bg-gray-100 px-4 py-2 rounded-full">
                {category.items.length} tools
              </div>
            </div>

            <!-- Tools Grid -->
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
              {category.items.map((tool) => (
                <a
                  href={`/tools/${tool.toolCode}`}
                  class="group block rounded-2xl p-5 transition-all duration-300 bg-white border border-gray-200 hover:shadow-xl hover:border-gray-300 hover:-translate-y-1 cursor-pointer"
                >
                  <div class="flex items-start gap-4">
                    <div
                      class="w-11 h-11 rounded-xl flex items-center justify-center text-white shrink-0 transition-transform group-hover:scale-110"
                      style={`background-color: ${tool.color}`}
                    >
                      <i class={`${tool.icon} text-base`}></i>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 mb-1.5 flex-wrap">
                        <h4 class="font-semibold text-sm transition-colors text-gray-900 group-hover:text-indigo-600">
                          {tool.name}
                        </h4>
                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-green-100 text-green-700">
                          FREE
                        </span>
                        {tool.isMVP && (
                          <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-amber-100 text-amber-700">
                            MVP
                          </span>
                        )}
                      </div>
                      <p class="text-xs text-gray-500 line-clamp-2 leading-relaxed">{tool.description}</p>
                    </div>
                  </div>
                  <div class="flex items-center justify-end mt-4 pt-3 border-t border-gray-100">
                    <span class="text-xs text-indigo-600 font-medium group-hover:text-indigo-700 inline-flex items-center gap-1">
                      Learn More
                      <i class="fa-solid fa-arrow-right text-[10px] group-hover:translate-x-1 transition-transform"></i>
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Why Choose Exyconn Free Tools?
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Professional-grade tools built with modern technology, designed for speed and reliability.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
          <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center mb-4">
            <i class="fa-solid fa-gift text-green-600 text-xl"></i>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">100% Free Forever</h3>
          <p class="text-sm text-gray-600">
            All tools are completely free. No hidden charges, no premium tiers, no credit card required.
          </p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
          <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mb-4">
            <i class="fa-solid fa-user-slash text-blue-600 text-xl"></i>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">No Signup Required</h3>
          <p class="text-sm text-gray-600">
            Start using tools instantly. No account creation, no email verification, no hassle.
          </p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
          <div class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center mb-4">
            <i class="fa-solid fa-shield-halved text-purple-600 text-xl"></i>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Privacy First</h3>
          <p class="text-sm text-gray-600">
            Your data is processed securely and never stored. We respect your privacy completely.
          </p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
          <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center mb-4">
            <i class="fa-solid fa-bolt text-amber-600 text-xl"></i>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Lightning Fast</h3>
          <p class="text-sm text-gray-600">
            Built with modern technology for blazing-fast performance and instant results.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Popular Tools Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Most Popular Free Tools
        </h2>
        <p class="text-lg text-gray-600">
          Our most used tools by businesses and professionals worldwide.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {toolCategories
          .flatMap(cat => cat.items)
          .slice(0, 4)
          .map((tool) => (
            <a
              href={`/tools/${tool.toolCode}`}
              class="group bg-gradient-to-br from-gray-50 to-white border border-gray-200 rounded-2xl p-6 hover:shadow-xl hover:border-indigo-200 transition-all hover:-translate-y-1"
            >
              <div 
                class="w-14 h-14 rounded-2xl flex items-center justify-center text-white mb-4 group-hover:scale-110 transition-transform"
                style={`background-color: ${tool.color}`}
              >
                <i class={`${tool.icon} text-xl`}></i>
              </div>
              <h3 class="font-bold text-gray-900 mb-2 group-hover:text-indigo-600 transition-colors">
                {tool.name}
              </h3>
              <p class="text-sm text-gray-600 mb-4 line-clamp-2">{tool.description}</p>
              <span class="inline-flex items-center gap-2 text-indigo-600 font-medium text-sm">
                Learn More
                <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
              </span>
            </a>
          ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section for SEO -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Frequently Asked Questions
        </h2>
        <p class="text-lg text-gray-600">
          Everything you need to know about our free online tools.
        </p>
      </div>

      <div class="space-y-4">
        <details class="bg-white rounded-xl border border-gray-200 p-6 group" open>
          <summary class="font-semibold text-gray-900 cursor-pointer list-none flex items-center justify-between">
            Are these tools really free?
            <i class="fa-solid fa-chevron-down text-gray-400 group-open:rotate-180 transition-transform"></i>
          </summary>
          <p class="mt-4 text-gray-600">
            Yes, all our tools are 100% free to use. There are no hidden charges, no premium tiers, and no credit card required. We believe in providing value to the community.
          </p>
        </details>

        <details class="bg-white rounded-xl border border-gray-200 p-6 group">
          <summary class="font-semibold text-gray-900 cursor-pointer list-none flex items-center justify-between">
            Do I need to create an account?
            <i class="fa-solid fa-chevron-down text-gray-400 group-open:rotate-180 transition-transform"></i>
          </summary>
          <p class="mt-4 text-gray-600">
            No account is required. You can start using any of our tools instantly without signing up or providing any personal information.
          </p>
        </details>

        <details class="bg-white rounded-xl border border-gray-200 p-6 group">
          <summary class="font-semibold text-gray-900 cursor-pointer list-none flex items-center justify-between">
            Is my data secure?
            <i class="fa-solid fa-chevron-down text-gray-400 group-open:rotate-180 transition-transform"></i>
          </summary>
          <p class="mt-4 text-gray-600">
            Absolutely. Your data is processed securely and is never stored on our servers beyond your session. We prioritize your privacy and data security.
          </p>
        </details>

        <details class="bg-white rounded-xl border border-gray-200 p-6 group">
          <summary class="font-semibold text-gray-900 cursor-pointer list-none flex items-center justify-between">
            What types of tools do you offer?
            <i class="fa-solid fa-chevron-down text-gray-400 group-open:rotate-180 transition-transform"></i>
          </summary>
          <p class="mt-4 text-gray-600">
            We offer {totalToolsCount}+ tools across categories including: SEO & Sitemap Tools, AI Chat Tools, File Converters, AI Content Generators, Business Automation Tools, and FAQ Generators.
          </p>
        </details>

        <details class="bg-white rounded-xl border border-gray-200 p-6 group">
          <summary class="font-semibold text-gray-900 cursor-pointer list-none flex items-center justify-between">
            Can I use these tools for commercial purposes?
            <i class="fa-solid fa-chevron-down text-gray-400 group-open:rotate-180 transition-transform"></i>
          </summary>
          <p class="mt-4 text-gray-600">
            Yes, you can use the output from our free tools for both personal and commercial purposes without any restrictions.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-br from-gray-900 to-gray-800">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
        Ready to Boost Your Productivity?
      </h2>
      <p class="text-lg text-gray-300 mb-10 max-w-2xl mx-auto">
        Start using our free online tools today and supercharge your workflow. 
        No signup required, completely free forever.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#all-tools"
          class="inline-flex items-center gap-3 bg-gradient-to-r from-indigo-500 to-purple-500 text-white font-semibold px-10 py-4 rounded-xl hover:from-indigo-600 hover:to-purple-600 transition-all shadow-lg shadow-indigo-500/30"
        >
          <i class="fa-solid fa-rocket"></i>
          Explore All {totalToolsCount} Tools
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm text-white font-semibold px-8 py-4 rounded-xl border border-white/20 hover:bg-white/20 transition-all"
        >
          <i class="fa-solid fa-message"></i>
          Request a Tool
        </a>
      </div>
    </div>
  </section>
</Page>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  details summary::-webkit-details-marker {
    display: none;
  }

  .scroll-mt-32 {
    scroll-margin-top: 8rem;
  }

  /* Hide scrollbar for Chrome, Safari and Opera */
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  /* Hide scrollbar for IE, Edge and Firefox */
  .scrollbar-hide {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>
