---
import Page from "../../layouts/Page.astro";
import { getTool, getToolCategories, getTools } from "../../lib/portal";

const { id } = Astro.params;

const tool = id ? await getTool(id) : null;

if (!tool) {
  return new Response(null, { status: 404 });
}

const [categories, categoryTools] = await Promise.all([
  getToolCategories(),
  getTools(tool.categorySlug),
]);

const category = categories.find((item) => item.slug === tool.categorySlug);
const relatedTools = categoryTools
  .filter((item) => item.toolCode !== tool.toolCode)
  .slice(0, 4);

// Generate structured data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: tool.name,
  description: tool.description,
  applicationCategory: "WebApplication",
  operatingSystem: "All",
  url: `https://exyconn.com/tools/${tool.toolCode}`,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  provider: {
    "@type": "Organization",
    name: "Exyconn",
    url: "https://exyconn.com",
  },
};

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://exyconn.com",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Tools",
      item: "https://exyconn.com/tools",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: category?.category || "Tool",
      item: `https://exyconn.com/tools#${category?.slug}`,
    },
    {
      "@type": "ListItem",
      position: 4,
      name: tool.name,
      item: `https://exyconn.com/tools/${tool.toolCode}`,
    },
  ],
};

const keywords = tool.keywords?.join(", ") || `${tool.name}, online tool, free tool, exyconn`;
const pageTitle = `${tool.name} - Free Online Tool | Exyconn`;
const pageDescription = tool.longDescription || tool.description;
---

<Page title={pageTitle} description={pageDescription} keywords={keywords}>
  <head slot="head">
    <!-- SEO Meta Tags -->
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`https://exyconn.com/tools/${tool.toolCode}`} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={tool.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://exyconn.com/tools/${tool.toolCode}`} />
    <meta property="og:site_name" content="Exyconn" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={tool.description} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
    />
  </head>

  <main class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <!-- Breadcrumb -->
    <nav class="bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="flex items-center space-x-2 text-sm">
          <li>
            <a
              href="/"
              class="text-gray-500 hover:text-indigo-600 dark:text-gray-400 dark:hover:text-indigo-400 transition-colors"
            >
              <i class="fa-solid fa-house"></i>
            </a>
          </li>
          <li class="text-gray-400 dark:text-gray-500">/</li>
          <li>
            <a
              href="/tools"
              class="text-gray-500 hover:text-indigo-600 dark:text-gray-400 dark:hover:text-indigo-400 transition-colors"
            >
              Tools
            </a>
          </li>
          <li class="text-gray-400 dark:text-gray-500">/</li>
          <li>
            <a
              href={`/tools#${category?.slug}`}
              class="text-gray-500 hover:text-indigo-600 dark:text-gray-400 dark:hover:text-indigo-400 transition-colors"
            >
              {category?.category}
            </a>
          </li>
          <li class="text-gray-400 dark:text-gray-500">/</li>
          <li
            class="text-gray-900 dark:text-white font-medium truncate max-w-[150px] sm:max-w-none"
          >
            {tool.name}
          </li>
        </ol>
      </div>
    </nav>

    <!-- Hero Section -->
    <section
      class="bg-gradient-to-br from-indigo-600 via-purple-600 to-pink-500 text-white py-16 sm:py-20"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-12">
          <div class="flex-1 text-center lg:text-left">
            <div
              class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full text-sm mb-6"
            >
              <i class={category?.icon + " text-white/80"}></i>
              <span>{category?.category}</span>
            </div>

            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4 leading-tight">
              {tool.name}
            </h1>

            <p class="text-lg sm:text-xl text-white/90 mb-8 max-w-2xl">
              {tool.description}
            </p>

            <div
              class="flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start"
            >
              <a
                href={`https://tools.exyconn.com${tool.url}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-white text-indigo-600 px-8 py-4 rounded-xl font-semibold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300"
              >
                <i class="fa-solid fa-rocket"></i>
                Use Tool Now
                <i class="fa-solid fa-arrow-up-right-from-square text-sm"></i>
              </a>

              <div class="flex items-center gap-2 text-white/80">
                <i class="fa-solid fa-check-circle"></i>
                <span>Free to use • No signup required</span>
              </div>
            </div>
          </div>

          <div class="flex-shrink-0">
            <div
              class="w-32 h-32 sm:w-40 sm:h-40 rounded-3xl flex items-center justify-center shadow-2xl"
              style={`background-color: ${tool.color}20; border: 3px solid ${tool.color}`}
            >
              <i class={tool.icon + " text-6xl sm:text-7xl"} style={`color: ${tool.color}`}></i>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <section class="py-12 sm:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-3 gap-8 lg:gap-12">
          <!-- Left Column - Main Content -->
          <div class="lg:col-span-2 space-y-8">
            <!-- About This Tool -->
            <div
              class="bg-white dark:bg-gray-800 rounded-2xl p-6 sm:p-8 shadow-lg border border-gray-100 dark:border-gray-700"
            >
              <h2
                class="text-2xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3"
              >
                <i class="fa-solid fa-circle-info text-indigo-600"></i>
                About This Tool
              </h2>
              <p class="text-gray-600 dark:text-gray-300 text-lg leading-relaxed">
                {tool.longDescription || tool.description}
              </p>
            </div>

            <!-- Features -->
            {
              tool.features && tool.features.length > 0 && (
                <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 sm:p-8 shadow-lg border border-gray-100 dark:border-gray-700">
                  <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
                    <i class="fa-solid fa-star text-yellow-500" />
                    Key Features
                  </h2>
                  <ul class="grid sm:grid-cols-2 gap-4">
                    {tool.features?.map((feature: string) => (
                      <li class="flex items-start gap-3">
                        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center mt-0.5">
                          <i class="fa-solid fa-check text-green-600 dark:text-green-400 text-xs" />
                        </span>
                        <span class="text-gray-700 dark:text-gray-300">{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            <!-- Use Cases -->
            {
              tool.useCases && tool.useCases.length > 0 && (
                <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 sm:p-8 shadow-lg border border-gray-100 dark:border-gray-700">
                  <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
                    <i class="fa-solid fa-lightbulb text-amber-500" />
                    Use Cases
                  </h2>
                  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    {tool.useCases?.map((useCase: string) => (
                      <div class="bg-gray-50 dark:bg-gray-700/50 rounded-xl p-4 border border-gray-100 dark:border-gray-600">
                        <i class="fa-solid fa-user-check text-indigo-500 mb-2" />
                        <p class="text-gray-700 dark:text-gray-300 text-sm">{useCase}</p>
                      </div>
                    ))}
                  </div>
                </div>
              )
            }

            <!-- How to Use -->
            <div
              class="bg-white dark:bg-gray-800 rounded-2xl p-6 sm:p-8 shadow-lg border border-gray-100 dark:border-gray-700"
            >
              <h2
                class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3"
              >
                <i class="fa-solid fa-book-open text-blue-500"></i>
                How to Use
              </h2>
              <ol class="space-y-4">
                <li class="flex items-start gap-4">
                  <span
                    class="flex-shrink-0 w-8 h-8 rounded-full bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center text-indigo-600 dark:text-indigo-400 font-bold"
                    >1</span
                  >
                  <div>
                    <h3 class="font-semibold text-gray-900 dark:text-white">
                      Click "Use Tool Now"
                    </h3>
                    <p class="text-gray-600 dark:text-gray-400 text-sm">
                      Opens the tool in a new tab on our tools platform
                    </p>
                  </div>
                </li>
                <li class="flex items-start gap-4">
                  <span
                    class="flex-shrink-0 w-8 h-8 rounded-full bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center text-indigo-600 dark:text-indigo-400 font-bold"
                    >2</span
                  >
                  <div>
                    <h3 class="font-semibold text-gray-900 dark:text-white">Enter Your Input</h3>
                    <p class="text-gray-600 dark:text-gray-400 text-sm">
                      Provide the text, data, or file that you want to process
                    </p>
                  </div>
                </li>
                <li class="flex items-start gap-4">
                  <span
                    class="flex-shrink-0 w-8 h-8 rounded-full bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center text-indigo-600 dark:text-indigo-400 font-bold"
                    >3</span
                  >
                  <div>
                    <h3 class="font-semibold text-gray-900 dark:text-white">Get Instant Results</h3>
                    <p class="text-gray-600 dark:text-gray-400 text-sm">
                      View, copy, or download your processed output
                    </p>
                  </div>
                </li>
              </ol>
            </div>
          </div>

          <!-- Right Column - Sidebar -->
          <div class="space-y-6">
            <!-- CTA Card -->
            <div
              class="bg-gradient-to-br from-indigo-600 to-purple-600 rounded-2xl p-6 text-white shadow-xl"
            >
              <div class="text-center">
                <div
                  class="w-16 h-16 mx-auto rounded-2xl flex items-center justify-center mb-4"
                  style="background-color: rgba(255,255,255,0.2);"
                >
                  <i class={tool.icon + " text-3xl"}></i>
                </div>
                <h3 class="text-xl font-bold mb-2">Ready to Use?</h3>
                <p class="text-white/80 text-sm mb-4">
                  Start using {tool.name} for free, no registration needed.
                </p>
                <a
                  href={`https://tools.exyconn.com${tool.url}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block w-full bg-white text-indigo-600 py-3 px-6 rounded-xl font-semibold hover:bg-gray-100 transition-colors"
                >
                  Open Tool <i class="fa-solid fa-arrow-right ml-2"></i>
                </a>
              </div>
            </div>

            <!-- Tool Info Card -->
            <div
              class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg border border-gray-100 dark:border-gray-700"
            >
              <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Tool Information</h3>
              <ul class="space-y-3 text-sm">
                <li class="flex items-center justify-between">
                  <span class="text-gray-500 dark:text-gray-400">Category</span>
                  <span class="text-gray-900 dark:text-white font-medium">{category?.category}</span
                  >
                </li>
                <li class="flex items-center justify-between">
                  <span class="text-gray-500 dark:text-gray-400">Price</span>
                  <span class="text-green-600 dark:text-green-400 font-medium">Free</span>
                </li>
                <li class="flex items-center justify-between">
                  <span class="text-gray-500 dark:text-gray-400">Registration</span>
                  <span class="text-gray-900 dark:text-white font-medium">Not Required</span>
                </li>
                <li class="flex items-center justify-between">
                  <span class="text-gray-500 dark:text-gray-400">Platform</span>
                  <span class="text-gray-900 dark:text-white font-medium">Web Browser</span>
                </li>
              </ul>
            </div>

            <!-- Share Card -->
            <div
              class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg border border-gray-100 dark:border-gray-700"
            >
              <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Share This Tool</h3>
              <div class="flex items-center gap-3">
                <a
                  href={`https://twitter.com/intent/tweet?text=Check out this ${tool.name} tool!&url=https://exyconn.com/tools/${tool.toolCode}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 flex items-center justify-center gap-2 bg-[#1DA1F2] text-white py-2.5 px-4 rounded-lg hover:bg-[#1a8cd8] transition-colors"
                >
                  <i class="fa-brands fa-twitter"></i>
                </a>
                <a
                  href={`https://www.linkedin.com/sharing/share-offsite/?url=https://exyconn.com/tools/${tool.toolCode}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 flex items-center justify-center gap-2 bg-[#0A66C2] text-white py-2.5 px-4 rounded-lg hover:bg-[#094d8a] transition-colors"
                >
                  <i class="fa-brands fa-linkedin-in"></i>
                </a>
                <button
                  onclick="navigator.clipboard.writeText(window.location.href); this.innerHTML = '<i class=\'fa-solid fa-check\'></i>'; setTimeout(() => this.innerHTML = '<i class=\'fa-solid fa-link\'></i>', 2000)"
                  class="flex-1 flex items-center justify-center gap-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 py-2.5 px-4 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors"
                >
                  <i class="fa-solid fa-link"></i>
                </button>
              </div>
            </div>

            <!-- Back to Tools -->
            <a
              href="/tools"
              class="flex items-center justify-center gap-2 text-gray-600 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors py-3"
            >
              <i class="fa-solid fa-arrow-left"></i>
              <span>Back to All Tools</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Related Tools -->
    {
      relatedTools.length > 0 && (
        <section class="py-12 bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 text-center">
              Related {category?.category}
            </h2>
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
              {relatedTools.map((relatedTool) => (
                <a
                  href={`/tools/${relatedTool.toolCode}`}
                  class="group bg-gray-50 dark:bg-gray-700/50 rounded-xl p-5 border border-gray-200 dark:border-gray-600 hover:border-indigo-300 dark:hover:border-indigo-500 hover:shadow-lg transition-all duration-300"
                >
                  <div
                    class="w-12 h-12 rounded-xl flex items-center justify-center mb-4"
                    style={`background-color: ${relatedTool.color}15`}
                  >
                    <i
                      class={relatedTool.icon + " text-xl"}
                      style={`color: ${relatedTool.color}`}
                    />
                  </div>
                  <h3 class="font-semibold text-gray-900 dark:text-white mb-2 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                    {relatedTool.name}
                  </h3>
                  <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-2">
                    {relatedTool.description}
                  </p>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- CTA Section -->
    <section class="py-16 bg-gradient-to-r from-indigo-600 to-purple-600 text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold mb-4">Explore More Free Tools</h2>
        <p class="text-lg text-white/80 mb-8 max-w-2xl mx-auto">
          Discover our collection of 50+ free online tools designed to make your work easier and
          more efficient.
        </p>
        <a
          href="/tools"
          class="inline-flex items-center gap-2 bg-white text-indigo-600 px-8 py-4 rounded-xl font-semibold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300"
        >
          <i class="fa-solid fa-th-large"></i>
          Browse All Tools
        </a>
      </div>
    </section>
  </main>
</Page>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
