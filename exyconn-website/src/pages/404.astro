---
import ChapterHeading from "../components/inner/ChapterHeading.astro";
import CtaBand from "../components/inner/CtaBand.astro";
import InnerStage from "../components/inner/InnerStage.astro";
import LinkCard from "../components/inner/LinkCard.astro";
import Page from "../layouts/Page.astro";
import { NOT_FOUND_COPY as copy, NOT_FOUND_LINKS } from "../lib/content/not-found";

// Prerender to dist/client/404.html so the Astro Node adapter (and any
// reverse proxy) can serve it reliably for unmatched routes in production.
export const prerender = true;

// Ensure proper HTTP 404 status (avoids soft-404s in Search Console)
Astro.response.status = 404;
Astro.response.statusText = "Not Found";
---

<Page
  metaTitle={copy.metaTitle}
  metaDescription={copy.metaDescription}
  metaKeywords={copy.metaKeywords}
  noindex={true}
>
  <InnerStage
    family="company"
    crumbs={[{ label: copy.label }]}
    title={copy.title}
    lede={copy.lede}
    primary={copy.primary}
    secondary={copy.secondary}
    scene={{ shapes: ["globe"] }}
  />

  <section class="inner-section stage-shell" aria-labelledby="not-found-routes">
    <ChapterHeading
      index={1}
      label={copy.chapterLabel}
      title={copy.chapterTitle}
      id="not-found-routes"
    />
    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mt-10">
      {
        NOT_FOUND_LINKS.map((link, index) => (
          <li>
            <LinkCard
              href={link.href}
              index={String(index + 1).padStart(2, "0")}
              title={link.title}
              text={link.text}
              more={copy.more}
            />
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand
    family="company"
    label={copy.ctaLabel}
    title={copy.ctaTitle}
    text={copy.ctaText}
    primary={copy.ctaPrimary}
  />
</Page>
