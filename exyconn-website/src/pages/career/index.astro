---
import Page from "../../layouts/Page.astro";
import {
  getCompanySummaries,
  getDaysAgo,
  getJobCompanies,
  getJobsWithCompanies,
  getOpenGigs,
} from "../../lib/portal";

// The group company advertises cross-brand roles and gets its own card below,
// so it is kept out of the individual-company grid.
const GROUP_COMPANY_SLUG = "group";

const [allJobs, jobCompanies, activeGigs] = await Promise.all([
  getJobsWithCompanies(),
  getJobCompanies(),
  getOpenGigs(),
]);

const jobs = allJobs.map(({ job }) => job);
const companies = getCompanySummaries(jobCompanies, jobs).filter(
  (company) => company.slug !== GROUP_COMPANY_SLUG
);
const groupJobs = jobs.filter((job) => job.companySlug === GROUP_COMPANY_SLUG);
const totalJobs = jobs.length;
const totalGigs = activeGigs.length;

// Category icon mapping for gigs
const gigCategoryIcons: Record<string, string> = {
  Development: "fa-code",
  Design: "fa-palette",
  Writing: "fa-pen-fancy",
  Marketing: "fa-bullhorn",
  Video: "fa-video",
  Data: "fa-database",
  "AI/ML": "fa-robot",
  Other: "fa-briefcase",
};

const gigCategoryColors: Record<string, string> = {
  Development: "#3b82f6",
  Design: "#ec4899",
  Writing: "#8b5cf6",
  Marketing: "#f59e0b",
  Video: "#ef4444",
  Data: "#10b981",
  "AI/ML": "#6366f1",
  Other: "#6b7280",
};

// Decorative dot-pattern background for the Group Roles card. Kept as a JS
// string (rather than inline entity-encoded markup) so it parses cleanly
// inside JSX expressions.
const groupCardBg =
  "background-image: url(\"data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23fff' fill-opacity='0.3' fill-rule='evenodd'%3E%3Ccircle cx='20' cy='20' r='5'/%3E%3C/g%3E%3C/svg%3E\");";
---

<Page
  metaTitle="Careers & Freelance Gigs | Exyconn"
  metaDescription="Explore career opportunities across Exyconn, Spentiva, Sibera, and Duncit. Full-time roles and freelance gigs in AI, FinTech, community apps, and more."
  metaKeywords="careers, jobs, freelance, gigs, AI jobs, SaaS jobs, remote jobs, Exyconn careers"
  metaImage="/career/og-image.png"
>
  <main class="bg-slate-50 min-h-screen">
    <!-- Hero Section - Light Mode -->
    <section
      class="relative py-24 px-6 overflow-hidden bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100"
    >
      <!-- Grid Pattern Overlay -->
      <div
        class="absolute inset-0 opacity-30"
        style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%234f46e5' fill-opacity='0.08'%3E%3Ccircle cx='1' cy='1' r='1'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&quot;);"
      >
      </div>

      <!-- Floating Orbs -->
      <div class="absolute top-20 left-10 w-72 h-72 bg-blue-200/40 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-10 w-96 h-96 bg-purple-200/30 rounded-full blur-3xl">
      </div>
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-indigo-100/40 rounded-full blur-3xl"
      >
      </div>

      <div class="relative z-10 max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <!-- Live Badge -->
          <div
            class="inline-flex items-center gap-3 px-5 py-2.5 bg-white/70 backdrop-blur-md rounded-full border border-slate-200 shadow-sm mb-8"
          >
            <span class="relative flex h-3 w-3">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
              ></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
            </span>
            <span class="text-slate-700 font-medium"
              >{totalJobs} Jobs + {totalGigs} Gigs Available</span
            >
          </div>

          <h1
            class="text-5xl md:text-7xl font-black text-slate-900 mb-6 leading-tight tracking-tight"
          >
            Build. Create.<br />
            <span
              class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent"
            >
              Grow With Us.
            </span>
          </h1>

          <p class="text-xl text-slate-600 max-w-2xl mx-auto mb-10">
            Join our ecosystem of innovative companies. Full-time roles, group positions, or
            freelance gigs — find your perfect opportunity.
          </p>

          <!-- Quick Links -->
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href="#companies"
              class="px-6 py-3 bg-slate-900 text-white font-bold rounded-full hover:bg-slate-800 transition shadow-xl"
            >
              <i class="fa-solid fa-building mr-2"></i>View Companies
            </a>
            <a
              href="#freelance"
              class="px-6 py-3 bg-white text-slate-700 font-bold rounded-full border border-slate-200 hover:bg-slate-50 transition shadow-sm"
            >
              <i class="fa-solid fa-laptop-code mr-2"></i>Freelance Gigs
            </a>
          </div>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
          {
            [
              {
                value: companies.length,
                label: "Companies",
                icon: "fa-building",
                color: "from-blue-500 to-cyan-400",
              },
              {
                value: totalJobs,
                label: "Open Roles",
                icon: "fa-briefcase",
                color: "from-violet-500 to-purple-400",
              },
              {
                value: totalGigs,
                label: "Freelance Gigs",
                icon: "fa-laptop-code",
                color: "from-amber-500 to-orange-400",
              },
              {
                value: "100%",
                label: "Remote Options",
                icon: "fa-globe",
                color: "from-emerald-500 to-teal-400",
              },
            ].map((stat) => (
              <div class="group bg-white/80 backdrop-blur-sm rounded-2xl p-5 border border-slate-200 shadow-sm hover:shadow-lg transition-all duration-300">
                <div
                  class={`w-10 h-10 rounded-xl bg-gradient-to-br ${stat.color} flex items-center justify-center mb-3`}
                >
                  <i class={`fa-solid ${stat.icon} text-white`} />
                </div>
                <div class="text-3xl font-black text-slate-900 mb-1">{stat.value}</div>
                <div class="text-sm text-slate-500">{stat.label}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Companies Section -->
    <section id="companies" class="py-20 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-14">
          <span
            class="inline-block px-4 py-1.5 bg-indigo-100 text-indigo-700 rounded-full text-sm font-semibold mb-4"
          >
            OUR ECOSYSTEM
          </span>
          <h2 class="text-4xl font-black text-slate-900 mb-4">Explore by Company</h2>
          <p class="text-slate-600 max-w-xl mx-auto">
            Each brand has unique culture, products, and opportunities. Find your perfect match.
          </p>
        </div>

        <!-- Company Cards Grid -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
          {
            companies.map((company) => (
              <a
                href={`/career/company/${company.slug}`}
                class="group relative bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 border border-slate-100"
              >
                {/* Content */}
                <div class="py-6 px-6">
                  {/* Job Count Badge */}
                  <div class="absolute top-4 right-4">
                    <span
                      class="px-3 py-1.5 backdrop-blur-sm rounded-full text-white text-sm font-bold"
                      style={`background: ${company.brandColor};`}
                    >
                      {company.activeJobCount} {company.activeJobCount === 1 ? "role" : "roles"}
                    </span>
                  </div>
                  {/* Logo Badge */}
                  <div class="flex items-center gap-4 mb-4">
                    <div class="w-14 h-14 bg-white rounded-xl shadow-md flex items-center justify-center p-2 border border-slate-100 group-hover:scale-105 transition-transform duration-300">
                      <img
                        src={company.logo}
                        alt={company.name}
                        class="w-full h-full object-contain"
                      />
                    </div>
                    <div>
                      <h3 class="text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition">
                        {company.name}
                      </h3>
                      <p class="text-sm text-slate-500">{company.industry}</p>
                    </div>
                  </div>

                  <p class="text-sm text-slate-600 line-clamp-2 mb-4">{company.tagline}</p>

                  <div class="flex items-center text-sm font-medium text-slate-400 group-hover:text-indigo-600 transition">
                    View openings
                    <i class="fa-solid fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform" />
                  </div>
                </div>
              </a>
            ))
          }
        </div>

        <!-- Group Roles Card -->
        {
          groupJobs.length > 0 && (
            <a
              href="/career/company/group"
              class="group block bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 rounded-2xl p-8 text-white relative overflow-hidden"
            >
              <div class="absolute inset-0 opacity-20" style={groupCardBg} />

              <div class="relative flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div class="flex items-center gap-5">
                  <div class="w-16 h-16 bg-white/20 backdrop-blur-sm rounded-2xl flex items-center justify-center">
                    <i class="fa-solid fa-layer-group text-3xl" />
                  </div>
                  <div>
                    <div class="flex items-center gap-3 mb-2">
                      <h3 class="text-2xl font-bold">Group Roles</h3>
                      <span class="px-2.5 py-1 bg-white/20 rounded-full text-sm font-semibold">
                        {groupJobs.length} positions
                      </span>
                    </div>
                    <p class="text-white/80">
                      Work across all {companies.length} companies. One role, unlimited variety.
                    </p>
                  </div>
                </div>

                <div class="flex items-center gap-3">
                  <div class="flex -space-x-3">
                    {companies.slice(0, 4).map((c) => (
                      <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-lg border-2 border-indigo-600">
                        <img src={c.logo} alt={c.name} class="w-6 h-6 object-contain" />
                      </div>
                    ))}
                    <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center text-xs font-bold">
                      +{companies.length - 4}
                    </div>
                  </div>
                  <i class="fa-solid fa-arrow-right text-2xl group-hover:translate-x-2 transition-transform" />
                </div>
              </div>
            </a>
          )
        }
      </div>
    </section>

    <!-- All Jobs Section -->
    <section id="jobs" class="py-20 px-6 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
          <div>
            <span
              class="inline-block px-4 py-1.5 bg-blue-100 text-blue-700 rounded-full text-sm font-semibold mb-4"
            >
              FULL-TIME POSITIONS
            </span>
            <h2 class="text-4xl font-black text-slate-900 mb-2">All Open Roles</h2>
            <p class="text-slate-600">{totalJobs} opportunities across our portfolio</p>
          </div>
        </div>

        <!-- Jobs List -->
        <div class="space-y-4">
          {
            allJobs.map(({ job, company }) => (
              <a
                href={`/career/company/${company.slug}/job/${job.jobCode}`}
                class="group flex flex-col lg:flex-row lg:items-center gap-5 bg-slate-50 hover:bg-white rounded-2xl p-6 border border-transparent hover:border-slate-200 hover:shadow-xl transition-all duration-300"
              >
                {/* Company Logo */}
                <div
                  class="w-14 h-14 rounded-xl flex items-center justify-center shrink-0"
                  style={`background: ${company.brandColor}15;`}
                >
                  <img src={company.logo} alt={company.name} class="w-10 h-10 object-contain" />
                </div>

                {/* Job Info */}
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-3 flex-wrap mb-2">
                    <h3 class="text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition">
                      {job.title}
                    </h3>
                    <span class="px-2 py-0.5 bg-slate-200 text-slate-500 rounded text-xs font-mono">
                      #{job.jobCode}
                    </span>
                    {job.isFeatured && (
                      <span class="px-2 py-0.5 bg-amber-100 text-amber-700 rounded text-xs font-semibold">
                        <i class="fa-solid fa-star text-[10px] mr-1" />
                        Featured
                      </span>
                    )}
                  </div>

                  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-500">
                    <span class="font-medium" style={`color: ${company.brandColor};`}>
                      {company.name}
                    </span>
                    <span class="flex items-center gap-1">
                      <i class="fa-solid fa-location-dot text-xs" />
                      {job.location}
                    </span>
                    <span class="flex items-center gap-1">
                      <i class="fa-solid fa-clock text-xs" />
                      {job.workMode}
                    </span>
                    {job.salaryRange && (
                      <span class="flex items-center gap-1">
                        <i class="fa-solid fa-indian-rupee-sign text-xs" />
                        {job.salaryRange}
                      </span>
                    )}
                  </div>
                </div>

                {/* Meta & Arrow */}
                <div class="flex items-center gap-4 shrink-0">
                  <span class="text-xs text-slate-400">{getDaysAgo(job.jobPostDate)}</span>
                  <div class="w-10 h-10 rounded-full bg-slate-100 group-hover:bg-indigo-600 flex items-center justify-center transition-all">
                    <i class="fa-solid fa-arrow-right text-slate-400 group-hover:text-white transition" />
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Freelance Gigs Section -->
    <section
      id="freelance"
      class="py-20 px-6 bg-gradient-to-br from-amber-50 via-orange-50 to-yellow-50"
    >
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-14">
          <span
            class="inline-block px-4 py-1.5 bg-amber-100 text-amber-700 rounded-full text-sm font-semibold mb-4"
          >
            <i class="fa-solid fa-bolt mr-1"></i>FREELANCE OPPORTUNITIES
          </span>
          <h2 class="text-4xl font-black text-slate-900 mb-4">Short-Term Gigs & Projects</h2>
          <p class="text-slate-600 max-w-xl mx-auto mb-6">
            Contract-based work for skilled freelancers. Quick projects, fair pay, flexible timing.
          </p>
          <a
            href="/career/gigs"
            class="inline-flex items-center gap-2 px-6 py-3 bg-amber-500 text-white font-bold rounded-full hover:bg-amber-600 transition shadow-lg"
          >
            <i class="fa-solid fa-grid-2"></i>
            View All {activeGigs.length} Gigs
          </a>
        </div>

        <!-- Gigs Grid (Preview - First 6) -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            activeGigs.slice(0, 6).map((gig) => (
              <a
                href={`/career/gig/${gig.gigCode}`}
                class="group block bg-white rounded-2xl p-6 shadow-sm hover:shadow-xl border border-slate-100 hover:border-amber-200 transition-all duration-300 relative overflow-hidden"
              >
                {/* Urgent Badge */}
                {gig.isUrgent && (
                  <div class="absolute top-4 right-4">
                    <span class="px-2.5 py-1 bg-red-100 text-red-600 rounded-full text-xs font-bold animate-pulse">
                      <i class="fa-solid fa-fire mr-1" />
                      Urgent
                    </span>
                  </div>
                )}

                {/* Category Icon */}
                <div
                  class="w-12 h-12 rounded-xl flex items-center justify-center mb-4"
                  style={`background: ${gigCategoryColors[gig.category]}15;`}
                >
                  <i
                    class={`fa-solid ${gigCategoryIcons[gig.category]} text-xl`}
                    style={`color: ${gigCategoryColors[gig.category]};`}
                  />
                </div>

                {/* Content */}
                <div class="flex items-center gap-2 mb-2">
                  <span
                    class="px-2 py-0.5 rounded text-xs font-semibold"
                    style={`background: ${gigCategoryColors[gig.category]}15; color: ${gigCategoryColors[gig.category]};`}
                  >
                    {gig.category}
                  </span>
                  <span class="px-2 py-0.5 bg-slate-200 text-slate-500 rounded text-xs font-mono">
                    #{gig.gigCode}
                  </span>
                </div>

                <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition">
                  {gig.title}
                </h3>

                <p class="text-sm text-slate-600 mb-4 line-clamp-2">{gig.shortDescription}</p>

                {/* Tags */}
                <div class="flex flex-wrap gap-1.5 mb-4">
                  {gig.tags.slice(0, 4).map((tag) => (
                    <span class="px-2 py-0.5 bg-slate-100 text-slate-600 rounded text-xs">
                      {tag}
                    </span>
                  ))}
                  {gig.tags.length > 4 && (
                    <span class="px-2 py-0.5 bg-slate-100 text-slate-500 rounded text-xs">
                      +{gig.tags.length - 4}
                    </span>
                  )}
                </div>

                {/* Meta */}
                <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                  <div class="flex flex-col gap-1 text-sm">
                    <span class="text-emerald-600 font-bold">{gig.budget}</span>
                    <span class="text-slate-500 text-xs">{gig.duration}</span>
                  </div>

                  <div class="w-10 h-10 rounded-full bg-slate-100 group-hover:bg-amber-500 flex items-center justify-center transition-all">
                    <i class="fa-solid fa-arrow-right text-slate-400 group-hover:text-white transition" />
                  </div>
                </div>
              </a>
            ))
          }
        </div>

        {/* View All Button */}
        {
          activeGigs.length > 6 && (
            <div class="text-center mt-10">
              <a
                href="/career/gigs"
                class="inline-flex items-center gap-2 px-8 py-4 bg-slate-900 text-white font-bold rounded-full hover:bg-slate-800 transition shadow-lg"
              >
                View All {activeGigs.length} Freelance Gigs
                <i class="fa-solid fa-arrow-right" />
              </a>
            </div>
          )
        }
      </div>
    </section>

    <!-- Why Join Section -->
    <section class="py-20 px-6 bg-white">
      <div class="max-w-6xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <span
              class="inline-block px-4 py-1.5 bg-emerald-100 text-emerald-700 rounded-full text-sm font-semibold mb-4"
            >
              WHY JOIN US
            </span>
            <h2 class="text-4xl font-black text-slate-900 mb-6">Built for Growth</h2>
            <p class="text-slate-600 mb-8">
              We're not just offering jobs — we're offering a chance to build something meaningful
              across multiple industries.
            </p>

            <div class="space-y-5">
              {
                [
                  {
                    icon: "fa-house-laptop",
                    title: "Remote-First Culture",
                    desc: "Work from anywhere. Flexible hours. Trust-based environment.",
                    color: "bg-blue-100 text-blue-600",
                  },
                  {
                    icon: "fa-rocket",
                    title: "Startup Speed, Stability",
                    desc: "Move fast with the backing of an established ecosystem.",
                    color: "bg-purple-100 text-purple-600",
                  },
                  {
                    icon: "fa-graduation-cap",
                    title: "Learning & Growth",
                    desc: "Annual learning budget. Mentorship. Cross-company exposure.",
                    color: "bg-amber-100 text-amber-600",
                  },
                  {
                    icon: "fa-heart-pulse",
                    title: "Health & Wellness",
                    desc: "Comprehensive insurance. Mental health support. Wellness programs.",
                    color: "bg-rose-100 text-rose-600",
                  },
                ].map((perk) => (
                  <div class="flex items-start gap-4">
                    <div
                      class={`w-12 h-12 rounded-xl flex items-center justify-center shrink-0 ${perk.color}`}
                    >
                      <i class={`fa-solid ${perk.icon} text-xl`} />
                    </div>
                    <div>
                      <h4 class="font-bold text-slate-900 mb-1">{perk.title}</h4>
                      <p class="text-sm text-slate-600">{perk.desc}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Company Logos Cloud -->
          <div class="relative">
            <div
              class="absolute inset-0 bg-gradient-to-br from-indigo-100/50 to-purple-100/50 rounded-3xl"
            >
            </div>
            <div class="relative p-10">
              <p class="text-center text-sm text-slate-500 mb-8 font-medium">OUR PORTFOLIO</p>
              <div class="grid grid-cols-3 gap-6">
                {
                  companies.map((c) => (
                    <a
                      href={`/career/company/${c.slug}`}
                      class="bg-white rounded-2xl p-5 shadow-sm hover:shadow-lg transition-all duration-300 flex items-center justify-center aspect-square group"
                    >
                      <img
                        src={c.logo}
                        alt={c.name}
                        class="w-12 h-12 object-contain group-hover:scale-110 transition-transform"
                      />
                    </a>
                  ))
                }
                <div
                  class="bg-gradient-to-br from-indigo-600 to-purple-600 rounded-2xl p-5 flex flex-col items-center justify-center aspect-square text-white"
                >
                  <i class="fa-solid fa-layer-group text-2xl mb-2"></i>
                  <span class="text-xs font-bold">GROUP</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 px-6 bg-slate-900 relative overflow-hidden">
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.4'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&quot;);"
      >
      </div>

      <div class="relative max-w-4xl mx-auto text-center">
        <h2 class="text-4xl font-black text-white mb-4">Don't See Your Role?</h2>
        <p class="text-slate-400 text-lg mb-10 max-w-xl mx-auto">
          We're always looking for exceptional talent. Drop us your resume and we'll reach out when
          there's a match.
        </p>

        <div class="flex flex-wrap justify-center gap-4">
          <a
