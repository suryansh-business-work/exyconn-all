---
import Page from "../../../../layouts/Page.astro";
import { getDaysAgo, getJobCompany, getJobs } from "../../../../lib/portal";

// Get company slug from URL
const { companySlug } = Astro.params;

if (!companySlug) {
  return new Response(null, { status: 404 });
}

// Get company and its active jobs from the portal
const [company, activeJobs] = await Promise.all([getJobCompany(companySlug), getJobs(companySlug)]);

// Handle 404
if (!company) {
  return new Response(null, { status: 404 });
}

// Get unique categories for filtering
const categories = [...new Set(activeJobs.map((job) => job.category))];
---

<Page
  metaTitle={`Careers at ${company.name} | Exyconn`}
  metaDescription={`Join ${company.name} - ${company.tagline}. Explore ${activeJobs.length} open positions in ${company.industry}.`}
  metaKeywords={`${company.name} careers, ${company.name} jobs, ${company.industry} jobs, remote jobs`}
  metaImage={company.logo}
>
  <main class="bg-surface min-h-screen">
    <!-- Hero Section with Company Branding -->
    <section
      class="relative py-20 px-6 overflow-hidden"
      style={`background: linear-gradient(135deg, ${company.brandColor}10, ${company.secondaryColor}10);`}
    >
      <div
        class="absolute top-20 right-20 w-80 h-80 rounded-full blur-3xl opacity-30"
        style={`background: ${company.brandColor};`}
      ></div>
      <div
        class="absolute bottom-10 left-10 w-96 h-96 rounded-full blur-3xl opacity-20"
        style={`background: ${company.secondaryColor};`}
      ></div>

      <div class="relative z-10 max-w-5xl mx-auto">
        <!-- Breadcrumb -->
        <nav class="mb-8">
          <ol class="flex items-center gap-2 text-sm">
            <li>
              <a href="/career" class="text-fg-subtle hover:text-fg-secondary transition">Careers</a>
            </li>
            <li class="text-fg-faint">/</li>
            <li class="font-medium" style={`color: ${company.brandColor};`}>{company.name}</li>
          </ol>
        </nav>

        <div class="flex flex-col md:flex-row items-start gap-8">
          <!-- Company Logo -->
          <div
            class="w-24 h-24 bg-surface rounded-2xl shadow-lg flex items-center justify-center overflow-hidden shrink-0"
          >
            <img src={company.logo} alt={`${company.name} logo`} class="w-full h-full object-contain p-3" />
          </div>

          <!-- Company Info -->
          <div class="flex-1">
            <h1 class="text-4xl md:text-5xl font-bold text-fg mb-3">{company.name}</h1>
            <p class="text-xl text-fg-muted mb-4">{company.tagline}</p>

            <div class="flex flex-wrap gap-4 text-sm mb-6">
              <span class="inline-flex items-center gap-2 text-fg-muted">
                <i class="fa-solid fa-building text-fg-faint"></i>
                {company.industry}
              </span>
              <span class="inline-flex items-center gap-2 text-fg-muted">
                <i class="fa-solid fa-location-dot text-fg-faint"></i>
                {company.headquarters}
              </span>
              {company.employees && (
                <span class="inline-flex items-center gap-2 text-fg-muted">
                  <i class="fa-solid fa-users text-fg-faint"></i>
                  {company.employees} employees
                </span>
              )}
              {company.founded && (
                <span class="inline-flex items-center gap-2 text-fg-muted">
                  <i class="fa-solid fa-calendar text-fg-faint"></i>
                  Founded {company.founded}
                </span>
              )}
            </div>

            <div class="flex flex-wrap gap-3">
              <span
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full font-semibold text-on-solid"
                style={`background: ${company.brandColor};`}
              >
                <i class="fa-solid fa-briefcase"></i>
                {activeJobs.length} Open Positions
              </span>
              {company.website && (
                <a
                  href={company.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-full font-medium bg-surface-muted text-fg-secondary hover:bg-surface-strong transition"
                >
                  <i class="fa-solid fa-globe"></i>
                  Visit Website
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Company Section -->
    <section class="py-16 px-6 bg-surface border-b border-line-subtle">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl font-bold text-fg mb-6">About {company.name}</h2>
        <div class="prose prose-lg max-w-none text-fg-muted" set:html={company.description} />
      </div>
    </section>

    <!-- Culture Section -->
    <section class="py-16 px-6 bg-surface-subtle">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl font-bold text-fg mb-6">Our Culture</h2>
        <div class="prose prose-lg max-w-none text-fg-muted" set:html={company.culture} />
      </div>
    </section>

    <!-- Benefits Section -->
    <section class="py-16 px-6 bg-surface">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl font-bold text-fg mb-8 text-center">Why Join {company.name}?</h2>
        <div class="grid md:grid-cols-3 gap-6">
          {
            company.benefits.map((benefit) => (
              <div class="bg-surface-subtle rounded-2xl p-6 hover:shadow-lg transition-all duration-300 border border-line-subtle">
                <div
                  class="w-12 h-12 rounded-xl flex items-center justify-center mb-4"
                  style={`background: ${company.brandColor}15;`}
                >
                  <i class={`fa-solid ${benefit.icon} text-xl`} style={`color: ${company.brandColor};`} />
                </div>
                <h4 class="font-bold text-fg mb-2">{benefit.title}</h4>
                <p class="text-sm text-fg-muted">{benefit.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Open Positions Section -->
    <section id="open-positions" class="py-20 px-6 bg-gradient-to-br from-surface-subtle to-blue-subtle">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-fg mb-4">Open Positions</h2>
          <p class="text-fg-muted">Find your next opportunity at {company.name}.</p>
        </div>

        <!-- Category Filter -->
        {categories.length > 1 && (
          <div class="relative -mx-6 px-6 lg:mx-0 lg:px-0 mb-8">
            <div class="flex gap-2 overflow-x-auto pb-2 lg:pb-0 lg:overflow-visible lg:flex-wrap lg:justify-center" id="category-filter" style="-ms-overflow-style: none; scrollbar-width: none;">
              <button
                class="category-btn active px-4 py-2 rounded-full text-sm font-medium bg-inverse text-on-solid transition whitespace-nowrap shrink-0"
                data-category="all"
              >
                All ({activeJobs.length})
              </button>
              {categories.map((category) => {
                const count = activeJobs.filter((j) => j.category === category).length;
                return (
                  <button
                    class="category-btn px-4 py-2 rounded-full text-sm font-medium bg-surface text-fg-muted border border-line hover:border-line-strong transition whitespace-nowrap shrink-0"
                    data-category={category}
                  >
                    {category} ({count})
                  </button>
                );
              })}
            </div>
          </div>
        )}

        <!-- Job Listings -->
        <div class="space-y-4" id="job-listings">
          {
            activeJobs.map((job) => (
              <a
                href={`/career/company/${company.slug}/job/${job.jobCode}`}
                class="job-card bg-surface rounded-2xl p-6 shadow-sm border border-line-subtle hover:shadow-lg hover:border-blue-soft transition-all duration-300 group block"
                data-category={job.category}
              >
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                  <div class="flex-1">
                    <div class="flex items-center gap-3 mb-2 flex-wrap">
                      <h3 class="text-lg font-bold text-fg group-hover:text-blue-fg transition">
                        {job.title}
                      </h3>
                      <span class="px-2 py-0.5 bg-surface-muted text-fg-muted text-xs font-medium rounded-full">
                        {job.category}
                      </span>
                      {job.isFeatured && (
                        <span class="px-2 py-0.5 bg-amber-subtle text-amber-fg text-xs font-medium rounded-full">
                          <i class="fa-solid fa-star text-[10px] mr-1" />
                          Featured
                        </span>
                      )}
                    </div>
                    <p class="text-sm text-fg-muted mb-3">{job.shortJobDescription}</p>
                    <div class="flex flex-wrap gap-3 text-sm">
                      <span class="inline-flex items-center gap-1 text-fg-subtle">
                        <i class="fa-solid fa-location-dot text-xs" /> {job.location}
                      </span>
                      <span class="inline-flex items-center gap-1 text-fg-subtle">
                        <i class="fa-solid fa-clock text-xs" /> {job.jobType}
                      </span>
                      <span class="inline-flex items-center gap-1 text-fg-subtle">
                        <i class="fa-solid fa-laptop-house text-xs" /> {job.workMode}
                      </span>
                      <span class="inline-flex items-center gap-1 text-fg-subtle">
                        <i class="fa-solid fa-calendar text-xs" /> {getDaysAgo(job.jobPostDate)}
                      </span>
                      {job.salaryRange && (
                        <span class="inline-flex items-center gap-1 text-emerald-fg font-medium">
                          <i class="fa-solid fa-indian-rupee-sign text-xs" /> {job.salaryRange}
                        </span>
                      )}
                    </div>
                    <!-- Skills -->
                    <div class="flex flex-wrap gap-2 mt-3">
                      {job.skillSet.slice(0, 5).map((skill) => (
                        <span class="px-2 py-1 bg-blue-subtle text-blue-fg text-xs rounded-md">
                          {skill}
                        </span>
                      ))}
                      {job.skillSet.length > 5 && (
                        <span class="px-2 py-1 bg-surface-muted text-fg-subtle text-xs rounded-md">
                          +{job.skillSet.length - 5} more
                        </span>
                      )}
                    </div>
                  </div>
                  <div class="shrink-0">
                    <span
                      class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-semibold text-on-solid transition"
                      style={`background: ${company.brandColor};`}
                    >
                      View Details <i class="fa-solid fa-arrow-right text-sm" />
                    </span>
                  </div>
                </div>
              </a>
            ))
          }
        </div>

        <!-- No Jobs Message -->
        {activeJobs.length === 0 && (
          <div class="text-center py-12">
            <i class="fa-solid fa-briefcase text-4xl text-line-strong mb-4"></i>
            <p class="text-fg-muted">No open positions at the moment. Check back soon!</p>
          </div>
        )}

        <div class="text-center mt-10">
          <p class="text-fg-muted">
            Don't see a role that fits?
            <a href={`mailto:careers@${company.slug}.com`} class="font-semibold hover:underline" style={`color: ${company.brandColor};`}>
              Send us your resume
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- Social Links -->
    {company.socialLinks && Object.keys(company.socialLinks).length > 0 && (
      <section class="py-12 px-6 bg-surface border-t border-line-subtle">
        <div class="max-w-5xl mx-auto text-center">
          <p class="text-fg-muted mb-4">Follow {company.name}</p>
          <div class="flex justify-center gap-4">
            {company.socialLinks.linkedin && (
              <a
                href={company.socialLinks.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 rounded-full bg-surface-muted flex items-center justify-center text-fg-muted hover:bg-blue-strong hover:text-on-solid transition"
              >
                <i class="fa-brands fa-linkedin-in" />
              </a>
            )}
            {company.socialLinks.twitter && (
              <a
                href={company.socialLinks.twitter}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 rounded-full bg-surface-muted flex items-center justify-center text-fg-muted hover:bg-sky hover:text-on-solid transition"
              >
                <i class="fa-brands fa-twitter" />
              </a>
            )}
            {company.socialLinks.instagram && (
              <a
                href={company.socialLinks.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 rounded-full bg-surface-muted flex items-center justify-center text-fg-muted hover:bg-pink hover:text-on-solid transition"
              >
                <i class="fa-brands fa-instagram" />
              </a>
            )}
            {company.socialLinks.facebook && (
              <a
                href={company.socialLinks.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 rounded-full bg-surface-muted flex items-center justify-center text-fg-muted hover:bg-blue-deep hover:text-on-solid transition"
              >
                <i class="fa-brands fa-facebook-f" />
              </a>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- Back to All Companies -->
    <section class="py-8 px-6 bg-surface-subtle">
      <div class="max-w-5xl mx-auto text-center">
        <a
          href="/career"
          class="inline-flex items-center gap-2 text-fg-muted hover:text-fg transition"
        >
          <i class="fa-solid fa-arrow-left"></i>
          Back to All Companies
        </a>
      </div>
    </section>
  </main>
</Page>

<script>
  // Category filter functionality
  document.addEventListener("DOMContentLoaded", () => {
    const filterButtons = document.querySelectorAll(".category-btn");
    const jobCards = document.querySelectorAll(".job-card");

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const category = btn.getAttribute("data-category");

        // Update active button
        filterButtons.forEach((b) => {
          b.classList.remove("active", "bg-inverse", "text-on-solid");
          b.classList.add("bg-surface", "text-fg-muted", "border", "border-line");
        });
        btn.classList.add("active", "bg-inverse", "text-on-solid");
        btn.classList.remove("bg-surface", "text-fg-muted", "border", "border-line");

        // Filter jobs
        jobCards.forEach((card) => {
          const jobCategory = card.getAttribute("data-category");
          if (category === "all" || jobCategory === category) {
            (card as HTMLElement).style.display = "block";
          } else {
            (card as HTMLElement).style.display = "none";
          }
        });
      });
    });
  });
</script>
