---
import Page from "../../../../layouts/Page.astro";
import { gigCategoryColors } from "../../../../lib/gigCategoryColors";
import { getDaysAgo, getGig, getOpenGigs } from "../../../../lib/portal";

// gigId carries the gig code (e.g. "GIG-DES-001")
const { gigId } = Astro.params;

if (!gigId) {
  return new Response(null, { status: 404 });
}

const [gig, openGigs] = await Promise.all([getGig(gigId), getOpenGigs()]);

if (!gig) {
  return new Response(null, { status: 404 });
}

const postedAgo = getDaysAgo(gig.postedDate);

const relatedGigs = openGigs
  .filter((g) => g.category === gig.category && g.gigCode !== gig.gigCode)
  .slice(0, 3);

// Category icons (their colours come from lib/gigCategoryColors)
const gigCategoryIcons: Record<string, string> = {
  Development: "fa-code",
  Design: "fa-palette",
  Writing: "fa-pen-fancy",
  Video: "fa-video",
  Data: "fa-database",
  Marketing: "fa-bullhorn",
};
---

<Page title={`${gig.title} | Freelance Gig | Exyconn`} description={gig.shortDescription}>
  <main class="bg-surface-subtle min-h-screen">
    <!-- Header -->
    <section
      class="border-b border-line py-6 px-6 sticky top-0 z-50 backdrop-blur-lg bg-surface/95"
    >
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        <a
          href="/career/gigs"
          class="flex items-center gap-2 text-fg-muted hover:text-fg transition"
        >
          <i class="fa-solid fa-arrow-left"></i>
          <span class="font-medium">Back to All Gigs</span>
        </a>

        <div class="flex items-center gap-3">
          <span class="text-sm text-fg-subtle">Posted {postedAgo}</span>
          {
            gig.isUrgent && (
              <span class="px-3 py-1.5 bg-red text-on-solid rounded-full text-xs font-bold animate-pulse">
                <i class="fa-solid fa-fire mr-1" />
                URGENT
              </span>
            )
          }
          <a
            href={`mailto:${gig.applicationContact}?subject=Application for ${gig.title}`}
            class="px-6 py-2.5 bg-amber text-on-solid font-bold rounded-full hover:bg-amber-strong transition shadow-lg"
          >
            Apply Now
          </a>
        </div>
      </div>
    </section>

    <!-- Hero -->
    <section class="py-16 px-6 bg-gradient-to-br from-surface-subtle to-surface-muted">
      <div class="max-w-6xl mx-auto">
        <div class="flex items-start gap-6">
          <!-- Icon -->
          <div
            class="w-20 h-20 rounded-2xl flex items-center justify-center shrink-0 shadow-lg"
            style={`background: ${gigCategoryColors(gig.category).solid};`}
          >
            <i class={`fa-solid ${gigCategoryIcons[gig.category]} text-3xl text-on-solid`}></i>
          </div>

          <!-- Content -->
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-4">
              <span
                class="px-3 py-1.5 rounded-lg text-sm font-semibold"
                style={`background: ${gigCategoryColors(gig.category).tint}; color: ${gigCategoryColors(gig.category).ink};`}
              >
                {gig.category}
              </span>
              <span class="px-2.5 py-1 bg-surface-strong text-fg-muted rounded text-sm font-mono">
                #{gig.gigCode}
              </span>
              {
                gig.status === "open" && (
                  <span class="px-3 py-1 bg-green-soft text-green-fg-strong rounded-full text-xs font-bold">
                    <i class="fa-solid fa-circle text-[8px] mr-1 animate-pulse" />
                    OPEN
                  </span>
                )
              }
            </div>

            <h1 class="text-4xl md:text-5xl font-black text-fg mb-4 leading-tight">
              {gig.title}
            </h1>

            <p class="text-xl text-fg-muted mb-6">
              {gig.shortDescription}
            </p>

            <div class="flex flex-wrap items-center gap-6">
              <div class="flex items-center gap-2">
                <i class="fa-solid fa-wallet text-emerald-fg"></i>
                <div>
                  <div class="text-xs text-fg-subtle">Budget</div>
                  <div class="text-lg font-bold text-emerald-fg">{gig.budget}</div>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <i class="fa-solid fa-clock text-blue-fg"></i>
                <div>
                  <div class="text-xs text-fg-subtle">Duration</div>
                  <div class="text-lg font-bold text-fg">{gig.duration}</div>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <i class="fa-solid fa-calendar text-purple-fg"></i>
                <div>
                  <div class="text-xs text-fg-subtle">Posted</div>
                  <div class="text-lg font-bold text-fg">Posted {postedAgo}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <section class="py-16 px-6">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-3 gap-8">
        <!-- Left Column - Main Content -->
        <div class="lg:col-span-2 space-y-8">
          <!-- Description -->
          <div class="bg-surface rounded-2xl p-8 shadow-sm border border-line">
            <h2 class="text-2xl font-bold text-fg mb-6 flex items-center gap-3">
              <i class="fa-solid fa-file-lines text-amber-fg"></i>
              Project Description
            </h2>
            <div class="prose prose-slate max-w-none" set:html={gig.fullDescription} />
          </div>

          <!-- Deliverables -->
          <div class="bg-surface rounded-2xl p-8 shadow-sm border border-line">
            <h2 class="text-2xl font-bold text-fg mb-6 flex items-center gap-3">
              <i class="fa-solid fa-box-check text-emerald-fg"></i>
              Deliverables
            </h2>
            <ul class="space-y-3">
              {
                gig.deliverables.map((deliverable) => (
                  <li class="flex items-start gap-3">
                    <i class="fa-solid fa-circle-check text-emerald-fg mt-1" />
                    <span class="text-fg-secondary">{deliverable}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Requirements -->
          <div class="bg-surface rounded-2xl p-8 shadow-sm border border-line">
            <h2 class="text-2xl font-bold text-fg mb-6 flex items-center gap-3">
              <i class="fa-solid fa-list-check text-blue-fg"></i>
              Requirements
            </h2>
            <ul class="space-y-3">
              {
                gig.requirements.map((requirement) => (
                  <li class="flex items-start gap-3">
                    <i class="fa-solid fa-star text-amber-fg mt-1" />
                    <span class="text-fg-secondary">{requirement}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Tags -->
          <div class="bg-surface rounded-2xl p-8 shadow-sm border border-line">
            <h2 class="text-2xl font-bold text-fg mb-6 flex items-center gap-3">
              <i class="fa-solid fa-tags text-purple-fg"></i>
              Skills & Technologies
            </h2>
            <div class="flex flex-wrap gap-2">
              {
                gig.tags.map((tag) => (
                  <span class="px-4 py-2 bg-surface-muted text-fg-secondary rounded-lg font-medium hover:bg-surface-strong transition">
                    {tag}
                  </span>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Right Column - Sidebar -->
        <div class="lg:col-span-1">
          <div class="sticky top-24 space-y-6">
            <!-- Apply Card -->
            <div class="bg-surface rounded-2xl p-6 shadow-lg border border-line">
              <h3 class="text-xl font-bold text-fg mb-4">Ready to Apply?</h3>
              <p class="text-sm text-fg-muted mb-6">
                Send us your portfolio and a brief introduction. We'll get back to you within 48
                hours.
              </p>

              <a
                href={`mailto:${gig.applicationContact}?subject=Application for ${gig.title} (${gig.gigCode})`}
                class="block w-full px-6 py-4 bg-amber text-on-solid text-center font-bold rounded-xl hover:bg-amber-strong transition shadow-lg mb-4"
              >
                <i class="fa-solid fa-envelope mr-2"></i>
                Apply via Email
              </a>

              <div class="text-center text-xs text-fg-subtle">
                Application contact: {gig.applicationContact}
              </div>
            </div>

            <!-- Project Info Card -->
            <div
              class="bg-gradient-to-br from-inverse to-indigo-night rounded-2xl p-6 shadow-lg text-on-solid"
            >
              <h3 class="text-lg font-bold mb-4">Project Details</h3>

              <div class="space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-on-solid/10">
                  <span class="text-on-solid/70 text-sm">Budget</span>
                  <span class="font-bold text-emerald-bright">{gig.budget}</span>
                </div>

                <div class="flex items-center justify-between pb-3 border-b border-on-solid/10">
                  <span class="text-on-solid/70 text-sm">Duration</span>
                  <span class="font-semibold">{gig.duration}</span>
                </div>

                <div class="flex items-center justify-between pb-3 border-b border-on-solid/10">
                  <span class="text-on-solid/70 text-sm">Category</span>
                  <span class="font-semibold">{gig.category}</span>
                </div>

                <div class="flex items-center justify-between pb-3 border-b border-on-solid/10">
                  <span class="text-on-solid/70 text-sm">Status</span>
                  <span
                    class="px-2 py-1 bg-green/20 text-green-bright rounded-full text-xs font-bold"
                  >
                    {gig.status === "open" ? "OPEN" : "CLOSED"}
                  </span>
                </div>

                <div class="flex items-center justify-between">
                  <span class="text-on-solid/70 text-sm">Urgency</span>
                  {
                    gig.isUrgent ? (
                      <span class="px-2 py-1 bg-red/20 text-red-bright rounded-full text-xs font-bold animate-pulse">
                        <i class="fa-solid fa-fire mr-1" />
                        URGENT
                      </span>
                    ) : (
                      <span class="text-on-solid/70 text-sm">Normal</span>
                    )
                  }
                </div>
              </div>
            </div>

            <!-- Why Work With Us -->
            <div class="bg-blue-subtle rounded-2xl p-6 border border-blue-soft">
              <h3 class="text-lg font-bold text-fg mb-4">
                <i class="fa-solid fa-heart text-red-fg mr-2"></i>
                Why Work With Us?
              </h3>
              <ul class="space-y-3 text-sm">
                <li class="flex items-start gap-2">
                  <i class="fa-solid fa-check text-green-fg mt-0.5"></i>
                  <span class="text-fg-secondary">Fast payment within 7 days</span>
                </li>
                <li class="flex items-start gap-2">
                  <i class="fa-solid fa-check text-green-fg mt-0.5"></i>
                  <span class="text-fg-secondary">Clear requirements & assets</span>
                </li>
                <li class="flex items-start gap-2">
                  <i class="fa-solid fa-check text-green-fg mt-0.5"></i>
                  <span class="text-fg-secondary">Ongoing collaboration opportunities</span>
                </li>
                <li class="flex items-start gap-2">
                  <i class="fa-solid fa-check text-green-fg mt-0.5"></i>
                  <span class="text-fg-secondary">Work with real SaaS products</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Related Gigs -->
    <section class="py-16 px-6 bg-surface-muted">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-black text-fg mb-8">More Gigs in {gig.category}</h2>

        <div class="grid md:grid-cols-3 gap-6">
          {
            relatedGigs.map((relatedGig) => (
              <a
                href={`/career/gig/${relatedGig.gigCode}`}
                class="group block bg-surface rounded-2xl p-6 shadow-sm hover:shadow-xl border border-line transition-all duration-300"
              >
                <div
                  class="w-12 h-12 rounded-xl flex items-center justify-center mb-4"
                  style={`background: ${gigCategoryColors(relatedGig.category).tint};`}
                >
                  <i
                    class={`fa-solid ${gigCategoryIcons[relatedGig.category]} text-xl`}
                    style={`color: ${gigCategoryColors(relatedGig.category).ink};`}
                  />
                </div>

                <h3 class="text-lg font-bold text-fg mb-2 group-hover:text-amber-fg transition">
                  {relatedGig.title}
                </h3>

                <p class="text-sm text-fg-muted mb-4 line-clamp-2">{relatedGig.shortDescription}</p>

                <div class="flex items-center justify-between text-sm">
                  <span class="text-emerald-fg font-bold">{relatedGig.budget}</span>
                  <span class="text-fg-subtle">{relatedGig.duration}</span>
                </div>
              </a>
            ))
          }
        </div>

        <div class="text-center mt-8">
          <a
            href="/career/gigs"
            class="inline-flex items-center gap-2 px-6 py-3 bg-inverse text-on-solid font-bold rounded-full hover:bg-inverse-muted transition"
          >
            View All Gigs
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </section>
  </main>
</Page>
