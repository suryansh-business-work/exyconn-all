---
import Page from "../layouts/Page.astro";
---

<Page
  metaTitle="Privacy Policy | Data Protection | Exyconn"
  metaDescription="Read Exyconn's privacy policy to learn how we collect, use, and protect your personal information when you use our website and AI automation services."
  metaKeywords="privacy policy, data protection, personal information, cookies, Exyconn"
  metaImage="https://images.pexels.com/photos/34088/pexels-photo.jpg?auto=compress&w=1200&q=80"
>
  <main class="bg-white min-h-screen">
    <!-- Hero Section - Light Background -->
    <section
      class="relative py-20 px-6 bg-gradient-to-br from-blue-50 via-white to-purple-50 overflow-hidden"
    >
      <div
        class="absolute top-20 right-20 w-80 h-80 bg-gradient-to-r from-blue-200/40 to-purple-200/40 rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-10 left-10 w-96 h-96 bg-gradient-to-r from-cyan-200/30 to-blue-200/30 rounded-full blur-3xl"
      >
      </div>

      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <span
          class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-full text-sm font-medium text-gray-600 mb-6 shadow-sm"
        >
          <i class="fa-solid fa-shield-halved text-blue-500"></i>
          Your Privacy Matters
        </span>

        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 tracking-tight">
          Privacy <span
            class="bg-gradient-to-r from-blue-600 to-purple-500 bg-clip-text text-transparent"
            >Policy</span
          >
        </h1>

        <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
          Learn how we collect, use, and protect your personal information.
        </p>

        <p class="text-sm text-gray-500 mt-4">Last updated: June 27, 2025</p>
      </div>
    </section>

    <!-- Content Section -->
    <section class="py-16 px-6">
      <div class="max-w-3xl mx-auto">
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8 md:p-12 space-y-8">
          <div class="space-y-4">
            <h2 class="text-xl font-bold text-gray-900 flex items-center gap-3">
              <span
                class="w-8 h-8 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center text-sm font-bold"
                >1</span
              >
              Introduction
            </h2>
            <p class="text-gray-600 leading-relaxed pl-11">
              Exyconn ("we", "us", or "our") is committed to protecting your privacy. This Privacy
              Policy explains how we collect, use, disclose, and safeguard your information when you
              visit our website and use our AI automation services.
            </p>
          </div>

          <div class="space-y-4">
            <h2 class="text-xl font-bold text-gray-900 flex items-center gap-3">
              <span
                class="w-8 h-8 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center text-sm font-bold"
                >2</span
              >
              Information We Collect
            </h2>
            <ul class="space-y-3 pl-11">
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-user text-blue-500 mt-1"></i>
                <span class="text-gray-600"
                  ><strong class="text-gray-900">Personal Information:</strong> Name, email address, phone
                  number, company name, and other contact details you provide.</span
                >
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-chart-line text-blue-500 mt-1"></i>
                <span class="text-gray-600"
                  ><strong class="text-gray-900">Usage Data:</strong> IP address, browser type, device
                  information, and pages visited.</span
                >
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-cookie text-blue-500 mt-1"></i>
                <span class="text-gray-600"
                  ><strong class="text-gray-900">Cookies & Tracking:</strong> We use cookies and similar
                  technologies to enhance your experience.</span
                >
              </li>
            </ul>
          </div>

          <div class="space-y-4">
            <h2 class="text-xl font-bold text-gray-900 flex items-center gap-3">
              <span
                class="w-8 h-8 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center text-sm font-bold"
                >3</span
              >
              How We Use Your Information
            </h2>
            <ul class="space-y-2 pl-11 text-gray-600">
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-check text-green-500"></i> To provide, operate, and maintain our
                website and services
              </li>
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-check text-green-500"></i> To communicate with you and respond to
                inquiries
              </li>
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-check text-green-500"></i> To improve our products, services, and
                user experience
              </li>
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-check text-green-500"></i> To comply with legal obligations and
                protect our rights
              </li>
            </ul>
          </div>

          <div class="space-y-4">
            <h2 class="text-xl font-bold text-gray-900 flex items-center gap-3">
              <span
                class="w-8 h-8 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center text-sm font-bold"
                >4</span
              >
              Sharing Your Information
            </h2>
            <ul class="space-y-2 pl-11 text-gray-600">
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-xmark text-red-500"></i> We do not sell your personal information
              </li>
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-check text-green-500"></i> We may share with trusted service providers
                under confidentiality agreements
              </li>
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-check text-green-500"></i> We may disclose information if required
                by law
              </li>
            </ul>
          </div>

          <div class="space-y-4">
            <h2 class="text-xl font-bold text-gray-900 flex items-center gap-3">
              <span
                class="w-8 h-8 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center text-sm font-bold"
                >5</span
              >
              Data Security
            </h2>
            <p class="text-gray-600 leading-relaxed pl-11">
              We implement reasonable technical and organizational measures to protect your
              information from unauthorized access, disclosure, alteration, or destruction.
            </p>
          </div>

          <div class="space-y-4">
            <h2 class="text-xl font-bold text-gray-900 flex items-center gap-3">
              <span
                class="w-8 h-8 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center text-sm font-bold"
                >6</span
              >
              Your Rights
            </h2>
            <div class="pl-11 space-y-3">
              <p class="text-gray-600">You have the right to:</p>
              <ul class="space-y-2 text-gray-600">
                <li class="flex items-center gap-2">
                  <i class="fa-solid fa-eye text-blue-500"></i> Access your personal information
                </li>
                <li class="flex items-center gap-2">
                  <i class="fa-solid fa-pen text-blue-500"></i> Correct inaccurate data
                </li>
                <li class="flex items-center gap-2">
                  <i class="fa-solid fa-trash text-blue-500"></i> Delete your personal information
                </li>
                <li class="flex items-center gap-2">
                  <i class="fa-solid fa-ban text-blue-500"></i> Opt out of marketing communications
                </li>
              </ul>
            </div>
          </div>

          <div class="space-y-4">
            <h2 class="text-xl font-bold text-gray-900 flex items-center gap-3">
              <span
                class="w-8 h-8 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center text-sm font-bold"
                >7</span
              >
              Contact Us
            </h2>
            <p class="text-gray-600 leading-relaxed pl-11">
              If you have any questions about this Privacy Policy or our data practices, please
              contact us at <a
                href="mailto:info@exyconn.com"
                class="text-blue-600 hover:underline font-medium">info@exyconn.com</a
              >.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Page>
