  <script>
    // Tab functionality
    document.addEventListener("DOMContentLoaded", () => {
      const tabBtns = document.querySelectorAll(".tab-btn");
      const tabPanels = document.querySelectorAll(".tab-panel");

      tabBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const category = btn.getAttribute("data-tab");

          // Update button styles
          tabBtns.forEach((b) => {
            b.classList.remove("bg-gray-900", "text-white");
            b.classList.add("bg-gray-100", "text-gray-600");
            const badge = b.querySelector("span:last-child");
            if (badge) {
              badge.classList.remove("bg-white/20");
              badge.classList.add("bg-gray-200");
            }
          });
          btn.classList.remove("bg-gray-100", "text-gray-600");
          btn.classList.add("bg-gray-900", "text-white");
          const activeBadge = btn.querySelector("span:last-child");
          if (activeBadge) {
            activeBadge.classList.remove("bg-gray-200");
            activeBadge.classList.add("bg-white/20");
          }

          // Update panel visibility
          tabPanels.forEach((panel) => {
            if (panel.getAttribute("data-panel") === category) {
              panel.classList.remove("hidden");
              panel.classList.add("block");
            } else {
              panel.classList.remove("block");
              panel.classList.add("hidden");
            }
          });
        });
      });
    });
  </script>

