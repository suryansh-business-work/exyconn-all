    </section>

    <!-- The Problem Section -->
    <section class="py-20 px-6 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16">
          <span
            class="inline-flex items-center gap-2 px-4 py-2 bg-red-50 border border-red-100 rounded-full text-sm font-semibold text-red-600 mb-6"
          >
            <i class="fa-solid fa-circle-exclamation"></i>
            The Problem
          </span>
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            Most entrepreneurs struggle to focus on what truly creates business value.
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            To build any product, they must deal with endless technical requirements that distract
            from their core business.
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {
            [
              { icon: "fa-shield-halved", label: "Authentication" },
              { icon: "fa-globe", label: "Website Setup" },
              { icon: "fa-envelope", label: "Emails & SMS" },
              { icon: "fa-chart-simple", label: "Analytics" },
              { icon: "fa-bullhorn", label: "Marketing Tools" },
              { icon: "fa-credit-card", label: "Payments" },
              { icon: "fa-server", label: "Deployment" },
              { icon: "fa-language", label: "Translations" },
