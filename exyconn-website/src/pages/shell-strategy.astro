                  <div class="flex items-center gap-2 mb-3">
                    <i class="fa-solid fa-code text-purple-500"></i>
                    <h4 class="font-semibold text-gray-900">Infrastructure Services</h4>
                  </div>
                  <div class="grid grid-cols-2 gap-2 pl-6">
                    {
                      [
                        "Authentication & SSO",
                        "Email & SMS Services",
                        "File Uploads & CDN",
                        "Logs & Monitoring",
                        "Environment Keys",
                        "Payments & Webhooks",
                        "Translations & i18n",
                        "Themes & Styling",
                        "Notifications",
                        "Cron Jobs",
                      ].map((item) => (
                        <span class="flex items-center gap-2 text-sm text-gray-600">
                          <i class="fa-solid fa-check text-purple-500 text-xs" />
                          {item}
                        </span>
                      ))
                    }
                  </div>
                </div>
              </div>

              <a
                href="#services-table"
                class="mt-6 p-4 bg-purple-50 rounded-xl text-sm text-purple-700 border border-purple-100 flex items-center justify-between group hover:bg-purple-100 transition-colors"
              >
                <strong>All standardized, reusable, secure, and ready from day one.</strong>
                <span class="flex items-center gap-2 font-semibold">
                  Many More
                  <i class="fa-solid fa-arrow-down group-hover:translate-y-1 transition-transform"
                  ></i>
                </span>
              </a>
            </div>
          </div>

          <!-- CORE BUSINESS Card -->
          <div
            class="bg-gradient-to-br from-blue-600 to-cyan-500 rounded-3xl shadow-xl p-8 text-white relative overflow-hidden"
          >
            <div class="absolute top-0 right-0 w-40 h-40 bg-white/10 rounded-full blur-2xl"></div>

            <div class="relative z-10">
              <div class="flex items-center gap-3 mb-6">
                <span class="text-4xl">💎</span>
                <div>
                  <span class="px-3 py-1 bg-white/20 text-white text-xs font-bold rounded-full"
                    >YOU FOCUS HERE</span
                  >
                  <h3 class="text-2xl font-bold mt-1">CORE BUSINESS</h3>
                </div>
              </div>

              <p class="text-blue-100 mb-6">This is where real value is created.</p>

              <!-- Example -->
              <div class="bg-white/10 backdrop-blur-sm rounded-xl p-5 mb-6">
                <p class="text-sm text-blue-100 mb-2">Example:</p>
                <p class="text-lg font-semibold mb-2">If you are building an Expense App</p>
                <p class="text-blue-100">
                  → Focus on <span class="text-white font-medium">expense logic & insights</span>,
                  not login pages or email setup.
                </p>
              </div>

              <div class="mb-6">
                <h4 class="font-semibold mb-3">You define:</h4>
                <ul class="space-y-2 text-blue-100">
                  <li class="flex items-center gap-2">
                    <i class="fa-solid fa-arrow-right text-yellow-300 text-sm"></i> Business logic
                  </li>
                  <li class="flex items-center gap-2">
                    <i class="fa-solid fa-arrow-right text-yellow-300 text-sm"></i> Differentiation
                  </li>
                  <li class="flex items-center gap-2">
                    <i class="fa-solid fa-arrow-right text-yellow-300 text-sm"></i> Market strategy
                  </li>
                  <li class="flex items-center gap-2">
                    <i class="fa-solid fa-arrow-right text-yellow-300 text-sm"></i> Product innovation
                  </li>
