---
import Page from "../layouts/Page.astro";
import DynamicTable from "../components/dynamic-components/DynamicTable.astro";

// Shell Services Data (Removed Dashboard and API Key)
const shellServices = [
  // Communications
  {
    id: "email",
    name: "Email",
    description:
      "Send transactional and marketing emails with template support and delivery tracking.",
    icon: "fa-envelope",
    status: "live",
    category: "Communications",
    features: ["Templates", "History", "Settings"],
  },
  {
    id: "phone",
    name: "Phone",
    description: "Voice calling capabilities with call tracking and recording features.",
    icon: "fa-phone",
    status: "live",
    category: "Communications",
  },
  {
    id: "sms",
    name: "SMS",
    description: "Send and receive SMS messages with delivery reports and templates.",
    icon: "fa-message",
    status: "live",
    category: "Communications",
  },
  {
    id: "chat",
    name: "Chat",
    description: "Real-time chat and instant messaging for web and mobile applications.",
    icon: "fa-comments",
    status: "live",
    category: "Communications",
  },
  {
    id: "web-video",
    name: "Web Video",
    description: "Video conferencing and streaming capabilities for web applications.",
    icon: "fa-video",
    status: "live",
    category: "Communications",
  },
  {
    id: "web-audio",
    name: "Web Audio",
    description: "Audio streaming and voice communication for web applications.",
    icon: "fa-microphone",
    status: "live",
    category: "Communications",
  },
  {
    id: "notifications",
    name: "Notifications",
    description: "Push notifications and in-app notification management.",
    icon: "fa-bell",
    status: "live",
    category: "Communications",
    features: ["Templates", "Settings"],
  },

  // Developer Tools
  {
    id: "logs",
    name: "Logs",
    description: "Centralized logging service for application debugging and monitoring.",
    icon: "fa-file-lines",
    status: "live",
    category: "Developer Tools",
    features: ["Search Logs", "Test Logs", "Settings"],
  },
  {
    id: "ai",
    name: "AI",
    description: "AI-powered services including text generation, analysis, and custom prompts.",
    icon: "fa-robot",
    status: "live",
    category: "Developer Tools",
    features: ["Demo", "Defined Prompts", "AI Models"],
  },
  {
    id: "environment-keys",
    name: "Environment Keys",
    description: "Secure storage and management of environment variables and secrets.",
    icon: "fa-database",
    status: "live",
    category: "Developer Tools",
  },
  {
    id: "global-search",
    name: "Global Search",
    description: "Unified search across all services and resources.",
    icon: "fa-magnifying-glass",
    status: "live",
    category: "Developer Tools",
  },
  {
    id: "timezone-settings",
    name: "Timezone",
    description: "Configure timezone preferences with multi-timezone select and time conversion.",
    icon: "fa-clock",
    status: "live",
    category: "Developer Tools",
  },

  // Storage & Files
  {
    id: "imagekit",
    name: "ImageKit",
    description: "Image optimization, transformation, and CDN delivery service.",
    icon: "fa-cloud-arrow-up",
    status: "live",
    category: "Storage & Files",
    features: ["Demo", "Settings", "Usage"],
  },
  {
    id: "storage-buckets",
    name: "Storage Buckets",
    description: "Secure file storage with access control and versioning.",
    icon: "fa-folder-open",
    status: "live",
    category: "Storage & Files",
    features: ["Folders", "Settings", "Usage"],
  },
  {
    id: "authentication",
    name: "Authentication",
    description:
      "Complete auth solution with SSO, OAuth, magic links, and role-based access control.",
    icon: "fa-shield-halved",
    status: "live",
    category: "Storage & Files",
    features: ["Demo", "Users", "Settings"],
  },
  {
    id: "cms",
    name: "CMS",
    description: "Content management system for dynamic content and media.",
    icon: "fa-newspaper",
    status: "live",
    category: "Storage & Files",
  },

  // Monitoring & Analytics
  {
    id: "site-status",
    name: "Site Status",
    description: "Monitor website uptime and performance with alerts.",
    icon: "fa-heart-pulse",
    status: "live",
    category: "Monitoring & Analytics",
  },
  {
    id: "repo-monitoring",
    name: "Repo Monitoring",
    description: "GitHub repository monitoring for commits, PRs, and issues.",
    icon: "fa-brands fa-github",
    status: "live",
    category: "Monitoring & Analytics",
  },
  {
    id: "click-tracking",
    name: "Click Tracking",
    description: "Track user clicks with custom addresses like 'login.button.click'.",
    icon: "fa-arrow-pointer",
    status: "live",
    category: "Monitoring & Analytics",
    features: ["Demo", "Trackers", "Statistics"],
  },

  // Content & Media
  {
    id: "translations",
    name: "Translations",
    description: "Internationalization and localization management for multi-language support.",
    icon: "fa-language",
    status: "live",
    category: "Content & Media",
    features: ["Locales", "Translation Text"],
  },
  {
    id: "themes",
    name: "Themes",
    description: "Theme management and component styling for consistent UI/UX.",
    icon: "fa-palette",
    status: "live",
    category: "Content & Media",
    features: ["Theme List", "Theme Components"],
  },

  // Infrastructure
  {
    id: "deployments",
    name: "Deployments",
    description: "Deploy and manage applications across multiple environments.",
    icon: "fa-rocket",
    status: "live",
    category: "Infrastructure",
  },
  {
    id: "queue",
    name: "Queue",
    description: "Message queue and background job processing service.",
    icon: "fa-list-check",
    status: "live",
    category: "Infrastructure",
  },
  {
    id: "dynamic-crud",
    name: "Dynamic CRUD",
    description: "Auto-generate CRUD operations for database models.",
    icon: "fa-table",
    status: "live",
    category: "Infrastructure",
  },
  {
    id: "payments",
    name: "Payments",
    description: "Payment processing with refunds, subscriptions, and transaction tracking.",
    icon: "fa-credit-card",
    status: "live",
    category: "Infrastructure",
    features: ["Demo", "Transactions", "Statistics"],
  },
  {
    id: "events",
    name: "Events",
    description: "Event-driven architecture with webhook support for real-time actions.",
    icon: "fa-bolt",
    status: "live",
    category: "Infrastructure",
    features: ["Demo", "Events", "Subscriptions"],
  },
  {
    id: "in-memory-database",
    name: "In-memory Database",
    description: "Redis-like in-memory data store for caching and sessions.",
    icon: "fa-server",
    status: "live",
    category: "Infrastructure",
  },
  {
    id: "cron-jobs",
    name: "Cron Jobs",
    description: "Schedule recurring tasks with webhook support for real-time actions.",
    icon: "fa-calendar-check",
    status: "live",
    category: "Infrastructure",
    features: ["Demo", "Jobs List", "Statistics"],
  },
];

// Group services by category
const servicesByCategory = shellServices.reduce(
  (acc, service) => {
    if (!acc[service.category]) acc[service.category] = [];
    acc[service.category].push(service);
    return acc;
  },
  {} as Record<string, typeof shellServices>
);

const categoryOrder = [
  "Communications",
  "Developer Tools",
  "Storage & Files",
  "Monitoring & Analytics",
  "Content & Media",
  "Infrastructure",
];

const getStatusBadge = (status: string) => {
  switch (status) {
    case "live":
      return { text: "Live", class: "bg-emerald-100 text-emerald-700" };
    case "dev":
      return { text: "In Development", class: "bg-amber-100 text-amber-700" };
    case "soon":
      return { text: "Coming Soon", class: "bg-gray-100 text-gray-600" };
    default:
      return { text: status, class: "bg-gray-100 text-gray-600" };
  }
};

const getCategoryColor = (category: string) => {
  const colors: Record<string, string> = {
    Communications: "from-purple-500 to-pink-500",
    "Developer Tools": "from-emerald-500 to-teal-500",
    "Storage & Files": "from-orange-500 to-amber-500",
    "Monitoring & Analytics": "from-rose-500 to-red-500",
    "Content & Media": "from-indigo-500 to-violet-500",
    Infrastructure: "from-gray-600 to-gray-800",
  };
  return colors[category] || "from-gray-500 to-gray-600";
};

const getCategoryIcon = (category: string) => {
  const icons: Record<string, string> = {
    Communications: "fa-comments",
    "Developer Tools": "fa-code",
    "Storage & Files": "fa-folder-open",
    "Monitoring & Analytics": "fa-chart-line",
    "Content & Media": "fa-palette",
    Infrastructure: "fa-server",
  };
  return icons[category] || "fa-folder";
};
---

<Page
  metaTitle="Shell Strategy | We Build the Shell | Exyconn"
  metaDescription="Share your business idea with us. We handle the entire technical infrastructure—authentication, payments, emails, storage—so you can focus purely on building real business value."
  metaKeywords="MVP development, shell strategy, infrastructure, authentication, SaaS development, API services, email, payments, logs"
  metaImage="https://images.pexels.com/photos/1181675/pexels-photo-1181675.jpeg?auto=compress&w=1200&q=80"
>
  <main class="bg-white min-h-screen">
    <!-- Hero Section -->
    <section
      class="relative py-28 px-6 bg-gradient-to-br from-blue-50 via-white to-cyan-50 overflow-hidden"
    >
      <!-- Terms Link with Jump Animation -->
      <div class="absolute top-6 left-1/2 -translate-x-1/2 z-20">
        <a
          href="/shell-strategy-terms"
          class="inline-flex items-center gap-2 px-6 py-3 bg-white border-2 border-blue-500 rounded-full text-sm font-semibold text-blue-600 hover:bg-blue-50 transition-all shadow-lg hover:shadow-xl animate-jump-smooth"
        >
          <i class="fa-solid fa-file-contract"></i>
          View Terms & Conditions
        </a>
      </div>

      <!-- Background Effects -->
      <div class="absolute inset-0">
        <div
          class="absolute top-20 right-20 w-96 h-96 bg-gradient-to-r from-blue-200/40 to-cyan-200/40 rounded-full blur-3xl"
