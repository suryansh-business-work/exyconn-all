              </div>

              <div class="p-4 bg-white/10 rounded-xl text-center">
                <p class="text-lg font-bold">We manage the SHELL.</p>
                <p class="text-lg font-bold">You build the VALUE.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Complete Infrastructure Stack - Tabbed Section -->
    <section class="py-20 px-6 bg-white" id="infrastructure-stack">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <span
            class="inline-flex items-center gap-2 px-4 py-2 bg-cyan-50 border border-cyan-100 rounded-full text-sm font-semibold text-cyan-700 mb-6"
          >
            <i class="fa-solid fa-terminal"></i>
            Shell Services
          </span>
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            Complete Infrastructure Stack
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Everything you need to build, deploy, and scale—all in one platform.
          </p>
        </div>

        <!-- Tabbed Interface -->
        <div class="infrastructure-tabs">
          <!-- Tab Navigation -->
          <div class="flex flex-wrap justify-center gap-2 mb-8 border-b border-gray-200 pb-4">
            {
              categoryOrder.map((category, index) => (
                <button
                  class={`tab-btn flex items-center gap-2 px-4 py-2.5 rounded-full text-sm font-medium transition-all ${
                    index === 0
                      ? "bg-gray-900 text-white"
                      : "bg-gray-100 text-gray-600 hover:bg-gray-200"
                  }`}
                  data-tab={category}
                >
                  <i class={`fa-solid ${getCategoryIcon(category)} text-xs`} />
                  <span class="hidden sm:inline">{category}</span>
                  <span class="sm:hidden">{category.split(" ")[0]}</span>
                  <span
                    class={`text-xs px-1.5 py-0.5 rounded-full ${
                      index === 0 ? "bg-white/20" : "bg-gray-200"
                    }`}
                  >
                    {servicesByCategory[category]?.length || 0}
                  </span>
                </button>
              ))
            }
          </div>

          <!-- Tab Content - Max 500px height -->
          <div
            class="tab-content-container max-h-[500px] overflow-y-auto rounded-2xl bg-gray-50 p-6"
          >
            {
              categoryOrder.map((category, index) => (
                <div class={`tab-panel ${index === 0 ? "block" : "hidden"}`} data-panel={category}>
                  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
                    {servicesByCategory[category]?.map((service) => {
                      const badge = getStatusBadge(service.status);
                      return (
                        <div class="bg-white rounded-xl p-5 border border-gray-100 hover:shadow-lg hover:border-blue-100 transition-all duration-300 group">
                          <div class="flex items-start justify-between mb-3">
                            <div
                              class={`w-10 h-10 bg-gradient-to-br ${getCategoryColor(category)} rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform`}
                            >
                              <i class={`fa-solid ${service.icon} text-white text-sm`} />
                            </div>
                            <span
                              class={`px-2 py-0.5 text-xs font-semibold rounded-full ${badge.class}`}
                            >
                              {badge.text}
                            </span>
                          </div>
                          <h4 class="font-bold text-gray-900 mb-2">{service.name}</h4>
                          <p class="text-sm text-gray-600 leading-relaxed">{service.description}</p>
                          {service.features && (
                            <div class="flex flex-wrap gap-1.5 mt-3">
                              {service.features.map((feature) => (
                                <span class="px-2 py-0.5 bg-gray-50 border border-gray-200 text-xs text-gray-500 rounded-full">
                                  {feature}
                                </span>
                              ))}
                            </div>
                          )}
                        </div>
                      );
                    })}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Services Summary Table -->
    <section class="py-20 px-6 bg-gray-50" id="services-table">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">All Services at a Glance</h2>
          <p class="text-gray-600">Quick overview of all shell services we handle for you</p>
