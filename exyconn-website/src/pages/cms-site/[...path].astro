---
/**
 * The pages of a site served without markets (a CMS site whose domain is not exyconn.com):
 * the middleware rewrites every page URL of such a host here, with the site it resolved on
 * `locals`. Reached any other way — exyconn.com/cms-site/… — there is no site, so it is a 404.
 */
import CmsPage from "../../layouts/CmsPage.astro";
import { getCmsPage } from "../../lib/cms";

const site = Astro.locals.cmsSite;
const rest = Astro.params.path ?? "";
const page = site ? await getCmsPage(site.site.id, `/${rest}`) : null;

if (!site || !page) {
  return new Response(null, { status: 404 });
}
---

<CmsPage site={site} page={page} path={rest === "" ? "" : `/${rest}`} />
