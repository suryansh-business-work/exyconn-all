---
import GrievanceFormReact from "../components/forms/GrievanceFormReact.tsx";
import Page from "../layouts/Page.astro";
---

<Page
  metaTitle="Raise a Grievance | Report Concerns | Exyconn"
  metaDescription="Submit your grievance or concern to Exyconn. We are committed to transparency, fairness, and prompt resolution for all stakeholders."
>
  <main class="bg-white min-h-screen">
    <!-- Hero Section - Light Background -->
    <section
      class="relative py-20 px-6 bg-gradient-to-br from-blue-50 via-white to-purple-50 overflow-hidden"
    >
      <div
        class="absolute top-20 right-20 w-80 h-80 bg-gradient-to-r from-blue-200/40 to-purple-200/40 rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-10 left-10 w-96 h-96 bg-gradient-to-r from-cyan-200/30 to-blue-200/30 rounded-full blur-3xl"
      >
      </div>

      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <span
          class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-full text-sm font-medium text-gray-600 mb-6 shadow-sm"
        >
          <i class="fa-solid fa-shield-halved text-blue-500"></i>
          We're Here to Listen
        </span>

        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 tracking-tight">
          Raise a <span
            class="bg-gradient-to-r from-blue-600 to-purple-500 bg-clip-text text-transparent"
            >Grievance</span
          >
        </h1>

        <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed mb-4">
          At Exyconn, we uphold the highest standards of integrity, transparency, and
          accountability. If you have a concern or grievance, we encourage you to share it with us.
        </p>

        <p class="text-gray-500 max-w-xl mx-auto">
          All submissions are handled confidentially and reviewed by our compliance team. We strive
          for prompt and just resolution.
        </p>
      </div>
    </section>

    <!-- Our Commitment -->
    <section class="py-12 px-6 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-3 gap-6">
          <div class="flex items-start gap-4 p-6 bg-gray-50 rounded-2xl">
            <div
              class="w-12 h-12 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-xl flex items-center justify-center shrink-0"
            >
              <i class="fa-solid fa-lock text-white"></i>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Confidential</h3>
              <p class="text-sm text-gray-600">Your identity is protected throughout the process</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-6 bg-gray-50 rounded-2xl">
            <div
              class="w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-500 rounded-xl flex items-center justify-center shrink-0"
            >
              <i class="fa-solid fa-scale-balanced text-white"></i>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Fair Review</h3>
              <p class="text-sm text-gray-600">Every concern is reviewed impartially by our team</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-6 bg-gray-50 rounded-2xl">
            <div
              class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-teal-500 rounded-xl flex items-center justify-center shrink-0"
            >
              <i class="fa-solid fa-clock text-white"></i>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Prompt Response</h3>
              <p class="text-sm text-gray-600">We aim to respond within 5 business days</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Grievance Form -->
    <GrievanceFormReact client:load />
  </main>
</Page>
