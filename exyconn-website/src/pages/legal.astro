---
import DynamicFaqs from "../components/dynamic-components/DynamicFaqs.astro";
import DynamicHorizontalTab from "../components/dynamic-components/DynamicHorizontalTab.astro";
import LegalFormReact from "../components/forms/LegalFormReact.tsx";
import Page from "../layouts/Page.astro";

const legalTopics = [
  {
    icon: "fa-copyright",
    title: "Copyright Infringement",
    description: "Report unauthorized use of your content",
  },
  {
    icon: "fa-image",
    title: "Content Takedown",
    description: "Request removal of specific content",
  },
  {
    icon: "fa-trademark",
    title: "Trademark Issues",
    description: "Trademark violations or concerns",
  },
  {
    icon: "fa-user-shield",
    title: "Privacy Concerns",
    description: "Personal data or privacy complaints",
  },
];

const faqs = [
  {
    question: "How long does it take to process a legal or copyright request?",
    answer:
      "Most requests are reviewed within 3-5 business days. Complex cases or those requiring additional information may take longer. We will notify you by email once your request has been processed or if we need more details.",
  },
  {
    question: "What information do I need to provide for a takedown or copyright claim?",
    answer:
      "Please provide a clear description of the content in question, the URL(s) where it appears, proof of ownership or rights, and your contact details. The more information you provide, the faster we can process your request.",
  },
  {
    question: "Will my grievance or legal request be kept confidential?",
    answer:
      "Yes, all submissions are handled confidentially and only shared with our compliance and legal teams as necessary to resolve your issue.",
  },
  {
    question: "What happens after I submit a legal request?",
    answer:
      "Our compliance team will review your submission, verify the details, and take appropriate action. You may be contacted for additional information if needed. We strive to resolve all valid requests promptly and fairly.",
  },
  {
    question: "Can I follow up on my request?",
    answer:
      "Yes, if you have not received a response within 7 business days, you may follow up by replying to our confirmation email or contacting us through our official channels.",
  },
];
---

<Page
  metaTitle="Legal | Exyconn"
  metaDescription="Submit legal requests regarding copyright, content removal, or intellectual property on Exyconn."
  metaKeywords="legal, copyright, takedown, intellectual property, privacy, trademark, Exyconn"
  metaImage="https://images.pexels.com/photos/159832/justice-law-case-hearing-159832.jpeg?auto=compress&w=1200&q=80"
>
  <main class="bg-white min-h-screen">
    <!-- Hero Section -->
    <section
      class="relative py-24 px-6 bg-gradient-to-br from-gray-50 via-white to-amber-50 overflow-hidden"
    >
      <div
        class="absolute top-20 right-20 w-80 h-80 bg-gradient-to-r from-amber-200/40 to-orange-200/40 rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-10 left-10 w-96 h-96 bg-gradient-to-r from-gray-200/30 to-gray-300/30 rounded-full blur-3xl"
      >
      </div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <span
          class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-full text-sm font-medium text-gray-600 mb-8 shadow-sm"
        >
          <i class="fa-solid fa-scale-balanced text-amber-500"></i>
          Legal & Compliance
        </span>

        <h1 class="text-5xl md:text-6xl font-bold text-gray-900 mb-6 tracking-tight">
          Legal &
          <span class="bg-gradient-to-r from-amber-600 to-orange-500 bg-clip-text text-transparent">
            Copyright</span
          > Requests
        </h1>

        <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
          Exyconn respects intellectual property rights and is committed to compliance with all
          applicable laws. Submit your legal concerns below.
        </p>
      </div>
    </section>

    <!-- Legal Topics -->
    <section class="py-16 px-6 bg-white border-b border-gray-100">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {
            legalTopics.map((topic) => (
              <div class="bg-gray-50 rounded-xl p-6 text-center border border-gray-100 hover:shadow-md hover:border-amber-100 transition-all duration-300">
                <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center mx-auto mb-4">
                  <i class={`fa-solid ${topic.icon} text-amber-600 text-lg`} />
                </div>
                <h3 class="font-semibold text-gray-900 mb-1">{topic.title}</h3>
                <p class="text-xs text-gray-500">{topic.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Horizontal Tabs for Legal Topics -->
    <DynamicHorizontalTab
      heading="Legal & Copyright Topics"
      tabs={[
        {
          label: "Copyright Infringement",
          description: "Report unauthorized use of your content",
          content: `<div>
            <h3 class="text-xl font-bold mb-3 text-gray-900">Copyright Infringement</h3>
            <p class="text-gray-600 mb-4">
              If you believe your copyrighted material has been used on our website without permission, you can submit a takedown request. Please provide details and evidence of ownership to help us process your claim efficiently.
            </p>
            <ul class="space-y-2 text-gray-600">
              <li class="flex items-start gap-2"><i class="fa-solid fa-check text-amber-500 mt-1"></i> Images, text, or media used without authorization</li>
              <li class="flex items-start gap-2"><i class="fa-solid fa-check text-amber-500 mt-1"></i> Proof of ownership or rights required</li>
              <li class="flex items-start gap-2"><i class="fa-solid fa-check text-amber-500 mt-1"></i> Swift review and removal if validated</li>
            </ul>
          </div>`,
        },
        {
          label: "Image/Content Takedown",
          description: "Request removal of specific content",
          content: `<div>
            <h3 class="text-xl font-bold mb-3 text-gray-900">Image or Content Takedown</h3>
            <p class="text-gray-600 mb-4">
              To request removal of images or content you own or have rights to, submit a detailed request. We respect all valid takedown notices and act promptly to resolve such issues.
            </p>
            <ul class="space-y-2 text-gray-600">
              <li class="flex items-start gap-2"><i class="fa-solid fa-check text-amber-500 mt-1"></i> Specify the URL(s) of the content in question</li>
              <li class="flex items-start gap-2"><i class="fa-solid fa-check text-amber-500 mt-1"></i> Describe your rights to the content</li>
              <li class="flex items-start gap-2"><i class="fa-solid fa-check text-amber-500 mt-1"></i> We will investigate and respond quickly</li>
            </ul>
          </div>`,
        },
        {
          label: "Trademark & Privacy",
          description: "Trademark or privacy concerns",
          content: `<div>
            <h3 class="text-xl font-bold mb-3 text-gray-900">Trademark & Privacy</h3>
            <p class="text-gray-600 mb-4">
              If you have concerns about trademark misuse or privacy/data issues on our site, please let us know. We are committed to protecting intellectual property and personal data.
            </p>
            <ul class="space-y-2 text-gray-600">
              <li class="flex items-start gap-2"><i class="fa-solid fa-check text-amber-500 mt-1"></i> Trademark violations or impersonation</li>
              <li class="flex items-start gap-2"><i class="fa-solid fa-check text-amber-500 mt-1"></i> Personal data or privacy complaints</li>
              <li class="flex items-start gap-2"><i class="fa-solid fa-check text-amber-500 mt-1"></i> Handled confidentially by our compliance team</li>
            </ul>
          </div>`,
        },
        {
          label: "Other Legal Issues",
          description: "Any other legal or compliance matter",
          content: `<div>
            <h3 class="text-xl font-bold mb-3 text-gray-900">Other Legal Issues</h3>
            <p class="text-gray-600 mb-4">
              For any other legal concerns not listed above, please describe your issue in detail. Our legal and compliance team will review and respond as appropriate.
            </p>
            <ul class="space-y-2 text-gray-600">
              <li class="flex items-start gap-2"><i class="fa-solid fa-check text-amber-500 mt-1"></i> General legal inquiries</li>
              <li class="flex items-start gap-2"><i class="fa-solid fa-check text-amber-500 mt-1"></i> Policy clarification or compliance requests</li>
              <li class="flex items-start gap-2"><i class="fa-solid fa-check text-amber-500 mt-1"></i> We strive for transparency and fairness</li>
            </ul>
          </div>`,
        },
      ]}
    />

    <!-- FAQs -->
    <DynamicFaqs title="Legal & Copyright FAQs" faqs={faqs} />

    <!-- Legal Request Form -->
    <LegalFormReact client:load />

    <!-- Additional Resources -->
    <section class="py-16 px-6 bg-gray-50">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Additional Resources</h2>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/privacy-policy"
            class="inline-flex items-center gap-2 bg-white border border-gray-200 text-gray-700 font-medium px-6 py-3 rounded-full hover:bg-blue-50 hover:border-blue-100 hover:text-blue-600 transition-all"
          >
            <i class="fa-solid fa-shield-halved"></i>
            Privacy Policy
          </a>
          <a
            href="/cookies"
            class="inline-flex items-center gap-2 bg-white border border-gray-200 text-gray-700 font-medium px-6 py-3 rounded-full hover:bg-blue-50 hover:border-blue-100 hover:text-blue-600 transition-all"
          >
            <i class="fa-solid fa-cookie-bite"></i>
            Cookie Policy
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 bg-white border border-gray-200 text-gray-700 font-medium px-6 py-3 rounded-full hover:bg-blue-50 hover:border-blue-100 hover:text-blue-600 transition-all"
          >
            <i class="fa-solid fa-envelope"></i>
            Contact Us
          </a>
          <a
            href="/grievance"
            class="inline-flex items-center gap-2 bg-white border border-gray-200 text-gray-700 font-medium px-6 py-3 rounded-full hover:bg-blue-50 hover:border-blue-100 hover:text-blue-600 transition-all"
          >
            <i class="fa-solid fa-flag"></i>
            Grievance
          </a>
        </div>
      </div>
    </section>
  </main>
</Page>
