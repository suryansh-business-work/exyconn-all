---
import Page from "../layouts/Page.astro";
import DynamicBreadcrumb from "../components/dynamic-components/DynamicBreadcrumb.astro";
import Newsletter from "../components/fragments/Newsletter.astro";
---

<Page
  metaTitle="Shell Strategy Terms & Conditions | Exyconn"
  metaDescription="Understand the terms and conditions of Exyconn's Shell Strategy - our 1-week MVP delivery program. Learn about shell setup vs core product development timelines."
  metaKeywords="shell strategy terms, MVP terms, 1 week MVP, software development terms, Exyconn terms"
>
  <DynamicBreadcrumb />

  <main class="bg-white">
    <!-- Hero Section -->
    <section
      class="relative py-20 px-6 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 overflow-hidden"
    >
      <div class="absolute inset-0">
        <div class="absolute top-20 left-20 w-72 h-72 bg-blue-500/10 rounded-full blur-3xl"></div>
        <div class="absolute bottom-20 right-20 w-80 h-80 bg-purple-500/10 rounded-full blur-3xl">
        </div>
      </div>

      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full text-sm text-gray-300 mb-6"
        >
          <i class="fa-solid fa-file-contract text-blue-400"></i>
          Terms & Conditions
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
          Shell Strategy
          <span
            class="block text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-400 mt-2"
          >
            Terms & Conditions
          </span>
        </h1>

        <p class="text-lg text-gray-400 max-w-2xl mx-auto">
          Comprehensive terms governing our 1-Week MVP Shell Strategy program. Understand what's
          included, timelines, and responsibilities.
        </p>

        <div class="flex flex-wrap justify-center gap-4 mt-8">
          <a
            href="/shell-strategy"
            class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white font-medium rounded-xl hover:bg-blue-700 transition-colors"
          >
            <i class="fa-solid fa-bolt"></i>
            View Shell Strategy
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 text-white font-medium rounded-xl hover:bg-white/20 transition-colors"
          >
            <i class="fa-solid fa-message"></i>
            Contact Us
          </a>
        </div>
      </div>
    </section>

    <!-- Key Information Cards -->
    <section class="py-16 px-6 bg-gray-50">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mb-4">
              <i class="fa-solid fa-clock text-blue-600 text-xl"></i>
            </div>
            <h3 class="font-bold text-gray-900 mb-2">1 Week Timeline</h3>
            <p class="text-gray-600 text-sm">
              Shell setup completed within 7 business days from project kickoff and requirement
              finalization.
            </p>
          </div>

          <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
            <div class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center mb-4">
              <i class="fa-solid fa-puzzle-piece text-purple-600 text-xl"></i>
            </div>
            <h3 class="font-bold text-gray-900 mb-2">Shell vs Core</h3>
            <p class="text-gray-600 text-sm">
              We build the infrastructure shell; you focus on your unique business logic and core
              features.
            </p>
          </div>

          <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
            <div class="w-12 h-12 bg-emerald-100 rounded-xl flex items-center justify-center mb-4">
              <i class="fa-solid fa-handshake text-emerald-600 text-xl"></i>
            </div>
            <h3 class="font-bold text-gray-900 mb-2">Clear Ownership</h3>
            <p class="text-gray-600 text-sm">
              Full ownership of code and infrastructure transferred upon project completion.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <section class="py-16 px-6">
      <div class="max-w-4xl mx-auto">
        <!-- Introduction -->
        <div class="prose prose-lg max-w-none">
          <div class="bg-blue-50 border-l-4 border-blue-500 rounded-r-xl p-6 mb-12">
            <h2 class="text-xl font-bold text-blue-900 mb-2 mt-0">Important Notice</h2>
            <p class="text-blue-800 mb-0">
              These terms apply specifically to Exyconn's Shell Strategy program - our rapid MVP
              delivery service. By engaging with this program, you agree to the following terms and
              conditions.
            </p>
          </div>

          <!-- Section 1: Definitions -->
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
              <span
                class="w-10 h-10 bg-gray-900 text-white rounded-xl flex items-center justify-center text-lg"
                >1</span
              >
              Definitions
            </h2>

            <div class="space-y-6 pl-4 border-l-2 border-gray-200">
              <div>
                <h4 class="font-semibold text-gray-900 mb-2">"Shell" or "Shell Setup"</h4>
                <p class="text-gray-600">
                  Refers to the foundational infrastructure and technical components provided by
                  Exyconn, including but not limited to:
                </p>
                <ul class="list-disc pl-6 mt-2 space-y-1 text-gray-600">
                  <li>Authentication and authorization systems</li>
                  <li>Database architecture and setup</li>
                  <li>API infrastructure and integrations</li>
                  <li>Cloud hosting configuration</li>
                  <li>Basic UI/UX framework and component library</li>
                  <li>CI/CD pipelines and deployment automation</li>
                  <li>Security configurations and best practices</li>
                  <li>Monitoring and logging infrastructure</li>
                </ul>
              </div>

              <div>
                <h4 class="font-semibold text-gray-900 mb-2">"Core Product" or "Core Features"</h4>
                <p class="text-gray-600">
                  Refers to the unique business logic, custom features, and value-adding
                  functionality specific to your product. This includes:
                </p>
                <ul class="list-disc pl-6 mt-2 space-y-1 text-gray-600">
                  <li>Custom business logic and algorithms</li>
                  <li>Industry-specific features and workflows</li>
                  <li>Unique data processing requirements</li>
                  <li>Custom integrations beyond standard APIs</li>
                  <li>Advanced UI customization and branding</li>
                </ul>
              </div>

              <div>
                <h4 class="font-semibold text-gray-900 mb-2">"1-Week MVP"</h4>
                <p class="text-gray-600">
                  The delivery of a complete shell setup within 7 business days from the
                  finalization of requirements and receipt of necessary credentials/access.
                </p>
              </div>
            </div>
          </div>

          <!-- Section 2: Scope of Work -->
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
              <span
                class="w-10 h-10 bg-gray-900 text-white rounded-xl flex items-center justify-center text-lg"
                >2</span
              >
              Scope of Work
            </h2>

            <div class="grid md:grid-cols-2 gap-6 mb-6">
              <!-- What's Included -->
              <div class="bg-green-50 rounded-2xl p-6 border border-green-100">
                <h4 class="font-bold text-green-900 mb-4 flex items-center gap-2">
                  <i class="fa-solid fa-check-circle"></i>
                  What's Included
                </h4>
                <ul class="space-y-3 text-green-800">
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-check text-green-600 mt-1 shrink-0"></i>
                    <span>Complete authentication system (OAuth, JWT, SSO)</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-check text-green-600 mt-1 shrink-0"></i>
                    <span>Database setup with schema design</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-check text-green-600 mt-1 shrink-0"></i>
                    <span>API gateway and routing</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-check text-green-600 mt-1 shrink-0"></i>
                    <span>Cloud infrastructure (AWS/GCP/Azure)</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-check text-green-600 mt-1 shrink-0"></i>
                    <span>Admin dashboard template</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-check text-green-600 mt-1 shrink-0"></i>
                    <span>CI/CD pipeline setup</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-check text-green-600 mt-1 shrink-0"></i>
                    <span>Basic monitoring & logging</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-check text-green-600 mt-1 shrink-0"></i>
                    <span>Documentation for handoff</span>
                  </li>
                </ul>
              </div>

              <!-- What's Not Included -->
              <div class="bg-amber-50 rounded-2xl p-6 border border-amber-100">
                <h4 class="font-bold text-amber-900 mb-4 flex items-center gap-2">
                  <i class="fa-solid fa-exclamation-triangle"></i>
                  What's Not Included
                </h4>
                <ul class="space-y-3 text-amber-800">
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-xmark text-amber-600 mt-1 shrink-0"></i>
                    <span>Custom business logic development</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-xmark text-amber-600 mt-1 shrink-0"></i>
                    <span>Industry-specific features</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-xmark text-amber-600 mt-1 shrink-0"></i>
                    <span>Advanced AI model training</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-xmark text-amber-600 mt-1 shrink-0"></i>
                    <span>Custom data migration</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-xmark text-amber-600 mt-1 shrink-0"></i>
                    <span>Third-party license fees</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-xmark text-amber-600 mt-1 shrink-0"></i>
                    <span>Ongoing maintenance (separate contract)</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-xmark text-amber-600 mt-1 shrink-0"></i>
                    <span>Marketing or SEO services</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-xmark text-amber-600 mt-1 shrink-0"></i>
                    <span>Legal compliance consulting</span>
                  </li>
                </ul>
              </div>
            </div>

            <p class="text-gray-600">
              <strong>Note:</strong> Core product development can be quoted separately based on complexity
              and requirements. We offer flexible engagement models for continued development after shell
              delivery.
            </p>
          </div>

          <!-- Section 3: Timeline & Milestones -->
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
              <span
                class="w-10 h-10 bg-gray-900 text-white rounded-xl flex items-center justify-center text-lg"
                >3</span
              >
              Timeline & Milestones
            </h2>

            <div class="bg-gray-50 rounded-2xl p-6 mb-6">
              <h4 class="font-bold text-gray-900 mb-4">Standard 1-Week Shell Delivery Timeline</h4>

              <div class="space-y-4">
                <div class="flex gap-4 items-start">
                  <div class="w-20 shrink-0">
                    <span
                      class="inline-block px-3 py-1 bg-blue-100 text-blue-700 text-sm font-medium rounded-full"
                      >Day 1-2</span
                    >
                  </div>
                  <div>
                    <h5 class="font-semibold text-gray-900">Requirements Finalization & Setup</h5>
                    <p class="text-gray-600 text-sm">
                      Final requirements review, cloud account setup, repository initialization
                    </p>
                  </div>
                </div>

                <div class="flex gap-4 items-start">
                  <div class="w-20 shrink-0">
                    <span
                      class="inline-block px-3 py-1 bg-purple-100 text-purple-700 text-sm font-medium rounded-full"
                      >Day 3-4</span
                    >
                  </div>
                  <div>
                    <h5 class="font-semibold text-gray-900">Core Infrastructure</h5>
                    <p class="text-gray-600 text-sm">
                      Database, authentication, API infrastructure deployment
                    </p>
                  </div>
                </div>

                <div class="flex gap-4 items-start">
                  <div class="w-20 shrink-0">
                    <span
                      class="inline-block px-3 py-1 bg-cyan-100 text-cyan-700 text-sm font-medium rounded-full"
                      >Day 5-6</span
                    >
                  </div>
                  <div>
                    <h5 class="font-semibold text-gray-900">Integration & UI</h5>
                    <p class="text-gray-600 text-sm">
                      Third-party integrations, admin panel, CI/CD setup
                    </p>
                  </div>
                </div>

                <div class="flex gap-4 items-start">
                  <div class="w-20 shrink-0">
                    <span
                      class="inline-block px-3 py-1 bg-emerald-100 text-emerald-700 text-sm font-medium rounded-full"
                      >Day 7</span
                    >
                  </div>
                  <div>
                    <h5 class="font-semibold text-gray-900">Testing & Handoff</h5>
                    <p class="text-gray-600 text-sm">
                      Final testing, documentation, credentials handover, training session
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <div class="bg-amber-50 border border-amber-200 rounded-xl p-4">
              <p class="text-amber-800 text-sm">
                <strong>Important:</strong> The 7-day timeline begins only after: (1) Requirements are
                finalized and approved in writing, (2) All necessary credentials and access are provided,
                and (3) Payment terms are satisfied as per the agreement.
              </p>
            </div>
          </div>

          <!-- Section 4: Core Product Timeline -->
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
              <span
                class="w-10 h-10 bg-gray-900 text-white rounded-xl flex items-center justify-center text-lg"
                >4</span
              >
              Core Product Development Timeline
            </h2>

            <p class="text-gray-600 mb-6">
              Core product development timeline is determined based on individual project
              requirements during our discovery and planning phase. Factors affecting timeline
              include:
            </p>

            <div class="grid sm:grid-cols-2 gap-4 mb-6">
              <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
                <i class="fa-solid fa-layer-group text-blue-600 mt-1"></i>
                <div>
                  <h5 class="font-semibold text-gray-900">Feature Complexity</h5>
                  <p class="text-gray-600 text-sm">Number and complexity of unique features</p>
                </div>
              </div>

              <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
                <i class="fa-solid fa-plug text-purple-600 mt-1"></i>
                <div>
                  <h5 class="font-semibold text-gray-900">Integrations</h5>
                  <p class="text-gray-600 text-sm">Third-party services and APIs required</p>
                </div>
              </div>

              <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
                <i class="fa-solid fa-database text-cyan-600 mt-1"></i>
                <div>
                  <h5 class="font-semibold text-gray-900">Data Requirements</h5>
                  <p class="text-gray-600 text-sm">Data migration, transformation needs</p>
                </div>
              </div>

              <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
                <i class="fa-solid fa-shield-halved text-emerald-600 mt-1"></i>
                <div>
                  <h5 class="font-semibold text-gray-900">Compliance</h5>
                  <p class="text-gray-600 text-sm">Industry-specific compliance requirements</p>
                </div>
              </div>
            </div>

            <p class="text-gray-600">
              A detailed timeline and quote for core product development will be provided after the
              initial consultation and requirements gathering. Core development can begin
              immediately after shell delivery or at a later date based on your preference.
            </p>
          </div>

          <!-- Section 5: Ownership & IP -->
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
              <span
                class="w-10 h-10 bg-gray-900 text-white rounded-xl flex items-center justify-center text-lg"
                >5</span
              >
              Ownership & Intellectual Property
            </h2>

            <div class="space-y-4">
              <div class="bg-green-50 border border-green-200 rounded-xl p-6">
                <h4 class="font-bold text-green-900 mb-3 flex items-center gap-2">
                  <i class="fa-solid fa-check-circle"></i>
                  What You Own
                </h4>
                <ul class="space-y-2 text-green-800">
                  <li>• Full ownership of all custom code developed for your project</li>
                  <li>• Complete access to all source code repositories</li>
                  <li>• All configurations and deployment scripts</li>
                  <li>• Documentation and technical specifications</li>
                  <li>• Database schemas and data structures</li>
                </ul>
              </div>

              <div class="bg-blue-50 border border-blue-200 rounded-xl p-6">
                <h4 class="font-bold text-blue-900 mb-3 flex items-center gap-2">
                  <i class="fa-solid fa-info-circle"></i>
                  Exyconn Retains
                </h4>
                <ul class="space-y-2 text-blue-800">
                  <li>• Rights to general methodologies and processes</li>
                  <li>• Pre-existing tools and frameworks (licensed for your use)</li>
                  <li>• Right to use anonymized insights for improving services</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Section 6: Client Responsibilities -->
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
              <span
                class="w-10 h-10 bg-gray-900 text-white rounded-xl flex items-center justify-center text-lg"
                >6</span
              >
              Client Responsibilities
            </h2>

            <p class="text-gray-600 mb-4">
              To ensure successful and timely delivery, clients must:
            </p>

            <ul class="space-y-3 text-gray-700">
              <li class="flex items-start gap-3">
                <span
                  class="w-6 h-6 bg-gray-100 rounded-full flex items-center justify-center shrink-0 mt-0.5 text-sm font-medium"
                  >1</span
                >
                <span>Provide clear and finalized requirements before project kickoff</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="w-6 h-6 bg-gray-100 rounded-full flex items-center justify-center shrink-0 mt-0.5 text-sm font-medium"
                  >2</span
                >
                <span>Grant necessary access to cloud accounts, APIs, and third-party services</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="w-6 h-6 bg-gray-100 rounded-full flex items-center justify-center shrink-0 mt-0.5 text-sm font-medium"
                  >3</span
                >
                <span>Respond to queries and provide feedback within 24 hours</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="w-6 h-6 bg-gray-100 rounded-full flex items-center justify-center shrink-0 mt-0.5 text-sm font-medium"
                  >4</span
                >
                <span>Designate a single point of contact for decision-making</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="w-6 h-6 bg-gray-100 rounded-full flex items-center justify-center shrink-0 mt-0.5 text-sm font-medium"
                  >5</span
                >
                <span>Cover costs for third-party services, licenses, and cloud resources</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="w-6 h-6 bg-gray-100 rounded-full flex items-center justify-center shrink-0 mt-0.5 text-sm font-medium"
                  >6</span
                >
                <span>Participate in handoff training and documentation review</span>
              </li>
            </ul>
          </div>

          <!-- Section 7: Warranty & Support -->
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
              <span
                class="w-10 h-10 bg-gray-900 text-white rounded-xl flex items-center justify-center text-lg"
                >7</span
              >
              Warranty & Support
            </h2>

            <div class="grid md:grid-cols-2 gap-6">
              <div class="border border-gray-200 rounded-xl p-6">
                <h4 class="font-bold text-gray-900 mb-3">30-Day Bug Fix Warranty</h4>
                <p class="text-gray-600 text-sm">
                  We provide a 30-day warranty period for fixing any bugs or issues in the delivered
                  shell that don't meet the agreed specifications.
                </p>
              </div>

              <div class="border border-gray-200 rounded-xl p-6">
                <h4 class="font-bold text-gray-900 mb-3">Extended Support</h4>
                <p class="text-gray-600 text-sm">
                  Ongoing maintenance and support packages available separately. Contact us for
                  custom support agreements.
                </p>
              </div>
            </div>
          </div>

          <!-- Section 8: Limitations -->
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
              <span
                class="w-10 h-10 bg-gray-900 text-white rounded-xl flex items-center justify-center text-lg"
                >8</span
              >
              Limitations & Disclaimers
            </h2>

            <div class="bg-gray-50 rounded-xl p-6 space-y-4 text-gray-600">
              <p>
                <strong>No Guarantee of Business Success:</strong> While we provide robust technical infrastructure,
                we do not guarantee business outcomes, user adoption, or commercial success of your product.
              </p>
              <p>
                <strong>Third-Party Dependencies:</strong> We are not responsible for downtime, changes,
                or discontinuation of third-party services integrated into your solution.
              </p>
              <p>
                <strong>Scope Changes:</strong> Any changes to agreed scope may impact timeline and pricing.
                Change requests will be documented and quoted separately.
              </p>
              <p>
                <strong>Force Majeure:</strong> Delays due to circumstances beyond reasonable control
                (natural disasters, pandemics, etc.) may extend delivery timelines.
              </p>
            </div>
          </div>

          <!-- Last Updated -->
          <div class="text-center text-gray-500 text-sm pt-8 border-t border-gray-200">
            <p>Last Updated: January 2025</p>
            <p class="mt-2">
              Questions about these terms?
              <a href="/contact" class="text-blue-600 hover:underline">Contact our team</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 px-6 bg-gradient-to-br from-blue-600 to-purple-600">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Ready to Start Your Project?</h2>
        <p class="text-blue-100 text-lg mb-8 max-w-2xl mx-auto">
          Let's discuss your requirements and create a tailored plan for your MVP. Our team is ready
          to help you launch in just 1 week.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-8 py-4 bg-white text-blue-600 font-semibold rounded-xl hover:bg-blue-50 transition-colors shadow-lg"
          >
            <i class="fa-solid fa-rocket"></i>
            Get Started
          </a>
          <a
            href="/shell-strategy"
            class="inline-flex items-center gap-2 px-8 py-4 bg-white/10 text-white font-semibold rounded-xl hover:bg-white/20 transition-colors border border-white/20"
          >
            <i class="fa-solid fa-bolt"></i>
            Learn More
          </a>
        </div>
      </div>
    </section>
  </main>

  <Newsletter />
</Page>
