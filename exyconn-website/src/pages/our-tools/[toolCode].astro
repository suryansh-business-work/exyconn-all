---
import Page from "../../layouts/Page.astro";
import { getTool, getToolCategories, getToolLaunchUrl, getTools } from "../../lib/portal";
import { roleVar } from "../../styles/tokens/semantic.tokens";

const { toolCode } = Astro.params;

if (!toolCode) {
  return new Response(null, { status: 404 });
}

const tool = await getTool(toolCode);

if (!tool) {
  return new Response(null, { status: 404 });
}

const [categories, siblings] = await Promise.all([
  getToolCategories(),
  getTools(tool.categorySlug),
]);

const category = categories.find((one) => one.slug === tool.categorySlug) ?? null;
const related = siblings.filter((one) => one.toolCode !== tool.toolCode).slice(0, 3);
// An admin-chosen colour (any CSS colour) or the indigo role; the tint mixes whichever it is.
const accent = tool.color || category?.color || roleVar("indigo-strong");
const accentTint = `color-mix(in srgb, ${accent} 8%, transparent)`;
---

<Page title={`${tool.name} | Exyconn Tools`} description={tool.description}>
  <main class="bg-surface-subtle min-h-screen">
    <section class="border-b border-line py-6 px-6 bg-surface">
      <div class="max-w-5xl mx-auto flex items-center justify-between gap-4">
        <a
          href="/our-tools"
          class="flex items-center gap-2 text-fg-muted hover:text-fg transition"
        >
          <i class="fa-solid fa-arrow-left"></i>
          <span class="font-medium">Back to all tools</span>
        </a>
        {
          category && (
            <a
              href={`/our-tools#${category.slug}`}
              class="text-sm font-semibold px-3 py-1.5 rounded-lg"
              style={`background: ${accentTint}; color: ${accent};`}
            >
              {category.category}
            </a>
          )
        }
      </div>
    </section>

    <section class="py-14 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="flex items-start gap-5 mb-8">
          <div
            class="w-16 h-16 rounded-2xl flex items-center justify-center shrink-0"
            style={`background: ${accentTint};`}
          >
            <i class={`fa-solid ${tool.icon || "fa-wrench"} text-2xl`} style={`color: ${accent};`}
            ></i>
          </div>
          <div>
            <div class="flex items-center gap-3 mb-2">
              <h1 class="text-4xl font-black text-fg">{tool.name}</h1>
              {
                tool.isMVP && (
                  <span class="px-2.5 py-1 bg-amber-soft text-amber-fg-strong rounded-lg text-xs font-bold">
                    MVP
                  </span>
                )
              }
            </div>
            <p class="text-lg text-fg-muted">{tool.description}</p>
            <span
              class="inline-block mt-3 px-2 py-0.5 bg-surface-strong text-fg-subtle rounded text-xs font-mono"
              >#{tool.toolCode}</span
            >
          </div>
        </div>

        <div class="grid lg:grid-cols-3 gap-8">
          <div class="lg:col-span-2 space-y-8">
            {
              tool.longDescription && (
                <div class="bg-surface rounded-2xl p-6 border border-line-subtle">
                  <h2 class="text-xl font-bold text-fg mb-3">About this tool</h2>
                  <p class="text-fg-muted whitespace-pre-line">{tool.longDescription}</p>
                </div>
              )
            }

            {
              tool.features.length > 0 && (
                <div class="bg-surface rounded-2xl p-6 border border-line-subtle">
                  <h2 class="text-xl font-bold text-fg mb-4">What it does</h2>
                  <ul class="space-y-2">
                    {tool.features.map((feature) => (
                      <li class="flex items-start gap-3 text-fg-muted">
                        <i class="fa-solid fa-check mt-1" style={`color: ${accent};`} />
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            {
              tool.useCases.length > 0 && (
                <div class="bg-surface rounded-2xl p-6 border border-line-subtle">
                  <h2 class="text-xl font-bold text-fg mb-4">Where people use it</h2>
                  <div class="flex flex-wrap gap-2">
                    {tool.useCases.map((useCase) => (
                      <span class="px-3 py-1.5 bg-surface-muted text-fg-muted rounded-lg text-sm">
                        {useCase}
                      </span>
                    ))}
                  </div>
                </div>
              )
            }
          </div>

          <aside class="space-y-6">
            {
              tool.url && (
                <a
                  href={getToolLaunchUrl(tool)}
                  class="block text-center px-6 py-4 rounded-2xl text-on-solid font-bold shadow-lg transition hover:opacity-90"
                  style={`background: ${accent};`}
                >
                  Open {tool.name}
                  <i class="fa-solid fa-arrow-up-right-from-square ml-2" />
                </a>
              )
            }

            {
              tool.pricing && (
                <div class="bg-surface rounded-2xl p-6 border border-line-subtle">
                  <h2 class="text-lg font-bold text-fg mb-2">Pricing</h2>
                  <p class="text-3xl font-black text-fg">
                    {tool.pricing.currency} {tool.pricing.price}
                  </p>
                  {tool.pricing.alterationNote && (
                    <p class="text-sm text-fg-subtle mt-2">{tool.pricing.alterationNote}</p>
                  )}
                  <ul class="mt-4 space-y-1.5">
                    {tool.pricing.features.map((feature) => (
                      <li class="text-sm text-fg-muted flex items-start gap-2">
                        <i class="fa-solid fa-check mt-1 text-emerald-fg" />
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            {
              related.length > 0 && (
                <div class="bg-surface rounded-2xl p-6 border border-line-subtle">
                  <h2 class="text-lg font-bold text-fg mb-3">More in this category</h2>
                  <ul class="space-y-2">
                    {related.map((one) => (
                      <li>
                        <a
                          href={`/our-tools/${one.toolCode}`}
                          class="text-fg-muted hover:text-indigo-fg transition"
                        >
                          {one.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }
          </aside>
        </div>
      </div>
    </section>
  </main>
</Page>
