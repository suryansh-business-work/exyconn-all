---
import ContactFormReact from "../components/forms/ContactFormReact.tsx";
import Page from "../layouts/Page.astro";

const contactMethods = [
  {
    icon: "fa-envelope",
    title: "HR Inquiries",
    description: "For career and HR-related queries",
    value: "hr@exyconn.com",
    href: "mailto:hr@exyconn.com",
    color: "from-purple to-pink",
  },
  {
    icon: "fa-headset",
    title: "Service Inquiries",
    description: "For service and project queries",
    value: "services@exyconn.com",
    href: "mailto:services@exyconn.com",
    color: "from-blue to-cyan",
  },
  {
    icon: "fa-scale-balanced",
    title: "Legal Inquiries",
    description: "For legal and compliance matters",
    value: "View Legal Page",
    href: "/legal",
    color: "from-amber to-orange",
  },
];

const quickLinks = [
  { icon: "fa-robot", label: "AI Services", href: "/ai" },
  { icon: "fa-cube", label: "Our Products", href: "/our-products" },
  { icon: "fa-briefcase", label: "Careers", href: "/career" },
  { icon: "fa-calculator", label: "Get a Quote", href: "/get-a-quote" },
];
---

<Page
  metaTitle="Contact Us | Get in Touch with Exyconn"
  metaDescription="Contact Exyconn for AI automation, SaaS solutions, and business inquiries. Reach out to our team for support, partnership, or to start your digital transformation journey."
  metaKeywords="contact, Exyconn, AI automation, SaaS, business inquiry, support, partnership"
  metaImage="https://images.pexels.com/photos/3183197/pexels-photo-3183197.jpeg?auto=compress&w=1200&q=80"
>
  <main class="bg-surface min-h-screen">
    <!-- Hero Section -->
    <section
      class="relative py-24 px-6 bg-gradient-to-br from-blue-subtle via-surface to-cyan-subtle overflow-hidden"
    >
      <div
        class="absolute top-20 right-20 w-80 h-80 bg-gradient-to-r from-blue-muted/40 to-cyan-muted/40 rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-10 left-10 w-96 h-96 bg-gradient-to-r from-purple-muted/30 to-pink-muted/30 rounded-full blur-3xl"
      >
      </div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <!-- Lottie illustration -->
        <div
          id="contact-hero-lottie"
          class="mx-auto mb-4 w-[180px] h-[140px] sm:w-[220px] sm:h-[160px]"
          aria-hidden="true"
          data-anime="zoom-in"
        >
        </div>

        <span
          class="inline-flex items-center gap-2 px-4 py-2 bg-surface border border-line rounded-full text-sm font-medium text-fg-muted mb-8 shadow-sm"
          data-anime="fade-up"
        >
          <i class="fa-solid fa-comments text-blue-fg"></i>
          Get In Touch
        </span>

        <h1
          class="text-5xl md:text-6xl font-bold text-fg mb-6 tracking-tight"
          data-anime="fade-up"
          data-anime-delay="100"
        >
          Let's Start a
          <span class="bg-gradient-to-r from-blue-strong to-cyan bg-clip-text text-transparent">
            Conversation</span
          >
        </h1>

        <p
          class="text-xl text-fg-muted max-w-2xl mx-auto leading-relaxed mb-10"
          data-anime="fade-up"
          data-anime-delay="200"
        >
          Have a project in mind? Questions about our services? We'd love to hear from you. Reach
          out and let's explore how we can help transform your business.
        </p>
      </div>
    </section>

    <!-- Contact Methods -->
    <section class="py-16 px-6 bg-surface border-b border-line-subtle">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-3 gap-6">
          {
            contactMethods.map((method) => (
              <a
                href={method.href}
                class="group bg-surface-subtle rounded-2xl p-6 border border-line-subtle hover:shadow-lg hover:border-blue-soft transition-all duration-300"
              >
                <div
                  class={`w-12 h-12 bg-gradient-to-br ${method.color} rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform`}
                >
                  <i class={`fa-solid ${method.icon} text-on-solid text-lg`} />
                </div>
                <h3 class="font-bold text-fg mb-1">{method.title}</h3>
                <p class="text-sm text-fg-subtle mb-3">{method.description}</p>
                <span class="text-blue-fg font-medium group-hover:underline">{method.value}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Quick Links -->
    <section class="py-12 px-6 bg-surface-subtle">
      <div class="max-w-5xl mx-auto">
        <p class="text-center text-fg-subtle mb-6">Quick Links</p>
        <div class="flex flex-wrap justify-center gap-4">
          {
            quickLinks.map((link) => (
              <a
                href={link.href}
                class="inline-flex items-center gap-2 bg-surface border border-line text-fg-secondary font-medium px-5 py-2.5 rounded-full hover:bg-blue-subtle hover:border-blue-soft hover:text-blue-fg transition-all"
              >
                <i class={`fa-solid ${link.icon} text-sm`} />
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Contact Form Section -->
    <section class="py-16 px-6 bg-surface">
      <div class="max-w-2xl mx-auto">
        <div class="text-center mb-8">
          <span
            class="inline-flex items-center gap-2 px-4 py-2 bg-blue-subtle border border-blue-soft rounded-full text-sm font-medium text-blue-fg mb-4"
          >
            <i class="fa-solid fa-paper-plane"></i>
            Send us a message
          </span>
          <h2 class="text-3xl font-bold text-fg">Get In Touch</h2>
        </div>
        <ContactFormReact client:load />
      </div>
    </section>

    <!-- Map or Additional Info Section -->
    <section class="py-16 px-6 bg-surface-subtle">
      <div class="max-w-4xl mx-auto text-center">
        <div class="bg-surface rounded-3xl shadow-lg border border-line-subtle p-10">
          <div
            class="w-16 h-16 bg-gradient-to-br from-blue to-cyan rounded-2xl flex items-center justify-center mx-auto mb-6"
          >
            <i class="fa-solid fa-globe text-on-solid text-2xl"></i>
          </div>
          <h2 class="text-2xl font-bold text-fg mb-4">We Work Remotely</h2>
          <p class="text-fg-muted leading-relaxed mb-6">
            As a remote-first company, we collaborate with clients globally. No matter where you're
            located, we're just an email or video call away.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <span
              class="inline-flex items-center gap-2 bg-surface-muted text-fg-muted px-4 py-2 rounded-full text-sm"
            >
              <i class="fa-solid fa-clock"></i>
              Quick Response Time
            </span>
            <span
              class="inline-flex items-center gap-2 bg-surface-muted text-fg-muted px-4 py-2 rounded-full text-sm"
            >
              <i class="fa-solid fa-earth-americas"></i>
              Global Clients
            </span>
            <span
              class="inline-flex items-center gap-2 bg-surface-muted text-fg-muted px-4 py-2 rounded-full text-sm"
            >
              <i class="fa-solid fa-video"></i>
              Video Consultations
            </span>
          </div>
        </div>
      </div>
    </section>
  </main>
</Page>

<!-- Lottie hero illustration loader -->
<script
  is:inline
  type="module"
  src="https://unpkg.com/@lottiefiles/lottie-player@2.0.12/dist/lottie-player.js"></script>
<script is:inline>
  (function () {
    function mount() {
      const host = document.getElementById("contact-hero-lottie");
      if (!host || host.querySelector("lottie-player")) return;
      const player = document.createElement("lottie-player");
      player.setAttribute("src", "https://assets3.lottiefiles.com/packages/lf20_u25cckyh.json");
      player.setAttribute("background", "transparent");
      player.setAttribute("speed", "1");
      player.setAttribute("loop", "");
      player.setAttribute("autoplay", "");
      player.style.width = "100%";
      player.style.height = "100%";
      host.appendChild(player);
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", mount);
    } else {
      mount();
    }
  })();
</script>
