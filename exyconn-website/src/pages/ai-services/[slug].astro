---
import Page from "../../layouts/Page.astro";
import {
  findAiService,
  findAiServiceCategory,
  servicesInCategory,
} from "../../lib/services/aiServices";

const { slug } = Astro.params;
const service = slug ? findAiService(slug) : undefined;

if (!service) {
  return new Response(null, { status: 404 });
}

const category = findAiServiceCategory(service.categorySlug);
const relatedServices = servicesInCategory(service.categorySlug)
  .filter((item) => item.slug !== service.slug)
  .slice(0, 4);

const SITE_URL = "https://exyconn.com";
const LISTING_URL = `${SITE_URL}/ai-services`;
const serviceUrl = `${LISTING_URL}/${service.slug}`;
const categoryUrl = category ? `${LISTING_URL}#${category.slug}` : LISTING_URL;
const categoryTitle = category?.title ?? "AI Services";

const pageTitle = `${service.title} | AI Services | Exyconn`;
const pageKeywords = [service.title, categoryTitle, "AI services", "Exyconn"].join(", ");

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  description: service.description,
  url: serviceUrl,
  serviceType: categoryTitle,
  category: categoryTitle,
  areaServed: "Worldwide",
  provider: {
    "@type": "Organization",
    name: "Exyconn",
    url: SITE_URL,
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: `${service.title} deliverables`,
    itemListElement: service.outcomes.map((outcome, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: outcome,
    })),
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL },
    { "@type": "ListItem", position: 2, name: "AI Services", item: LISTING_URL },
    { "@type": "ListItem", position: 3, name: service.title, item: serviceUrl },
  ],
};
---

<Page
  metaTitle={pageTitle}
  metaDescription={service.summary}
  metaKeywords={pageKeywords}
  canonical={serviceUrl}
  jsonLd={[serviceJsonLd, breadcrumbJsonLd]}
>
  <div class="bg-white min-h-screen">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="border-b border-gray-100 bg-gray-50">
      <ol class="max-w-6xl mx-auto flex items-center gap-2 px-6 py-3 text-sm text-gray-600">
        <li><a href="/" class="hover:text-blue-700 transition-colors">Home</a></li>
        <li aria-hidden="true" class="text-gray-400">/</li>
        <li>
          <a href="/ai-services" class="hover:text-blue-700 transition-colors">AI Services</a>
        </li>
        <li aria-hidden="true" class="text-gray-400">/</li>
        <li class="font-medium text-gray-900 truncate">{service.title}</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section
      class="relative overflow-hidden px-6 py-20 bg-gradient-to-br from-gray-50 via-white to-blue-50"
    >
      <div
        class="absolute top-10 right-10 w-80 h-80 bg-gradient-to-r from-blue-200/40 to-cyan-200/40 rounded-full blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="relative z-10 max-w-6xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-start gap-8">
          <div
            class={`w-20 h-20 shrink-0 rounded-3xl bg-gradient-to-br ${service.color} flex items-center justify-center shadow-lg`}
          >
            <i class={`fa-solid ${service.icon} text-white text-3xl`} aria-hidden="true"></i>
          </div>

          <div class="flex-1">
            <a
              href={categoryUrl}
              class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-full text-sm font-medium text-gray-700 mb-6 shadow-sm hover:border-blue-200 hover:text-blue-700 transition-colors"
            >
              <i
                class={`fa-solid ${category?.icon ?? "fa-microchip"} text-blue-600`}
                aria-hidden="true"></i>
              {categoryTitle}
            </a>

            <h1
              class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 tracking-tight leading-tight"
              data-anime="fade-up"
            >
              {service.title}
            </h1>

            <p
              class="text-lg md:text-xl text-gray-600 max-w-3xl leading-relaxed"
              data-anime="fade-up"
              data-anime-delay="100"
            >
              {service.summary}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Detail -->
    <section class="px-6 py-16">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-3 gap-10">
        <div class="lg:col-span-2 space-y-8">
          <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-4 flex items-center gap-3">
              <i class="fa-solid fa-circle-info text-blue-600" aria-hidden="true"></i>
              How we approach it
            </h2>
            <p class="text-gray-600 text-lg leading-relaxed">{service.description}</p>
          </div>

          <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
              <i class="fa-solid fa-circle-check text-emerald-600" aria-hidden="true"></i>
              What you get
            </h2>
            <ul class="grid sm:grid-cols-2 gap-4">
              {
                service.outcomes.map((outcome) => (
                  <li class="flex items-start gap-3 rounded-2xl bg-gray-50 border border-gray-100 p-4">
                    <span class="shrink-0 w-6 h-6 rounded-full bg-emerald-100 flex items-center justify-center mt-0.5">
                      <i class="fa-solid fa-check text-emerald-700 text-xs" aria-hidden="true" />
                    </span>
                    <span class="text-gray-700 text-sm leading-relaxed">{outcome}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <aside class="space-y-6">
          <div
            class="bg-gradient-to-br from-blue-600 to-cyan-500 rounded-3xl p-8 text-white shadow-xl"
          >
            <h2 class="text-xl font-bold mb-3">Scope this for your business</h2>
            <p class="text-blue-50 text-sm leading-relaxed mb-6">
              Send us the workflow you want {service.title.toLowerCase()} applied to. You get a scope,
              a timeline and a price — not a discovery invoice.
            </p>
            <a
              href="/get-a-quote"
              class="inline-flex w-full items-center justify-center gap-2 bg-white text-blue-700 font-semibold px-6 py-3 rounded-full hover:bg-blue-50 transition"
            >
              <i class="fa-solid fa-calculator" aria-hidden="true"></i> Get a Quote
            </a>
            <a
              href="/contact"
              class="mt-3 inline-flex w-full items-center justify-center gap-2 bg-white/15 border border-white/40 text-white font-semibold px-6 py-3 rounded-full hover:bg-white/25 transition"
            >
              <i class="fa-solid fa-comments" aria-hidden="true"></i> Talk to Us
            </a>
          </div>

          <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-6">
            <h2 class="text-lg font-bold text-gray-900 mb-2">Part of {categoryTitle}</h2>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">{category?.description}</p>
            <a
              href={categoryUrl}
              class="inline-flex items-center gap-2 text-blue-700 font-medium text-sm hover:gap-3 transition-all"
            >
              See the whole category
              <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
            </a>
          </div>

          <a
            href="/ai-services"
            class="flex items-center justify-center gap-2 text-gray-600 hover:text-blue-700 transition-colors py-3"
          >
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            <span>Back to all AI services</span>
          </a>
        </aside>
      </div>
    </section>

    <!-- Related -->
    {
      relatedServices.length > 0 && (
        <section class="px-6 py-16 bg-gray-50 border-t border-gray-100">
          <div class="max-w-6xl mx-auto">
            <h2 class="text-2xl font-bold text-gray-900 mb-8">More in {categoryTitle}</h2>
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
              {relatedServices.map((related) => (
                <a
                  href={`/ai-services/${related.slug}`}
                  class="group bg-white rounded-2xl border border-gray-100 shadow-sm p-6 hover:shadow-xl hover:border-blue-100 hover:-translate-y-1 transition-all duration-300"
                >
                  <div
                    class={`w-12 h-12 bg-gradient-to-br ${related.color} rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform`}
                  >
                    <i class={`fa-solid ${related.icon} text-white`} aria-hidden="true" />
                  </div>
                  <h3 class="font-bold text-gray-900 mb-2 group-hover:text-blue-700 transition-colors">
                    {related.title}
                  </h3>
                  <p class="text-gray-600 text-sm leading-relaxed">{related.summary}</p>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </div>
</Page>
