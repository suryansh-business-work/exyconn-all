---
import Page from "../../layouts/Page.astro";
import GetInTouch from "../../components/forms/GetInTouch.astro";
import DynamicFaqs from "../../components/dynamic-components/DynamicFaqs.astro";
import DynamicBreadcrumb from "../../components/dynamic-components/DynamicBreadcrumb.astro";
---

<Page
  metaTitle="Software Development Outsourcing | Exyconn"
  metaDescription="Outsource software development to Exyconn — reduce costs, access top talent, and accelerate delivery with flexible engagement models. Enterprise-grade quality guaranteed."
  metaKeywords="software development outsourcing, outsource software development, IT outsourcing, offshore development, software engineering outsourcing, Exyconn"
  metaImage="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1200&q=80"
>
  <DynamicBreadcrumb />

  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="outsource-hero">
    <div class="hero-bg-grid"></div>
    <div class="hero-glow hero-glow-1"></div>
    <div class="hero-glow hero-glow-2"></div>
    <div class="hero-inner">
      <div class="hero-badge">
        <i class="fa-solid fa-handshake"></i> Trusted Outsourcing Partner
      </div>
      <h1 class="hero-title">
        Software Development<br />
        <span class="hero-gradient-text">Outsourcing</span>
      </h1>
      <p class="hero-desc">
        Stay at the forefront of technology while de-risking software development and optimizing
        costs. Exyconn is your trusted partner for building world-class software — reliably,
        scalably, and cost-effectively.
      </p>
      <div class="hero-cta-row">
        <a href="/contact" class="hero-btn-primary">
          <i class="fa-solid fa-paper-plane"></i> Talk to Our Experts
        </a>
        <a href="#services" class="hero-btn-ghost">
          <i class="fa-solid fa-arrow-down"></i> Explore Services
        </a>
      </div>
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="stat-num">50+</span>
          <span class="stat-label">Projects Delivered</span>
        </div>
        <div class="hero-stat-divider"></div>
        <div class="hero-stat">
          <span class="stat-num">98%</span>
          <span class="stat-label">Client Satisfaction</span>
        </div>
        <div class="hero-stat-divider"></div>
        <div class="hero-stat">
          <span class="stat-num">40%</span>
          <span class="stat-label">Cost Savings Avg.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ WHAT IS IT ═══════════════ -->
  <section class="intro-section">
    <div class="intro-inner">
      <div class="intro-icon-col">
        <div class="intro-icon-circle">
          <i class="fa-solid fa-people-arrows"></i>
        </div>
      </div>
      <div class="intro-text-col">
        <h2>What is Software Development Outsourcing?</h2>
        <p>
          <strong>Software development outsourcing</strong> is the practice of delegating software engineering
          tasks — from full-cycle product development to team augmentation — to an external partner. It
          enables businesses to access specialized talent, accelerate time-to-market, and focus on core
          competencies while reducing operational costs.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════ SERVICES ═══════════════ -->
  <section class="services-section" id="services">
    <div class="services-inner">
      <div class="section-label"><i class="fa-solid fa-cubes"></i> What We Offer</div>
      <h2 class="section-title">Our Outsourcing Services</h2>
      <p class="section-subtitle">
        From ideation to deployment and beyond — we cover the entire spectrum.
      </p>
      <div class="services-grid">
        <div class="svc-card">
          <div class="svc-icon svc-icon-indigo"><i class="fa-solid fa-rocket"></i></div>
          <h3>Cutting-Edge App Development</h3>
          <p>
            Launch innovative solutions powered by AI, cloud, and intelligent automation with our
            emerging tech expertise.
          </p>
        </div>
        <div class="svc-card">
          <div class="svc-icon svc-icon-purple"><i class="fa-solid fa-arrows-rotate"></i></div>
          <h3>Legacy Modernization</h3>
          <p>
            Rewrite, rearchitect, rehost, or reengineer your legacy systems with a team deep in
            modernization.
          </p>
        </div>
        <div class="svc-card">
          <div class="svc-icon svc-icon-cyan"><i class="fa-solid fa-layer-group"></i></div>
          <h3>Large-Scale App Management</h3>
          <p>
            Outsource development, change management, and operations for your existing software
            stack.
          </p>
        </div>
        <div class="svc-card">
          <div class="svc-icon svc-icon-emerald">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
          </div>
          <h3>Digital Transformation</h3>
          <p>
            Enhance digital experiences and optimize costs by adopting cloud, Agile, DevOps, and
            microservices.
          </p>
        </div>
        <div class="svc-card">
          <div class="svc-icon svc-icon-amber"><i class="fa-solid fa-globe"></i></div>
          <h3>Delivery Model Optimization</h3>
          <p>
            Leverage onshore, offshore, and hybrid models to optimize costs, efficiency, and
            speed-to-market.
          </p>
        </div>
        <div class="svc-card">
          <div class="svc-icon svc-icon-rose"><i class="fa-solid fa-users-gear"></i></div>
          <h3>Dedicated Development Teams</h3>
          <p>
            Get a fully managed team of developers, QA, and DevOps engineers integrated into your
            workflow.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ BENEFITS ═══════════════ -->
  <section class="benefits-section">
    <div class="benefits-inner">
      <div class="section-label"><i class="fa-solid fa-star"></i> Why Exyconn</div>
      <h2 class="section-title">Benefits of Outsourcing to Exyconn</h2>
      <div class="benefits-grid">
        <div class="benefit-card">
          <div class="benefit-icon"><i class="fa-solid fa-user-tie"></i></div>
          <div class="benefit-content">
            <h3>Access to Top Talent</h3>
            <p>
              Our team of top-tier professionals bridges any expertise gaps. No client-led talent
              searches needed — skilled engineers are ready to go.
            </p>
          </div>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><i class="fa-solid fa-sliders"></i></div>
          <div class="benefit-content">
            <h3>Flexible Engagement Models</h3>
            <p>
              From autonomous squads and application ownership to team augmentation — we adapt to
              your needs and scale on demand.
            </p>
          </div>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><i class="fa-solid fa-earth-americas"></i></div>
          <div class="benefit-content">
            <h3>Global Presence</h3>
            <p>
              We serve clients across multiple geographies with location-optimized delivery centers
              for maximum efficiency.
            </p>
          </div>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><i class="fa-solid fa-chart-column"></i></div>
          <div class="benefit-content">
            <h3>Measurable Success</h3>
            <p>
              Key metrics translate progress and outcomes into objective, quantitative data — full
              visibility guaranteed.
            </p>
          </div>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><i class="fa-solid fa-book-open"></i></div>
          <div class="benefit-content">
            <h3>Efficient Knowledge Management</h3>
            <p>
              Thorough documentation, knowledge transfer, and internal wikis ensure complete
              transparency at every stage.
            </p>
          </div>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><i class="fa-solid fa-puzzle-piece"></i></div>
          <div class="benefit-content">
            <h3>Holistic Approach</h3>
            <p>
              Cross-functional teams combine technology, industry expertise, and human-centered
              design for best outcomes.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ EXPERTISE ═══════════════ -->
  <section class="expertise-section">
    <div class="expertise-inner">
      <h2 class="section-title">Exyconn's Outsourcing Expertise</h2>
      <div class="expertise-grid">
        <div class="expertise-card">
          <div class="expertise-icon"><i class="fa-solid fa-handshake"></i></div>
          <h3>Experience-Driven Services</h3>
          <p>
            Years of experience delivering tangible business value to clients across industries
            worldwide.
          </p>
        </div>
        <div class="expertise-card">
          <div class="expertise-icon"><i class="fa-solid fa-trophy"></i></div>
          <h3>Proven Track Record</h3>
          <p>
            We have served clients across diverse industries — from ambitious startups to
            Fortune-level enterprises.
          </p>
        </div>
        <div class="expertise-card">
          <div class="expertise-icon"><i class="fa-solid fa-graduation-cap"></i></div>
          <h3>Advanced Teams</h3>
          <p>
            Our engineers hold advanced degrees and industry certifications ensuring top-quality,
            reliable delivery.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ LIFECYCLE ═══════════════ -->
  <section class="lifecycle-section">
    <div class="lifecycle-inner">
      <div class="section-label"><i class="fa-solid fa-infinity"></i> End-to-End</div>
      <h2 class="section-title">We Work Across the Whole Development Lifecycle</h2>
      <div class="lifecycle-grid">
        <div class="lc-card">
          <div class="lc-step lc-step-1">01</div>
          <div class="lc-icon"><i class="fa-solid fa-lightbulb"></i></div>
          <h3>Ideation</h3>
          <p>
            Validate and enhance product ideas with our domain and technology expertise for stronger
            collaboration.
          </p>
        </div>
        <div class="lc-connector"><i class="fa-solid fa-chevron-right"></i></div>
        <div class="lc-card">
          <div class="lc-step lc-step-2">02</div>
          <div class="lc-icon"><i class="fa-solid fa-code"></i></div>
          <h3>Development & Launch</h3>
          <p>
            Optimize development costs while ensuring stable and predictable delivery via shared
            ownership.
          </p>
        </div>
        <div class="lc-connector"><i class="fa-solid fa-chevron-right"></i></div>
        <div class="lc-card">
          <div class="lc-step lc-step-3">03</div>
          <div class="lc-icon"><i class="fa-solid fa-chart-line"></i></div>
          <h3>Growth & Maturity</h3>
          <p>
            Supercharge growth and increase operational efficiency with delivery ownership transfer.
          </p>
        </div>
        <div class="lc-connector"><i class="fa-solid fa-chevron-right"></i></div>
        <div class="lc-card">
          <div class="lc-step lc-step-4">04</div>
          <div class="lc-icon"><i class="fa-solid fa-arrows-turn-to-dots"></i></div>
          <h3>End of Life</h3>
          <p>
            Optimize costs, enhance efficiency and enable demand throttling with portfolio ownership
            transfer.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ WHY CHOOSE ═══════════════ -->
  <section class="why-section">
    <div class="why-inner">
      <h2 class="section-title section-title-white">Why Choose Exyconn for Outsourcing?</h2>
      <div class="why-grid">
        <div class="why-card">
          <div class="why-icon"><i class="fa-solid fa-shield-halved"></i></div>
          <h3>Enterprise-Grade Security</h3>
          <p>
            Industry best practices for data security, encryption, and compliance throughout the
            SDLC.
          </p>
        </div>
        <div class="why-card">
          <div class="why-icon"><i class="fa-solid fa-clock-rotate-left"></i></div>
          <h3>Faster Time-to-Market</h3>
          <p>
            Dedicated teams and agile processes ensure rapid, iterative delivery with predictable
            timelines.
          </p>
        </div>
        <div class="why-card">
          <div class="why-icon"><i class="fa-solid fa-money-bill-trend-up"></i></div>
          <h3>Cost Optimization</h3>
          <p>
            Reduce operational overhead with flexible engagement models and location-optimized
            delivery.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ CTA ═══════════════ -->
  <section class="outsource-cta">
    <div class="cta-inner">
      <h2>Beat the Competition with a<br /><span>Bespoke Value-Driven Product</span></h2>
      <p>
        Let Exyconn handle the engineering so you can focus on what matters most — growing your
        business.
      </p>
      <a href="/contact" class="cta-btn">
        <i class="fa-solid fa-paper-plane"></i> Get in Touch with Our Experts
      </a>
    </div>
  </section>

  <DynamicFaqs
    title="Software Development Outsourcing FAQs"
    faqs={[
      {
        question: "What is software development outsourcing?",
        answer:
          "Software development outsourcing is the practice of hiring an external company to handle some or all of your software engineering needs — from full product development to team augmentation and application management.",
      },
      {
        question: "Why should I consider outsourcing software development?",
        answer:
          "Outsourcing gives you access to specialized talent, reduces development costs, accelerates time-to-market, and lets you focus on core business activities. It also provides flexibility to scale teams up or down as needed.",
      },
      {
        question: "What engagement models does Exyconn offer?",
        answer:
          "We offer multiple models: dedicated development teams, project-based development, team augmentation, and managed services. We tailor the approach based on your project requirements and goals.",
      },
      {
        question: "How do you handle communication across different time zones?",
        answer:
          "We use asynchronous communication tools, overlapping working hours, and regular standups to ensure seamless collaboration. Our project managers act as a bridge between your team and ours.",
      },
      {
        question: "Can I scale my development team as needed?",
        answer:
          "Absolutely. One of the key advantages of outsourcing with Exyconn is the ability to quickly scale your team up or down based on project demands without the overhead of traditional hiring.",
      },
      {
        question: "How do you ensure code quality and project transparency?",
        answer:
          "We follow agile methodologies, conduct regular code reviews, maintain CI/CD pipelines, and provide clients with full access to project metrics, repositories, and progress dashboards.",
      },
    ]}
  />
  <GetInTouch />
</Page>

<style>
  /* ═══════════════ VARIABLES ═══════════════ */
  :root {
    --os-primary: #4338ca;
    --os-primary-light: #6366f1;
    --os-dark: #1e1b4b;
    --os-bg: #f8fafc;
    --os-shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.05);
    --os-shadow-md: 0 4px 20px rgba(0, 0, 0, 0.08);
    --os-shadow-lg: 0 8px 40px rgba(0, 0, 0, 0.1);
    --os-shadow-xl: 0 16px 56px rgba(0, 0, 0, 0.12);
  }

  /* ═══════════════ HERO ═══════════════ */
  .outsource-hero {
    position: relative;
    overflow: hidden;
    background: var(--os-dark);
    padding: 7rem 1.5rem 5rem;
    text-align: center;
    color: #fff;
  }

  .hero-bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(99, 102, 241, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(99, 102, 241, 0.06) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }

  .hero-glow-1 {
    width: 500px;
    height: 500px;
    background: rgba(99, 102, 241, 0.15);
    top: -150px;
    right: -100px;
  }

  .hero-glow-2 {
    width: 400px;
    height: 400px;
    background: rgba(139, 92, 246, 0.1);
    bottom: -100px;
    left: -80px;
  }

  .hero-inner {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.85);
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.5rem 1.25rem;
    border-radius: 50px;
    margin-bottom: 2rem;
    backdrop-filter: blur(10px);
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .hero-gradient-text {
    background: linear-gradient(135deg, #818cf8, #c084fc, #f472b6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-desc {
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.7;
    margin-bottom: 2.5rem;
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta-row {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3.5rem;
  }

  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--os-primary);
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.9rem 2.2rem;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.2s;
    box-shadow: 0 4px 20px rgba(67, 56, 202, 0.4);
  }

  .hero-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(67, 56, 202, 0.5);
  }

  .hero-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 600;
    font-size: 1rem;
    padding: 0.9rem 2.2rem;
    border-radius: 50px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    text-decoration: none;
    transition: all 0.2s;
  }

  .hero-btn-ghost:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-num {
    font-size: 2rem;
    font-weight: 800;
    color: #fff;
  }

  .stat-label {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 0.15rem;
  }

  .hero-stat-divider {
    width: 1px;
    height: 40px;
    background: rgba(255, 255, 255, 0.12);
  }

  /* ═══════════════ INTRO ═══════════════ */
  .intro-section {
    padding: 5rem 1.5rem;
    background: #fff;
  }

  .intro-inner {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  .intro-icon-col {
    flex-shrink: 0;
  }

  .intro-icon-circle {
    width: 100px;
    height: 100px;
    border-radius: 24px;
    background: linear-gradient(135deg, #eef2ff, #e0e7ff);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--os-shadow-md);
  }

  .intro-icon-circle i {
    font-size: 2.5rem;
    color: var(--os-primary);
  }

  .intro-text-col h2 {
    font-size: 1.8rem;
    font-weight: 800;
    color: #1e293b;
    margin-bottom: 1rem;
  }

  .intro-text-col p {
    font-size: 1.05rem;
    color: #64748b;
    line-height: 1.8;
  }

  .intro-text-col strong {
    color: var(--os-primary);
  }

  /* ═══════════════ SHARED SECTION HEADINGS ═══════════════ */
  .section-label {
    text-align: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--os-primary);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }

  .section-title {
    text-align: center;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    color: #1e293b;
    margin-bottom: 0.75rem;
  }

  .section-title-white {
    color: #fff;
  }

  .section-subtitle {
    text-align: center;
    font-size: 1.05rem;
    color: #94a3b8;
    margin-bottom: 3.5rem;
  }

  /* ═══════════════ SERVICES ═══════════════ */
  .services-section {
    padding: 5rem 1.5rem;
    background: var(--os-bg);
  }

  .services-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-top: 3.5rem;
  }

  .svc-card {
    background: #fff;
    border-radius: 20px;
    padding: 2rem;
    border: 1px solid #e2e8f0;
    transition:
      transform 0.25s,
      box-shadow 0.25s;
    box-shadow: var(--os-shadow-sm);
  }

  .svc-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--os-shadow-lg);
  }

  .svc-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    font-size: 1.3rem;
    color: #fff;
  }

  .svc-icon-indigo {
    background: #4f46e5;
  }
  .svc-icon-purple {
    background: #7c3aed;
  }
  .svc-icon-cyan {
    background: #0891b2;
  }
  .svc-icon-emerald {
    background: #059669;
  }
  .svc-icon-amber {
    background: #d97706;
  }
  .svc-icon-rose {
    background: #e11d48;
  }

  .svc-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.5rem;
  }

  .svc-card p {
    font-size: 0.95rem;
    color: #64748b;
    line-height: 1.65;
  }

  /* ═══════════════ BENEFITS ═══════════════ */
  .benefits-section {
    padding: 5rem 1.5rem;
    background: #fff;
  }

  .benefits-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .benefit-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    background: #f8fafc;
    border-radius: 16px;
    padding: 1.75rem;
    border: 1px solid #e2e8f0;
    transition: all 0.2s;
  }

