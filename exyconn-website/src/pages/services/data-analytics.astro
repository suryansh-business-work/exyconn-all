---
import Page from "../../layouts/Page.astro";
import GetInTouch from "../../components/forms/GetInTouch.astro";
import DynamicFaqs from "../../components/dynamic-components/DynamicFaqs.astro";
import DynamicBanner from "../../components/fragments/Banners/DynamicBanner.astro";
import DynamicImageStack from "../../components/dynamic-components/DynamicImageStack.astro";
import DynamicBreadcrumb from "../../components/dynamic-components/DynamicBreadcrumb.astro";
import DynamicTwoColumnWithIcon from "../../components/dynamic-components/DynamicTwoColumnWithIcon.astro";
import DynamicTwoColumnWithBgAndIcon from "../../components/dynamic-components/DynamicTwoColumnWithBgAndIcon.astro";
import DynamicThreeColumnWithIcon from "../../components/dynamic-components/DynamicThreeColumnWithIcon.astro";
---

<Page
  metaTitle="Data Analytics & Business Insights Services | Exyconn"
  metaDescription="Transform your data into actionable insights with Exyconn's data analytics services. We help you collect, analyze, visualize, and leverage data for smarter business decisions."
  metaKeywords="data analytics, business intelligence, data visualization, analytics consulting, Exyconn"
  metaImage="https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=1200&q=80"
>
  <DynamicBreadcrumb />
  <DynamicBanner
    title="Data Analytics Services"
    subtitle="Unlock Insights. Drive Decisions."
    description="Leverage the power of your data with Exyconn’s analytics services. We help you collect, analyze, and visualize data to uncover trends, optimize operations, and make smarter business decisions."
    image="https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=1200&q=80"
    ctaText="Start Your Analytics Journey"
    ctaHref="/contact"
  />
  <DynamicTwoColumnWithIcon
    title="What is Data Analytics?"
    description='<span class="font-semibold text-indigo-700">Data analytics</span> is the process of examining raw data to find trends, patterns, and actionable insights. We turn your business data into a strategic asset—fueling growth, efficiency, and innovation.'
    iconClass="fa-solid fa-chart-bar text-6xl text-indigo-600"
  />
  <DynamicTwoColumnWithBgAndIcon
    title="Why Choose Exyconn for Data Analytics?"
    items={[
      {
        icon: "fa-solid fa-database text-indigo-500 mt-1",
        text: "Expertise in data collection, cleaning, and integration.",
      },
      {
        icon: "fa-solid fa-chart-line text-indigo-500 mt-1",
        text: "Advanced analytics and predictive modeling.",
      },
      {
        icon: "fa-solid fa-eye text-indigo-500 mt-1",
        text: "Interactive dashboards and data visualization.",
      },
      {
        icon: "fa-solid fa-gears text-indigo-500 mt-1",
        text: "Seamless integration with your business systems.",
      },
      {
        icon: "fa-solid fa-user-check text-indigo-500 mt-1",
        text: "Actionable insights for better decision-making.",
      },
    ]}
    bgClass="bg-gradient-to-r from-indigo-100 via-white to-cyan-100 rounded-2xl shadow-lg p-8"
  />
  <DynamicThreeColumnWithIcon
    title="Our Data Analytics Services"
    columns={[
      {
        icon: "fa-solid fa-magnifying-glass-chart text-4xl text-indigo-600 mb-4",
        heading: "Business Intelligence",
        text: "Dashboards, KPIs, and reporting for real-time business insights.",
      },
      {
        icon: "fa-solid fa-chart-pie text-4xl text-indigo-600 mb-4",
        heading: "Advanced Analytics",
        text: "Predictive analytics, machine learning, and data mining.",
      },
      {
        icon: "fa-solid fa-diagram-project text-4xl text-indigo-600 mb-4",
        heading: "Data Integration",
        text: "Connect and unify data from multiple sources for a complete view.",
      },
    ]}
  />
  <DynamicFaqs
    title="Data Analytics FAQs"
    faqs={[
      {
        question: "What analytics platforms do you support?",
        answer:
          "We work with Power BI, Tableau, Looker, Google Data Studio, and custom analytics stacks.",
      },
      {
        question: "Can you integrate data from multiple sources?",
        answer:
          "Yes, we specialize in data integration from CRMs, ERPs, cloud apps, databases, and more.",
      },
      {
        question: "Do you provide predictive analytics and AI?",
        answer:
          "Absolutely. We offer advanced analytics, machine learning, and AI-driven insights tailored to your business.",
      },
      {
        question: "How do you ensure data security and privacy?",
        answer:
          "We follow best practices for data governance, privacy, and compliance throughout every analytics project.",
      },
      {
        question: "How do I get started with data analytics?",
        answer:
          "Contact Exyconn for a free consultation. We’ll assess your data and recommend the best analytics strategy for your needs.",
      },
    ]}
  />
  <DynamicImageStack
    title="Analytics Tools"
    logos={[
      {
        name: "Tableau",
        src: "https://upload.wikimedia.org/wikipedia/commons/thumb/4/4b/Tableau_Logo.png/1200px-Tableau_Logo.png",
      },
      {
        name: "Adobe analytics",
        src: "https://improvado.io/5a1eb87c9afe1000014a4c7d/64e351d1fc727d1651281ecd_646cbd27e444c08356e0a1c3_adobe-analytics-adobe-experience-cloud.png",
      },
      {
        name: "Gemini",
        src: "https://miro.medium.com/v2/resize:fit:768/1*sF3Hm25Vf25D3t494To1XA.png",
      },
    ]}
  />
  <GetInTouch />
</Page>
