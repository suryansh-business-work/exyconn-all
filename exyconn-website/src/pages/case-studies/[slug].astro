---
import Page from "../../layouts/Page.astro";
import { formatDate } from "../../lib/portal";
import { getCaseStudy } from "../../lib/content";

const { slug } = Astro.params;
const result = slug ? await getCaseStudy(slug) : null;

if (!result) {
  return new Response(null, { status: 404 });
}

const { caseStudy, Content } = result;

const SITE_URL = (Astro.site?.toString() || "https://exyconn.com/").replace(/\/$/, "");
const caseStudyUrl = `${SITE_URL}/case-studies/${caseStudy.slug}`;
const coverAbs = /^https?:\/\//.test(caseStudy.coverImage)
  ? caseStudy.coverImage
  : `${SITE_URL}${caseStudy.coverImage}`;

const pageJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: caseStudy.title,
    description: caseStudy.excerpt,
    image: coverAbs,
    datePublished: caseStudy.publishedAt,
    dateModified: caseStudy.publishedAt,
    articleSection: caseStudy.category,
    author: {
      "@type": "Organization",
      name: "Exyconn",
      url: SITE_URL,
    },
    publisher: {
      "@type": "Organization",
      name: "Exyconn",
      logo: { "@type": "ImageObject", url: `${SITE_URL}/favicon.svg` },
    },
    mainEntityOfPage: { "@type": "WebPage", "@id": caseStudyUrl },
    keywords: caseStudy.tags.join(", "),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Case Studies", item: `${SITE_URL}/case-studies` },
      { "@type": "ListItem", position: 3, name: caseStudy.title, item: caseStudyUrl },
    ],
  },
];
---

<Page
  metaTitle={caseStudy.title + " | Exyconn Case Study"}
  metaDescription={caseStudy.excerpt}
  metaKeywords={caseStudy.tags.join(", ")}
  metaImage={caseStudy.coverImage}
  ogType="article"
  jsonLd={pageJsonLd}
>
  <main class="bg-gradient-to-b from-gray-50 to-white min-h-screen">
    <!-- Hero Section -->
    <section class="relative pt-12 pb-8 px-6">
      <div class="max-w-4xl mx-auto">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8">
          <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
          <i class="fa-solid fa-chevron-right text-xs"></i>
          <a href="/case-studies" class="hover:text-blue-600 transition-colors">Case Studies</a>
          <i class="fa-solid fa-chevron-right text-xs"></i>
          <span class="text-gray-900 font-medium truncate max-w-[200px]">{caseStudy.title}</span>
        </nav>

        <!-- Category + Tags -->
        <div class="flex flex-wrap gap-2 mb-4">
          <span
            class="text-xs font-semibold text-purple-700 bg-purple-50 px-3 py-1 rounded-full uppercase tracking-wide"
          >
            {caseStudy.category}
          </span>
          {
            caseStudy.tags.map((tag) => (
              <span class="text-xs font-medium text-blue-600 bg-blue-50 px-3 py-1 rounded-full">
                {tag}
              </span>
            ))
          }
        </div>

        <!-- Title -->
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 leading-tight">
          {caseStudy.title}
        </h1>

        <!-- Excerpt -->
        <p class="text-xl text-gray-600 mb-8 leading-relaxed">
          {caseStudy.excerpt}
        </p>

        <!-- Meta Info -->
        <div
          class="flex flex-wrap items-center gap-4 pb-8 border-b border-gray-200 text-sm text-gray-500"
        >
          <span class="flex items-center gap-1.5">
            <i class="fa-regular fa-user"></i>
            {caseStudy.author}
          </span>
          <span class="flex items-center gap-1.5">
            <i class="fa-regular fa-calendar"></i>
            {formatDate(caseStudy.publishedAt)}
          </span>
          {
            caseStudy.pdfUrl && (
              <a
                href={caseStudy.pdfUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 px-4 py-2 bg-gray-900 text-white font-semibold rounded-full hover:bg-gray-800 transition-colors"
              >
                <i class="fa-solid fa-file-pdf" />
                Download PDF
              </a>
            )
          }
        </div>
      </div>
    </section>

    <!-- Cover Image -->
    <section class="px-6 mb-12">
      <div class="max-w-5xl mx-auto">
        <img
          src={caseStudy.coverImage}
          alt={caseStudy.title}
          class="w-full h-[400px] object-cover rounded-2xl shadow-lg"
        />
      </div>
    </section>

    <!-- Content -->
    <section class="px-6 pb-16">
      <div class="max-w-3xl mx-auto">
        <article
          class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-headings:font-bold prose-p:text-gray-700 prose-a:text-blue-600 prose-strong:text-gray-900 prose-blockquote:border-blue-500 prose-blockquote:bg-blue-50 prose-blockquote:py-1 prose-blockquote:px-4 prose-blockquote:rounded-r-lg prose-li:text-gray-700"
        >
          <Content />
        </article>

        <!-- Back Link -->
        <div class="mt-12 pt-8 border-t border-gray-200">
          <a
            href="/case-studies"
            class="inline-flex items-center gap-2 text-sm font-medium text-blue-600 hover:text-blue-700 transition-colors"
          >
            <i class="fa-solid fa-arrow-left"></i>
            Back to all case studies
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="px-6 py-16 bg-gradient-to-br from-blue-600 to-purple-600">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-white mb-4">Ready to Create Your Success Story?</h2>
        <p class="text-blue-100 text-lg mb-8">
          Let's discuss how Exyconn can transform your business with AI and automation.
        </p>
        <a
          href="/get-a-quote"
          class="inline-flex items-center gap-2 px-8 py-4 bg-white text-blue-600 font-semibold rounded-full hover:shadow-xl transition-all"
        >
          Start Your Project
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </section>
  </main>
</Page>

<style>
  .prose .lead {
    font-size: 1.25rem;
    line-height: 1.75rem;
    color: #4b5563;
  }
</style>
