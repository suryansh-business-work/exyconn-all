---
/**
 * A CMS page's draft, through the short-lived link the page editor opens
 * (/cms-preview?token=…). Never indexed and never cached; an expired or forged link says so.
 */
import CmsPage from "../layouts/CmsPage.astro";
import { getCmsPreview, getCmsSite } from "../lib/cms";
import { PortalRequestError } from "../lib/portal";

const token = Astro.url.searchParams.get("token") ?? "";
if (token === "") {
  return new Response(null, { status: 404 });
}

const site = await getCmsSite(Astro.request.headers.get("host") ?? "");
let page;
try {
  page = await getCmsPreview(site.site.id, token);
} catch (error) {
  if (error instanceof PortalRequestError) {
    return new Response(error.message.replace(/^Portal request failed: /, ""), {
      status: 400,
      headers: { "Content-Type": "text/plain; charset=utf-8", "X-Robots-Tag": "noindex" },
    });
  }
  throw error;
}

if (!page) {
  return new Response(null, { status: 404 });
}
Astro.response.headers.set("Cache-Control", "no-store");
const path = page.page.path === "/" ? "" : page.page.path;
---

<CmsPage site={site} page={page} path={path} />
