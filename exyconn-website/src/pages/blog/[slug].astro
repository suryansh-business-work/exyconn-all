---
import Page from "../../layouts/Page.astro";
import { formatDate, getBlogPost, getBlogPosts, sanitizeArticleHtml } from "../../lib/portal";

const { slug } = Astro.params;
const post = slug ? await getBlogPost(slug) : null;

if (!post) {
  return new Response(null, { status: 404 });
}

const body = sanitizeArticleHtml(post.content);

// Get related posts (same tags, excluding current)
const allPosts = await getBlogPosts();
const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug && p.tags.some((tag) => post.tags.includes(tag)))
  .slice(0, 3);

const SITE_URL = (Astro.site?.toString() || "https://exyconn.com/").replace(/\/$/, "");
const postUrl = `${SITE_URL}/blog/${post.slug}`;
const coverAbs = /^https?:\/\//.test(post.coverImage)
  ? post.coverImage
  : `${SITE_URL}${post.coverImage}`;

const pageJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    description: post.summary,
    image: coverAbs,
    datePublished: post.publishedAt,
    dateModified: post.publishedAt,
    author: {
      "@type": "Organization",
      name: "Exyconn",
      url: SITE_URL,
    },
    publisher: {
      "@type": "Organization",
      name: "Exyconn",
      logo: { "@type": "ImageObject", url: `${SITE_URL}/favicon.svg` },
    },
    mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
    keywords: post.tags.join(", "),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE_URL}/blog` },
      { "@type": "ListItem", position: 3, name: post.title, item: postUrl },
    ],
  },
];
---

<Page
  metaTitle={post.title + " | Exyconn Blog"}
  metaDescription={post.summary}
  metaKeywords={post.tags.join(", ")}
  metaImage={post.coverImage}
  ogType="article"
  jsonLd={pageJsonLd}
>
  <main class="bg-gradient-to-b from-surface-subtle to-surface min-h-screen">
    <!-- Hero Section -->
    <section class="relative pt-12 pb-8 px-6">
      <div class="max-w-4xl mx-auto">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-fg-subtle mb-8">
          <a href="/" class="hover:text-blue-fg transition-colors">Home</a>
          <i class="fa-solid fa-chevron-right text-xs"></i>
          <a href="/blog" class="hover:text-blue-fg transition-colors">Blog</a>
          <i class="fa-solid fa-chevron-right text-xs"></i>
          <span class="text-fg font-medium truncate max-w-[200px]">{post.title}</span>
        </nav>

        <!-- Tags -->
        <div class="flex flex-wrap gap-2 mb-4">
          {
            post.tags.map((tag) => (
              <span class="text-xs font-medium text-blue-fg bg-blue-subtle px-3 py-1 rounded-full">
                {tag}
              </span>
            ))
          }
        </div>

        <!-- Title -->
        <h1 class="text-4xl md:text-5xl font-bold text-fg mb-6 leading-tight">
          {post.title}
        </h1>

        <!-- Summary -->
        <p class="text-xl text-fg-muted mb-8 leading-relaxed">
          {post.summary}
        </p>

        <!-- Meta Info (Date & Read Time only) -->
        <div
          class="flex flex-wrap items-center gap-4 pb-8 border-b border-line text-sm text-fg-subtle"
        >
          <span class="flex items-center gap-1.5">
            <i class="fa-regular fa-calendar"></i>
            {formatDate(post.publishedAt)}
          </span>
          <span class="flex items-center gap-1.5">
            <i class="fa-regular fa-clock"></i>
            {post.readTime}
          </span>
        </div>
      </div>
    </section>

    <!-- Cover Image -->
    <section class="px-6 mb-12">
      <div class="max-w-5xl mx-auto">
        <img
          src={post.coverImage}
          alt={post.title}
          class="w-full h-[400px] object-cover rounded-2xl shadow-lg"
        />
      </div>
    </section>

    <!-- Content -->
    <section class="px-6 pb-16">
      <div class="max-w-3xl mx-auto">
        <article
          class="prose prose-lg max-w-none prose-headings:text-fg prose-headings:font-bold prose-p:text-fg-secondary prose-a:text-blue-fg prose-strong:text-fg prose-blockquote:border-blue prose-blockquote:bg-blue-subtle prose-blockquote:py-1 prose-blockquote:px-4 prose-blockquote:rounded-r-lg prose-li:text-fg-secondary"
          set:html={body}
        />

        <!-- Share Section -->
        <div class="mt-12 pt-8 border-t border-line">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <span class="text-fg-muted font-medium">Share this article:</span>
            <div class="flex items-center gap-3">
              <a
                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent("https://exyconn.com/blog/" + post.slug)}`}
                target="_blank"
                rel="noopener"
                class="w-10 h-10 rounded-full bg-surface-muted flex items-center justify-center text-fg-muted hover:bg-blue hover:text-on-solid transition-colors"
              >
                <i class="fa-brands fa-x-twitter"></i>
              </a>
              <a
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent("https://exyconn.com/blog/" + post.slug)}`}
                target="_blank"
                rel="noopener"
                class="w-10 h-10 rounded-full bg-surface-muted flex items-center justify-center text-fg-muted hover:bg-blue-deep hover:text-on-solid transition-colors"
              >
                <i class="fa-brands fa-linkedin-in"></i>
              </a>
              <button
                onclick="navigator.clipboard.writeText(window.location.href)"
                class="w-10 h-10 rounded-full bg-surface-muted flex items-center justify-center text-fg-muted hover:bg-inverse hover:text-on-solid transition-colors"
                title="Copy link"
              >
                <i class="fa-solid fa-link"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Related Articles -->
    {
      relatedPosts.length > 0 && (
        <section class="px-6 py-16 bg-surface-subtle">
          <div class="max-w-6xl mx-auto">
            <h2 class="text-2xl font-bold text-fg mb-8">Related Articles</h2>
            <div class="grid md:grid-cols-3 gap-8">
              {relatedPosts.map((related) => (
                <a
                  href={`/blog/${related.slug}`}
                  class="group bg-surface rounded-2xl shadow-sm border border-line-subtle overflow-hidden hover:shadow-lg transition-all"
                >
                  <div class="h-40 overflow-hidden">
                    <img
                      src={related.coverImage}
                      alt={related.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  </div>
                  <div class="p-5">
                    <div class="flex gap-2 mb-2">
                      {related.tags.slice(0, 2).map((tag) => (
                        <span class="text-xs text-blue-fg bg-blue-subtle px-2 py-0.5 rounded-full">
                          {tag}
                        </span>
                      ))}
                    </div>
                    <h3 class="font-bold text-fg group-hover:text-blue-fg transition-colors line-clamp-2">
                      {related.title}
                    </h3>
                    <p class="text-sm text-fg-subtle mt-2">{formatDate(related.publishedAt)}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- CTA Section -->
    <section class="px-6 py-16 bg-gradient-to-br from-blue-strong to-purple-strong">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-on-solid mb-4">Ready to Transform Your Business?</h2>
        <p class="text-on-solid-muted text-lg mb-8">
          Let's discuss how Exyconn can help you leverage AI and automation for growth.
        </p>
        <a
          href="/get-a-quote"
          class="inline-flex items-center gap-2 px-8 py-4 bg-surface text-blue-fg font-semibold rounded-full hover:shadow-xl transition-all"
        >
          Get Started
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </section>
  </main>
</Page>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .prose .lead {
    font-size: var(--font-size-xl);
    line-height: 1.75rem;
    color: var(--color-fg-muted);
  }
</style>
