---
import Page from "../layouts/Page.astro";
---

<Page
  metaTitle="Cookies Policy | How We Use Cookies | Exyconn"
  metaDescription="Learn how Exyconn uses cookies and similar technologies to enhance your experience, analyze site usage, and provide relevant content."
  metaKeywords="cookies policy, cookie usage, privacy, Exyconn, website cookies, data protection"
  metaImage="https://images.pexels.com/photos/34088/pexels-photo.jpg?auto=compress&w=1200&q=80"
>
  <main class="bg-white min-h-screen">
    <!-- Hero Section - Light Background -->
    <section
      class="relative py-20 px-6 bg-gradient-to-br from-blue-50 via-white to-purple-50 overflow-hidden"
    >
      <div
        class="absolute top-20 right-20 w-80 h-80 bg-gradient-to-r from-blue-200/40 to-purple-200/40 rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-10 left-10 w-96 h-96 bg-gradient-to-r from-cyan-200/30 to-blue-200/30 rounded-full blur-3xl"
      >
      </div>

      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <span
          class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-full text-sm font-medium text-gray-600 mb-6 shadow-sm"
        >
          <i class="fa-solid fa-cookie-bite text-amber-500"></i>
          Cookie Information
        </span>

        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 tracking-tight">
          Cookies <span
            class="bg-gradient-to-r from-blue-600 to-purple-500 bg-clip-text text-transparent"
            >Policy</span
          >
        </h1>

        <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
          Understanding how we use cookies to improve your experience.
        </p>
      </div>
    </section>

    <!-- Content Section -->
    <section class="py-16 px-6">
      <div class="max-w-3xl mx-auto">
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8 md:p-12 space-y-8">
          <!-- What Are Cookies -->
          <div class="space-y-4">
            <h2 class="text-xl font-bold text-gray-900 flex items-center gap-3">
              <span
                class="w-10 h-10 bg-amber-100 text-amber-600 rounded-xl flex items-center justify-center"
              >
                <i class="fa-solid fa-cookie"></i>
              </span>
              What Are Cookies?
            </h2>
            <p class="text-gray-600 leading-relaxed pl-13">
              Cookies are small text files that are placed on your device when you visit a website.
              They are widely used to make websites work more efficiently and provide information to
              site owners.
            </p>
          </div>

          <!-- How We Use Cookies -->
          <div class="space-y-4">
            <h2 class="text-xl font-bold text-gray-900 flex items-center gap-3">
              <span
                class="w-10 h-10 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center"
              >
                <i class="fa-solid fa-gear"></i>
              </span>
              How We Use Cookies
            </h2>
            <ul class="space-y-2 pl-13 text-gray-600">
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-check text-green-500"></i> Remember your preferences and settings
              </li>
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-check text-green-500"></i> Enable essential website functionality
              </li>
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-check text-green-500"></i> Analyze site traffic and usage to improve
                our services
              </li>
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-check text-green-500"></i> Provide relevant content and enhance
                your experience
              </li>
            </ul>
          </div>

          <!-- Types of Cookies -->
          <div class="space-y-4">
            <h2 class="text-xl font-bold text-gray-900 flex items-center gap-3">
              <span
                class="w-10 h-10 bg-purple-100 text-purple-600 rounded-xl flex items-center justify-center"
              >
                <i class="fa-solid fa-list"></i>
              </span>
              Types of Cookies We Use
            </h2>
            <div class="space-y-4 pl-13">
              <div class="p-4 bg-gray-50 rounded-xl">
                <h3 class="font-semibold text-gray-900 mb-1">Essential Cookies</h3>
                <p class="text-sm text-gray-600">
                  Necessary for the website to function. Cannot be switched off.
                </p>
              </div>
              <div class="p-4 bg-gray-50 rounded-xl">
                <h3 class="font-semibold text-gray-900 mb-1">Performance & Analytics</h3>
                <p class="text-sm text-gray-600">
                  Help us understand how visitors interact with our website.
                </p>
              </div>
              <div class="p-4 bg-gray-50 rounded-xl">
                <h3 class="font-semibold text-gray-900 mb-1">Functionality Cookies</h3>
                <p class="text-sm text-gray-600">
                  Remember choices you make and provide enhanced features.
                </p>
              </div>
              <div class="p-4 bg-gray-50 rounded-xl">
                <h3 class="font-semibold text-gray-900 mb-1">Marketing Cookies</h3>
                <p class="text-sm text-gray-600">Used to deliver relevant advertisements to you.</p>
              </div>
            </div>
          </div>

          <!-- Managing Cookies -->
          <div class="space-y-4">
            <h2 class="text-xl font-bold text-gray-900 flex items-center gap-3">
              <span
                class="w-10 h-10 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center"
              >
                <i class="fa-solid fa-sliders"></i>
              </span>
              Managing Cookies
            </h2>
            <div class="pl-13 space-y-3">
              <p class="text-gray-600">You can control and manage cookies in various ways:</p>
              <ul class="space-y-2 text-gray-600">
                <li class="flex items-start gap-2">
                  <i class="fa-solid fa-browser text-blue-500 mt-1"></i>
                  <span
                    ><strong class="text-gray-900">Browser Settings:</strong> Find these in the "options"
                    or "preferences" menu of your browser.</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <i class="fa-solid fa-toggle-on text-blue-500 mt-1"></i>
                  <span
                    ><strong class="text-gray-900">Cookie Banner:</strong> Use our cookie consent banner
                    when you first visit to manage preferences.</span
                  >
                </li>
              </ul>
              <p class="text-sm text-gray-500 mt-4">
                Note: Disabling cookies may affect the functionality of this website.
              </p>
            </div>
          </div>

          <!-- Contact -->
          <div class="space-y-4">
            <h2 class="text-xl font-bold text-gray-900 flex items-center gap-3">
              <span
                class="w-10 h-10 bg-cyan-100 text-cyan-600 rounded-xl flex items-center justify-center"
              >
                <i class="fa-solid fa-envelope"></i>
              </span>
              Questions?
            </h2>
            <p class="text-gray-600 leading-relaxed pl-13">
              For more details about how we use and protect your data, see our <a
                href="/privacy-policy"
                class="text-blue-600 hover:underline font-medium">Privacy Policy</a
              >. Contact us at <a
                href="mailto:info@exyconn.com"
                class="text-blue-600 hover:underline font-medium">info@exyconn.com</a
              > for any questions.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Page>
