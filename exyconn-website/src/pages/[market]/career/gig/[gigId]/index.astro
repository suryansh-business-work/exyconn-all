---
import ApplyBar from "../../../../../components/career/ApplyBar.astro";
import DetailSection from "../../../../../components/career/DetailSection.astro";
import GigTile from "../../../../../components/career/GigTile.astro";
import StageChips from "../../../../../components/career/StageChips.astro";
import ChapterHeading from "../../../../../components/inner/ChapterHeading.astro";
import InnerStage from "../../../../../components/inner/InnerStage.astro";
import type { InnerAction } from "../../../../../components/inner/types";
import Page from "../../../../../layouts/Page.astro";
import { GIG_COPY as copy, GIG_LABELS } from "../../../../../lib/career/copy";
import { fill, sceneCount } from "../../../../../lib/career/format";
import {
  gigApplyLink,
  gigHref,
  gigPay,
  isOpenGig,
  relatedGigs,
} from "../../../../../lib/career/gigs";
import { displayDate } from "../../../../../lib/content/format";
import { DEFAULT_MARKET } from "../../../../../lib/i18n/markets";
import { breadcrumbJsonLd } from "../../../../../lib/inner/structured-data";
import { ARTICLE_CLASS, getGig, getOpenGigs, sanitizeArticleHtml } from "../../../../../lib/portal";
import "../../../../../styles/article.css";

// gigId carries the gig code (e.g. "GIG-DES-001")
const { gigId } = Astro.params;
const [gig, openGigs] = gigId ? await Promise.all([getGig(gigId), getOpenGigs()]) : [null, []];

if (!gig) {
  return new Response(null, { status: 404 });
}

const market = Astro.locals.market ?? DEFAULT_MARKET;
const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const open = isOpenGig(gig);
const apply = open ? gigApplyLink(gig, copy.applySubject) : null;
const applyLabels = { email: copy.applyEmail, whatsapp: copy.applyWhatsApp, form: copy.applyForm };
// Open: the gig's own apply link (none when its contact is unusable). Closed: the open gigs.
let action: InnerAction | undefined;
if (apply) {
  action = { label: applyLabels[apply.kind], href: apply.href, external: apply.external };
} else if (!open) {
  action = copy.closedAction;
}
const pay = gigPay(gig);
const posted = displayDate(gig.postedDate, market.locale).text;
// A closed gig takes no applications, so it shows no "apply by" date.
const deadline = open && gig.deadline ? displayDate(gig.deadline, market.locale).text : "";
const related = relatedGigs(gig, openGigs);
const crumbs = [
  { label: copy.crumbHome, href: "/" },
  { label: copy.crumbCareers, href: "/career" },
  { label: copy.crumbGigs, href: "/career/gigs" },
  { label: gig.title },
];
const facts = [
  ...(pay ? [{ term: copy.budget, value: pay }] : []),
  { term: copy.duration, value: gig.duration },
  { term: copy.category, value: gig.category },
  { term: copy.status, value: open ? GIG_LABELS.open : GIG_LABELS.closed },
];
---

<Page
  title={`${gig.title} | Freelance Gig | Exyconn`}
  description={gig.shortDescription}
  jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}
>
  <InnerStage
    family="company"
    variant="band"
    crumbs={crumbs}
    title={gig.title}
    lede={gig.shortDescription}
    scene={{
      shapes: ["orbits"],
      data: { orbits: { agents: sceneCount(gig.tags.length, 3, 12) } },
    }}
  >
    <StageChips
      label={copy.status}
      status={{ label: open ? GIG_LABELS.open : GIG_LABELS.closed, open }}
      flag={gig.isUrgent && open ? GIG_LABELS.urgent : undefined}
      items={[
        pay ?? "",
        gig.category,
        gig.duration,
        posted ? fill(GIG_LABELS.posted, { date: posted }) : "",
        deadline ? fill(GIG_LABELS.deadline, { date: deadline }) : "",
      ]}
    />
  </InnerStage>

  <div class="stage-shell inner-section career-detail">
    <div class="career-detail__main">
      {
        gig.fullDescription && (
          <DetailSection title={copy.description}>
            <div class={ARTICLE_CLASS} set:html={sanitizeArticleHtml(gig.fullDescription)} />
          </DetailSection>
        )
      }
      {
        gig.deliverables.length > 0 && (
          <DetailSection title={copy.deliverables}>
            <ul class="inner-points">
              {gig.deliverables.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </DetailSection>
        )
      }
      {
        gig.requirements.length > 0 && (
          <DetailSection title={copy.requirements}>
            <ul class="inner-points">
              {gig.requirements.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </DetailSection>
        )
      }
      {
        gig.tags.length > 0 && (
          <DetailSection title={copy.skills}>
            <ul class="inner-chips">
              {gig.tags.map((tag) => (
                <li class="inner-chip">{tag}</li>
              ))}
            </ul>
          </DetailSection>
        )
      }
    </div>
    <ApplyBar
      label={open ? copy.applyTitle : copy.closedTitle}
      title={gig.title}
      facts={facts}
      note={open ? copy.applyText : copy.closedText}
      action={action}
    />
  </div>

  {
    related.length > 0 && (
      <section class="inner-section stage-shell" aria-labelledby="related-gigs">
        <ChapterHeading
          index={1}
          label={copy.relatedLabel}
          title={copy.relatedTitle}
          id="related-gigs"
        />
        <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 mt-10">
          {related.map((other) => (
            <GigTile
              href={gigHref(other)}
              title={other.title}
              category={other.category}
              scope={other.shortDescription}
              pay={gigPay(other)}
              duration={other.duration}
              skills={other.tags}
              skillsLabel={GIG_LABELS.skills}
              urgent={other.isUrgent ? GIG_LABELS.urgent : undefined}
            />
          ))}
        </ul>
        <a href={copy.allGigs.href} class="inner-action inner-action--ghost mt-8">
          {copy.allGigs.label}
        </a>
      </section>
    )
  }
</Page>
