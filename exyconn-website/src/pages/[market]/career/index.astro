---
import CompaniesChapter from "../../../components/career/CompaniesChapter.astro";
import GigsTeaser from "../../../components/career/GigsTeaser.astro";
import JoinChapters from "../../../components/career/JoinChapters.astro";
import RolesChapter from "../../../components/career/RolesChapter.astro";
import CtaBand from "../../../components/inner/CtaBand.astro";
import InnerStage from "../../../components/inner/InnerStage.astro";
import ProofStrip from "../../../components/inner/ProofStrip.astro";
import Page from "../../../layouts/Page.astro";
import { CAREERS_COPY as copy } from "../../../lib/career/copy";
import { liveStats, sceneCount } from "../../../lib/career/format";
import { orderedGigs } from "../../../lib/career/gigs";
import { companyCards } from "../../../lib/career/roles";
import { breadcrumbJsonLd } from "../../../lib/inner/structured-data";
import {
  getBrandingSafe,
  getJobCompanies,
  getJobsWithCompanies,
  getOpenGigs,
} from "../../../lib/portal";
import { safeHref } from "../../../lib/safe-output";
import { MAX_FIGURES } from "../../../scripts/stage3d/shapes/figures";

const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const [roles, jobCompanies, openGigs, branding] = await Promise.all([
  getJobsWithCompanies(),
  getJobCompanies(),
  getOpenGigs(),
  getBrandingSafe(),
]);
const cards = companyCards(
  jobCompanies,
  roles.map(({ job }) => job)
);
const stats = liveStats([
  { count: roles.length, label: copy.statRoles },
  { count: cards.companies.length, label: copy.statCompanies },
  { count: openGigs.length, label: copy.statGigs },
]);
const linkedIn = safeHref(branding.linkedinUrl);
const crumbs = [{ label: "Home", href: "/" }, { label: copy.crumb }];
// One figure per open role in the constellation of people (the shape's own count when none).
const figures = sceneCount(roles.length, 1, MAX_FIGURES);
// Chapter numbers run on when there are no companies to show.
const next = cards.companies.length > 0 ? 3 : 2;
---

<Page
  metaTitle={copy.metaTitle}
  metaDescription={copy.metaDescription}
  metaKeywords={copy.metaKeywords}
  metaImage={copy.metaImage}
  jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}
>
  <InnerStage
    family="company"
    crumbs={crumbs}
    title={copy.title}
    lede={copy.lede}
    primary={copy.primary}
    secondary={copy.secondary}
    scene={{ shapes: ["figures"], data: { figures: { figures } } }}
  />
  {stats.length > 0 && <ProofStrip variant="stats" label={copy.proofLabel} items={stats} />}

  <RolesChapter
    id="open-roles"
    index={1}
    label={copy.rolesLabel}
    title={copy.rolesTitle}
    lede={copy.rolesLede}
    roles={roles}
    empty={{
      label: copy.emptyRolesLabel,
      title: copy.emptyRolesTitle,
      text: copy.emptyRolesText,
      primary: copy.ctaPrimary,
      secondary: copy.secondary,
    }}
  />
  {
    cards.companies.length > 0 && (
      <CompaniesChapter index={2} companies={cards.companies} group={cards.group} />
    )
  }
  <GigsTeaser index={next} gigs={orderedGigs(openGigs).slice(0, 3)} total={openGigs.length} />
  <JoinChapters start={next + 1} />

  <CtaBand
    family="company"
    label={copy.ctaLabel}
    title={copy.ctaTitle}
    text={copy.ctaText}
    primary={copy.ctaPrimary}
    secondary={linkedIn ? { label: copy.linkedIn, href: linkedIn, external: true } : undefined}
  />
</Page>
