---
import GigTile from "../../../components/career/GigTile.astro";
import PerkGrid from "../../../components/career/PerkGrid.astro";
import ContentEmpty from "../../../components/content/ContentEmpty.astro";
import ChapterHeading from "../../../components/inner/ChapterHeading.astro";
import CtaBand from "../../../components/inner/CtaBand.astro";
import FilterBar from "../../../components/inner/FilterBar.astro";
import InnerStage from "../../../components/inner/InnerStage.astro";
import ProofStrip from "../../../components/inner/ProofStrip.astro";
import Page from "../../../layouts/Page.astro";
import { displayDate } from "../../../lib/content/format";
import { GIG_LABELS, GIG_PERKS, GIGS_COPY as copy } from "../../../lib/career/copy";
import { fill, liveStats, sceneCount } from "../../../lib/career/format";
import {
  gigCategoryOptions,
  gigFilterData,
  gigHref,
  gigPay,
  orderedGigs,
} from "../../../lib/career/gigs";
import { DEFAULT_MARKET } from "../../../lib/i18n/markets";
import { breadcrumbJsonLd } from "../../../lib/inner/structured-data";
import { getOpenGigs } from "../../../lib/portal";

const market = Astro.locals.market ?? DEFAULT_MARKET;
const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const gigs = orderedGigs(await getOpenGigs());
const categories = gigCategoryOptions(gigs);
const stats = liveStats([
  { count: gigs.length, label: copy.statOpen },
  { count: gigs.filter((gig) => gig.isUrgent).length, label: copy.statUrgent },
  { count: categories.length, label: copy.statCategories },
]);
const crumbs = [
  { label: copy.crumbHome, href: "/" },
  { label: copy.crumbCareers, href: "/career" },
  { label: copy.crumb },
];
const deadlineOf = (iso: string | null) => {
  const text = iso ? displayDate(iso, market.locale).text : "";
  return text ? fill(GIG_LABELS.deadline, { date: text }) : undefined;
};
// One orbiting node per open gig (2–12), the shape's own count when there are none.
const agents = sceneCount(gigs.length, 2, 12);
---

<Page
  title={copy.metaTitle}
  description={copy.metaDescription}
  jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}
>
  <InnerStage
    family="company"
    crumbs={crumbs}
    title={copy.title}
    lede={copy.lede}
    primary={copy.primary}
    secondary={copy.secondary}
    scene={{ shapes: ["orbits"], data: { orbits: { agents } } }}
  />
  {stats.length > 0 && <ProofStrip variant="stats" label={copy.proofLabel} items={stats} />}

  <section
    id="open-gigs"
    class="inner-section stage-shell career-anchor"
    aria-labelledby="gigs-list-title"
  >
    <ChapterHeading index={1} label={copy.listLabel} title={copy.listTitle} id="gigs-list-title" />
    {
      gigs.length === 0 ? (
        <div class="mt-10">
          <ContentEmpty
            label={copy.emptyLabel}
            title={copy.emptyTitle}
            text={copy.emptyText}
            primary={copy.ctaPrimary}
            secondary={copy.ctaSecondary}
            level="h3"
          />
        </div>
      ) : (
        <>
          <div class="mt-10">
            <FilterBar
              target="gig-list"
              label={copy.filterLabel}
              sheetLabel={copy.sheetLabel}
              groups={
                categories.length > 1
                  ? [
                      {
                        param: "category",
                        label: copy.categoryLabel,
                        allLabel: copy.allCategories,
                        options: categories,
                      },
                    ]
                  : []
              }
              search={{ param: "q", label: copy.searchLabel, placeholder: copy.searchPlaceholder }}
              sort={{
                param: "sort",
                label: copy.sortLabel,
                options: [
                  { value: "order", label: copy.sortCategory },
                  { value: "-posted", label: copy.sortNewest },
                  { value: "deadline", label: copy.sortDeadline },
                ],
              }}
              countTemplate={copy.countTemplate}
            />
          </div>
          <ul id="gig-list" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 mt-8">
            {gigs.map((gig, order) => (
              <GigTile
                href={gigHref(gig)}
                title={gig.title}
                category={gig.category}
                scope={gig.shortDescription}
                pay={gigPay(gig)}
                duration={gig.duration}
                skills={gig.tags}
                skillsLabel={GIG_LABELS.skills}
                deadline={deadlineOf(gig.deadline)}
                urgent={gig.isUrgent ? GIG_LABELS.urgent : undefined}
                {...gigFilterData(gig)}
                data-sort-order={order}
              />
            ))}
          </ul>
          <p data-filter-empty="gig-list" class="inner-panel p-6 mt-6 text-fg-secondary" hidden>
            {copy.noMatch}
          </p>
        </>
      )
    }
  </section>

  <section class="inner-section stage-shell" aria-labelledby="gigs-why-title">
    <ChapterHeading index={2} label={copy.whyLabel} title={copy.whyTitle} id="gigs-why-title" />
    <PerkGrid items={GIG_PERKS} />
  </section>

  <CtaBand
    family="company"
    label={copy.ctaLabel}
    title={copy.ctaTitle}
    text={copy.ctaText}
    primary={copy.ctaPrimary}
    secondary={copy.ctaSecondary}
  />
</Page>
