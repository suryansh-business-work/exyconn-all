---
import CompanyAbout from "../../../../../components/career/CompanyAbout.astro";
import PerkGrid from "../../../../../components/career/PerkGrid.astro";
import RolesChapter from "../../../../../components/career/RolesChapter.astro";
import StageChips from "../../../../../components/career/StageChips.astro";
import "../../../../../components/career/career.css";
import ActionLink from "../../../../../components/inner/ActionLink.astro";
import ChapterHeading from "../../../../../components/inner/ChapterHeading.astro";
import CtaBand from "../../../../../components/inner/CtaBand.astro";
import InnerStage from "../../../../../components/inner/InnerStage.astro";
import Page from "../../../../../layouts/Page.astro";
import { companyFacts, hasText } from "../../../../../lib/career/company";
import { COMPANY_COPY as copy } from "../../../../../lib/career/copy";
import { chapterNumbers, countLabel, fill } from "../../../../../lib/career/format";
import { breadcrumbJsonLd } from "../../../../../lib/inner/structured-data";
import { getJobCompany, getJobs } from "../../../../../lib/portal";
import { safeHref } from "../../../../../lib/safe-output";

const { companySlug } = Astro.params;
const [company, jobs] = companySlug
  ? await Promise.all([getJobCompany(companySlug), getJobs(companySlug)])
  : [null, []];

if (!company) {
  return new Response(null, { status: 404 });
}

const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const name = company.name;
const roles = jobs.map((job) => ({ job, company }));
const website = safeHref(company.website);
const crumbs = [
  { label: copy.crumbHome, href: "/" },
  { label: copy.crumbCareers, href: "/career" },
  { label: name },
];
const chapters = chapterNumbers(["about", "culture", "benefits", "roles"], {
  about: hasText(company.description),
  culture: hasText(company.culture),
  benefits: company.benefits.length > 0,
});
const benefits = company.benefits.map(({ title, description }) => ({ title, text: description }));
---

<Page
  metaTitle={`Careers at ${name} | Exyconn`}
  metaDescription={[company.tagline, `${jobs.length} open positions in ${company.industry}.`]
    .filter(Boolean)
    .join(" ")}
  metaKeywords={`${name} careers, ${name} jobs, ${company.industry} jobs, remote jobs`}
  metaImage={safeHref(company.logo) || undefined}
  jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}
>
  <InnerStage
    family="company"
    variant="band"
    crumbs={crumbs}
    title={fill(copy.title, { name })}
    lede={company.tagline || undefined}
    primary={jobs.length > 0
      ? { label: countLabel(jobs.length, copy.role, copy.roles), href: "#open-positions" }
      : undefined}
    secondary={website ? { label: copy.website, href: website, external: true } : undefined}
    scene={{ shapes: ["globe"] }}
  >
    <StageChips label={name} items={companyFacts(company, copy)} />
  </InnerStage>

  {chapters.about && <CompanyAbout index={chapters.about} company={company} />}
  {chapters.culture && <CompanyAbout index={chapters.culture} company={company} part="culture" />}
  {
    chapters.benefits && (
      <section class="inner-section stage-shell" aria-labelledby="benefits-title">
        <ChapterHeading
          index={chapters.benefits}
          label={copy.benefitsLabel}
          title={fill(copy.benefitsTitle, { name })}
          id="benefits-title"
        />
        <PerkGrid items={benefits} />
      </section>
    )
  }
  <RolesChapter
    id="open-positions"
    index={chapters.roles ?? 1}
    label={copy.rolesLabel}
    title={fill(copy.rolesTitle, { name })}
    roles={roles}
    showCompany={false}
    empty={{
      label: copy.emptyRolesLabel,
      title: fill(copy.emptyRolesTitle, { name }),
      text: copy.emptyRolesText,
      primary: copy.emptyPrimary,
      secondary: copy.emptySecondary,
    }}
  >
    {
      jobs.length > 0 && (
        <div class="career-nofit">
          <p class="inner-card__text">{copy.noFitText}</p>
          <ActionLink action={copy.noFitAction} variant="ghost" />
        </div>
      )
    }
  </RolesChapter>

  <CtaBand
    family="company"
    label={copy.ctaLabel}
    title={copy.ctaTitle}
    primary={copy.ctaPrimary}
    secondary={copy.ctaSecondary}
  />
</Page>
