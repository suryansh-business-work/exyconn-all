---
import ApplyBar from "../../../../../../../components/career/ApplyBar.astro";
import JobApplicationForm from "../../../../../../../components/career/JobApplicationForm.astro";
import JobBody from "../../../../../../../components/career/JobBody.astro";
import StageChips from "../../../../../../../components/career/StageChips.astro";
import "../../../../../../../components/career/career.css";
import ChapterHeading from "../../../../../../../components/inner/ChapterHeading.astro";
import RoleRow from "../../../../../../../components/inner/RoleRow.astro";
import InnerStage from "../../../../../../../components/inner/InnerStage.astro";
import Page from "../../../../../../../layouts/Page.astro";
import { JOB_COPY as copy } from "../../../../../../../lib/career/copy";
import { fill, sceneCount } from "../../../../../../../lib/career/format";
import { otherRoles, roleHref } from "../../../../../../../lib/career/roles";
import { jobPostingJsonLd } from "../../../../../../../lib/career/structured-data";
import {
  absoluteAsset,
  displayDate,
  marketCrumbs,
  marketPageUrl,
} from "../../../../../../../lib/content/format";
import { DEFAULT_MARKET } from "../../../../../../../lib/i18n/markets";
import { breadcrumbJsonLd } from "../../../../../../../lib/inner/structured-data";
import {
  getJob,
  getJobCompany,
  getJobs,
  sanitizeArticleHtml,
} from "../../../../../../../lib/portal";
import { safeHref } from "../../../../../../../lib/safe-output";

// jobId carries the job code (e.g. "GRP-SM-001")
const { companySlug, jobId } = Astro.params;
const [company, job, companyJobs] =
  companySlug && jobId
    ? await Promise.all([getJobCompany(companySlug), getJob(jobId), getJobs(companySlug)])
    : [null, null, []];

// Not found, or a job that belongs to another company
if (!company || job?.companySlug !== company.slug) {
  return new Response(null, { status: 404 });
}

const market = Astro.locals.market ?? DEFAULT_MARKET;
const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const url = marketPageUrl(SITE_URL, market, roleHref(job));
const posted = displayDate(job.jobPostDate, market.locale).text;
const deadline = job.applicationDeadline
  ? displayDate(job.applicationDeadline, market.locale).text
  : "";
const others = otherRoles(job, companyJobs);
const crumbs = [
  { label: copy.crumbHome, href: "/" },
  { label: copy.crumbCareers, href: "/career" },
  { label: company.name, href: `/career/company/${company.slug}` },
  { label: job.title },
];
const facts = [
  { term: copy.companyLabel, value: company.name },
  { term: copy.factLocation, value: job.location },
  { term: copy.factType, value: `${job.jobType} · ${job.workMode}` },
  { term: copy.factLevel, value: job.experienceLevel },
  { term: copy.factSalary, value: job.salaryRange },
].filter((fact) => fact.value.trim() !== "");
const jsonLd = [
  jobPostingJsonLd({
    job,
    company,
    description: sanitizeArticleHtml(job.jobDescription),
    url,
    logo: absoluteAsset(SITE_URL, safeHref(company.logo)),
  }),
  breadcrumbJsonLd(marketCrumbs(crumbs, market, url), SITE_URL),
];
---

<Page
  metaTitle={`${job.title} | ${company.name} Careers`}
  metaDescription={job.shortJobDescription}
  metaKeywords={[
    job.title,
    `${company.name} careers`,
    `${job.category} jobs`,
    ...job.skillSet,
  ].join(", ")}
  metaImage={safeHref(company.logo) || undefined}
  jsonLd={jsonLd}
>
  <InnerStage
    family="company"
    variant="band"
    crumbs={crumbs}
    title={job.title}
    lede={job.shortJobDescription || undefined}
    scene={{
      shapes: ["orbits"],
      data: { orbits: { agents: sceneCount(job.skillSet.length, 3, 12) } },
    }}
  >
    <StageChips
      label={copy.skills}
      items={[
        job.location,
        job.jobType,
        job.workMode,
        job.experienceLevel,
        job.salaryRange,
        posted ? fill(copy.posted, { date: posted }) : "",
        deadline ? fill(copy.deadline, { date: deadline }) : "",
      ]}
    />
  </InnerStage>

  <div class="stage-shell inner-section career-detail">
    <JobBody job={job} company={company} url={url} />
    <ApplyBar
      label={copy.applyFor}
      title={job.title}
      facts={facts}
      action={{ label: copy.apply, href: "#apply" }}
      watch="apply"
    />
  </div>

  <section id="apply" class="inner-section stage-shell career-anchor" aria-labelledby="apply-title">
    <ChapterHeading
      index={1}
      label={copy.apply}
      title={copy.applyTitle}
      lede={copy.applyLede}
      id="apply-title"
    />
    <div class="mt-10 career-form-column">
      <JobApplicationForm
        jobId={job.jobCode}
        jobTitle={job.title}
        companyName={company.name}
        companySlug={company.slug}
      />
    </div>
  </section>

  {
    others.length > 0 && (
      <section class="inner-section stage-shell" aria-labelledby="other-roles">
        <ChapterHeading
          index={2}
          label={copy.relatedLabel}
          title={fill(copy.relatedTitle, { name: company.name })}
          id="other-roles"
        />
        <ul class="career-group__list mt-10">
          {others.map((other) => (
            <RoleRow
              href={roleHref(other)}
              title={other.title}
              department={other.category}
              location={other.location || other.workMode}
              type={`${other.jobType} · ${other.workMode}`}
              pay={other.salaryRange || undefined}
            />
          ))}
        </ul>
        <a href={`/career/company/${company.slug}`} class="inner-action inner-action--ghost mt-8">
          {fill(copy.companyMore, { name: company.name })}
        </a>
      </section>
    )
  }
</Page>
