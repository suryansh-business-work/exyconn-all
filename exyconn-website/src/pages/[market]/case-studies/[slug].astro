---
import StudySnapshot from "../../../components/content/StudySnapshot.astro";
import CtaBand from "../../../components/inner/CtaBand.astro";
import InnerStage from "../../../components/inner/InnerStage.astro";
import ProofStrip from "../../../components/inner/ProofStrip.astro";
import ReadingProgress from "../../../components/inner/ReadingProgress.astro";
import StickyToc from "../../../components/inner/StickyToc.astro";
import Page from "../../../layouts/Page.astro";
import {
  CASE_STUDY_COPY as copy,
  storyMetrics,
  storyTerrain,
} from "../../../lib/content/case-studies";
import {
  absoluteAsset,
  displayDate,
  marketCrumbs,
  marketPageUrl,
} from "../../../lib/content/format";
import { articleJsonLd } from "../../../lib/content/structured-data";
import { DEFAULT_MARKET } from "../../../lib/i18n/markets";
import { withHeadingIds } from "../../../lib/inner/headings";
import { breadcrumbJsonLd } from "../../../lib/inner/structured-data";
import {
  ARTICLE_CLASS,
  BRANDING_FALLBACK,
  getCaseStudy,
  sanitizeArticleHtml,
  scopeArticleCss,
} from "../../../lib/portal";
import { safeHref } from "../../../lib/safe-output";
import "../../../styles/article.css";

const { slug } = Astro.params;
const study = slug ? await getCaseStudy(slug) : null;

if (!study) {
  return new Response(null, { status: 404 });
}

const market = Astro.locals.market ?? DEFAULT_MARKET;
const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const { html, toc } = withHeadingIds(sanitizeArticleHtml(study.content));
// A body designed in the portal's live editor brings its own CSS, scoped to the article.
const designCss = scopeArticleCss(study.contentCss);
const metrics = storyMetrics(study);
const pdfHref = safeHref(study.pdfUrl);
const published = displayDate(study.publishedAt, market.locale);
const url = marketPageUrl(SITE_URL, market, `/case-studies/${study.slug}`);
const crumbs = [
  { label: copy.home, href: "/" },
  { label: copy.list, href: "/case-studies" },
  { label: study.title },
];
const jsonLd = [
  articleJsonLd({
    type: "Article",
    headline: study.title,
    description: study.excerpt,
    image: absoluteAsset(SITE_URL, study.coverImage),
    published: study.publishedAt,
    url,
    keywords: study.tags,
    section: study.category,
    publisher: {
      name: BRANDING_FALLBACK.businessName,
      url: SITE_URL,
      logo: `${SITE_URL}${BRANDING_FALLBACK.faviconUrl}`,
    },
  }),
  breadcrumbJsonLd(marketCrumbs(crumbs, market, url), SITE_URL),
];
---

<Page
  metaTitle={`${study.title} | Exyconn Case Study`}
  metaDescription={study.excerpt}
  metaKeywords={study.tags.join(", ")}
  metaImage={study.coverImage || undefined}
  ogType="article"
  jsonLd={jsonLd}
>
  <InnerStage
    family="proof"
    variant="band"
    crumbs={crumbs}
    title={study.title}
    lede={study.excerpt}
    scene={{ shapes: ["terrain"], data: { terrain: { values: storyTerrain(metrics) } } }}
  >
    <p class="inner-meta stage-label">
      <span>{study.category}</span>
      {published.text && <time datetime={published.iso}>{published.text}</time>}
    </p>
  </InnerStage>

  {metrics.length > 0 && <ProofStrip variant="stats" label={copy.resultsLabel} items={metrics} />}

  <ReadingProgress target="study-reading" />
  <div class="inner-section stage-shell">
    <div class="content-study">
      <aside class="content-study__aside">
        <StudySnapshot
          title={copy.snapshot}
          rows={[
            { term: copy.industry, value: study.category },
            { term: copy.services, value: study.tags.join(", ") },
            { term: copy.author, value: study.author },
          ]}
          published={{ term: copy.published, date: published }}
          pdf={pdfHref ? { label: copy.pdf, href: pdfHref } : undefined}
        />
        {toc.length > 1 && <StickyToc label={copy.toc} items={toc} />}
      </aside>
      <div id="study-reading" class="inner-article-column w-full">
        {
          study.coverImage && (
            <img
              src={study.coverImage}
              alt=""
              width="1600"
              height="900"
              class="w-full h-auto rounded-2xl mb-10"
              decoding="async"
            />
          )
        }
        {designCss && <style is:inline set:html={designCss} />}
        <article class={ARTICLE_CLASS} set:html={html} />
        <a href="/case-studies" class="content-share__button mt-12">
          <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
          {copy.back}
        </a>
      </div>
    </div>
  </div>

  <CtaBand
    family="proof"
    label={copy.ctaLabel}
    title={copy.ctaTitle}
    text={copy.ctaText}
    primary={copy.ctaPrimary}
    secondary={copy.ctaSecondary}
  />
</Page>
