---
import ContentEmpty from "../../../components/content/ContentEmpty.astro";
import PostCard from "../../../components/content/PostCard.astro";
import ChapterHeading from "../../../components/inner/ChapterHeading.astro";
import CtaBand from "../../../components/inner/CtaBand.astro";
import FilterBar from "../../../components/inner/FilterBar.astro";
import InnerStage from "../../../components/inner/InnerStage.astro";
import ProofStrip from "../../../components/inner/ProofStrip.astro";
import Page from "../../../layouts/Page.astro";
import {
  CASE_STUDIES_COPY as copy,
  listTerrain,
  storyMetrics,
} from "../../../lib/content/case-studies";
import { chipOptions, displayDate, filterTokens, sortableDate } from "../../../lib/content/format";
import { DEFAULT_MARKET } from "../../../lib/i18n/markets";
import { breadcrumbJsonLd } from "../../../lib/inner/structured-data";
import { getCaseStudies } from "../../../lib/portal";

const market = Astro.locals.market ?? DEFAULT_MARKET;
const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const studies = await getCaseStudies();
// Featured stories lead; every story stays in the one filterable list.
const ordered = [...studies.filter((s) => s.featured), ...studies.filter((s) => !s.featured)];
const cards = ordered.map((study) => ({ study, metrics: storyMetrics(study, 2) }));
const headline = cards.flatMap(({ study, metrics }) =>
  metrics
    .slice(0, 1)
    .map((metric) => ({ value: metric.value, label: `${study.category}: ${metric.label}` }))
);
const industries = chipOptions(
  studies.map((s) => s.category),
  8
);
const services = chipOptions(
  studies.flatMap((s) => s.tags),
  8
);
const crumbs = [{ label: "Home", href: "/" }, { label: copy.crumb }];
---

<Page
  metaTitle={copy.metaTitle}
  metaDescription={copy.metaDescription}
  jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}
>
  <InnerStage
    family="proof"
    crumbs={crumbs}
    title={copy.title}
    lede={copy.lede}
    scene={{ shapes: ["terrain"], data: { terrain: { values: listTerrain(studies) } } }}
  >
    {
      studies.length > 0 && (
        <p class="inner-meta stage-label">
          {copy.countLabel.replace("{count}", String(studies.length))}
        </p>
      )
    }
  </InnerStage>

  {
    headline.length > 0 && (
      <ProofStrip variant="stats" label={copy.resultsLabel} items={headline.slice(0, 4)} />
    )
  }

  <section class="inner-section stage-shell" aria-labelledby="case-study-list">
    <ChapterHeading
      index={1}
      label={copy.chapterLabel}
      title={cards.length > 0 ? copy.chapterTitle : copy.emptyChapterTitle}
      id="case-study-list"
    />
    {
      cards.length === 0 ? (
        <div class="mt-10">
          <ContentEmpty
            label={copy.emptyLabel}
            title={copy.emptyTitle}
            text={copy.emptyText}
            primary={copy.emptyPrimary}
            secondary={copy.emptySecondary}
            level="h3"
          />
        </div>
      ) : (
        <>
          <div class="mt-10">
            <FilterBar
              target="case-studies"
              label={copy.filterLabel}
              sheetLabel={copy.sheetLabel}
              groups={[
                {
                  param: "industry",
                  label: copy.industryLabel,
                  allLabel: copy.all,
                  options: industries,
                },
                {
                  param: "service",
                  label: copy.serviceLabel,
                  allLabel: copy.all,
                  options: services,
                },
              ]}
              search={{ param: "q", label: copy.searchLabel, placeholder: copy.searchPlaceholder }}
              sort={{
                param: "sort",
                label: copy.sortLabel,
                options: [
                  { value: "", label: copy.sortFeatured },
                  { value: "-date", label: copy.sortNewest },
                  { value: "date", label: copy.sortOldest },
                ],
              }}
              countTemplate={copy.countTemplate}
            />
          </div>
          <ul id="case-studies" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mt-8">
            {cards.map(({ study, metrics }, index) => (
              <PostCard
                href={`/case-studies/${study.slug}`}
                title={study.title}
                summary={study.excerpt}
                image={study.coverImage}
                kicker={study.category}
                badge={study.featured ? copy.featured : undefined}
                metrics={metrics}
                meta={[
                  displayDate(study.publishedAt, market.locale).text,
                  ...study.tags.slice(0, 2),
                ]}
                more={copy.read}
                wide={index === 0 && study.featured}
                eager={index === 0}
                data-filter-item
                data-filter-industry={filterTokens([study.category])}
                data-filter-service={filterTokens(study.tags)}
                data-search={`${study.title} ${study.excerpt} ${study.category} ${study.tags.join(" ")}`}
                data-sort-date={sortableDate(study.publishedAt)}
              />
            ))}
          </ul>
          <p data-filter-empty="case-studies" class="inner-panel p-6 mt-6 text-fg-secondary" hidden>
            {copy.noMatch}
          </p>
        </>
      )
    }
  </section>

  <CtaBand
    family="proof"
    label={copy.ctaLabel}
    title={copy.ctaTitle}
    text={copy.ctaText}
    primary={copy.ctaPrimary}
    secondary={copy.ctaSecondary}
  />
</Page>
