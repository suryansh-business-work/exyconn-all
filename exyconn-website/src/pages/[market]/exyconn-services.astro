---
import Page from "../../layouts/Page.astro";
import ChapterHeading from "../../components/inner/ChapterHeading.astro";
import CtaBand from "../../components/inner/CtaBand.astro";
import InnerStage from "../../components/inner/InnerStage.astro";
import ProofStrip from "../../components/inner/ProofStrip.astro";
import InfoGrid from "../../components/hubs/InfoGrid.astro";
import PlatformDirectory from "../../components/hubs/PlatformDirectory.astro";
import RelatedHubs from "../../components/hubs/RelatedHubs.astro";
import { breadcrumbJsonLd } from "../../lib/inner/structured-data";
import {
  directoryCopy,
  groupPlatformServices,
  platformCategories,
  platformChapters,
  platformCta,
  platformHero,
  platformIntegration,
  platformMeta,
  platformServices,
  platformStats,
} from "../../lib/services/platform";

const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const crumbs = [{ label: "Home", href: "/" }, { label: "Infrastructure platform" }];
const groups = groupPlatformServices(platformServices, platformCategories);
const stats = platformStats(platformServices, groups);
---

<Page
  metaTitle={platformMeta.title}
  metaDescription={platformMeta.description}
  metaKeywords={platformMeta.keywords}
  metaImage={platformMeta.image}
  jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}
>
  <InnerStage
    family="services"
    crumbs={crumbs}
    title={platformHero.title}
    lede={platformHero.lede}
    primary={platformHero.primary}
    secondary={platformHero.secondary}
    scene={{ shapes: ["cubes"], data: { cubes: { cubes: groups.length } } }}
  />
  <ProofStrip variant="stats" label="The platform at a glance" items={stats} />

  <section class="inner-section stage-shell" aria-labelledby="directory">
    <ChapterHeading
      index={1}
      id="directory"
      label={platformChapters.directory.label}
      title={platformChapters.directory.title}
      lede={platformChapters.directory.lede}
    />
    <div class="mt-10">
      <PlatformDirectory groups={groups} copy={directoryCopy} />
    </div>
  </section>

  <section class="inner-section stage-shell" aria-labelledby="integration">
    <ChapterHeading
      index={2}
      id="integration"
      label={platformChapters.integration.label}
      title={platformChapters.integration.title}
      lede={platformChapters.integration.lede}
    />
    <InfoGrid items={platformIntegration} indexPrefix="I" />
  </section>

  <RelatedHubs
    current="/exyconn-services"
    index={3}
    label={platformChapters.explore.label}
    title={platformChapters.explore.title}
  />

  <CtaBand
    family="services"
    title={platformCta.title}
    text={platformCta.text}
    primary={platformCta.primary}
    secondary={platformCta.secondary}
  />
</Page>
