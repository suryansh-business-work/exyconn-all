---
import Page from "../../layouts/Page.astro";
import BeliefList from "../../components/company/BeliefList.astro";
import HorizonMorph from "../../components/company/HorizonMorph.astro";
import "../../components/company/company.css";
import ChapterHeading from "../../components/inner/ChapterHeading.astro";
import CtaBand from "../../components/inner/CtaBand.astro";
import InnerStage from "../../components/inner/InnerStage.astro";
import { breadcrumbJsonLd } from "../../lib/inner/structured-data";
import {
  visionAhead,
  visionChapters,
  visionCta,
  visionHero,
  visionHorizons,
  visionMeta,
  visionPillars,
  visionStatement,
} from "../../lib/company/vision";

const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const crumbs = [
  { label: "Home", href: "/" },
  { label: "About us", href: "/about-us" },
  { label: "Our vision" },
];
const { statement, horizons, principles, ahead } = visionChapters;
---

<Page
  metaTitle={visionMeta.title}
  metaDescription={visionMeta.description}
  metaKeywords={visionMeta.keywords}
  metaImage={visionMeta.image}
  jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}
>
  <InnerStage
    family="company"
    crumbs={crumbs}
    title={visionHero.title}
    lede={visionHero.lede}
    primary={visionHero.primary}
    secondary={visionHero.secondary}
    scene={{ shapes: ["horizon"], data: { horizon: { horizons: visionHorizons.length } } }}
  />

  <section class="inner-section stage-shell" aria-labelledby="statement">
    <ChapterHeading index={1} id="statement" label={statement.label} title={statement.title} />
    {visionStatement.map((line) => <p class="company-statement">{line}</p>)}
  </section>

  <section class="inner-section stage-shell" aria-labelledby="horizons">
    <ChapterHeading
      index={2}
      id="horizons"
      label={horizons.label}
      title={horizons.title}
      lede={horizons.lede}
    />
    <HorizonMorph horizons={visionHorizons} />
  </section>

  <section class="inner-section stage-shell" aria-labelledby="principles">
    <ChapterHeading index={3} id="principles" label={principles.label} title={principles.title} />
    <BeliefList items={visionPillars} />
  </section>

  <section class="inner-section stage-shell" aria-labelledby="ahead">
    <ChapterHeading index={4} id="ahead" label={ahead.label} title={ahead.title} />
    <p class="company-statement">{visionAhead.text}</p>
    <ul class="inner-points">
      {visionAhead.points.map((point) => <li>{point}</li>)}
    </ul>
  </section>

  <CtaBand
    family="company"
    title={visionCta.title}
    text={visionCta.text}
    primary={visionCta.primary}
    secondary={visionCta.secondary}
  />
</Page>
