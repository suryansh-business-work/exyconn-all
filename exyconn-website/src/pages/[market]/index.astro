---
import Page from "../../layouts/Page.astro";
import HomeStage from "../../components/home/HomeStage.astro";
import HeroChapter from "../../components/home/HeroChapter.astro";
import SolutionsChapter from "../../components/home/SolutionsChapter.astro";
import IndustriesChapter from "../../components/home/IndustriesChapter.astro";
import PartnerChapter from "../../components/home/PartnerChapter.astro";
import ClosingChapter from "../../components/home/ClosingChapter.astro";
import { aiServices } from "../../lib/services/aiServices";
import { BRANDING_FALLBACK, getBrandingSafe } from "../../lib/portal";
import { heroCopy } from "../../lib/home/hero";
import { solutionsHeader } from "../../lib/home/solutions";
import { industriesHeader } from "../../lib/home/industries";
import { whyChooseUsCopy } from "../../lib/home/why-choose-us";
import { processCopy } from "../../lib/home/process";

// Every branding field can be empty until an admin fills it in.
const branding = await getBrandingSafe();
const businessName = branding.businessName || BRANDING_FALLBACK.businessName;

const chapters = [
  { id: "intro", label: heroCopy.badge },
  { id: "solutions", label: solutionsHeader.badge },
  { id: "industries", label: industriesHeader.badge },
  { id: "partner", label: whyChooseUsCopy.badge },
  { id: "start", label: processCopy.cta.label },
];
---

<Page
  title="Exyconn | AI Agents, Automation & Vertical AI SaaS"
  description={`Exyconn builds AI agents, automation and vertical AI products across ${aiServices.length} service areas — sales, support, voice, finance, hiring, logistics and the platform layer underneath.`}
  keywords="AI agents, AI automation, AI sales automation, AI customer support, AI voice agents, WhatsApp automation, vertical AI SaaS, AI workflow automation, RAG platform, AI governance"
>
  <HomeStage chapters={chapters} railLabel="Page sections">
    <HeroChapter id={chapters[0].id} />
    <SolutionsChapter id={chapters[1].id} />
    <IndustriesChapter id={chapters[2].id} />
    <PartnerChapter
      id={chapters[3].id}
      techTitle="Powered By Leading Technology"
      techSubtitle="Cutting-Edge AI & Cloud Infrastructure"
    />
    <ClosingChapter
      id={chapters[4].id}
      businessName={businessName}
      slogan={branding.slogan || BRANDING_FALLBACK.slogan}
      description={branding.description || BRANDING_FALLBACK.description}
    />
  </HomeStage>
</Page>
