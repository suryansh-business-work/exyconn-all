---
import ContentEmpty from "../../../components/content/ContentEmpty.astro";
import ToolCard from "../../../components/content/ToolCard.astro";
import ChapterHeading from "../../../components/inner/ChapterHeading.astro";
import CtaBand from "../../../components/inner/CtaBand.astro";
import FilterBar from "../../../components/inner/FilterBar.astro";
import InnerStage from "../../../components/inner/InnerStage.astro";
import Page from "../../../layouts/Page.astro";
import {
  TOOLS_COPY as copy,
  cssColor,
  cubeCount,
  MAX_CUBES,
  monogram,
  toolCatalogue,
} from "../../../lib/content/tools";
import { breadcrumbJsonLd } from "../../../lib/inner/structured-data";
import { getToolCategories, getToolLaunchUrl, getTools, isToolAppSlug } from "../../../lib/portal";

// Both lists come from the portal's Tools CRUD — this page holds no tool data of its own.
const [categories, tools] = await Promise.all([getToolCategories(), getTools()]);
const catalogue = toolCatalogue(categories, tools);
const total = catalogue.entries.length;
const early = catalogue.entries.filter(({ tool }) => tool.isMVP).length;
const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const crumbs = [{ label: "Home", href: "/" }, { label: copy.crumb }];
const stats = copy.stats
  .replace("{tools}", String(total))
  .replace("{categories}", String(catalogue.categories.length));
---

<Page title={copy.title} description={copy.description} jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}>
  <InnerStage
    family="services"
    crumbs={crumbs}
    title={copy.heading}
    lede={copy.lede}
    primary={total > 0 ? copy.appLink : undefined}
    scene={{ shapes: ["cubes"], data: { cubes: { cubes: cubeCount(total) } } }}
  >
    {
      total > 0 && (
        <p class="inner-meta stage-label">
          <span>{stats}</span>
          {early > 0 && <span>{copy.early.replace("{count}", String(early))}</span>}
        </p>
      )
    }
  </InnerStage>

  <section class="inner-section stage-shell" aria-labelledby="tools-directory">
    <ChapterHeading
      index={1}
      label={copy.chapterLabel}
      title={copy.chapterTitle}
      id="tools-directory"
    />
    {
      total === 0 ? (
        <div class="mt-10">
          <ContentEmpty
            label={copy.emptyLabel}
            title={copy.emptyTitle}
            text={copy.emptyText}
            primary={copy.emptyPrimary}
            secondary={copy.emptySecondary}
            level="h3"
          />
        </div>
      ) : (
        <>
          <div class="mt-10">
            <FilterBar
              target="tools"
              label={copy.filterLabel}
              sheetLabel={copy.sheetLabel}
              groups={[
                {
                  param: "cat",
                  label: copy.categoryLabel,
                  allLabel: copy.all,
                  options: catalogue.categories.map(({ category }) => ({
                    value: category.slug,
                    label: category.category,
                  })),
                },
              ]}
              search={{ param: "q", label: copy.searchLabel, placeholder: copy.searchPlaceholder }}
              countTemplate={copy.countTemplate}
            />
          </div>
          <ul id="tools" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mt-8">
            {catalogue.entries.map(({ tool, category }, index) => (
              <ToolCard
                href={`/our-tools/${tool.toolCode}`}
                name={tool.name}
                description={tool.description}
                category={category.category}
                mark={monogram(tool.name)}
                tint={cssColor(tool.color || category.color)}
                badge={tool.isMVP ? copy.mvp : undefined}
                details={copy.details}
                open={
                  isToolAppSlug(tool)
                    ? { label: copy.open, href: getToolLaunchUrl(tool), note: copy.opensApp }
                    : undefined
                }
                highlight={index < MAX_CUBES ? index + 1 : undefined}
                data-filter-item
                data-filter-cat={category.slug}
                data-search={`${tool.name} ${tool.description} ${tool.keywords.join(" ")}`}
              />
            ))}
          </ul>
          <p data-filter-empty="tools" class="inner-panel p-6 mt-6 text-fg-secondary" hidden>
            {copy.noMatch}
          </p>
        </>
      )
    }
  </section>

  <CtaBand
    family="services"
    label={copy.ctaLabel}
    title={copy.ctaTitle}
    text={copy.ctaText}
    primary={copy.ctaPrimary}
    secondary={copy.ctaSecondary}
  />
</Page>
