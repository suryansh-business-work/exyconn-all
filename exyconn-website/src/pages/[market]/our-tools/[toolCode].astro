---
import DeviceFrame from "../../../components/content/DeviceFrame.astro";
import ActionLink from "../../../components/inner/ActionLink.astro";
import CtaBand from "../../../components/inner/CtaBand.astro";
import InnerStage from "../../../components/inner/InnerStage.astro";
import LinkCard from "../../../components/inner/LinkCard.astro";
import Page from "../../../layouts/Page.astro";
import { TOOL_COPY as copy, cubeCount, monogram } from "../../../lib/content/tools";
import { breadcrumbJsonLd } from "../../../lib/inner/structured-data";
import { getTool, getToolCategories, getToolLaunchUrl, getTools } from "../../../lib/portal";

const { toolCode } = Astro.params;
const tool = toolCode ? await getTool(toolCode) : null;

if (!tool) {
  return new Response(null, { status: 404 });
}

const [categories, siblings] = await Promise.all([
  getToolCategories(),
  getTools(tool.categorySlug),
]);
const category = categories.find((one) => one.slug === tool.categorySlug) ?? null;
const related = siblings.filter((one) => one.toolCode !== tool.toolCode).slice(0, 3);
// "" when the tool has no URL, or one with an unsafe scheme — then there is no Open button.
const launchUrl = getToolLaunchUrl(tool);
const open = launchUrl ? { label: copy.open, href: launchUrl } : undefined;
const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const crumbs = [
  { label: copy.home, href: "/" },
  { label: copy.list, href: "/our-tools" },
  { label: tool.name },
];
const pricing = tool.pricing;
---

<Page
  title={`${tool.name} | Exyconn Tools`}
  description={tool.description}
  jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}
>
  <InnerStage
    family="services"
    variant="band"
    crumbs={crumbs}
    title={tool.name}
    lede={tool.description}
    primary={open}
    secondary={copy.ctaSecondary}
    scene={{ shapes: ["cubes"], data: { cubes: { cubes: cubeCount(siblings.length) } } }}
  >
    <p class="inner-meta stage-label">
      {category && <a href={`/our-tools?cat=${category.slug}`}>{category.category}</a>}
      {tool.isMVP && <span>{copy.mvp}</span>}
      <span>#{tool.toolCode}</span>
    </p>
  </InnerStage>

  <section class="inner-section stage-shell grid gap-12">
    {
      launchUrl && (
        <DeviceFrame url={launchUrl} label={copy.previewLabel}>
          <div class="content-tool">
            <span class="content-tool__mark" aria-hidden="true">
              {monogram(tool.name)}
            </span>
            <h2 class="inner-h3 mt-5">{tool.name}</h2>
            <p class="inner-card__text mt-2">{tool.description}</p>
            <div class="mt-6">
              <ActionLink action={{ label: copy.open, href: launchUrl }} />
            </div>
          </div>
          {tool.features.length > 0 && (
            <ul class="content-checks" aria-label={copy.features}>
              {tool.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
          )}
        </DeviceFrame>
      )
    }

    <div class="grid gap-6 lg:grid-cols-3">
      <div class="grid gap-6 lg:col-span-2 content-start">
        {
          tool.longDescription && (
            <div class="inner-panel p-6 md:p-8">
              <h2 class="inner-h3">{copy.about}</h2>
              <p class="inner-card__text mt-3 whitespace-pre-line">{tool.longDescription}</p>
            </div>
          )
        }
        {
          tool.useCases.length > 0 && (
            <div class="inner-panel p-6 md:p-8">
              <h2 class="inner-h3">{copy.useCases}</h2>
              <ul class="inner-chips mt-4">
                {tool.useCases.map((useCase) => (
                  <li class="inner-chip">{useCase}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
      {
        pricing && (
          <div class="inner-panel p-6 md:p-8 self-start">
            <h2 class="inner-h3">{copy.pricing}</h2>
            <p class="inner-metric__value mt-4">
              {pricing.currency} {pricing.price}
            </p>
            {pricing.alterationNote && (
              <p class="inner-card__text mt-3">{pricing.alterationNote}</p>
            )}
            {pricing.features.length > 0 && (
              <ul class="content-checks mt-5">
                {pricing.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
            )}
          </div>
        )
      }
    </div>

    {
      related.length > 0 && (
        <div>
          <h2 class="inner-h3">{copy.related}</h2>
          <ul class="grid gap-6 md:grid-cols-3 mt-6">
            {related.map((one) => (
              <li>
                <LinkCard
                  href={`/our-tools/${one.toolCode}`}
                  index={monogram(one.name)}
                  title={one.name}
                  text={one.description}
                  more={copy.details}
                />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <CtaBand
    family="services"
    label={copy.ctaLabel}
    title={copy.ctaTitle}
    primary={copy.ctaPrimary}
    secondary={copy.ctaSecondary}
  />
</Page>
