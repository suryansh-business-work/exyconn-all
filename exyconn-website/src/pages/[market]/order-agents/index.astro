---
import Page from "../../../layouts/Page.astro";
import "../../../components/company/company.css";
import { OrderAgentsForm } from "../../../components/company/order-agents";
import InnerStage from "../../../components/inner/InnerStage.astro";
import { AGENTS, agentsBand, agentsMeta } from "../../../lib/company/agents";
import { breadcrumbJsonLd } from "../../../lib/inner/structured-data";

const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const crumbs = [
  { label: "Home", href: "/" },
  { label: "AI", href: "/ai" },
  { label: "Order agents" },
];
---

<Page
  metaTitle={agentsMeta.title}
  metaDescription={agentsMeta.description}
  metaKeywords={agentsMeta.keywords}
  metaImage={agentsMeta.image}
  jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}
>
  <InnerStage
    family="ai"
    variant="band"
    crumbs={crumbs}
    title={agentsBand.title}
    lede={agentsBand.lede}
    scene={{ shapes: ["rings"], data: { rings: { rings: AGENTS.length } } }}
  />

  <div class="inner-section stage-shell company-tail">
    <OrderAgentsForm client:load />
  </div>
</Page>
