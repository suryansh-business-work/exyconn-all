---
import Page from "../../../layouts/Page.astro";
import ChapterHeading from "../../../components/inner/ChapterHeading.astro";
import CtaBand from "../../../components/inner/CtaBand.astro";
import InnerStage from "../../../components/inner/InnerStage.astro";
import ProofStrip from "../../../components/inner/ProofStrip.astro";
import AiCatalogue from "../../../components/hubs/AiCatalogue.astro";
import RelatedHubs from "../../../components/hubs/RelatedHubs.astro";
import { breadcrumbJsonLd } from "../../../lib/inner/structured-data";
import {
  catalogueCopy,
  catalogueCta,
  catalogueHero,
  catalogueScene,
  catalogueStats,
} from "../../../lib/services/aiCatalogue";
import { aiServiceCategories, aiServices } from "../../../lib/services/aiServices";

const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const PAGE_URL = `${SITE_URL}/ai-services`;
const crumbs = [{ label: "Home", href: "/" }, { label: "AI services" }];

// Everything countable is derived from the catalogue so the copy can never drift
// out of step with the data.
const serviceCount = aiServices.length;
const categoryCount = aiServiceCategories.length;

const pageTitle = `AI Services | ${serviceCount} AI Products & Build Services | Exyconn`;
const pageDescription = `Exyconn is an AI product and services company. ${serviceCount} AI services across ${categoryCount} categories — agents and automation, revenue systems, industry platforms, business operations, AI infrastructure, and governance.`;
const pageKeywords = [
  "AI services",
  "AI product company",
  "AI development company",
  "AI agents",
  ...aiServices.map((service) => service.title),
].join(", ");

const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Exyconn AI Services",
  description: pageDescription,
  url: PAGE_URL,
  numberOfItems: serviceCount,
  itemListElement: aiServices.map((service, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: service.title,
    description: service.summary,
    url: `${PAGE_URL}/${service.slug}`,
  })),
};
---

<Page
  metaTitle={pageTitle}
  metaDescription={pageDescription}
  metaKeywords={pageKeywords}
  canonical={PAGE_URL}
  jsonLd={[itemListJsonLd, breadcrumbJsonLd(crumbs, SITE_URL)]}
>
  <InnerStage
    family="services"
    crumbs={crumbs}
    title={catalogueHero.title}
    lede={catalogueHero.lede}
    primary={catalogueHero.primary}
    secondary={catalogueHero.secondary}
    scene={catalogueScene()}
  />
  <ProofStrip variant="stats" label="The catalogue at a glance" items={catalogueStats()} />

  <section class="inner-section stage-shell" aria-labelledby="catalogue">
    <ChapterHeading
      index={1}
      id="catalogue"
      label={catalogueCopy.chapterLabel}
      title={catalogueCopy.chapterTitle}
    />
    <div class="mt-10">
      <AiCatalogue copy={catalogueCopy} />
    </div>
  </section>

  <RelatedHubs
    current="/ai-services"
    index={2}
    label={catalogueCopy.relatedLabel}
    title={catalogueCopy.relatedTitle}
  />

  <CtaBand
    family="services"
    title={catalogueCta.title}
    text={catalogueCta.text}
    primary={catalogueCta.primary}
    secondary={catalogueCta.secondary}
  />
</Page>
