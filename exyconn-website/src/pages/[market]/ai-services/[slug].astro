---
import Page from "../../../layouts/Page.astro";
import ActionLink from "../../../components/inner/ActionLink.astro";
import ChapterHeading from "../../../components/inner/ChapterHeading.astro";
import CtaBand from "../../../components/inner/CtaBand.astro";
import InnerStage from "../../../components/inner/InnerStage.astro";
import LinkCard from "../../../components/inner/LinkCard.astro";
import "../../../components/hubs/hubs.css";
import { breadcrumbJsonLd } from "../../../lib/inner/structured-data";
import {
  catalogueCta,
  categoryHref,
  detailCopy,
  sceneForCategory,
} from "../../../lib/services/aiCatalogue";
import {
  findAiService,
  findAiServiceCategory,
  servicesInCategory,
} from "../../../lib/services/aiServices";

const { slug } = Astro.params;
const service = slug ? findAiService(slug) : undefined;

if (!service) {
  return new Response(null, { status: 404 });
}

const category = findAiServiceCategory(service.categorySlug);
const relatedServices = servicesInCategory(service.categorySlug)
  .filter((item) => item.slug !== service.slug)
  .slice(0, 3);

const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const serviceUrl = `${SITE_URL}/ai-services/${service.slug}`;
const categoryTitle = category?.title ?? detailCopy.listing;
const categoryUrl = categoryHref(service.categorySlug);

const crumbs = [
  { label: "Home", href: "/" },
  { label: detailCopy.listing, href: "/ai-services" },
  { label: categoryTitle, href: categoryUrl },
  { label: service.title },
];

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  description: service.description,
  url: serviceUrl,
  serviceType: categoryTitle,
  category: categoryTitle,
  areaServed: "Worldwide",
  provider: { "@type": "Organization", name: "Exyconn", url: SITE_URL },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: `${service.title} deliverables`,
    itemListElement: service.outcomes.map((outcome, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: outcome,
    })),
  },
};
---

<Page
  metaTitle={`${service.title} | AI Services | Exyconn`}
  metaDescription={service.summary}
  metaKeywords={[service.title, categoryTitle, "AI services", "Exyconn"].join(", ")}
  canonical={serviceUrl}
  jsonLd={[serviceJsonLd, breadcrumbJsonLd(crumbs, SITE_URL)]}
>
  <InnerStage
    family="services"
    crumbs={crumbs}
    title={service.title}
    lede={service.summary}
    primary={detailCopy.quote}
    secondary={detailCopy.talk}
    scene={sceneForCategory(service.categorySlug)}
  />

  <section class="inner-section stage-shell" aria-labelledby="approach">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:items-start">
      <div>
        <ChapterHeading
          index={1}
          id="approach"
          label={detailCopy.approachLabel}
          title={detailCopy.approachTitle}
          lede={service.description}
        />
      </div>
      <aside class="inner-panel p-6 lg:mt-10" aria-labelledby="scope-title">
        <h3 id="scope-title" class="inner-h3">{detailCopy.scopeTitle}</h3>
        <p class="inner-card__text mt-3">{detailCopy.scopeText}</p>
        <div class="inner-stage__actions">
          <ActionLink action={detailCopy.quote} />
          <ActionLink action={detailCopy.talk} variant="ghost" />
        </div>
        <div class="stage-rule mt-6" aria-hidden="true"></div>
        <p class="stage-label inner-index mt-6">{categoryTitle}</p>
        <p class="inner-card__text mt-2">{category?.description}</p>
        <a href={categoryUrl} class="hub-link mt-2">{detailCopy.categoryLink}</a>
      </aside>
    </div>
  </section>

  <section class="inner-section stage-shell" aria-labelledby="outcomes">
    <ChapterHeading
      index={2}
      id="outcomes"
      label={detailCopy.outcomesLabel}
      title={detailCopy.outcomesTitle}
    />
    <ol class="grid gap-4 mt-10 md:grid-cols-2">
      {
        service.outcomes.map((outcome, index) => (
          <li class="inner-card">
            <span class="stage-label inner-index">{String(index + 1).padStart(2, "0")}</span>
            <p class="text-fg leading-relaxed">{outcome}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {
    relatedServices.length > 0 && (
      <section class="inner-section stage-shell" aria-labelledby="related">
        <ChapterHeading
          index={3}
          id="related"
          label={detailCopy.relatedLabel}
          title={detailCopy.relatedTitle(categoryTitle)}
        />
        <div class="grid gap-4 mt-10 md:grid-cols-3">
          {relatedServices.map((related) => (
            <LinkCard
              href={`/ai-services/${related.slug}`}
              title={related.title}
              text={related.summary}
              more={detailCopy.more}
            />
          ))}
        </div>
      </section>
    )
  }

  <CtaBand
    family="services"
    title={catalogueCta.title}
    text={catalogueCta.text}
    primary={detailCopy.quote}
    secondary={detailCopy.talk}
  />
</Page>
