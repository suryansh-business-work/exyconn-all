---
import Page from "../../layouts/Page.astro";
import BeliefList from "../../components/company/BeliefList.astro";
import MarketReach from "../../components/company/MarketReach.astro";
import "../../components/company/company.css";
import ChapterHeading from "../../components/inner/ChapterHeading.astro";
import CtaBand from "../../components/inner/CtaBand.astro";
import InnerStage from "../../components/inner/InnerStage.astro";
import LinkCard from "../../components/inner/LinkCard.astro";
import ProofStrip from "../../components/inner/ProofStrip.astro";
import InfoGrid from "../../components/hubs/InfoGrid.astro";
import {
  aboutChapters,
  aboutCta,
  aboutHero,
  aboutMeta,
  aboutNext,
  aboutStats,
  aboutThesis,
  aboutValues,
  aboutWork,
  fillTemplate,
} from "../../lib/company/about";
import { marketArcs, marketFacts } from "../../lib/company/markets-globe";
import { MARKETS } from "../../lib/i18n/markets";
import { breadcrumbJsonLd } from "../../lib/inner/structured-data";

const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const crumbs = [{ label: "Home", href: "/" }, { label: "About us" }];
const facts = marketFacts(MARKETS);
const { thesis, work, values, reach, next } = aboutChapters;
---

<Page
  metaTitle={aboutMeta.title}
  metaDescription={aboutMeta.description}
  metaKeywords={aboutMeta.keywords}
  metaImage={aboutMeta.image}
  jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}
>
  <InnerStage
    family="company"
    crumbs={crumbs}
    title={aboutHero.title}
    lede={aboutHero.lede}
    primary={aboutHero.primary}
    secondary={aboutHero.secondary}
    scene={{ shapes: ["globe"], data: { globe: { arcs: marketArcs(MARKETS) } } }}
  />
  <ProofStrip variant="stats" label="Exyconn at a glance" items={aboutStats} />

  <section class="inner-section stage-shell" aria-labelledby="thesis">
    <ChapterHeading index={1} id="thesis" label={thesis.label} title={thesis.title} />
    <InfoGrid items={aboutThesis} columns={2} />
  </section>

  <section class="inner-section stage-shell" aria-labelledby="work">
    <ChapterHeading index={2} id="work" label={work.label} title={work.title} lede={work.lede} />
    <ul class="company-work">
      {
        aboutWork.map((item, index) => (
          <li>
            <LinkCard
              href={item.href}
              index={`W/${String(index + 1).padStart(2, "0")}`}
              title={item.title}
              text={item.text}
              more={work.more}
            />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="inner-section stage-shell" aria-labelledby="values">
    <ChapterHeading index={3} id="values" label={values.label} title={values.title} />
    <BeliefList items={aboutValues} />
  </section>

  <section class="inner-section stage-shell" aria-labelledby="reach">
    <ChapterHeading index={4} id="reach" label={reach.label} title={reach.title} />
    <MarketReach
      facts={facts}
      labels={reach.facts}
      text={fillTemplate(reach.text, { ...facts })}
      caption={reach.caption}
    />
  </section>

  <section class="inner-section stage-shell" aria-labelledby="next">
    <ChapterHeading index={5} id="next" label={next.label} title={next.title} />
    <ul class="grid gap-4 mt-10 md:grid-cols-3">
      {
        aboutNext.map((item) => (
          <li>
            <LinkCard href={item.href} title={item.title} text={item.text} />
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand
    family="company"
    title={aboutCta.title}
    text={aboutCta.text}
    primary={aboutCta.primary}
  />
</Page>
