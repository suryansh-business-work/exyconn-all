---
import LegalLayout from "../../../components/inner/LegalLayout.astro";
import PolicyNotice from "../../../components/forms/legal/page/PolicyNotice.astro";
import RelatedLegal from "../../../components/forms/legal/page/RelatedLegal.astro";
import InnerStage from "../../../components/inner/InnerStage.astro";
import Page from "../../../layouts/Page.astro";
import { DEFAULT_MARKET } from "../../../lib/i18n/markets";
import { withHeadingIds } from "../../../lib/inner/headings";
import { breadcrumbJsonLd } from "../../../lib/inner/structured-data";
import { loadPolicy, policySummary, readerDate } from "../../../lib/legal";
import { ARTICLE_CLASS, sanitizeArticleHtml } from "../../../lib/portal";
import "../../../styles/article.css";

/**
 * A company policy, rendered from the portal. The wording lives in Legal, not in this
 * repository. A slug Legal has not published is a 404 like every other detail page; a portal
 * failure is a 503 with a notice, never a server error.
 */
const result = await loadPolicy(Astro.params.slug);
if (result.status === "missing") {
  return new Response(null, { status: 404 });
}
if (result.status === "error") {
  Astro.response.status = 503;
}
const policy = result.status === "found" ? result.policy : null;
const market = Astro.locals.market ?? DEFAULT_MARKET;
const body = policy ? withHeadingIds(sanitizeArticleHtml(policy.body)) : null;
const title = policy?.title ?? "Policy";
const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const crumbs = [
  { label: "Home", href: "/" },
  { label: "Policies", href: "/policies" },
  { label: title },
];
---

<Page
  metaTitle={`${title} | Exyconn`}
  metaDescription={policy?.summary ?? "An Exyconn company policy."}
  metaKeywords={`${title.toLowerCase()}, exyconn, policy`}
  noindex={!policy}
  jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}
>
  {
    policy && body ? (
      <LegalLayout
        title={policy.title}
        crumbs={crumbs}
        updatedLabel="Last updated"
        updated={readerDate(policy.updatedAt, market.locale)}
        summaryTitle="In plain words"
        summary={policySummary(policy, market.locale)}
        tocLabel="On this page"
        sections={body.toc}
        scene={{ shapes: ["documents"] }}
      >
        <article class={ARTICLE_CLASS} set:html={body.html} />
        <RelatedLegal current="policies" slot="after" />
      </LegalLayout>
    ) : (
      <>
        <InnerStage
          family="company"
          variant="band"
          crumbs={crumbs}
          title={title}
          scene={{ shapes: ["documents"] }}
        />
        <section class="inner-section stage-shell">
          <PolicyNotice kind="error" />
        </section>
      </>
    )
  }
</Page>
