---
import PolicyNotice from "../../../components/forms/legal/page/PolicyNotice.astro";
import RelatedLegal from "../../../components/forms/legal/page/RelatedLegal.astro";
import InnerStage from "../../../components/inner/InnerStage.astro";
import Page from "../../../layouts/Page.astro";
import { DEFAULT_MARKET } from "../../../lib/i18n/markets";
import { breadcrumbJsonLd } from "../../../lib/inner/structured-data";
import { loadPolicies, policyRow, policySheets } from "../../../lib/legal";
import "../../../components/forms/legal/page/legal-page.css";

/** Every policy the operator company has published publicly. The list is the portal's. */
const result = await loadPolicies();
if (result.status === "error") {
  Astro.response.status = 503;
}
const market = Astro.locals.market ?? DEFAULT_MARKET;
const rows =
  result.status === "ok" ? result.policies.map((policy) => policyRow(policy, market.locale)) : [];
const sheets = policySheets(rows.length);
const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const crumbs = [
  { label: "Home", href: "/" },
  { label: "Legal", href: "/legal" },
  { label: "Policies" },
];
---

<Page
  metaTitle="Policies | Exyconn"
  metaDescription="Exyconn's published company policies, including privacy, cookies and terms."
  metaKeywords="policies, privacy policy, terms, exyconn"
  jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}
>
  <InnerStage
    family="company"
    variant="band"
    crumbs={crumbs}
    title="Company policies"
    lede="The commitments we publish, and when each one took effect."
    scene={{ shapes: ["documents"], data: sheets ? { documents: { sheets } } : undefined }}
  />
  <section class="inner-section stage-shell">
    <h2 class="inner-h3">Policies in effect</h2>
    <div class="mt-6">
      {result.status === "error" && <PolicyNotice kind="error" headingLevel="h3" />}
      {
        result.status === "ok" && rows.length === 0 && (
          <PolicyNotice kind="empty" headingLevel="h3" />
        )
      }
      {
        rows.length > 0 && (
          <ul class="legal-policies">
            {rows.map((row) => (
              <li>
                <a class="inner-card" href={row.href}>
                  <h3 class="inner-h3">{row.title}</h3>
                  {row.summary && <p class="inner-card__text">{row.summary}</p>}
                  <p class="legal-policies__meta">{row.meta}</p>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <div class="max-w-[70ch]">
      <RelatedLegal current="policies" />
    </div>
  </section>
</Page>
