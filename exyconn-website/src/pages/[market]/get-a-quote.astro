---
import Page from "../../layouts/Page.astro";
import "../../components/company/company.css";
import { QuoteForm, QuoteSummary } from "../../components/company/quote";
import ChapterHeading from "../../components/inner/ChapterHeading.astro";
import InnerStage from "../../components/inner/InnerStage.astro";
import MultiStepFormShell from "../../components/inner/MultiStepFormShell.astro";
import StepTrack from "../../components/inner/StepTrack.astro";
import ActionLink from "../../components/inner/ActionLink.astro";
import {
  QUOTE_STEPS,
  quoteAfter,
  quoteBand,
  quoteMeta,
  quoteNextSteps,
  quoteText,
} from "../../lib/company/quote-copy";
import { breadcrumbJsonLd } from "../../lib/inner/structured-data";

const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const crumbs = [{ label: "Home", href: "/" }, { label: "Get a quote" }];
---

<Page
  metaTitle={quoteMeta.title}
  metaDescription={quoteMeta.description}
  metaKeywords={quoteMeta.keywords}
  metaImage={quoteMeta.image}
  jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}
>
  <InnerStage
    family="contact"
    variant="band"
    crumbs={crumbs}
    title={quoteBand.title}
    lede={quoteBand.lede}
    scene={{ shapes: ["rings"], data: { rings: { rings: QUOTE_STEPS.length } } }}
  />

  <div class="inner-section stage-shell company-tail">
    <MultiStepFormShell steps={QUOTE_STEPS} progressTemplate={quoteText.progress}>
      <QuoteForm client:load />
      <QuoteSummary slot="summary" client:load />
      <section slot="after" class="mt-8 lg:col-span-2" aria-labelledby="next-steps">
        <ChapterHeading
          index={1}
          id="next-steps"
          label={quoteAfter.label}
          title={quoteAfter.title}
        />
        <div class="mt-10">
          <StepTrack steps={quoteNextSteps} />
        </div>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <p class="inner-card__text">{quoteAfter.talkText}</p>
          <ActionLink action={quoteAfter.talkAction} variant="ghost" />
        </div>
      </section>
    </MultiStepFormShell>
  </div>
</Page>
