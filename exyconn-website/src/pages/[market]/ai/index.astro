---
import Page from "../../../layouts/Page.astro";
import ChapterHeading from "../../../components/inner/ChapterHeading.astro";
import CtaBand from "../../../components/inner/CtaBand.astro";
import InnerStage from "../../../components/inner/InnerStage.astro";
import LinkCard from "../../../components/inner/LinkCard.astro";
import ProofStrip from "../../../components/inner/ProofStrip.astro";
import GroupedCards from "../../../components/hubs/GroupedCards.astro";
import InfoGrid from "../../../components/hubs/InfoGrid.astro";
import RelatedHubs from "../../../components/hubs/RelatedHubs.astro";
import { breadcrumbJsonLd } from "../../../lib/inner/structured-data";
import {
  aiHubChapters,
  aiHubCta,
  aiHubHero,
  aiHubMeta,
  aiHubPromises,
  aiHubStats,
  capabilityGroups,
  featuredAgents,
  governance,
} from "../../../lib/services/aiHub";
import { categoryHref } from "../../../lib/services/aiCatalogue";

const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const crumbs = [{ label: "Home", href: "/" }, { label: "AI" }];
---

<Page
  metaTitle={aiHubMeta.title}
  metaDescription={aiHubMeta.description}
  metaKeywords={aiHubMeta.keywords}
  metaImage={aiHubMeta.image}
  jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}
>
  <InnerStage
    family="ai"
    crumbs={crumbs}
    title={aiHubHero.title}
    lede={aiHubHero.lede}
    primary={aiHubHero.primary}
    secondary={aiHubHero.secondary}
    scene={{ shapes: ["core"] }}
  />
  <ProofStrip variant="stats" label="AI platform at a glance" items={aiHubStats} />

  <section class="inner-section stage-shell" aria-labelledby="capabilities">
    <ChapterHeading
      index={1}
      id="capabilities"
      label={aiHubChapters.capabilities.label}
      title={aiHubChapters.capabilities.title}
      lede={aiHubChapters.capabilities.lede}
    />
    <GroupedCards groups={capabilityGroups} more={aiHubChapters.capabilities.more} />
  </section>

  <section class="inner-section stage-shell" aria-labelledby="governance">
    <ChapterHeading
      index={2}
      id="governance"
      label={aiHubChapters.governance.label}
      title={aiHubChapters.governance.title}
    />
    <div class="grid gap-10 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
      <InfoGrid items={aiHubPromises} columns={2} />
      {
        governance.category && (
          <aside class="inner-panel p-6 mt-10 self-start" aria-labelledby="governance-services">
            <p class="stage-label inner-index">{governance.category.title}</p>
            <h3 id="governance-services" class="inner-h3 mt-2">
              {aiHubChapters.governance.servicesTitle}
            </h3>
            <p class="inner-card__text mt-2">{governance.category.description}</p>
            <ul class="inner-points hub-link-list">
              {governance.services.map((service) => (
                <li>
                  <a href={`/ai-services/${service.slug}`} class="hub-link">
                    {service.title}
                  </a>
                </li>
              ))}
            </ul>
            <a href={categoryHref(governance.category.slug)} class="hub-link inline-flex mt-6">
              {aiHubChapters.governance.more}
            </a>
          </aside>
        )
      }
    </div>
  </section>

  <RelatedHubs
    current="/ai"
    index={3}
    label={aiHubChapters.explore.label}
    title={aiHubChapters.explore.title}
  >
    <div class="mt-10 max-w-xl">
      <LinkCard
        href={featuredAgents.href}
        title={featuredAgents.title}
        text={featuredAgents.text}
        more={featuredAgents.more}
      />
    </div>
  </RelatedHubs>

  <CtaBand
    family="ai"
    title={aiHubCta.title}
    text={aiHubCta.text}
    primary={aiHubCta.primary}
    secondary={aiHubCta.secondary}
  />
</Page>
