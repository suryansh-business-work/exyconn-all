---
import Page from "../../../layouts/Page.astro";
import ChapterHeading from "../../../components/inner/ChapterHeading.astro";
import CtaBand from "../../../components/inner/CtaBand.astro";
import InnerStage from "../../../components/inner/InnerStage.astro";
import ProofStrip from "../../../components/inner/ProofStrip.astro";
import StepTrack from "../../../components/inner/StepTrack.astro";
import GroupedCards from "../../../components/hubs/GroupedCards.astro";
import RelatedHubs from "../../../components/hubs/RelatedHubs.astro";
import { breadcrumbJsonLd } from "../../../lib/inner/structured-data";
import { pillarGroups, servicePillars } from "../../../lib/services/catalog";
import { hubChapters, hubCta, hubHero, hubMeta, hubStats } from "../../../lib/services/hub";
import { lifecycleSteps } from "../../../lib/services/outsourcing";

const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const crumbs = [{ label: "Home", href: "/" }, { label: "Services" }];
---

<Page
  metaTitle={hubMeta.title}
  metaDescription={hubMeta.description}
  metaKeywords={hubMeta.keywords}
  metaImage={hubMeta.image}
  jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}
>
  <InnerStage
    family="services"
    crumbs={crumbs}
    title={hubHero.title}
    lede={hubHero.lede}
    primary={hubHero.primary}
    secondary={hubHero.secondary}
    scene={{ shapes: ["lattice"], data: { lattice: { clusters: servicePillars.length } } }}
  />
  <ProofStrip variant="stats" label="Services at a glance" items={hubStats} />

  <section class="inner-section stage-shell" aria-labelledby="pillars">
    <ChapterHeading
      index={1}
      id="pillars"
      label={hubChapters.pillars.label}
      title={hubChapters.pillars.title}
      lede={hubChapters.pillars.lede}
    />
    <GroupedCards groups={pillarGroups()} more={hubChapters.pillars.more} highlight />
  </section>

  <section class="inner-section stage-shell" aria-labelledby="lifecycle">
    <ChapterHeading
      index={2}
      id="lifecycle"
      label={hubChapters.lifecycle.label}
      title={hubChapters.lifecycle.title}
    />
    <div class="mt-10"><StepTrack steps={lifecycleSteps} /></div>
  </section>

  <RelatedHubs
    current="/services"
    index={3}
    label={hubChapters.explore.label}
    title={hubChapters.explore.title}
  />

  <CtaBand
    family="services"
    title={hubCta.title}
    text={hubCta.text}
    primary={hubCta.primary}
    secondary={hubCta.secondary}
  />
</Page>
