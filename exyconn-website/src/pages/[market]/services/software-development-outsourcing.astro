---
import Page from "../../../layouts/Page.astro";
import ChapterHeading from "../../../components/inner/ChapterHeading.astro";
import CtaBand from "../../../components/inner/CtaBand.astro";
import FaqAccordion from "../../../components/inner/FaqAccordion.astro";
import InnerStage from "../../../components/inner/InnerStage.astro";
import ProofStrip from "../../../components/inner/ProofStrip.astro";
import StepTrack from "../../../components/inner/StepTrack.astro";
import InfoGrid from "../../../components/hubs/InfoGrid.astro";
import { breadcrumbJsonLd } from "../../../lib/inner/structured-data";
import {
  lifecycleSteps,
  outsourcingAssurances,
  outsourcingBenefits,
  outsourcingChapters,
  outsourcingCta,
  outsourcingFaqs,
  outsourcingHero,
  outsourcingIntro,
  outsourcingMeta,
  outsourcingServices,
  outsourcingStats,
} from "../../../lib/services/outsourcing";

const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const crumbs = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services" },
  { label: "Software development outsourcing" },
];
const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Software development outsourcing",
  description: outsourcingMeta.description,
  provider: { "@type": "Organization", name: "Exyconn", url: SITE_URL },
};
---

<Page
  metaTitle={outsourcingMeta.title}
  metaDescription={outsourcingMeta.description}
  metaKeywords={outsourcingMeta.keywords}
  metaImage={outsourcingMeta.image}
  jsonLd={[serviceJsonLd, breadcrumbJsonLd(crumbs, SITE_URL)]}
>
  <InnerStage
    family="services"
    crumbs={crumbs}
    title={outsourcingHero.title}
    lede={outsourcingHero.lede}
    primary={outsourcingHero.primary}
    secondary={outsourcingHero.secondary}
    scene={{ shapes: ["orbits"], data: { orbits: { agents: outsourcingServices.length } } }}
  />
  <div class="hub-proof-3">
    <ProofStrip variant="stats" label="Outsourcing results" items={outsourcingStats} />
  </div>

  <section class="inner-section stage-shell" aria-labelledby="definition">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-end">
      <ChapterHeading
        index={1}
        id="definition"
        label={outsourcingIntro.label}
        title={outsourcingIntro.title}
      />
      <p class="inner-lede">{outsourcingIntro.text}</p>
    </div>
  </section>

  <section id="services" class="inner-section stage-shell scroll-mt-24" aria-labelledby="offer">
    <ChapterHeading
      index={2}
      id="offer"
      label={outsourcingChapters.services.label}
      title={outsourcingChapters.services.title}
    />
    <InfoGrid items={outsourcingServices} indexPrefix="S" />
  </section>

  <section class="inner-section stage-shell" aria-labelledby="benefits">
    <ChapterHeading
      index={3}
      id="benefits"
      label={outsourcingChapters.benefits.label}
      title={outsourcingChapters.benefits.title}
    />
    <InfoGrid items={outsourcingBenefits} />
    <ul class="inner-panel p-6 mt-4 grid gap-6 md:grid-cols-2 lg:grid-cols-5">
      {
        outsourcingAssurances.map((item) => (
          <li>
            <p class="font-semibold text-fg">{item.title}</p>
            <p class="inner-card__text text-sm mt-1">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="inner-section stage-shell" aria-labelledby="lifecycle">
    <ChapterHeading
      index={4}
      id="lifecycle"
      label={outsourcingChapters.lifecycle.label}
      title={outsourcingChapters.lifecycle.title}
    />
    <div class="mt-10"><StepTrack steps={lifecycleSteps} /></div>
  </section>

  <section class="inner-section stage-shell" aria-labelledby="faq">
    <ChapterHeading
      index={5}
      id="faq"
      label={outsourcingChapters.faq.label}
      title={outsourcingChapters.faq.title}
    />
    <div class="mt-10 max-w-3xl"><FaqAccordion items={outsourcingFaqs} /></div>
  </section>

  <CtaBand
    family="services"
    label={outsourcingCta.label}
    title={outsourcingCta.title}
    text={outsourcingCta.text}
    primary={outsourcingCta.primary}
    secondary={outsourcingCta.secondary}
  />
</Page>
