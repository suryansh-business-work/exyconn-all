---
import Page from "../../../layouts/Page.astro";
import ChapterHeading from "../../../components/inner/ChapterHeading.astro";
import CtaBand from "../../../components/inner/CtaBand.astro";
import InnerStage from "../../../components/inner/InnerStage.astro";
import ProofStrip from "../../../components/inner/ProofStrip.astro";
import StepTrack from "../../../components/inner/StepTrack.astro";
import InfoGrid from "../../../components/hubs/InfoGrid.astro";
import { breadcrumbJsonLd } from "../../../lib/inner/structured-data";
import {
  marketingChapters,
  marketingCta,
  marketingHero,
  marketingMeta,
  marketingProcess,
  marketingServices,
  marketingStats,
} from "../../../lib/services/digitalMarketing";

const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const crumbs = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services" },
  { label: "Digital marketing" },
];
const cards = marketingServices.map((service) => ({
  id: service.id,
  title: service.title,
  text: service.description,
  points: service.features,
}));
const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Digital marketing",
  description: marketingMeta.description,
  provider: { "@type": "Organization", name: "Exyconn", url: SITE_URL },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Digital marketing services",
    itemListElement: marketingServices.map((service, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: service.title,
    })),
  },
};
---

<Page
  metaTitle={marketingMeta.title}
  metaDescription={marketingMeta.description}
  metaKeywords={marketingMeta.keywords}
  jsonLd={[serviceJsonLd, breadcrumbJsonLd(crumbs, SITE_URL)]}
>
  <InnerStage
    family="services"
    crumbs={crumbs}
    title={marketingHero.title}
    lede={marketingHero.lede}
    primary={marketingHero.primary}
    secondary={marketingHero.secondary}
    scene={{ shapes: ["pipeline"], data: { pipeline: { stations: marketingProcess.length } } }}
  />
  <ProofStrip variant="stats" label="Marketing results" items={marketingStats} />

  <section class="inner-section stage-shell" aria-labelledby="capabilities">
    <ChapterHeading
      index={1}
      id="capabilities"
      label={marketingChapters.services.label}
      title={marketingChapters.services.title}
      lede={marketingChapters.services.lede}
    />
    <InfoGrid items={cards} indexPrefix="M" />
  </section>

  <section class="inner-section stage-shell" aria-labelledby="process">
    <ChapterHeading
      index={2}
      id="process"
      label={marketingChapters.process.label}
      title={marketingChapters.process.title}
    />
    <div class="mt-10">
      <StepTrack
        steps={marketingProcess}
        highlights={marketingProcess.map((_, index) => index + 1)}
      />
    </div>
  </section>

  <CtaBand
    family="services"
    title={marketingCta.title}
    text={marketingCta.text}
    primary={marketingCta.primary}
    secondary={marketingCta.secondary}
  />
</Page>
