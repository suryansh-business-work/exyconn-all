---
import Page from "../../layouts/Page.astro";
import ContactAside from "../../components/company/ContactAside.astro";
import "../../components/company/company.css";
import ContactFormReact from "../../components/forms/ContactFormReact.tsx";
import InnerStage from "../../components/inner/InnerStage.astro";
import SplitFormShell from "../../components/inner/SplitFormShell.astro";
import {
  contactBand,
  contactChannels,
  contactMeta,
  contactQuickLinks,
  contactSplit,
} from "../../lib/company/contact";
import { breadcrumbJsonLd } from "../../lib/inner/structured-data";

const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const crumbs = [{ label: "Home", href: "/" }, { label: "Contact" }];
---

<Page
  metaTitle={contactMeta.title}
  metaDescription={contactMeta.description}
  metaKeywords={contactMeta.keywords}
  metaImage={contactMeta.image}
  jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}
>
  <InnerStage
    family="contact"
    variant="band"
    crumbs={crumbs}
    title={contactBand.title}
    lede={contactBand.lede}
    scene={{ shapes: ["rings"] }}
  />

  <div class="inner-section company-tail">
    <SplitFormShell
      label={contactSplit.label}
      title={contactSplit.title}
      lede={contactSplit.lede}
      points={contactSplit.points}
      formLabel={contactSplit.formLabel}
    >
      <ContactFormReact client:load />
      <ContactAside
        slot="aside"
        channelsTitle={contactSplit.channelsTitle}
        channels={contactChannels}
        linksTitle={contactSplit.linksTitle}
        links={contactQuickLinks}
      />
    </SplitFormShell>
  </div>
</Page>
