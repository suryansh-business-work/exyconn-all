---
import Page from "../../layouts/Page.astro";
import ChapterHeading from "../../components/inner/ChapterHeading.astro";
import CtaBand from "../../components/inner/CtaBand.astro";
import InnerStage from "../../components/inner/InnerStage.astro";
import InfoGrid from "../../components/hubs/InfoGrid.astro";
import LinkRows from "../../components/hubs/LinkRows.astro";
import RelatedHubs from "../../components/hubs/RelatedHubs.astro";
import { breadcrumbJsonLd } from "../../lib/inner/structured-data";
import {
  ourPillars,
  ourServicesChapters,
  ourServicesCta,
  ourServicesHero,
  ourServicesMeta,
  portfolioGroups,
} from "../../lib/services/ourServices";

const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const crumbs = [{ label: "Home", href: "/" }, { label: "Our services" }];
const pillarCards = ourPillars.map((pillar) => ({
  title: pillar.title,
  text: pillar.text,
  points: pillar.items,
  link: pillar.link,
}));
const portfolioSize = portfolioGroups.reduce((total, group) => total + group.services.length, 0);
---

<Page
  metaTitle={ourServicesMeta.title}
  metaDescription={ourServicesMeta.description}
  metaKeywords={ourServicesMeta.keywords}
  metaImage={ourServicesMeta.image}
  jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}
>
  <InnerStage
    family="services"
    crumbs={crumbs}
    title={ourServicesHero.title}
    lede={ourServicesHero.lede}
    primary={ourServicesHero.primary}
    secondary={ourServicesHero.secondary}
    scene={{ shapes: ["hubSpokes"], data: { hubSpokes: { ports: portfolioSize } } }}
  />

  <section class="inner-section stage-shell" aria-labelledby="pillars">
    <ChapterHeading
      index={1}
      id="pillars"
      label={ourServicesChapters.pillars.label}
      title={ourServicesChapters.pillars.title}
      lede={ourServicesChapters.pillars.lede}
    />
    <InfoGrid items={pillarCards} indexPrefix="P" />
  </section>

  <section class="inner-section stage-shell" aria-labelledby="portfolio">
    <ChapterHeading
      index={2}
      id="portfolio"
      label={ourServicesChapters.portfolio.label}
      title={ourServicesChapters.portfolio.title}
      lede={ourServicesChapters.portfolio.lede}
    />
    <LinkRows groups={portfolioGroups} />
  </section>

  <RelatedHubs
    current="/our-services"
    index={3}
    label={ourServicesChapters.explore.label}
    title={ourServicesChapters.explore.title}
  />

  <CtaBand
    family="services"
    title={ourServicesCta.title}
    text={ourServicesCta.text}
    primary={ourServicesCta.primary}
    secondary={ourServicesCta.secondary}
  />
</Page>
