---
import LegalDocumentPage from "../../components/forms/legal/page/LegalDocumentPage.astro";
import { getLegalDocument } from "../../lib/legal";

const doc = await getLegalDocument("privacy");
const crumbs = [
  { label: "Home", href: "/" },
  { label: "Legal", href: "/legal" },
  { label: doc.title },
];
---

<LegalDocumentPage doc={doc} current="privacy" crumbs={crumbs} scene={{ shapes: ["shield"] }} />
