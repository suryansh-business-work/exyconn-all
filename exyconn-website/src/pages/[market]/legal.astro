---
import { LegalFormReact } from "../../components/forms/legal";
import LegalDocumentPage from "../../components/forms/legal/page/LegalDocumentPage.astro";
import FaqAccordion from "../../components/inner/FaqAccordion.astro";
import LegalSection from "../../components/inner/LegalSection.astro";
import { getLegalDocument, sectionById, sectionNumber } from "../../lib/legal";

const doc = await getLegalDocument("legal");
const crumbs = [{ label: "Home", href: "/" }, { label: "Legal" }];
const handled = sectionById(doc, "how-requests-are-handled");
const request = sectionById(doc, "submit-a-request");
---

<LegalDocumentPage doc={doc} current="legal" crumbs={crumbs} scene={{ shapes: ["shield"] }}>
  <LegalSection
    id={handled.id}
    number={sectionNumber(doc, handled.id)}
    title={handled.label}
    anchorLabel="Link to this section"
  >
    <FaqAccordion items={doc.faqs ?? []} />
  </LegalSection>
  <LegalSection
    id={request.id}
    number={sectionNumber(doc, request.id)}
    title={request.label}
    anchorLabel="Link to this section"
  >
    <LegalFormReact client:load />
  </LegalSection>
</LegalDocumentPage>
