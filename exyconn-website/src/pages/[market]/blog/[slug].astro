---
import ShareLinks from "../../../components/content/ShareLinks.astro";
import ArticleLayout from "../../../components/inner/ArticleLayout.astro";
import ChapterHeading from "../../../components/inner/ChapterHeading.astro";
import CtaBand from "../../../components/inner/CtaBand.astro";
import LinkCard from "../../../components/inner/LinkCard.astro";
import Page from "../../../layouts/Page.astro";
import { ARTICLE_COPY as copy, articleSheets, relatedPosts } from "../../../lib/content/blog";
import {
  absoluteAsset,
  displayDate,
  marketCrumbs,
  marketPageUrl,
} from "../../../lib/content/format";
import { articleJsonLd } from "../../../lib/content/structured-data";
import { DEFAULT_MARKET } from "../../../lib/i18n/markets";
import { withHeadingIds } from "../../../lib/inner/headings";
import { breadcrumbJsonLd } from "../../../lib/inner/structured-data";
import {
  ARTICLE_CLASS,
  BRANDING_FALLBACK,
  getBlogPost,
  getBlogPosts,
  sanitizeArticleHtml,
  scopeArticleCss,
} from "../../../lib/portal";

const { slug } = Astro.params;
const post = slug ? await getBlogPost(slug) : null;

if (!post) {
  return new Response(null, { status: 404 });
}

const market = Astro.locals.market ?? DEFAULT_MARKET;
const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const { html, toc } = withHeadingIds(sanitizeArticleHtml(post.content));
// A body designed in the portal's live editor brings its own CSS, scoped to the article.
const designCss = scopeArticleCss(post.contentCss);
const related = relatedPosts(post, await getBlogPosts());
const url = marketPageUrl(SITE_URL, market, `/blog/${post.slug}`);
const crumbs = [
  { label: copy.home, href: "/" },
  { label: copy.blog, href: "/blog" },
  { label: post.title },
];
const image = absoluteAsset(SITE_URL, post.coverImage);
const jsonLd = [
  articleJsonLd({
    type: "BlogPosting",
    headline: post.title,
    description: post.summary,
    image,
    published: post.publishedAt,
    url,
    keywords: post.tags,
    section: post.tags[0],
    author: post.author.name,
    publisher: {
      name: BRANDING_FALLBACK.businessName,
      url: SITE_URL,
      logo: `${SITE_URL}${BRANDING_FALLBACK.faviconUrl}`,
    },
  }),
  breadcrumbJsonLd(marketCrumbs(crumbs, market, url), SITE_URL),
];
---

<Page
  metaTitle={`${post.title} | Exyconn Blog`}
  metaDescription={post.summary}
  metaKeywords={post.tags.join(", ")}
  metaImage={post.coverImage || undefined}
  ogType="article"
  jsonLd={jsonLd}
>
  <ArticleLayout
    title={post.title}
    crumbs={crumbs}
    category={post.tags[0]}
    author={post.author.name}
    published={displayDate(post.publishedAt, market.locale)}
    readTime={post.readTime}
    image={post.coverImage
      ? { src: post.coverImage, alt: "", width: 1600, height: 900 }
      : undefined}
    tocLabel={copy.toc}
    toc={toc}
    scene={{ shapes: ["documents"], data: { documents: { sheets: articleSheets(toc) } } }}
  >
    {designCss && <style is:inline set:html={designCss} />}
    <p class="inner-lede mb-10">{post.summary}</p>
    <article class={ARTICLE_CLASS} set:html={html} />

    <div slot="after" class="mt-16 grid gap-6">
      {
        post.tags.length > 0 && (
          <ul class="inner-chips" aria-label={copy.tags}>
            {post.tags.map((tag) => (
              <li class="inner-chip">{tag}</li>
            ))}
          </ul>
        )
      }
      <div class="inner-panel content-author">
        <span class="content-author__mark" aria-hidden="true">{post.author.initials}</span>
        <div>
          <p class="stage-label">{copy.by}</p>
          <p class="inner-h3 mt-1">{post.author.name}</p>
          {post.author.role && <p class="inner-card__text">{post.author.role}</p>}
        </div>
      </div>
      <ShareLinks
        url={url}
        title={post.title}
        labels={{
          heading: copy.share,
          x: copy.shareX,
          linkedIn: copy.shareLinkedIn,
          copy: copy.copy,
          copied: copy.copied,
          copyFailed: copy.copyFailed,
        }}
      />
    </div>
  </ArticleLayout>

  {
    related.length > 0 && (
      <section class="inner-section stage-shell" aria-labelledby="related-articles">
        <ChapterHeading
          index={1}
          label={copy.relatedLabel}
          title={copy.relatedTitle}
          id="related-articles"
        />
        <ul class="grid gap-6 md:grid-cols-3 mt-10">
          {related.map((other) => (
            <li>
              <LinkCard
                href={`/blog/${other.slug}`}
                index={other.tags[0]}
                title={other.title}
                text={other.summary}
                more={copy.read}
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <CtaBand
    family="blog"
    label={copy.ctaLabel}
    title={copy.ctaTitle}
    primary={copy.ctaPrimary}
    secondary={copy.ctaSecondary}
  />
</Page>
