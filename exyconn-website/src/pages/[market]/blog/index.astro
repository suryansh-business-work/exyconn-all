---
import ContentEmpty from "../../../components/content/ContentEmpty.astro";
import PostCard from "../../../components/content/PostCard.astro";
import ChapterHeading from "../../../components/inner/ChapterHeading.astro";
import CtaBand from "../../../components/inner/CtaBand.astro";
import FilterBar from "../../../components/inner/FilterBar.astro";
import InnerStage from "../../../components/inner/InnerStage.astro";
import Page from "../../../layouts/Page.astro";
import { BLOG_COPY as copy, blogConstellation, leadPost } from "../../../lib/content/blog";
import { chipOptions, displayDate, filterTokens, sortableDate } from "../../../lib/content/format";
import { DEFAULT_MARKET } from "../../../lib/i18n/markets";
import { breadcrumbJsonLd } from "../../../lib/inner/structured-data";
import { getBlogPosts } from "../../../lib/portal";

const market = Astro.locals.market ?? DEFAULT_MARKET;
const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const posts = await getBlogPosts();
const lead = leadPost(posts);
const ordered = lead ? [lead, ...posts.filter((post) => post !== lead)] : [];
const topics = chipOptions(
  posts.flatMap((post) => post.tags),
  8
);
const crumbs = [{ label: "Home", href: "/" }, { label: copy.crumb }];
const constellation = blogConstellation(posts);
---

<Page
  metaTitle={copy.metaTitle}
  metaDescription={copy.metaDescription}
  metaKeywords={copy.metaKeywords}
  jsonLd={breadcrumbJsonLd(crumbs, SITE_URL)}
>
  <InnerStage
    family="blog"
    variant="band"
    crumbs={crumbs}
    title={copy.title}
    lede={copy.lede}
    scene={{ shapes: ["constellation"], data: { constellation } }}
  />

  <section class="inner-section stage-shell" aria-labelledby="blog-articles">
    <ChapterHeading
      index={1}
      label={copy.chapterLabel}
      title={copy.chapterTitle}
      id="blog-articles"
    />
    {
      ordered.length === 0 ? (
        <div class="mt-10">
          <ContentEmpty
            label={copy.emptyLabel}
            title={copy.emptyTitle}
            text={copy.emptyText}
            primary={copy.emptyPrimary}
            secondary={copy.emptySecondary}
            level="h3"
          />
        </div>
      ) : (
        <>
          <div class="mt-10">
            <FilterBar
              target="blog-posts"
              label={copy.filterLabel}
              sheetLabel={copy.sheetLabel}
              groups={[
                {
                  param: "topic",
                  label: copy.topicLabel,
                  allLabel: copy.allTopics,
                  options: topics,
                },
              ]}
              search={{
                param: "q",
                label: copy.searchLabel,
                placeholder: copy.searchPlaceholder,
              }}
              sort={{
                param: "sort",
                label: copy.sortLabel,
                options: [
                  { value: "", label: copy.sortNewest },
                  { value: "date", label: copy.sortOldest },
                ],
              }}
              countTemplate={copy.countTemplate}
            />
          </div>
          <ul id="blog-posts" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mt-8">
            {ordered.map((post, index) => (
              <PostCard
                href={`/blog/${post.slug}`}
                title={post.title}
                summary={post.summary}
                image={post.coverImage}
                kicker={post.tags[0]}
                badge={post.featured ? copy.featured : undefined}
                meta={[displayDate(post.publishedAt, market.locale).text, post.readTime]}
                more={copy.read}
                wide={index === 0}
                eager={index === 0}
                data-filter-item
                data-filter-topic={filterTokens(post.tags)}
                data-search={`${post.title} ${post.summary} ${post.tags.join(" ")}`}
                data-sort-date={sortableDate(post.publishedAt)}
              />
            ))}
          </ul>
          <p data-filter-empty="blog-posts" class="inner-panel p-6 mt-6 text-fg-secondary" hidden>
            {copy.noMatch}
          </p>
        </>
      )
    }
  </section>

  <CtaBand
    family="blog"
    label={copy.ctaLabel}
    title={copy.ctaTitle}
    text={copy.ctaText}
    primary={copy.ctaPrimary}
    secondary={copy.ctaSecondary}
  />
</Page>
