---
/**
 * The Hindi India offer: three website packages for small businesses. Copy lives in
 * src/lib/india/offer.ts, prices and plan contents in src/lib/india/plans.ts (one source for
 * the cards, the comparison, the form and the JSON-LD). The phone line appears only when
 * portal branding has a contact number.
 */
import Page from "../../../layouts/Page.astro";
import ChapterHeading from "../../../components/inner/ChapterHeading.astro";
import CtaBand from "../../../components/inner/CtaBand.astro";
import InnerStage from "../../../components/inner/InnerStage.astro";
import SplitFormShell from "../../../components/inner/SplitFormShell.astro";
import StepTrack from "../../../components/inner/StepTrack.astro";
import ContactChannels from "../../../components/india/ContactChannels.astro";
import OfferServices from "../../../components/india/OfferServices.astro";
import PlanCard from "../../../components/india/PlanCard.astro";
import PlanComparison from "../../../components/india/PlanComparison.astro";
import { IndiaOfferForm } from "../../../components/forms/india-offer";
import "../../../components/india/india-offer.css";
import { contactChannels } from "../../../lib/india/contact";
import {
  OFFER_ANCHORS,
  OFFER_COMPARISON,
  OFFER_CONTACT,
  OFFER_CTA,
  OFFER_ENQUIRY,
  OFFER_HERO,
  OFFER_META,
  OFFER_PRICING,
  OFFER_PROBLEMS,
  OFFER_SCENE,
  OFFER_SERVICES,
  OFFER_STEPS,
} from "../../../lib/india/offer";
import { OFFER_PLANS, PLAN_FEATURES } from "../../../lib/india/plans";
import { offerServiceJsonLd } from "../../../lib/india/structured-data";
import { breadcrumbJsonLd } from "../../../lib/inner/structured-data";
import { DEFAULT_MARKET, marketUrl } from "../../../lib/i18n/markets";
import { BRANDING_FALLBACK, getBrandingSafe } from "../../../lib/portal";

const SITE_URL = (Astro.site?.toString() ?? "https://exyconn.com/").replace(/\/$/, "");
const market = Astro.locals.market ?? DEFAULT_MARKET;
const absolute = (path: string) => `${SITE_URL}${marketUrl(market, path)}`;

const branding = await getBrandingSafe();
const channels = contactChannels(branding.contactPhone, OFFER_CONTACT);

const jsonLd = [
  breadcrumbJsonLd(
    OFFER_HERO.crumbs.map((crumb) => ({
      label: crumb.label,
      href: absolute("href" in crumb ? crumb.href : OFFER_META.path),
    })),
    SITE_URL
  ),
  offerServiceJsonLd(
    OFFER_META.serviceName,
    OFFER_META.description,
    absolute(OFFER_META.path),
    OFFER_PLANS,
    { name: branding.businessName || BRANDING_FALLBACK.businessName, url: SITE_URL }
  ),
];
---

<Page
  title={OFFER_META.title}
  description={OFFER_META.description}
  keywords={OFFER_META.keywords}
  jsonLd={jsonLd}
>
  <div class="india-offer" lang="hi">
    <InnerStage
      family="contact"
      crumbs={OFFER_HERO.crumbs}
      title={OFFER_HERO.title}
      lede={OFFER_HERO.lede}
      primary={OFFER_HERO.primary}
      secondary={OFFER_HERO.secondary}
      scene={OFFER_SCENE}
    />

    <section class="inner-section stage-shell" aria-labelledby="offer-problems">
      <ChapterHeading
        index={1}
        label={OFFER_PROBLEMS.label}
        title={OFFER_PROBLEMS.title}
        id="offer-problems"
      />
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          OFFER_PROBLEMS.items.map((item) => (
            <li class="inner-card">
              <span class="offer-icon">
                <i class={`fa-solid ${item.icon} icon-lg`} aria-hidden="true" />
              </span>
              <h3 class="inner-h3">{item.title}</h3>
              <p class="inner-card__text">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="plans" class="inner-section stage-shell" aria-labelledby="offer-plans">
      <ChapterHeading
        index={2}
        label={OFFER_PRICING.label}
        title={OFFER_PRICING.title}
        lede={OFFER_PRICING.lede}
        id="offer-plans"
      />
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {
          OFFER_PLANS.map((plan, index) => (
            <PlanCard
              plan={plan}
              highlight={index + 1}
              popularLabel={OFFER_PRICING.popular}
              href={OFFER_ANCHORS.form}
            />
          ))
        }
      </div>
    </section>

    <section class="inner-section stage-shell" aria-labelledby="offer-steps">
      <ChapterHeading
        index={3}
        label={OFFER_STEPS.label}
        title={OFFER_STEPS.title}
        id="offer-steps"
      />
      <div class="mt-10">
        <StepTrack steps={OFFER_STEPS.steps} />
      </div>
    </section>

    <section class="inner-section stage-shell" aria-labelledby="offer-compare">
      <ChapterHeading
        index={4}
        label={OFFER_COMPARISON.label}
        title={OFFER_COMPARISON.title}
        id="offer-compare"
      />
      <PlanComparison
        plans={OFFER_PLANS}
        features={PLAN_FEATURES}
        caption={OFFER_COMPARISON.title}
        featureLabel={OFFER_COMPARISON.feature}
        yes={OFFER_COMPARISON.yes}
        no={OFFER_COMPARISON.no}
      />
    </section>

    <section class="inner-section stage-shell" aria-labelledby="offer-services">
      <ChapterHeading
        index={5}
        label={OFFER_SERVICES.label}
        title={OFFER_SERVICES.title}
        lede={OFFER_SERVICES.lede}
        id="offer-services"
      />
      <OfferServices
        groups={OFFER_SERVICES.groups}
        more={OFFER_SERVICES.more}
        all={OFFER_SERVICES.all}
      />
    </section>

    <section id="enquiry-form" class="inner-section">
      <SplitFormShell
        label={`06 — ${OFFER_ENQUIRY.label}`}
        title={OFFER_ENQUIRY.title}
        lede={OFFER_ENQUIRY.lede}
        points={OFFER_ENQUIRY.points}
        formLabel={OFFER_ENQUIRY.formLabel}
      >
        <IndiaOfferForm client:visible />
        <ContactChannels slot="aside" channels={channels} />
      </SplitFormShell>
    </section>

    <CtaBand
      family="contact"
      title={OFFER_CTA.title}
      text={OFFER_CTA.text}
      primary={OFFER_CTA.primary}
    >
      <ContactChannels channels={channels} />
    </CtaBand>
  </div>
</Page>
