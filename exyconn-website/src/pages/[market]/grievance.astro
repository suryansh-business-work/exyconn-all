---
import { GrievanceFormReact } from "../../components/forms/grievance";
import LegalDocumentPage from "../../components/forms/legal/page/LegalDocumentPage.astro";
import LegalSection from "../../components/inner/LegalSection.astro";
import { getLegalDocument, sectionById, sectionNumber } from "../../lib/legal";

const doc = await getLegalDocument("grievance");
const crumbs = [
  { label: "Home", href: "/" },
  { label: "Legal", href: "/legal" },
  { label: doc.title },
];
const submit = sectionById(doc, "submit-your-grievance");
---

<LegalDocumentPage
  doc={doc}
  current="grievance"
  crumbs={crumbs}
  family="contact"
  scene={{ shapes: ["rings"] }}
>
  <LegalSection
    id={submit.id}
    number={sectionNumber(doc, submit.id)}
    title={submit.label}
    anchorLabel="Link to this section"
  >
    <GrievanceFormReact client:load />
  </LegalSection>
</LegalDocumentPage>
