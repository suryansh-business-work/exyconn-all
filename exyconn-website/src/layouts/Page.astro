---
/**
 * The layout of every hand-written page: the site's document (SiteShell) with the site's own
 * header and footer around the page. A CMS page uses CmsPage.astro, over the same shell.
 */
import SiteShell from "./SiteShell.astro";
import type { PageSeoInput } from "../lib/chrome/page-meta";

type Props = PageSeoInput;
---

<SiteShell {...Astro.props}>
  <slot />
</SiteShell>
