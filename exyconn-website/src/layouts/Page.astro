---
import "../styles/global.scss";
import "../styles/global.css";
import "../styles/chrome.css";
import BackToTop from "../components/fragments/BackToTop.astro";
import Footer from "../components/header-and-footer/Footer.astro";
import MarketSuggestion from "../components/MarketSuggestion.astro";
import Header from "../components/header-and-footer/Header.astro";
import SearchModal from "../components/SearchModal.astro";
import { BRANDING_FALLBACK, getBrandingSafe } from "../lib/portal";
import { renderHead, ROBOTS_INDEX, ROBOTS_NOINDEX, type PageMeta } from "@exyconn/seo";
import HeadScripts from "../components/header-and-footer/HeadScripts.astro";
import { baselineJsonLd } from "../lib/chrome/site-schema";
import { socialLinks } from "../lib/social-links";
import { DEFAULT_MARKET, MARKETS, marketUrl, splitMarketPath } from "../lib/i18n/markets";

const {
  title,
  metaTitle,
  description,
  metaDescription,
  keywords,
  metaKeywords,
  metaImage,
  canonical,
  noindex = false,
  ogType = "website",
  jsonLd,
} = Astro.props;

const SITE_URL = (Astro.site?.toString() || "https://exyconn.com/").replace(/\/$/, "");

// Branding is fetched once here and passed down to Header/Footer, so a page render costs a
// single branding request. `getBrandingSafe` never throws — see queries.ts for why branding
// is the one portal query allowed a fallback.
const branding = await getBrandingSafe();

// Every branding field can be an empty string until an admin fills it in, so each read falls
// back to the value the site used to hardcode.
const businessName = branding.businessName || BRANDING_FALLBACK.businessName;
const slogan = branding.slogan || BRANDING_FALLBACK.slogan;
const faviconUrl = branding.faviconUrl || BRANDING_FALLBACK.faviconUrl;
const themeColor = branding.primaryColor || BRANDING_FALLBACK.primaryColor;
// Organization identity only — canonical/og:url stay derived from Astro.site.
const organizationUrl = branding.websiteUrl || SITE_URL;

// Only tag the icon as SVG when it actually is one; an uploaded PNG/ICO favicon would be
// ignored by some browsers if mislabelled, and Astro drops the attribute when undefined.
const faviconType = faviconUrl.toLowerCase().includes(".svg") ? "image/svg+xml" : undefined;

const toAbsoluteUrl = (url: string): string =>
  /^https?:\/\//i.test(url) ? url : `${SITE_URL}${url}`;

const finalTitle = title || metaTitle || `${businessName} | ${slogan}`;
const finalDescription =
  description ||
  metaDescription ||
  "Transform your business with Exyconn's AI solutions and comprehensive technology infrastructure.";
const finalKeywords =
  keywords || metaKeywords || "AI, automation, SaaS, business solutions, cloud infrastructure";

// Build canonical URL: strip query/hash and trailing slashes (root stays "/")
const rawPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

// The middleware rewrote /en-in/about-us to /about-us before this page ran, so the market it
// resolved is on `locals` and the page itself never has to know about markets.
const market = Astro.locals.market ?? DEFAULT_MARKET;
const { rest: pagePath } = splitMarketPath(rawPath);
const marketPath = marketUrl(market, pagePath === "" ? "/" : pagePath);
const canonicalUrl = canonical || `${SITE_URL}${marketPath}`;

/**
 * The same page in every other market.
 *
 * Search engines need this to tell eighty-six near-identical pages apart: without it they
 * pick one, drop the rest as duplicates, and a Spanish reader gets the English page. Google
 * follows `x-default` when it knows nothing about the reader, which is where anyone the site
 * cannot place is sent anyway.
 */
const alternates = MARKETS.map((entry) => ({
  hreflang: entry.locale,
  href: `${SITE_URL}${marketUrl(entry, pagePath === "" ? "/" : pagePath)}`,
}));

// OG image: absolute URL, defaulting to the branding OG image (1200x630). Use a PNG/JPG of the
// same dimensions for full compatibility with Facebook/LinkedIn/X (some platforms reject SVG).
const rawImage = metaImage || branding.ogImageUrl || BRANDING_FALLBACK.ogImageUrl;
const absoluteImage = toAbsoluteUrl(rawImage);
const absoluteLogo = toAbsoluteUrl(faviconUrl);

// Baseline Organization + WebSite JSON-LD (always emitted on every page)
const baselineLd = baselineJsonLd({
  businessName,
  organizationUrl,
  siteUrl: SITE_URL,
  logo: absoluteLogo,
  profiles: socialLinks(branding).map((link) => link.url),
});

const pageLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Every meta tag of the head, printed (escaped, in a fixed order) by @exyconn/seo — the same
// renderer the tools site prerenders with.
const pageMeta: PageMeta = {
  title: finalTitle,
  description: finalDescription,
  canonical: canonicalUrl,
  keywords: finalKeywords,
  robots: noindex ? ROBOTS_NOINDEX : ROBOTS_INDEX,
  locale: market.locale,
  alternates: [
    ...alternates,
    {
      hreflang: "x-default",
      href: `${SITE_URL}${marketUrl(DEFAULT_MARKET, pagePath === "" ? "/" : pagePath)}`,
    },
  ],
  siteName: businessName,
  type: ogType,
  image: { url: absoluteImage, width: 1200, height: 630 },
  themeColor,
  jsonLd: [...baselineLd, ...pageLd],
};
---

<!doctype html>
<html lang={market.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <HeadScripts />
    <link rel="icon" type={faviconType} href={faviconUrl} />
    <meta name="generator" content={Astro.generator} />
    <!-- Apple touch icon for iOS -->
    <link rel="apple-touch-icon" href={faviconUrl} />

    <!-- Title, description, canonical, hreflang, robots, Open Graph, Twitter, JSON-LD -->
    <Fragment set:html={renderHead(pageMeta)} />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-5LF624ZH"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->

    <!-- Skip to main content link for keyboard users -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Header branding={branding} />

    <main id="main-content" role="main" tabindex="-1">
      <slot />
    </main>

    <Footer branding={branding} />
    <MarketSuggestion />

    <!-- Global search modal (Ctrl/Cmd+K, /, or [data-search-open] triggers) -->
    <SearchModal />

    <!-- Global anime.js scroll-reveal animations (lazy, respects reduced motion) -->
    <script>
      import "../scripts/anime-init.ts";
    </script>

    <!-- Focus containment for every modal (mobile menu, search, cookie + accessibility drawers) -->
    <script>
      import "../scripts/modal-dialogs.ts";
    </script>

    <BackToTop />
  </body>
</html>

<style>
  /* `min-height`, not `height`: a 100%-tall body ends the sticky header one screen down. */
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  /* Smooth scroll only when user hasn't disabled it */
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  /* Remove focus outline on main content after navigation */
  #main-content:focus {
    outline: none;
  }
</style>
