{
  "name": "exyconn",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "TINA_PUBLIC_IS_LOCAL=true tinacms dev --port 4005 -c \"astro dev\"",
    "build": "tinacms build --skip-indexing && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,js,jsx,css,scss,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,tsx,js,jsx,css,scss,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:husky": "husky",
    "pre-commit": "lint-staged && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.2",
    "@astrojs/react": "^4.4.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tinacms/datalayer": "^2.0.29",
    "@tinacms/schema-tools": "^2.9.0",
    "animejs": "^4.3.6",
    "astro": "^5.17.1",
    "formik": "^2.4.9",
    "mongodb-level": "^0.0.4",
    "next-auth": "^4.24.15",
    "nodemailer": "^8.0.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sass": "^1.97.3",
    "tailwindcss": "^4.1.18",
    "tinacms-gitprovider-github": "^4.1.16",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@eslint/js": "^9.39.2",
    "@tinacms/cli": "^2.6.1",
    "@types/node": "^25.2.0",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "tinacms": "^3.12.1",
    "tinacms-authjs": "^24.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,astro}": [
      "eslint --fix"
    ],
    "src/**/*.{astro,ts,tsx,js,jsx,css,scss,json,md}": [
      "prettier --write"
    ]
  }
}
