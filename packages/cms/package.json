{
  "name": "@exyconn/cms",
  "version": "1.1.0",
  "private": true,
  "description": "The website CMS's shared model, with ZERO runtime dependencies: the block tree a page compiles to, the GrapesJS placeholder tags, the HTML \u2192 blocks compiler (used by the portal for previews and by the server on publish) and the catalogue of dynamic components the website renders server-side.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run --passWithNoTests"
  },
  "prettier": "@exyconn/config/prettier.json",
  "devDependencies": {
    "@exyconn/config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.1",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
