{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "ES2022.Intl"],
    "module": "node20",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": []
  },
  "include": ["src/**/*.ts"]
}
