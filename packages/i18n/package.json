{
  "name": "@exyconn/i18n",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Localization primitives shared by every portal, the design system and the desktop app: the t() lookup with its source-string fallback, locale/timezone resolution, script direction, and Intl-backed date, number and currency formatting.",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest run --passWithNoTests"
  },
  "prettier": "@exyconn/config/prettier.json",
  "dependencies": {
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@exyconn/config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
