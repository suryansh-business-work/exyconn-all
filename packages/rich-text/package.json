{
  "name": "@exyconn/rich-text",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "The Exyconn rich-text editor: TipTap behind an MUI toolbar — headings, marks, colour, alignment, lists, task lists, links, tables, ImageKit images, HTML source and a word count. The value is an HTML string.",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:ct": "cypress run --component"
  },
  "prettier": "@exyconn/config/prettier.json",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@exyconn/ui": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@tiptap/core": "3.27.4",
    "@tiptap/extension-highlight": "3.27.4",
    "@tiptap/extension-image": "3.27.4",
    "@tiptap/extension-list": "3.27.4",
    "@tiptap/extension-subscript": "3.27.4",
    "@tiptap/extension-superscript": "3.27.4",
    "@tiptap/extension-table": "3.27.4",
    "@tiptap/extension-text-align": "3.27.4",
    "@tiptap/extension-text-style": "3.27.4",
    "@tiptap/extensions": "3.27.4",
    "@tiptap/pm": "^3.27.4",
    "@tiptap/react": "^3.27.4",
    "@tiptap/starter-kit": "^3.27.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@exyconn/config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cypress": "^16.0.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
