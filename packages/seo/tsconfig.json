{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Self-contained on purpose: the tools image copies only this package (no @exyconn/config), and esbuild reads the nearest tsconfig of every file it transforms.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "__tests__", "vitest.config.ts"]
}
