{
  "name": "@exyconn/logger",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "The client side of Tech > Logs, with ZERO runtime dependencies: a durable, batched queue of error and debug logs with breadcrumbs, console capture and a React error boundary. Shared by the portals, the desktop tracker and the phone tracker; each supplies only its transport and device details.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"__tests__/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.ts\"",
    "test": "vitest run"
  },
  "prettier": "@exyconn/config/prettier.json",
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@exyconn/config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/react": "^19.2.18",
    "eslint": "^10.9.1",
    "prettier": "^3.4.2",
    "react": "^19.2.8",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
