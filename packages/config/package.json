{
  "name": "@exyconn/config",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portal app registry plus the build, lint, format and test presets every portal package extends.",
  "exports": {
    "./apps.json": "./apps.json",
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    },
    "./cypress": {
      "types": "./cypress.d.ts",
      "default": "./cypress.js"
    },
    "./eslint": "./eslint.cjs",
    "./prettier.json": "./prettier.json",
    "./tsconfig.app.json": "./tsconfig.app.json",
    "./vitest.setup": "./vitest.setup.ts"
  },
  "scripts": {
    "lint": "eslint \"*.{js,cjs}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@vitejs/plugin-react": "*",
    "vite": "*",
    "vitest": "*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.10.5",
    "eslint": "^8.57.1",
    "typescript": "^5.7.3"
  }
}
