{
  "name": "@exyconn/config",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Portal app registry plus the build, lint, format and test presets every portal package extends.",
  "exports": {
    "./apps.json": "./apps.json",
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    },
    "./cypress": {
      "types": "./cypress.d.ts",
      "default": "./cypress.js"
    },
    "./eslint": {
      "types": "./eslint.d.ts",
      "default": "./eslint.js"
    },
    "./prettier.json": "./prettier.json",
    "./tsconfig.app.json": "./tsconfig.app.json"
  },
  "scripts": {
    "lint": "eslint \"*.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@vitejs/plugin-react": "*",
    "vite": "*",
    "vitest": "*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^22.10.5",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "@types/eslint": "^9.6.1"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.69.0"
  }
}
