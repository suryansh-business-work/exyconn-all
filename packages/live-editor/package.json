{
  "name": "@exyconn/live-editor",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "GrapesJS visual editor for website article bodies: drag-and-drop blocks, a style manager and ImageKit uploads on a canvas styled with the live site's CSS. Produces the body HTML plus the CSS its styles need.",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest run"
  },
  "prettier": "@exyconn/config/prettier.json",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@exyconn/ui": "workspace:*",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "grapesjs": "^0.23.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@exyconn/config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
