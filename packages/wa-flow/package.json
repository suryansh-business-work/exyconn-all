{
  "name": "@exyconn/wa-flow",
  "version": "1.1.0",
  "private": true,
  "description": "The WhatsApp demo's conversation schema (Zod), graph validator, pure conversation engine and seed industries. One definition shared by the portal server (validation, seeding and the real WhatsApp channel, through the compiled dist) and the whatsapp-demo app (engine + editor, straight from source).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./src/index.ts"
    },
    "./seeds": {
      "require": {
        "types": "./dist/seeds/index.d.ts",
        "default": "./dist/seeds/index.js"
      },
      "default": "./src/seeds/index.ts"
    },
    "./engine": {
      "require": {
        "types": "./dist/engine/index.d.ts",
        "default": "./dist/engine/index.js"
      },
      "default": "./src/engine/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run --passWithNoTests"
  },
  "prettier": "@exyconn/config/prettier.json",
  "dependencies": {
    "@exyconn/regex": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@exyconn/config": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^10.9.1",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
