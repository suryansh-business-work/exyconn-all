{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@exyconn/config/tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "../*/src",
    "../*/__tests__",
    "../../exyconn-portal/apps/*/src",
    "../../exyconn-portal/apps/*/__tests__",
    "../../exyconn-portal/ui/src",
    "../../demos/hub/src",
    "../../demos/whatsapp-demo/ui/src",
    "../../demos/whatsapp-demo/ui/__tests__",
    "../../demos/calling-bot-demo/ui/src",
    "../../demos/website-chat-demo/ui/src",
    "../../demos/meeting-bot-demo/ui/src",
    "../../demos/mcp-sandbox-demo/ui/src"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "../**/*.cy.ts",
    "../**/*.cy.tsx",
    "../../exyconn-portal/**/*.cy.ts",
    "../../exyconn-portal/**/*.cy.tsx",
    "../../exyconn-portal/**/cypress",
    "../../demos/**/*.cy.ts",
    "../../demos/**/*.cy.tsx"
  ]
}
