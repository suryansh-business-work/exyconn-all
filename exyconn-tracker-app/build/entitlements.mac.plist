<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron needs both under the hardened runtime; without them the app crashes on launch. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The webcam photo, when the workspace has switched it on. -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <!-- Reaching the portal over HTTPS. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Reading the foreground window title via the Apple Events the tracker already declares. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
