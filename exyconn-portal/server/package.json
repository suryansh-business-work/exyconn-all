{
  "name": "exyconn-portal-server",
  "version": "1.1.0",
  "private": true,
  "description": "Exyconn Portal GraphQL server",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "seed": "tsx src/seed/seed.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:unit": "jest __tests__/unit-tests",
    "test:e2e": "jest __tests__/e2e",
    "coverage": "jest --coverage --collectCoverageFrom=src/**/*.{ts,tsx}"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "graphql": "^16.10.0",
    "graphql-scalars": "^1.24.0",
    "graphql-tag": "^2.12.6",
    "imagekit": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mjml": "^5.3.0",
    "mongoose": "^8.9.5",
    "nodemailer": "^8.0.10",
    "pdfkit": "^0.20.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/typescript": "^4.1.2",
    "@graphql-codegen/typescript-resolvers": "^4.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mjml": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
