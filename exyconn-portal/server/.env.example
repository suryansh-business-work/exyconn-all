PORT=4004
NODE_ENV=development
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# At least 32 random characters (e.g. `openssl rand -hex 32`). Production refuses to boot with
# a published placeholder such as change-me-in-production, and warns below 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Exact origins, comma-separated. '*' is refused in production.
CORS_ORIGIN=http://localhost:4003
# Body limit for /graphql; keep it equal to nginx's client_max_body_size.
# GRAPHQL_BODY_LIMIT=15mb
# Bootstrap admin, created on an empty database only. There is no default password: leave
# SEED_ADMIN_PASSWORD empty and no account is created (use a long, unique value locally).
SEED_ADMIN_NAME=Exyconn Admin
SEED_ADMIN_EMAIL=admin@exyconn.com
SEED_ADMIN_PASSWORD=

# Public portal URL used as the login CTA inside welcome emails
APP_URL=https://portal.exyconn.com
# Website chat (Website > Chatbot): sites the widget connects from, and the site it learns from.
CHAT_ORIGINS=http://localhost:4321,http://localhost:9000
WEBSITE_URL=https://exyconn.com
CHAT_KNOWLEDGE_MARKET=en-us
# Website › Settings › Domains offers this as the A record for a site's domains.
WEBSITE_SERVER_IP=

# NOTE: SMTP, ImageKit and Slack credentials are NOT read from env. Configure
# them at runtime under Admin > Environment Variables (stored in the database,
# Admin only), where each one also has a test-connection action.
