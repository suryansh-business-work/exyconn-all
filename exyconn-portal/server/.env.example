PORT=4004
NODE_ENV=development
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:4003
# Seed admin credentials (temp dev helper used by "Login with Admin")
SEED_ADMIN_NAME=Exyconn Admin
SEED_ADMIN_EMAIL=admin@exyconn.com
SEED_ADMIN_PASSWORD=Admin@1234

# Public portal URL used as the login CTA inside welcome emails
APP_URL=https://portal.exyconn.com

# NOTE: SMTP, ImageKit and Slack credentials are NOT read from env. Configure
# them at runtime under Admin > Environment Variables (stored in the database,
# Admin only), where each one also has a test-connection action.
