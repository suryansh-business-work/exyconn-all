package-manager=pnpm@9.15.0
auto-install-peers=true

# Windows MAX_PATH (260) guard. pnpm names virtual-store dirs after the package plus a
# peer-dependency hash, e.g.
#   app-builder-lib@25.1.8_dmg-builder@25.1.8_electron-builder-squirrel-windows@25.1.8
# which pushed the NSIS template include to 262 chars:
#   node_modules/.pnpm/<that>/node_modules/app-builder-lib/templates/nsis/include/allowOnlyOneInstallerInstance.nsh
# makensis.exe is a legacy Win32 binary with no long-path manifest, so `!include` failed with
# "could not open file" even though the file existed, and `electron-builder --win` could not
# produce the installer. Truncating the virtual-store dir names keeps every path well clear of 260.
virtual-store-dir-max-length=60
