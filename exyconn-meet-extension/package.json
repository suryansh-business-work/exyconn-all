{
  "name": "@exyconn/meet-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Exyconn Meeting Assistant: a Manifest V3 Chrome extension for Google Meet (transcription reminders, consent-based AI transcription, participants, notes and action items), backed by the portal's GraphQL API.",
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "dev": "node scripts/build.mjs --mode development --watch",
    "build": "node scripts/build.mjs --mode production",
    "build:development": "node scripts/build.mjs --mode development",
    "build:staging": "node scripts/build.mjs --mode staging",
    "build:production": "node scripts/build.mjs --mode production",
    "verify": "node scripts/verify.mjs",
    "package": "node scripts/package.mjs",
    "release": "node scripts/build.mjs --mode production && node scripts/verify.mjs && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"!src/graphql/generated/**\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ct": "cypress run --component"
  },
  "prettier": "@exyconn/config/prettier.json",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@exyconn/i18n": "workspace:*",
    "@exyconn/logger": "workspace:*",
    "@exyconn/regex": "workspace:*",
    "@exyconn/ui": "workspace:*",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@exyconn/config": "workspace:*",
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/typed-document-node": "^5.1.2",
    "@graphql-codegen/typescript": "^4.1.2",
    "@graphql-codegen/typescript-operations": "^4.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.3.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "cypress": "^16.0.0",
    "eslint": "^10.9.1",
    "graphql": "^16.14.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
