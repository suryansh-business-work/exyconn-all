# --- Secrets: never commit real env files (only the .example templates) --------
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# --- Dependencies & build output ----------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
out/
**/out/
build/
**/build/
.astro/
**/.astro/
.vite/
**/.vite/
coverage/
**/coverage/
*.tsbuildinfo

# --- Electron packaged artifacts ----------------------------------------------
exyconn-tracker-app/dist/
exyconn-tracker-app/out/

# --- Logs & OS cruft ----------------------------------------------------------
*.log
**/*.log
.DS_Store
Thumbs.db

# --- Editor -------------------------------------------------------------------
.idea/
*.swp

# electron-builder output (the installer is a release artifact, not source)
exyconn-tracker-app/dist/
# Written by every Cypress run; CI uploads them from the runner, so nothing reads a committed copy.
**/cypress/a11y/
**/cypress/screenshots/
**/cypress/videos/

# CI quality reports (.github/scripts/pr-reports)
/reports/
sonar-coverage/
__pycache__/
